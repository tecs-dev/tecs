local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local gm = require("tecs.gm")
local test = require("nupp.test")

local suite = {}

--- Event operations sit at bit 40 of an event's data, as `tecs-audio-abi`
--- packs them.
local OP: integer = 1099511627776

--- The id the test backend hands every Decoder it registers.
local DECODER: integer = 7

--- One event the mixer submitted, decoded from its `EVENT` command.
local record Sent
    handle: integer
    kind: string
    status: integer
    data1: integer
    data2: integer
    at: number
end

--- One `openDecoded` call the backend received.
local record Opened
    decoder: integer
    handle: integer
    params: string
    bytes: string
end

--- A backend that copies every command it is submitted and records every
--- Decoder it is asked to open, on a clock the test moves.
local record Harness
    backend: audiobackend.Backend
    commands: {audiobackend.Command}
    opened: {Opened}
    registered: {integer}
    clock: {number}
    refusal: {string}
end

--- Makes a harness. `decoders` false leaves the backend without the Decoder
--- seam, as a backend with no native library has.
local function newHarness(available: boolean, decoders: boolean): Harness
    local commands: {audiobackend.Command} = {}
    local opened: {Opened} = {}
    local registered = {0}
    local clock = {0.0}
    local refusal = {""}

    local backend = audiobackend.silent()
    backend.available = available
    backend.submit = function(pending: {audiobackend.Command}, count: integer): nil
        for index = 1, count do
            local source = pending[index]
            local copy = audiobackend.newCommand()
            copy.kind = source.kind
            copy.handle = source.handle
            copy.clip = source.clip
            copy.flags = source.flags
            copy.gain = source.gain
            copy.target = source.target
            copy.param = source.param
            copy.data = source.data
            copy.at = source.at
            copy.fade = source.fade
            commands[#commands + 1] = copy
        end
    end
    backend.now = function(): number
        return clock[1]
    end
    if decoders then
        backend.registerDecoder = function(_vtable: any): (integer?, string?)
            registered[1] = registered[1] + 1

            return DECODER
        end
        backend.openDecoded = function(
            decoder: integer,
            handle: integer,
            params: string,
            bytes: string
        ): (boolean, string?)
            if refusal[1] ~= "" then
                return false, refusal[1]
            end
            opened[#opened + 1] = new Opened(decoder = decoder, handle = handle, params = params, bytes = bytes)

            return true
        end
    end

    return new Harness(
        backend = backend,
        commands = commands,
        opened = opened,
        registered = registered,
        clock = clock,
        refusal = refusal
    )
end

local function lastCommand(harness: Harness, kind: integer): audiobackend.Command?
    for index = #harness.commands, 1, -1 do
        if harness.commands[index].kind == kind then
            return harness.commands[index]
        end
    end

    return nil
end

local function countOf(harness: Harness, kind: integer): integer
    local count: integer = 0
    for _, command in ipairs(harness.commands) do
        if command.kind == kind then
            count = count + 1
        end
    end

    return count
end

--- Flushes the mixer and decodes every `EVENT` it has submitted, as the
--- synthesizer would read them.
local function sentBy(harness: Harness, mixer: audio.Audio): {Sent}
    mixer:flush()
    local found: {Sent} = {}
    for _, command in ipairs(harness.commands) do
        if command.kind == audiobackend.EVENT then
            local data = command.data
            local op = data // OP
            local rest = data % OP
            local kind = op == 0 and "message" or op == 1 and "notesOff" or op == 2 and "reset" or "unknown"
            found[#found + 1] = new Sent(
                handle = command.handle,
                kind = kind,
                status = rest % 256,
                data1 = rest // 256 % 256,
                data2 = rest // 65536 % 256,
                at = command.at
            )
        end
    end

    return found
end

--- Returns `value` as `width` little-endian bytes.
local function littleEndian(value: integer, width: integer): string
    local bytes: {string} = {}
    local rest = value
    for index = 1, width do
        bytes[index] = string.char(rest % 256)
        rest = rest // 256
    end

    return table.concat(bytes)
end

--- A SoundFont the harness never reads: the backend is handed only its id.
local function font(): gm.SoundFont
    return new gm.SoundFont(path = "font.sf2", id = 1)
end

local function made(harness: Harness, options: gm.Options?): (audio.Audio, gm.Synth)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 2})

    return mixer, assert(gm.new(mixer, font(), options))
end

function suite.refusesAMissingSoundFontAndAnEmptyPath(): nil
    local missing, reason = gm.loadSoundFont("tests/no-such-font.sf2")
    test.equal(missing, nil)
    test.assert(#assert(reason) > 0, "the library says why")
    local junk, junkReason = gm.loadSoundFontBytes("junk.sf2", "these bytes are not a SoundFont")
    test.equal(junk, nil)
    test.assert(#assert(junkReason) > 0)
    test.raises(
        function(): nil
            gm.loadSoundFont("")
        end,
        "cannot be empty"
    )
end

function suite.startsTheSynthAsOneVoiceOfTheMixer(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness, {group = "music", gain = 0.5})
    test.equal(mixer:sounding(), 1)
    mixer:update()
    local play = assert(lastCommand(harness, audiobackend.PLAY))
    test.equal(play.flags, audiobackend.SYNTH)
    test.equal(play.gain, 0.5)
    test.equal(play.handle, music.voice)
    local bus = mixer:bus("music")
    test.equal(play.target, bus:track().id, "a grouped synth plays on its Bus's Track")
    -- The synthesizer was opened for the voice that started, before the
    -- start crossed, which is what hands it to the mixer.
    test.equal(#harness.opened, 1)
    local opened = harness.opened[1]
    test.equal(opened.decoder, DECODER)
    test.equal(opened.handle, play.handle)
    -- `tecs_gm::Params`: the font id, the polyphony, the effects flag.
    test.equal(opened.params, littleEndian(1, 8) .. littleEndian(64, 4) .. littleEndian(1, 4))
    test.equal(opened.bytes, "")

    mixer:setGroupGain("music", 0.5)
    mixer:update()
    -- The group is a Bus, whose fader the backend applies.
    local fader = assert(lastCommand(harness, audiobackend.BUS_SET))
    test.equal(fader.param, audiobackend.BUS_GAIN)
    test.equal(fader.gain, 0.5)
    mixer:setGroupMuted("music", true)
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.BUS_SET)).param, audiobackend.BUS_MUTE)
    mixer:setGroupMuted("music", false)
    music:setGain(1)
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.SET_GAIN)).gain, 1)
    mixer:pauseGroup("music")
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.BUS_SET)).param, audiobackend.BUS_PAUSE)
    test.assert(mixer:paused(play.handle))
    test.assert(music:paused(), "a synth on a paused Bus is held")

    music:destroy()
    music:destroy()
    mixer:update()
    test.equal(countOf(harness, audiobackend.STOP), 1, "a second destroy does nothing")
    test.equal(assert(lastCommand(harness, audiobackend.STOP)).handle, play.handle)
    test.equal(mixer:sounding(), 0)
    test.assert(not music:playing())
end

function suite.registersItsDecoderOncePerMixer(): nil
    local harness = newHarness(true, true)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 4})
    test.equal(gm.install(mixer), DECODER)
    assert(gm.new(mixer, font()))
    assert(gm.new(mixer, font()))
    test.equal(harness.registered[1], 1)
    local other = audio.newAudio({backend = harness.backend, maxVoices = 4})
    assert(gm.new(other, font()))
    test.equal(harness.registered[1], 2, "another mixer registers its own")
end

function suite.passesPolyphonyEffectsAndTrackToTheVoice(): nil
    local harness = newHarness(true, true)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 2})
    local bus = mixer:bus("music")
    local track = bus:track()
    local music = assert(gm.new(mixer, font(), {polyphony = 128, effects = false, track = track, priority = 3}))
    mixer:update()
    test.equal(harness.opened[1].params, littleEndian(1, 8) .. littleEndian(128, 4) .. littleEndian(0, 4))
    test.equal(assert(lastCommand(harness, audiobackend.PLAY)).target, track.id)
    music:destroy()
end

function suite.pausesTheVoiceAndFadesItOut(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness)
    mixer:update()
    local handle = assert(lastCommand(harness, audiobackend.PLAY)).handle
    music:pause()
    test.assert(music:paused())
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.PAUSE)).handle, handle)
    music:resume()
    test.assert(not music:paused())
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.RESUME)).handle, handle)
    music:destroy(0.75)
    mixer:update()
    local stop = assert(lastCommand(harness, audiobackend.STOP))
    test.equal(stop.handle, handle)
    test.equal(stop.fade, 0.75)
end

function suite.countsAgainstTheVoiceCeiling(): nil
    local harness = newHarness(true, true)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 1})
    local first = assert(gm.new(mixer, font()))
    local second, reason = gm.new(mixer, font())
    test.equal(second, nil)
    test.assert(reason ~= nil)
    test.equal(#harness.opened, 1, "a refused start opens nothing")
    first:destroy()
    test.assert(gm.new(mixer, font()) ~= nil)
end

function suite.reportsADecoderThatRefusesTheSynth(): nil
    local harness = newHarness(true, true)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 2})
    harness.refusal[1] = "font 1 is not loaded"
    local music, reason = gm.new(mixer, font())
    test.equal(music, nil)
    test.equal(reason, "font 1 is not loaded")
    test.equal(mixer:sounding(), 0, "the slot it claimed is given back")
end

function suite.sendsEveryHelperAsTheShortMessageItNames(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness)
    test.assert(music:noteOn(2, 60, 100, 0.25))
    test.assert(music:noteOff(2, 60))
    test.assert(music:controlChange(9, 7, 90, 1))
    test.assert(music:programChange(15, 40))
    test.assert(music:pitchBend(0, 8192))
    test.assert(music:pitchBend(0, 16383))
    test.assert(music:send(0xF8, 0, 0))
    local expected: {
        {number}
    } = {
        {0x92, 60, 100, 0.25},
        {0x82, 60, 0, 0},
        {0xB9, 7, 90, 1},
        {0xCF, 40, 0, 0},
        {0xE0, 0, 64, 0},
        {0xE0, 127, 127, 0},
        {0xF8, 0, 0, 0},
    }
    local sent = sentBy(harness, mixer)
    test.equal(#sent, #expected)
    for index = 1, #expected do
        local event = sent[index]
        test.equal(event.handle, music.voice)
        test.equal(event.kind, "message")
        test.equal(event.status, expected[index][1])
        test.equal(event.data1, expected[index][2])
        test.equal(event.data2, expected[index][3])
        test.equal(event.at, expected[index][4])
    end
    -- There is one clock, and it is the mixer's.
    harness.clock[1] = 1.5
    test.equal(music:now(), 1.5)
    test.equal(music:now(), mixer:now())
end

function suite.carriesNotesOffAndResetAsDecoderOperations(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness)
    test.assert(music:allNotesOff())
    test.assert(music:allNotesOff(3, true, 0.5))
    test.assert(music:reset())
    local sent = sentBy(harness, mixer)
    test.equal(#sent, 3)
    test.equal(sent[1].kind, "notesOff")
    test.equal(sent[1].data1, 0xFF, "no channel is every channel")
    test.equal(sent[1].status, 0, "released rather than cut")
    test.equal(sent[2].data1, 3)
    test.equal(sent[2].status, 1)
    test.equal(sent[2].at, 0.5)
    test.equal(sent[3].kind, "reset")
    test.equal(assert(lastCommand(harness, audiobackend.EVENT)).data, 2 * OP)
end

function suite.refusesEventsOnceDestroyed(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness)
    music:destroy()
    test.assert(not music:noteOn(0, 60, 100), "a destroyed synth sends nothing")
    test.assert(not music:allNotesOff())
    test.assert(not music:reset())
    test.equal(#sentBy(harness, mixer), 0)
end

function suite.raisesForAValueOutsideItsRange(): nil
    local harness = newHarness(true, true)
    local mixer, music = made(harness)
    test.raises(
        function(): nil
            music:noteOn(16, 60, 100)
        end,
        "channel must be from 0 to 15"
    )
    test.raises(
        function(): nil
            music:noteOn(0, 128, 100)
        end,
        "key"
    )
    test.raises(
        function(): nil
            music:send(0x7F, 0, 0)
        end,
        "status"
    )
    test.raises(
        function(): nil
            music:pitchBend(0, 16384)
        end,
        "value"
    )
    test.raises(
        function(): nil
            music:allNotesOff(-1)
        end,
        "channel"
    )
    test.raises(
        function(): nil
            gm.new(mixer, font(), {polyphony = 4})
        end,
        "polyphony"
    )
    test.raises(
        function(): nil
            gm.new(mixer, font(), {polyphony = 257})
        end,
        "polyphony"
    )
    test.equal(#sentBy(harness, mixer), 0)
end

function suite.makesAVoicelessSynthWithoutAnOutput(): nil
    -- A mixer with no output takes no voice. Its synth is still made, so a
    -- game needs no branch for the silent case: every call is taken, and
    -- nothing sounds.
    local mixer = audio.newAudio({backend = audiobackend.silent()})
    local music = assert(gm.new(mixer, font()))
    test.equal(mixer:sounding(), 0)
    test.assert(music:noteOn(0, 60, 100, 0.5))
    test.assert(music:allNotesOff())
    test.assert(not music:playing())
    test.equal(music:now(), 0)
    music:pause()
    music:destroy()
end

function suite.takesAVoiceOnABackendWithNoDecoders(): nil
    local harness = newHarness(true, false)
    local mixer, music = made(harness)
    test.equal(mixer:sounding(), 1)
    test.assert(music:noteOn(0, 60, 100))
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.PLAY)).flags, audiobackend.SYNTH)
    test.equal(#harness.opened, 0)
    test.equal(#sentBy(harness, mixer), 1, "the events still reach the backend")
end

--- Returns the native binding, or skips when `libtecsaudio` is not staged.
local function binding(): {[string]: any}
    local ok, loaded = pcall(require, "tecs.platform.audionative")
    if not ok then
        test.skip("libtecsaudio is not on the loader path: " .. tostring(loaded))
    end

    return loaded as {[string]: any}
end

--- Returns the SoundFont a native test renders, or skips without one: no
--- SoundFont ships in the tree.
local function soundFontPath(): string
    local path = os.getenv("TECS_TEST_SOUNDFONT")
    if path == nil or path == "" then
        test.skip("TECS_TEST_SOUNDFONT names no SoundFont")
    end

    return assert(path)
end

function suite.loadsARealSoundFontOncePerPath(): nil
    local path = soundFontPath()
    local first = assert(gm.loadSoundFont(path))
    test.equal(first.path, path)
    test.assert(first.id ~= 0)
    test.equal(gm.loadSoundFont(path), first)
end

function suite.rendersANoteFromARealSoundFontOnTheMixerClock(): nil
    local path = soundFontPath()
    binding()
    local mixer = audio.newAudio({output = "memory", maxVoices = 4, limiter = false})
    test.assert(mixer.available)
    local loaded = assert(gm.loadSoundFont(path))
    local music = assert(gm.new(mixer, loaded, {effects = false}))
    test.assert(music:playing())
    test.assert(mixer:listen(1))
    test.assert(music:programChange(0, 0))
    test.assert(music:noteOn(0, 60, 110, 0.25))
    test.assert(music:noteOff(0, 60, 0.75))
    test.equal(mixer:step(1), 1)
    test.equal(music:now(), 1)
    local heard = assert(mixer:listening())
    test.assert(heard.peak > 0.01, "the note sounds, peaking at " .. tostring(heard.peak))
    test.assert(#heard.onsets >= 1, "the note has an onset")
    -- Within the synthesizer's eight-frame block, and the detector's window.
    test.assert(
        math.abs(heard.onsets[1] - 0.25) < 0.02,
        "the note starts on the mixer's clock, got " .. tostring(heard.onsets[1])
    )
    music:destroy()
    mixer:destroy()
end

return suite
