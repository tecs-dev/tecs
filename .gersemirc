# CMake. STYLE.md sets the indent and the column limit.
line_length: 120
indent: 4
# Keep the argument names this project writes in the case the CMake docs use,
# rather than having the formatter decide what a command's keywords look like.
unsafe: false
# Where this project's own commands are defined. Without it `tecs_cdef` and
# `tecs_registry` are unknown commands, which gersemi warns about on every run
# and then lays out by a generic rule.
definitions:
  - CMakeLists.txt
  - cmake/
