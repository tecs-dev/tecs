local files = require("tecs.files")
local paths = require("nupp.io.path")
local test = require("nupp.test")

local suite = {}

local SEPARATOR = paths.separator()

--- Puts the module back the way the suite found it.
---
--- The asset root is process-wide module state, so a case that moves it and
--- leaves it moved would decide what the next case sees.
local function restore(): nil
    files.reset()
end

function suite.resolvesTheAssetRootFromAnOverrideAndJoinsWithoutChecking(): nil
    restore()
    files.setAssetRoot("/tmp/tecs-assets")
    test.equal(files.assetRoot(), "/tmp/tecs-assets/")
    test.equal(files.assetPath("levels/one.json"), "/tmp/tecs-assets/levels/one.json")

    -- A root that already ends in a separator does not collect a second one.
    files.setAssetRoot("/tmp/tecs-assets/")
    test.equal(files.assetRoot(), "/tmp/tecs-assets/")
    restore()
end

function suite.refusesAnEmptyRelativePath(): nil
    restore()
    files.setAssetRoot("/tmp/tecs-assets")
    test.assert(not pcall(files.assetPath, ""))
    test.assert(not pcall(files.setAssetRoot, ""))
    restore()
end

function suite.forgetsTheCachedAssetRootOnReset(): nil
    restore()
    files.setAssetRoot("/tmp/first")
    test.equal(files.assetRoot(), "/tmp/first/")
    files.reset()

    -- Nothing set the override back, so the root falls through to wherever the
    -- executable running this suite was loaded from.
    test.assert(files.assetRoot() ~= "/tmp/first/")
    restore()
end

function suite.fallsBackToTheDirectoryTheExecutableWasLoadedFrom(): nil
    restore()
    if os.getenv(files.ASSET_ROOT_VARIABLE) then
        test.skip("TECS_ASSETS names a root in this environment, and it wins")
    end
    local root = files.assetRoot()

    -- Which directory that is belongs to whoever started this process, so the
    -- only fact that holds on every host is that an answer terminates like a
    -- directory. An empty answer means the platform declined to say.
    if root ~= "" then
        local last = root:sub(-1)
        test.assert(last == "/" or last == "\\")
        test.equal(files.assetPath("levels/one.json"), root .. "levels/one.json")
    end
    restore()
end

function suite.readsTheContentGlobalAHostSet(): nil
    restore()
    if os.getenv(files.ASSET_ROOT_VARIABLE) then
        test.skip("TECS_ASSETS names a root in this environment, and it wins")
    end
    local globals = _G as {[string]: any}
    local previous = globals[files.CONTENT_GLOBAL]
    globals[files.CONTENT_GLOBAL] = "/tmp/tecs-installed"
    test.equal(files.assetRoot(), "/tmp/tecs-installed" .. SEPARATOR)
    globals[files.CONTENT_GLOBAL] = previous
    restore()
end

return suite
