const {type Key} = require("nupp.util")
const util = require("nupp.util")

local test = require("nupp.test")
local ecs = require("tecs.ecs")
local suite = {}

function suite.storesValuesUnderTypedKeys(): nil
    local speed: Key<number> = util.newKey("test.store.speed")
    local store = util.newStore()
    store:set(speed, 120)
    local current: number? = store:get(speed)
    test.equal(current as number, 120)
    store:remove(speed)
    test.assert(store:get(speed) == nil)
end

function suite.registersANameOnceAndFindsItByLookup(): nil
    local first: Key<string> = util.newKey("test.store.registered")
    local ok = pcall(function(): nil
        local _: Key<string> = util.newKey("test.store.registered")
    end)
    test.assert(not ok, "a second declaration of a registered name did not raise")
    local found = util.Key.find("test.store.registered") as Key<string>
    test.equal(found, first)
    local registered: integer? = nil
    for id, name in util.Key.registered() do
        if name == "test.store.registered" then
            registered = id
        end
    end
    test.equal(registered as integer, first.id)
    test.assert(util.Key.find("test.store.unregistered") == nil)
end

function suite.keepsStoresAndWorldsIndependent(): nil
    local score: Key<number> = util.newKey("test.store.world.score")
    local first = ecs.newWorld({maxEntities = 2})
    local second = ecs.newWorld({maxEntities = 2})
    first.resources:set(score, 10)
    second.resources:set(score, 20)
    test.equal(first.resources:get(score) as number, 10)
    test.equal(second.resources:get(score) as number, 20)
end

function suite.preservesResourcesWhenEntitiesAreCleared(): nil
    local label: Key<string> = util.newKey("test.store.clear.label")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources:set(label, "ready")
    world:spawn()
    world:commit()
    world:clearEntities()
    test.equal(world.resources:get(label) as string, "ready")
    test.equal(world.liveCount, 0)
end

function suite.sharesTypedStateBetweenSystems(): nil
    local frames: Key<number> = util.newKey("test.store.system.frames")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources:set(frames, 0)
    world:addSystem({
        name = "test.resource.writer",
        phase = ecs.phases.Update,
        run = function(_dt: number, exclusive running: ecs.World): nil
            running.resources:set(frames, (running.resources:get(frames) or 0) + 1)
        end
    })
    world:update(0)
    world:update(0)
    test.equal(world.resources:get(frames) as number, 2)
end

return suite
