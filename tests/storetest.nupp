const {type Key} = require("types")

local ecs = require("tecs.ecs")
local suite = {}

function suite.storesValuesUnderTypedKeys(): nil
    local speed: Key<number> = types.Key("test.store.speed")
    local store = types.Store.create()
    store:set(speed, 120)
    local current: number? = store:get(speed)
    assert.eq(current as number, 120)
    store:remove(speed)
    assert(store:get(speed) == nil)
end

function suite.registersANameOnceAndFindsItByLookup(): nil
    local first: Key<string> = types.Key("test.store.registered")
    local ok = pcall(function(): nil
        local _: Key<string> = types.Key("test.store.registered")
    end)
    assert(not ok, "a second declaration of a registered name did not raise")
    local found = types.Key.find("test.store.registered") as Key<string>
    assert.eq(found, first)
    local registered: integer? = nil
    for id, name in types.Key.registered() do
        if name == "test.store.registered" then
            registered = id
        end
    end
    assert.eq(registered as integer, first.id)
    assert(types.Key.find("test.store.unregistered") == nil)
end

function suite.keepsStoresAndWorldsIndependent(): nil
    local score: Key<number> = types.Key("test.store.world.score")
    local first = ecs.newWorld({maxEntities = 2})
    local second = ecs.newWorld({maxEntities = 2})
    first.resources:set(score, 10)
    second.resources:set(score, 20)
    assert.eq(first.resources:get(score) as number, 10)
    assert.eq(second.resources:get(score) as number, 20)
end

function suite.preservesResourcesWhenEntitiesAreCleared(): nil
    local label: Key<string> = types.Key("test.store.clear.label")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources:set(label, "ready")
    world:spawn()
    world:commit()
    world:clearEntities()
    assert.eq(world.resources:get(label) as string, "ready")
    assert.eq(world.liveCount, 0)
end

function suite.sharesTypedStateBetweenSystems(): nil
    local frames: Key<number> = types.Key("test.store.system.frames")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources:set(frames, 0)
    world:addSystem({
        name = "test.resource.writer",
        phase = ecs.phases.Update,
        run = function(_dt: number, exclusive running: ecs.World): nil
            running.resources:set(frames, (running.resources:get(frames) or 0) + 1)
        end
    })
    world:update(0)
    world:update(0)
    assert.eq(world.resources:get(frames) as number, 2)
end

return suite
