local test = require("nupp.test")
local ecs = require("tecs.ecs")
local suite = {}

function suite.storesValuesUnderTypedKeys(): nil
    local speed: nupp.data.Key<number> = nupp.data.newKey("test.store.speed")
    local store = nupp.data.newStore()
    store[speed] = 120
    local current: number? = store[speed]
    test.equal(current as number, 120)
    store[speed] = nil
    test.assert(store[speed] == nil)
end

function suite.registersANameOnceAndFindsItByLookup(): nil
    local first: nupp.data.Key<string> = nupp.data.newKey("test.store.registered")
    local ok = pcall(function(): nil
        local _: nupp.data.Key<string> = nupp.data.newKey("test.store.registered")
    end)
    test.assert(not ok, "a second declaration of a registered name did not raise")
    local found = nupp.data.findKey("test.store.registered") as nupp.data.Key<string>
    test.equal(found, first)
    test.equal(nupp.data.listKeys()["test.store.registered"], first.id)
    test.assert(nupp.data.findKey("test.store.unregistered") == nil)
end

function suite.keepsStoresAndWorldsIndependent(): nil
    local score: nupp.data.Key<number> = nupp.data.newKey("test.store.world.score")
    local first = ecs.newWorld({maxEntities = 2})
    local second = ecs.newWorld({maxEntities = 2})
    first.resources[score] = 10
    second.resources[score] = 20
    test.equal(first.resources[score] as number, 10)
    test.equal(second.resources[score] as number, 20)
end

function suite.preservesResourcesWhenEntitiesAreCleared(): nil
    local label: nupp.data.Key<string> = nupp.data.newKey("test.store.clear.label")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources[label] = "ready"
    world:spawn()
    world:commit()
    world:clearEntities()
    test.equal(world.resources[label] as string, "ready")
    test.equal(world.liveCount, 0)
end

function suite.sharesTypedStateBetweenSystems(): nil
    local frames: nupp.data.Key<number> = nupp.data.newKey("test.store.system.frames")
    local world = ecs.newWorld({maxEntities = 2})
    world.resources[frames] = 0
    world:addSystem({
        name = "test.resource.writer",
        phase = ecs.phases.Update,
        run = function(_dt: number, exclusive running: ecs.World): nil
            running.resources[frames] = (running.resources[frames] or 0) + 1
        end
    })
    world:update(0)
    world:update(0)
    test.equal(world.resources[frames] as number, 2)
end

return suite
