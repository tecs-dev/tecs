local test = require("nupp.test")
local random = require("nupp.data.random")

local suite = {}

local function equalWords(first: {integer}, second: {integer}): nil
    test.equal(#first, #second)
    for index = 1, #first do
        test.equal(first[index], second[index])
    end
end

local function sameDraws(first: random.Random, second: random.Random): nil
    for _ = 1, 30 do
        test.equal(first:next(), second:next())
    end
end

local function payload(snapshot: tecs.ecs.Snapshot): any
    for _, entry in ipairs(snapshot.data) do
        if entry.key == "tecs.random" then
            return entry.value
        end
    end
    error("missing random snapshot payload")
end

function suite.retainsIdentityAndKeepsWorldsIndependent(): nil
    const first = tecs.ecs.newWorld()
    const second = tecs.ecs.newWorld()
    const loot: random.Random = first:randomStream("game.loot")
    test.assert(loot == first:randomStream("game.loot"))
    test.assert(loot ~= first:randomStream("game.Loot"))
    test.assert(loot ~= second:randomStream("game.loot"))
    sameDraws(loot, second:randomStream("game.loot"))
end

function suite.pinsTheLegacyNameSeedAndStateContract(): nil
    const world = tecs.ecs.newWorld()
    world:seedRandom(42)
    equalWords(world:randomStream("game.loot"):state(), {1782179806, -635290933, 1046902905, -1667463104})
end

function suite.ignoresOtherStreamsCreationAndDrawOrder(): nil
    const first = tecs.ecs.newWorld()
    const second = tecs.ecs.newWorld()
    first:seedRandom(999)
    second:seedRandom(999)
    for index = 1, 20 do
        const other = second:randomStream("game.other." .. tostring(index))
        for _ = 1, index do
            other:integer(100)
        end
    end
    sameDraws(first:randomStream("game.loot"), second:randomStream("game.loot"))
end

function suite.reseedsExistingAndFutureStreamsWithoutReplacingObjects(): nil
    const world = tecs.ecs.newWorld()
    const expected = tecs.ecs.newWorld()
    const loot = world:randomStream("game.loot")
    const weather = world:randomStream("game.weather")
    loot:next()
    weather:next()
    world:seedRandom(12345)
    expected:seedRandom(12345)
    test.assert(world:randomStream("game.loot") == loot)
    test.assert(world:randomStream("game.weather") == weather)
    sameDraws(loot, expected:randomStream("game.loot"))
    sameDraws(weather, expected:randomStream("game.weather"))
    sameDraws(world:randomStream("game.future"), expected:randomStream("game.future"))
end

function suite.wrapsSeedsAndUsesAFixedDefault(): nil
    const first = tecs.ecs.newWorld()
    const second = tecs.ecs.newWorld()
    second:seedRandom(0x5EED1234)
    sameDraws(first:randomStream("default"), second:randomStream("default"))
    first:seedRandom(2147483648)
    second:seedRandom(-2147483648)
    sameDraws(first:randomStream("wrapped"), second:randomStream("wrapped"))
    first:seedRandom(0)
    second:seedRandom(4294967296)
    sameDraws(first:randomStream("zero"), second:randomStream("zero"))
end

function suite.rejectsBadArgumentsWithoutInstallingRandomState(): nil
    const world = tecs.ecs.newWorld()
    test.raises(
        function(): nil
            world:randomStream("")
        end,
        "non%-empty name"
    )
    for _, invalid in ipairs({math.huge, -math.huge, 0 / 0, 1.5}) do
        test.raises(
            function(): nil
                world:seedRandom(invalid as integer)
            end,
            "finite integer"
        )
    end
    test.equal(#world:saveSnapshot().data, 0)
end

function suite.savesSeedOnlyAndLoadsWithoutPriorInitialization(): nil
    const world = tecs.ecs.newWorld()
    world:seedRandom(42)
    const saved = world:saveSnapshot()
    test.equal(payload(saved).seed, 42)
    const fresh = tecs.ecs.newWorld()
    fresh:loadSnapshot(saved)
    sameDraws(world:randomStream("later"), fresh:randomStream("later"))
end

function suite.restoresCapturedAndNotYetRequestedStreams(): nil
    const world = tecs.ecs.newWorld()
    world:seedRandom(31337)
    const loot = world:randomStream("loot")
    const weather = world:randomStream("weather")
    for _ = 1, 20 do
        loot:next()
        weather:next()
    end
    const saved = world:saveSnapshot()
    const lootState = loot:state()
    const weatherState = weather:state()
    loot:next()
    weather:next()
    world:seedRandom(1)
    world:loadSnapshot(saved)
    test.assert(world:randomStream("loot") == loot)
    equalWords(loot:state(), lootState)
    equalWords(weather:state(), weatherState)
    const fresh = tecs.ecs.newWorld()
    fresh:loadSnapshot(saved)
    sameDraws(loot, fresh:randomStream("loot"))
    sameDraws(weather, fresh:randomStream("weather"))
end

function suite.restartsUnsavedStreamsFromTheRestoredSeed(): nil
    const source = tecs.ecs.newWorld()
    source:seedRandom(42)
    const saved = source:saveSnapshot()
    const world = tecs.ecs.newWorld()
    const extra = world:randomStream("extra")
    extra:next()
    world:loadSnapshot(saved)
    test.assert(extra == world:randomStream("extra"))
    sameDraws(extra, source:randomStream("extra"))
end

function suite.detachesSnapshotsAndDoesNotAdvanceOnSave(): nil
    const world = tecs.ecs.newWorld()
    const stream = world:randomStream("loot")
    const original = stream:state()
    const saved = world:saveSnapshot()
    equalWords(stream:state(), original)
    stream:next()
    equalWords(payload(saved).streams.loot, original)
    payload(saved).streams.loot[1] = 0
    const before = stream:state()
    payload(world:saveSnapshot()).streams.loot[2] = 0
    equalWords(stream:state(), before)
end

function suite.leavesStreamsAloneWhenClearingEntitiesOrLoadingNoRandomData(): nil
    const world = tecs.ecs.newWorld()
    const stream = world:randomStream("loot")
    stream:next()
    const state = stream:state()
    world:spawn()
    world:commit()
    world:clearEntities()
    equalWords(stream:state(), state)
    const empty = tecs.ecs.newWorld()
    world:loadSnapshot(empty:saveSnapshot())
    equalWords(stream:state(), state)
end

function suite.validatesAllRandomDataBeforeClearingEntitiesOrMovingStreams(): nil
    const world = tecs.ecs.newWorld()
    const live = world:spawn()
    world:commit()
    const stream = world:randomStream("loot")
    const state = stream:state()
    const saved = world:saveSnapshot()
    const bad: {
        any
    } = {
        false,
        {},
        {seed = "seed", streams = {}},
        {seed = 0 / 0, streams = {}},
        {seed = 1, streams = {loot = {0, 0, 0, 0}}},
        {seed = 1, streams = {loot = {1, 2, 3}}},
        {seed = 1, streams = {loot = {1, 2, 3, 4, 5}}},
        {seed = 1, streams = {loot = {1, 2, 3, 1.5}}},
        {seed = 1, streams = {loot = {1, 2, 3, 4294967296}}},
        {seed = 1, streams = {[""] = {1, 2, 3, 4}}},
        {seed = 1, streams = {[1] = {1, 2, 3, 4}}},
        {seed = 1, streams = {loot = "state"}},
        {seed = 1, streams = {loot = {[1] = 1, [2] = 2, [3] = 3, [4] = 4, extra = 5}}}
    }
    const pending = world:spawn()
    local function loadInvalid(): nil
        world:loadSnapshot(saved)
    end

    for _, invalid in ipairs(bad) do
        saved.data[1].value = invalid
        test.raises(loadInvalid, "tecs.random")
        test.assert(world:isAlive(live))
        test.assert(not world:isAlive(pending))
        equalWords(stream:state(), state)
    end
    world:commit()
    test.assert(world:isAlive(pending))
end

function suite.acceptsTheLegacyPayloadAndUnsignedStateWords(): nil
    const world = tecs.ecs.newWorld()
    world:seedRandom(0)
    const saved = world:saveSnapshot()
    test.equal(saved.data[1].key, "tecs.random")
    saved.data[1].value = {seed = 42, streams = {loot = {1782179806, 3659676363, 1046902905, 2627504192}}}
    world:loadSnapshot(saved)
    const expected = random.newRandom()
    expected:setState({1782179806, -635290933, 1046902905, -1667463104})
    sameDraws(world:randomStream("loot"), expected)
end

function suite.reservesThePersistedKey(): nil
    const world = tecs.ecs.newWorld()
    test.raises(
        function(): nil
            world:addSnapshotHandler({name = "tecs.random"})
        end,
        "reserved"
    )
    test.raises(
        function(): nil
            world:saveSnapshot({customData = {["tecs.random"] = {}}})
        end,
        "reserved"
    )
end

function suite.restoresBeforeUserSnapshotHandlersRun(): nil
    const world = tecs.ecs.newWorld()
    const loot = world:randomStream("loot")
    const savedState = loot:state()
    local restored = false
    world:addSnapshotHandler({
        name = "test.random.consumer",
        save = function(): any
            return true
        end,
        load = function(): nil
            equalWords(loot:state(), savedState)
            restored = true
        end
    })
    const saved = world:saveSnapshot()
    loot:next()
    world:loadSnapshot(saved)
    test.assert(restored)
end

function suite.roundTripsThroughJsonWithoutLosingSignedWords(): nil
    const world = tecs.ecs.newWorld()
    world:seedRandom(42)
    const stream = world:randomStream("game.loot")
    stream:next()
    const encoded = nupp.data.json.encode(world:saveSnapshot())
    const restored = tecs.ecs.newWorld()
    -- JSON decoding is the dynamic serialization boundary; loadSnapshot validates it.
    restored:loadSnapshot(nupp.data.json.decode(encoded) as tecs.ecs.Snapshot)
    sameDraws(stream, restored:randomStream("game.loot"))
end

function suite.suppliesTheNuppGeneratorDirectlyToJitterPredicates(): nil
    const world = tecs.ecs.newWorld()
    const stream = world:randomStream("game.jitter")
    const expected = random.newRandom()
    expected:setState(stream:state())
    world:addSystem({
        phase = tecs.ecs.phases.Update,
        runIf = tecs.ecs.runif.every(1, 0.2, stream),
        run = function(): nil
        end
    })
    world:update(1)
    expected:next()
    equalWords(stream:state(), expected:state())
end

return suite
