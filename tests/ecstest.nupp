local test = require("nupp.test")
local ecs = require("tecs.ecs")
local suite = {}

function suite.exposesTheWorldLifecycleThroughThePublicModule(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn()
    test.assert(not world:isAlive(entity))
    world:commit()
    test.assert(world:isAlive(entity))
    world:despawn(entity)
    world:commit()
    test.assert(not world:isAlive(entity))
end

function suite.exposesEntityCapacityConstants(): nil
    test.equal(ecs.DEFAULT_MAX_ENTITIES, 1048576)
    test.equal(ecs.MAX_ENTITIES, 4194303)
end

function suite.exposesTagComponentsThroughThePublicModule(): nil
    local visible = ecs.newTagComponent({name = "test.PublicVisible"})
    local selected = ecs.newTagComponent({name = "test.PublicSelected", transient = true})
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn(visible, selected)
    test.assert(not world:has(entity, visible))
    world:commit()
    test.assert(world:has(entity, visible))
    test.assert(world:has(entity, selected))
    test.assert(ecs.findComponentByName(visible.componentName) == visible)
    test.assert(ecs.findComponentById(selected.componentId) == selected)
end

function suite.exposesReusableQueriesThroughWorlds(): nil
    local tag = ecs.newTagComponent({name = "test.PublicQueryTag"})
    local world = ecs.newWorld({maxEntities = 4})
    local matching: ecs.Query = world:newQuery({include = {tag}})
    world:spawn(tag)
    world:spawn()
    world:commit()
    local count: integer = 0
    for _, length in matching:iter() do
        count = count + (length as integer)
    end
    test.equal(count, 1)
end

function suite.exposesDeferredTagMutationThroughWorlds(): nil
    local tag = ecs.newTagComponent({name = "test.PublicMutationTag"})
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn()
    world:commit()
    world:set(entity, tag)
    test.assert(not world:has(entity, tag))
    world:commit()
    test.assert(world:has(entity, tag))
    world:remove(entity, tag)
    world:commit()
    test.assert(not world:has(entity, tag))
end

function suite.exposesTypedScalarComponentsThroughThePublicModule(): nil
    local level: ecs.ScalarComponent<number> = ecs.newScalarComponent({
        name = "test.PublicLevel",
        kind = "number",
        default = 1
    })
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn(level(7))
    world:commit()
    local current: number? = world:get(entity, level)
    test.equal(current as number, 7)
end

local record PublicPoint
    x: number
end

function suite.exposesTableComponentsThroughThePublicModule(): nil
    local position: ecs.TableComponent<PublicPoint> = ecs.newComponent({
        name = "test.PublicPosition",
        construct = function(x: number): PublicPoint
            return new PublicPoint(x = x)
        end,
        default = function(): PublicPoint
            return new PublicPoint(x = 0)
        end
    })
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn(position(8))
    world:commit()
    local current: PublicPoint? = world:get(entity, position)
    test.equal((current as PublicPoint).x, 8)
end

function suite.exposesTheSynchronousSystemPipeline(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local seenDt: number = -1
    world:addSystem({
        name = "test.public.system",
        phase = ecs.phases.Update,
        run = function(dt: number, exclusive _running: ecs.World): nil
            seenDt = dt
        end
    })
    world:update(0.125)
    test.equal(seenDt, 0.125)
end

function suite.exposesExclusiveRelationships(): nil
    local follows: ecs.Relationship = ecs.newRelationship({
        name = "test.PublicRelationship",
        exclusive = true,
        reverseIndex = true
    })
    local world = ecs.newWorld({maxEntities = 3})
    local target = world:spawn()
    local source = world:spawn(follows(target))
    world:commit()
    local relationship: ecs.RelationshipValue? = world:get(source, follows)
    test.equal((relationship as ecs.RelationshipValue).target, target)
end

return suite
