const ecs = require("tecs.ecs")
const {type RunIf} = require("tecs.ecs")
const {type World} = require("tecs.ecs")
const random = require("nupp.random")

local test = require("nupp.test")

local suite = {}

function suite.removesDelayedAnonymousSystemsAfterOneRun(): nil
    const world = ecs.newWorld()
    local calls = 0
    const name = world:addSystem({
        phase = ecs.phases.Update,
        runIf = ecs.runif.after(0.25),
        run = function(): nil
            calls = calls + 1
        end
    })
    world:update(0.125)
    test.equal(calls, 0)
    world:update(0.125)
    test.equal(calls, 1)
    test.assert(not world:removeSystem(name))
    world:update(1)
    test.equal(calls, 1)
end

function suite.retainsIntervalOvershootButRunsOncePerDispatch(): nil
    const world = ecs.newWorld()
    const predicate = ecs.runif.every(0.25)
    test.assert(not predicate(0.125, world, "timer"))
    test.assert(predicate(0.625, world, "timer"))
    test.assert(predicate(0, world, "timer"))
    test.assert(predicate(0, world, "timer"))
    test.assert(not predicate(0, world, "timer"))
end

function suite.cooldownFiresImmediatelyAndDiscardsOvershoot(): nil
    const world = ecs.newWorld()
    const predicate = ecs.runif.cooldown(0.25)
    test.assert(predicate(0, world, "timer"))
    test.assert(not predicate(0.125, world, "timer"))
    test.assert(predicate(1, world, "timer"))
    test.assert(not predicate(0, world, "timer"))
    test.assert(not predicate(0.125, world, "timer"))
    test.assert(predicate(0.125, world, "timer"))
    test.assert(ecs.runif.cooldown(0)(0, world, "zero"))
    test.assert(ecs.runif.after(0)(0, world, "zero"))
end

function suite.pausesTimersWhenTheirSystemOrPhaseIsDisabled(): nil
    const world = ecs.newWorld()
    local calls = 0
    world:addSystem({
        name = "timer",
        phase = ecs.phases.Update,
        runIf = ecs.runif.every(0.25),
        run = function(): nil
            calls = calls + 1
        end
    })
    world:update(0.125)
    world:setSystemEnabled("timer", false)
    world:update(1)
    world:setSystemEnabled("timer", true)
    world:disablePhase(ecs.phases.Update)
    world:update(1)
    world:enablePhase(ecs.phases.Update)
    world:update(0.125)
    test.equal(calls, 1)
end

function suite.fixedTimersConsumeTheFixedDelta(): nil
    const world = ecs.newWorld({timestep = 0.125})
    local calls = 0
    world:addSystem({
        phase = ecs.phases.FixedUpdate,
        runIf = ecs.runif.every(0.25),
        run = function(): nil
            calls = calls + 1
        end
    })
    world:update(0.5)
    test.equal(calls, 2)
end

function suite.stateGateOrderControlsTimerProgress(): nil
    const world = ecs.newWorld()
    world:createState("game")
    world:createState("menu")
    world:pushState("menu")
    const paused = ecs.runif.both(ecs.runif.inState("game"), ecs.runif.every(0.25))
    const advancing = ecs.runif.both(ecs.runif.every(0.25), ecs.runif.inState("game"))
    test.assert(not paused(0.125, world, "paused"))
    test.assert(not advancing(0.125, world, "advancing"))
    world:pushState("game")
    test.assert(not paused(0.125, world, "paused"))
    test.assert(advancing(0.125, world, "advancing"))
    test.assert(paused(0.125, world, "paused"))
end

function suite.shortCircuitsAndPassesPredicateArguments(): nil
    const world = ecs.newWorld()
    local leftCalls = 0
    local rightCalls = 0
    const left: RunIf = function(dt: number, exclusive value: World, name: string): boolean
        test.equal(dt, 0.125)
        test.assert(value == world)
        test.equal(name, "combined")
        leftCalls = leftCalls + 1

        return true
    end
    const right: RunIf = function(): boolean
        rightCalls = rightCalls + 1;
        return false
    end
    test.assert(ecs.runif.either(left, right)(0.125, world, "combined"))
    test.equal(rightCalls, 0)
    test.assert(not ecs.runif.both(ecs.runif.negate(left), right)(0.125, world, "combined"))
    test.equal(rightCalls, 0)
    test.assert(not ecs.runif.both(left, right)(0.125, world, "combined"))
    test.equal(rightCalls, 1)
    test.assert(ecs.runif.either(right, left)(0.125, world, "combined"))
    test.equal(rightCalls, 2)
    test.equal(leftCalls, 4)
end

function suite.jitterUsesTheSuppliedReproducibleGenerator(): nil
    const world = ecs.newWorld()
    const first = ecs.runif.every(0.25, 0.125, random.newRandom(42))
    const second = ecs.runif.every(0.25, 0.125, random.newRandom(42))
    local runs = 0
    for index = 1, 256 do
        const fired = first(0.03125, world, "first")
        test.equal(fired, second(0.03125, world, "second"))
        if fired then
            runs = runs + 1
        end
    end
    test.assert(runs > 20 and runs < 50)
    const clamp = ecs.runif.every(1, 1000, random.newRandom(42))
    test.assert(clamp(1, world, "clamp"))
    test.assert(not clamp(0, world, "clamp"))
end

function suite.rejectsInvalidTimerArgumentsAtConstruction(): nil
    test.raises(
        function(): nil
            ecs.runif.every(0)
        end,
        "positive and finite"
    )
    test.raises(
        function(): nil
            ecs.runif.every(-1)
        end,
        "positive and finite"
    )
    test.raises(
        function(): nil
            ecs.runif.every(math.huge)
        end,
        "positive and finite"
    )
    test.raises(
        function(): nil
            ecs.runif.every(1, -1)
        end,
        "non%-negative and finite"
    )
    test.raises(
        function(): nil
            ecs.runif.every(1, 0.1)
        end,
        "requires a nupp.random.Random"
    )
    test.raises(
        function(): nil
            ecs.runif.after(-1)
        end,
        "non%-negative and finite"
    )
    test.raises(
        function(): nil
            ecs.runif.cooldown(0 / 0)
        end,
        "non%-negative and finite"
    )
end

return suite
