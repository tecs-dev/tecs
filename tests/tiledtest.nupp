const tiled = require("tecs.tiled")
const test = require("nupp.test")
const ecs = require("tecs.ecs")
const gfx = require("tecs.gfx")
const {type World} = require("tecs.ecs")
const {type Object} = require("tecs.tiled")
const physics = require("tecs.physics")
const {type Component} = require("tecs.ecs")

local suite = {}
function suite.loadsExternalTilesetsGroupsAndMetadata(): nil
    local map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    test.equal(map.width, 3)
    test.equal(#map.layers, 2)
    local ground = map.layers[1]
    test.equal(ground.x, 8)
    test.equal(ground.opacity, 0.5)
    test.equal(ground.parallaxX, 0.5)
    test.equal(map.tilesets[1].tiles[1].properties.cost, 2)
    test.equal(map.layers[2].objects[1].properties.health, 100)
    test.assert(assert(tiled.getTile(map, 1, 0, 1)).flipH)
    test.assert(assert(tiled.getTile(map, 1, 2, 1)).flipD)
end

function suite.rendersAnimatesAndEditsOneCell(): nil
    local world = ecs.newWorld()
    local map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    local root = tiled.spawn(world, map)
    world:update(0)
    local children = world:relationshipSources(ecs.ChildOf, root)
    test.equal(#children, 2)
    local entity = children[1]
    local original = assert(world:get(entity, gfx.Sprite)).u0
    world:update(0.15)
    test.assert(assert(world:get(entity, gfx.Sprite)).u0 ~= original)
    tiled.setTile(map, 1, 2, 0, {tileset = 1, id = 1})
    world:update(0)
    test.equal(#world:relationshipSources(ecs.ChildOf, root), 2)
    test.assert(world:isAlive(entity))
    tiled.setTile(map, 1, 2, 0, nil)
    world:update(0)
    test.equal(#world:relationshipSources(ecs.ChildOf, root), 2)
    world:despawn(root)
    world:commit()
    test.equal(world.liveCount, 0)
    world:shutdown()
end

function suite.restoresObjectsWithoutDuplicatingThem(): nil
    local world = ecs.newWorld()
    local marker = ecs.newTagComponent({name = "tiledtest.Player"})
    tiled.registerObject("Player", function(exclusive running: World, object: Object): integer
        test.equal(object.id, 42)
        return running:spawn(marker)
    end)
    local map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    local root = tiled.spawn(world, map)
    world:update(0)
    local count = world.liveCount
    local snapshot = world:saveSnapshot()
    world:loadSnapshot(snapshot)
    world:update(0)
    test.equal(world.liveCount, count)
    local objects = 0
    for _, child in ipairs(world:relationshipSources(ecs.ChildOf, root)) do
        if world:has(child, marker) then
            objects = objects + 1
        end
    end
    test.equal(objects, 1)
    world:shutdown()
end

function suite.buildsNativeCollisionAndRemovesEditedBoundaries(): nil
    local world = ecs.newWorld()
    local map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    tiled.setTile(map, 1, 0, 1, nil)
    tiled.setTile(map, 1, 1, 1, nil)
    tiled.setTile(map, 1, 2, 1, nil)
    tiled.spawn(world, map, {collision = true})
    world:update(0);
    world:update(1 / 60)
    local hit = physics.raycast(world, 32, -10, 32, 40)
    test.assert(hit ~= nil)
    tiled.setTile(map, 1, 1, 0, nil)
    world:update(0);
    world:update(1 / 60)
    test.equal(physics.raycast(world, 32, -10, 32, 40), nil)
    world:shutdown()
end

function suite.rendersTileObjectsAndReusesRepeatingImages(): nil
    local world = ecs.newWorld()
    local map = tiled.load("tests/fixtures/tiled/maps/objects.tmx")
    local root = tiled.spawn(world, map)
    world:update(0)
    local children = world:relationshipSources(ecs.ChildOf, root)
    test.assert(#children > 3)
    local object = children[1]
    local pose = assert(world:get(object, ecs.Transform2D))
    test.equal(pose.x, 32)
    test.equal(pose.y, 48)
    world:update(0)
    test.equal(#world:relationshipSources(ecs.ChildOf, root), #children)
    test.assert(world:isAlive(object))
    world:remove(root, tiled.Tilemap)
    world:update(0)
    test.equal(#world:relationshipSources(ecs.ChildOf, root), 0)
    world:shutdown()
end

local function countComponent(world: World, component: Component): integer
    return world:newQuery({include = {component}}):count()
end

function suite.groupsStaticTilesAndKeepsAnimatedSprites(): nil
    const world = ecs.newWorld()
    const map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    const root = tiled.spawn(world, map)
    world:update(0)
    test.equal(countComponent(world, gfx.TileChunk), 1)
    test.equal(countComponent(world, gfx.Sprite), 1)
    test.equal(countComponent(world, tiled.TileSource), 1)
    local chunkId: integer = 0
    for _, id in ipairs(world:relationshipSources(ecs.ChildOf, root)) do
        if world:has(id, gfx.TileChunk) then
            chunkId = id
        end
    end
    const chunk = assert(world:get(chunkId, gfx.TileChunk))
    unsafe do
        test.equal(chunk.tiles[2], 2)
        test.equal(chunk.tiles[17], 2147483650)
        test.equal(chunk.tiles[18], 1073741826)
        test.equal(chunk.tiles[19], 536870914)
    end
    -- Move a cell from static to animated, then back, preserving its chunk.
    tiled.setTile(map, 1, 1, 0, {tileset = 1, id = 0})
    world:update(0)
    test.equal(countComponent(world, gfx.Sprite), 2)
    test.assert(world:isAlive(chunkId))
    tiled.setTile(map, 1, 1, 0, {tileset = 1, id = 1})
    world:update(0)
    test.equal(countComponent(world, gfx.Sprite), 1)
    test.assert(world:isAlive(chunkId))
    world:shutdown()
end

function suite.groupsByTilesetAndRegionIncludingNegativeCells(): nil
    const world = ecs.newWorld()
    const map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    map.infinite = true
    map.layers[1].cells = {}
    map.layers[2].objects = {}
    map.tilesets[2] = map.tilesets[1]
    for y = 0, 15 do
        for x = 0, 15 do
            tiled.setTile(map, 1, x, y, {tileset = 1, id = 1})
        end
    end
    tiled.setTile(map, 1, -1, -1, {tileset = 1, id = 1})
    tiled.setTile(map, 1, 16, 0, {tileset = 1, id = 1})
    tiled.setTile(map, 1, 1, 1, {tileset = 2, id = 1})
    const root = tiled.spawn(world, map)
    world:update(0)
    test.equal(countComponent(world, gfx.TileChunk), 4)
    test.equal(countComponent(world, gfx.Sprite), 0)
    test.equal(world.liveCount, 5)
    tiled.setTile(map, 1, -1, -1, nil)
    world:update(0)
    test.equal(countComponent(world, gfx.TileChunk), 3)
    world:remove(root, tiled.Tilemap)
    world:update(0)
    test.equal(world.liveCount, 1)
    world:shutdown()
end

function suite.staticMapsUseChunkCapacityInsteadOfTileCapacity(): nil
    const world = ecs.newWorld({maxEntities = 257})
    const map = tiled.load("tests/fixtures/tiled/maps/level.tmx")
    map.width, map.height = 256, 256
    map.layers[1].cells = {}
    map.layers[2].objects = {}
    for y = 0, 255 do
        for x = 0, 255 do
            map.layers[
                1
            ].cells[
                #map.layers[1].cells + 1
            ] = {x = x, y = y, tileset = 1, id = 1, flipH = false, flipV = false, flipD = false}
        end
    end
    tiled.spawn(world, map)
    world:update(0)
    test.equal(countComponent(world, gfx.TileChunk), 256)
    test.equal(countComponent(world, gfx.Sprite), 0)
    test.equal(world.liveCount, 257)
    world:shutdown()
end

return suite
