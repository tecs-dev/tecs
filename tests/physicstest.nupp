function suite.rejectsAnUnknownJointKind(): nil
    local world = newWorld()
    local anchor = world:spawn()
    physics.attach(world, anchor)
    local arm = world:spawn()
    physics.attach(world, arm)
    local joint = world:spawn()
    world:update(STEP)
    test.raises(function(): nil
        physics.attachJoint(world, joint, anchor, arm, {kind = "wobbly"})
    end, "unknown joint kind")
