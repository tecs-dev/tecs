function suite.keepsACallerSuppliedTransformWhenABodyIsAttached(): nil
    local world = newWorld()
    local placed = world:spawn(ecs.Transform2D(48, 96, 0, 3, 1.25))
    physics.attach(world, placed)
    local bare = world:spawn()
    physics.attach(world, bare)
    world:update(STEP)

    local kept = assert(world:get(placed, ecs.Transform2D))
    test.equal(kept.x, 48)
    test.equal(kept.y, 96)
    test.equal(kept.layer, 3)
    test.equal(kept.rotation, 1.25)
    local defaulted = assert(world:get(bare, ecs.Transform2D))
    test.equal(defaulted.x, 0)
    test.equal(defaulted.layer, 1)
end

function suite.raycastsInPixelsAndReturnsNilWithoutASimulation(): nil
    local world = newWorld()
    local entity = world:spawn(ecs.Transform2D(64, 0))
    physics.attach(world, entity)
    world:update(STEP)

    local hit = physics.raycast(world, 0, 0, 128, 0)
    test.equal(assert(hit).entity, entity)
    test.equal(assert(hit).x, 64)
    test.equal(physics.raycast(ecs.newWorld(), 0, 0, 1, 0), nil)
end

function suite.roundTripsSimulationStateUnderTheEstablishedKey(): nil
    local world = newWorld()
    local entity = world:spawn(ecs.Transform2D(0, 0))
    physics.attach(world, entity)
    local shape = world:spawn()
    physics.attachCollider(world, shape, entity, {radius = 4})
    world:update(STEP)
    physics.setVelocity(world, entity, 128, 256)
    world:update(STEP)
    local before = handleOf(world, entity)

    local snapshot = world:saveSnapshot()

    local saved: {[string]: any}? = nil
    for index = 1, #snapshot.data do
        if snapshot.data[index].key == "tecs.physics" then
            saved = snapshot.data[index].value as {[string]: any}
        end
    end
    test.assert(saved ~= nil, "the snapshot carries a tecs.physics entry")
    test.assert(assert(saved).state ~= nil)
    -- `Motion` is where a save records velocity, so it survives the load.
    local motion = assert(world:get(entity, physics.Motion))
    test.equal(motion.vx, 128)
    test.equal(motion.vy, 256)

    world:loadSnapshot(snapshot)

    test.assert(world:isAlive(entity))
    local after = assert(world:get(entity, physics.RigidBody))
    test.equal(after.index1, before.index1)
    test.equal(after.generation, before.generation)
    test.assert(physics.hasBody(world, entity))
    test.notEqual(assert(world:get(shape, physics.ColliderShape)).index1, 0)
    test.equal(assert(world:get(entity, physics.Motion)).vx, 128)
end

function suite.reattachesAJointAfterASnapshotLoad(): nil
    local world = newWorld()
    local anchor = world:spawn()
    physics.attach(world, anchor, {kind = "static"})
    local arm = world:spawn()
    physics.attach(world, arm)
    local joint = world:spawn()
    physics.attachJoint(world, joint, anchor, arm, {kind = "revolute"})
    world:update(STEP)
    local before = assert(world:get(joint, physics.JointLink))

    world:loadSnapshot(world:saveSnapshot())

    local after = assert(world:get(joint, physics.JointLink))
    test.equal(after.index1, before.index1)
    test.equal(after.generation, before.generation)
    test.equal(assert(world:get(joint, physics.JointBodyA)).target, anchor)
    test.equal(assert(world:get(joint, physics.JointBodyB)).target, arm)
end

function suite.ignoresASnapshotFromAnotherEngine(): nil
    local world, backend = newWorld()
    local entity = world:spawn()
    physics.attach(world, entity)
    world:update(STEP)
    local snapshot = world:saveSnapshot()
    for index = 1, #snapshot.data do
        if snapshot.data[index].key == "tecs.physics" then
            (snapshot.data[index].value as {[string]: any}).engine = "somethingelse"
        end
    end

    backend.clearLog()
    world:loadSnapshot(snapshot)

    test.equal(#logged(backend, "load"), 0)
end

--- Runs one identical scenario and answers the command stream it produced.
local function scenario(): {string}
    local world, backend = newWorld(9.81)
    local ground = world:spawn(ecs.Transform2D(0, 100))
    physics.attach(world, ground, {kind = "static", halfWidth = 200, halfHeight = 8})
    local boxes: {integer} = {}
    for index = 1, 8 do
        -- Two archetypes, so archetype order and entity order disagree and the
        -- stream only matches when the reconcile pass sorts.
        local box: integer
        if index % 2 == 0 then
            box = world:spawn(ecs.Transform2D(index * 12, index * -7), marker)
        else
            box = world:spawn(ecs.Transform2D(index * 12, index * -7))
        end
        physics.attach(world, box, {halfWidth = 6, halfHeight = 6, restitution = 0.2})
        boxes[index] = box
    end
    local joint = world:spawn()
    physics.attachJoint(world, joint, ground, boxes[1], {kind = "revolute"})

    for frame = 1, 20 do
        if frame == 5 then
            physics.applyImpulse(world, boxes[3], 64, -32)
        elseif frame == 9 then
            physics.detach(world, boxes[6])
        elseif frame == 12 then
            world:despawn(boxes[7])
        end
        world:update(STEP)
    end
    world:shutdown()

    return backend.log
end

function suite.producesTheSameCommandStreamForTheSameScenario(): nil
    local first = scenario()
    local second = scenario()

    test.equal(#first, #second)
    test.assert(#first > 20, "the scenario produced a command stream worth comparing")
    for index = 1, #first do
        test.equal(second[index], first[index], "command " .. tostring(index) .. " diverged")
    end
end

function suite.releasesTheSimulationAtShutdown(): nil
    local world, backend = newWorld()
    local entity = world:spawn()
    physics.attach(world, entity)
    world:update(STEP)
    backend.clearLog()

    world:shutdown()

    test.equal(#logged(backend, "destroy"), 1)
    test.equal(physics.of(world), nil)
    test.assert(not physics.hasBody(world, entity))
end

return suite
