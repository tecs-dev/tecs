local assets = require("tecs.assets")
local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local ecs = require("tecs.ecs")
local hostpump = require("nupp.host.pump")
local test = require("nupp.test")

local suite = {}

--- One `openDecoded` call the recorder took.
local record Opened
    decoder: integer
    handle: integer
    params: string
    bytes: string
end

--- A backend that keeps the command stream instead of making a sound.
local record Recorder
    backend: audiobackend.Backend
    log: {audiobackend.Command}
    finished: {integer}
    registered: {any}
    opened: {Opened}
    closed: {boolean}
end

--- The id the recorder hands every Decoder it registers.
local DECODER_ID: integer = 7

local function newRecorder(): Recorder
    local log: {audiobackend.Command} = {}
    local finished: {integer} = {}
    local registered: {any} = {}
    local opened: {Opened} = {}
    local closed = {false}

    local backend = new audiobackend.Backend(
        available = true,
        frequency = 48000,
        channels = 2,
        submit = function(commands: {audiobackend.Command}, count: integer): nil
            for index = 1, count do
                local source = commands[index]
                local copy = audiobackend.newCommand()
                copy.kind = source.kind
                copy.handle = source.handle
                copy.clip = source.clip
                copy.flags = source.flags
                copy.gain = source.gain
                copy.pitch = source.pitch
                copy.start = source.start
                copy.fade = source.fade
                copy.loopStart = source.loopStart
                copy.x = source.x
                copy.y = source.y
                copy.z = source.z
                copy.at = source.at
                copy.target = source.target
                copy.param = source.param
                copy.data = source.data
                log[#log + 1] = copy
            end
        end,
        drain = function(out: {integer}): integer
            local written: integer = 0
            for index = 1, #finished do
                written = written + 1
                out[written] = finished[index]
            end
            for index = #finished, 1, -1 do
                finished[index] = nil
            end

            return written
        end,
        registerDecoder = function(vtable: any): (integer?, string?)
            registered[#registered + 1] = vtable

            return DECODER_ID
        end,
        openDecoded = function(decoder: integer, handle: integer, params: string, bytes: string): (boolean, string?)
            opened[#opened + 1] = new Opened(decoder = decoder, handle = handle, params = params, bytes = bytes)

            return true
        end,
        position = function(_handle: integer): number?
            return 0.25
        end,
        seek = function(_handle: integer, _seconds: number): boolean
            return true
        end,
        close = function(): nil
            closed[1] = true
        end
    )

    return new Recorder(
        backend = backend,
        log = log,
        finished = finished,
        registered = registered,
        opened = opened,
        closed = closed
    )
end

local function clear(recorder: Recorder): nil
    for index = #recorder.log, 1, -1 do
        recorder.log[index] = nil
    end
end

local function lastOf(recorder: Recorder, kind: integer): audiobackend.Command?
    for index = #recorder.log, 1, -1 do
        if recorder.log[index].kind == kind then
            return recorder.log[index]
        end
    end

    return nil
end

local function countOf(recorder: Recorder, kind: integer): integer
    local total: integer = 0
    for index = 1, #recorder.log do
        if recorder.log[index].kind == kind then
            total = total + 1
        end
    end

    return total
end

local nextName = {0}

--- Returns a Sound name nothing else in this suite has interned, so Sound
--- indices never cross between tests.
local function freshName(): string
    nextName[1] = nextName[1] + 1

    return "test/audio/sound" .. tostring(nextName[1]) .. ".ogg"
end

--- Stands for the vtable address a Decoder's library exports. The recorder
--- only keeps it, so any value it can compare does.
local VTABLE: any = {"test decoder"}

--- Makes a Sound a Decoder named `decoder` plays, the way an extension does.
local function newSound(name: string, decoder: string?): audio.Sound
    local made = new audio.Sound(
        name = name,
        duration = 1,
        decoder = decoder or "test",
        vtable = function(): any
            return VTABLE
        end,
        params = "params:" .. name,
        bytes = "bytes:" .. name,
        reload = nil
    )

    return made
end

--- Makes a fresh Sound and adds it to the mixer, so a component row naming
--- it by `soundId` plays it.
local function loaded(mixer: audio.Audio): audio.Sound
    local sound = newSound(freshName())
    mixer:addSound(sound)

    return sound
end

--- Returns the index a component row names a Sound by.
local function idOf(sound: audio.Sound): integer
    return audio.soundId(sound.name)
end

function suite.reportsNoOutputWithoutABackend(): nil
    local mixer = audio.newAudio({backend = audiobackend.silent()})
    test.assert(not mixer.available)
    test.equal(mixer:play(newSound(freshName())), 0)
    test.equal(mixer:sounding(), 0)
end

function suite.answersZeroForAnAbsentClip(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    test.equal(mixer:play(nil), 0)
    test.equal(countOf(recorder, audiobackend.PLAY), 0)
end

function suite.rejectsAVoiceCeilingOutsideItsRange(): nil
    test.raises(
        function(): nil
            audio.newAudio({maxVoices = 0, backend = audiobackend.silent()})
        end,
        "maxVoices"
    )
end

function suite.internsSoundAndGroupNamesBothWays(): nil
    local id = audio.soundId("test/audio/interned.ogg")
    test.equal(audio.soundId("test/audio/interned.ogg"), id)
    test.equal(audio.soundName(id), "test/audio/interned.ogg")
    test.equal(audio.soundName(0), nil)
    -- The deprecated names answer the same registry.
    test.equal(audio.clipId("test/audio/interned.ogg"), id)
    test.equal(audio.clipPath(id), "test/audio/interned.ogg")

    local group = audio.groupId("interned")
    test.equal(audio.groupId("interned"), group)
    test.equal(audio.groupName(group), "interned")
    test.equal(audio.groupName(0), nil)

    test.raises(
        function(): nil
            audio.soundId("")
        end,
        "name cannot be empty"
    )
    test.raises(
        function(): nil
            audio.clipId("")
        end,
        "clip path"
    )
    test.raises(
        function(): nil
            audio.groupId("")
        end,
        "group name"
    )
end

function suite.playsASoundThroughItsDecoderRegisteringItOnce(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    test.equal(#mixer:decoders(), 0)
    local first = newSound(freshName())
    local second = newSound(freshName())

    local handle = mixer:play(first, {gain = 0.5})
    test.assert(handle > 0)
    test.assert(mixer:play(second) > 0)
    test.assert(mixer:play(first) > 0)
    -- One Decoder, registered on its first Sound's first play.
    test.equal(#recorder.registered, 1)
    test.equal(recorder.registered[1], VTABLE)
    test.equal(#mixer:decoders(), 1)
    test.equal(mixer:decoders()[1], "test")

    -- Each start opens its Playback from the Sound's own parameters.
    test.equal(#recorder.opened, 3)
    local opened = recorder.opened[1]
    test.equal(opened.decoder, DECODER_ID)
    test.equal(opened.handle, handle)
    test.equal(opened.params, first.params)
    test.equal(opened.bytes, first.bytes)
    test.equal(recorder.opened[2].params, second.params)

    mixer:flush()
    local command = assert(lastOf(recorder, audiobackend.PLAY))
    test.equal(command.clip, idOf(first))
    test.equal(command.flags & audiobackend.SYNTH, audiobackend.SYNTH)

    -- A Sound it played is one it knows, by name.
    test.equal(mixer:sound(first.name), first)
    test.equal(mixer:sound("test/audio/never-played.ogg"), nil)
    test.equal(#mixer:sounds(), 2)
    local info = assert(mixer:voiceList()[1])
    test.equal(info.clip, first.name)

    -- A second Decoder registers on its own first play, under its own id.
    recorder.backend.registerDecoder = function(vtable: any): (integer?, string?)
        recorder.registered[#recorder.registered + 1] = vtable

        return DECODER_ID + 1
    end
    test.assert(mixer:play(newSound(freshName(), "other")) > 0)
    test.equal(#recorder.registered, 2)
    test.equal(assert(recorder.opened[#recorder.opened]).decoder, DECODER_ID + 1)
    test.equal(#mixer:decoders(), 2)
    test.equal(mixer:decoders()[2], "other")
end

function suite.refusesASoundWhoseDecoderTheBackendRefuses(): nil
    local recorder = newRecorder()
    local asked = {0}
    recorder.backend.registerDecoder = function(_vtable: any): (integer?, string?)
        asked[1] = asked[1] + 1

        return nil, "not this one"
    end
    local mixer = audio.newAudio({backend = recorder.backend})
    local sound = newSound(freshName())

    test.equal(mixer:play(sound), 0)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.PLAY), 0)
    test.equal(#recorder.opened, 0)
    test.equal(#mixer:decoders(), 0)
    local events = mixer:events()
    local last = assert(events[#events])
    test.equal(last.event, "refuse")
    test.equal(last.reason, "decoder")
    test.equal(last.sound, sound.name)
    test.equal(mixer:stats().refused, 1)

    -- A refusal is not remembered: the next play asks again.
    test.equal(mixer:play(sound), 0)
    test.equal(asked[1], 2)
end

function suite.refusesEverySoundOnABackendThatTakesNoDecoders(): nil
    local recorder = newRecorder()
    recorder.backend.registerDecoder = nil
    local mixer = audio.newAudio({backend = recorder.backend})
    test.equal(mixer:play(newSound(freshName())), 0)
    local events = mixer:events()
    test.equal(assert(events[#events]).reason, "decoder")
end

function suite.takesAStartOnABackendThatOpensNothing(): nil
    local recorder = newRecorder()
    recorder.backend.openDecoded = nil
    local mixer = audio.newAudio({backend = recorder.backend})
    local handle = mixer:play(newSound(freshName()))
    test.assert(handle > 0)
    test.assert(mixer:playing(handle))
end

function suite.stopsAVoiceWhosePlaybackDidNotOpen(): nil
    local recorder = newRecorder()
    recorder.backend.openDecoded = function(
        _decoder: integer,
        _handle: integer,
        _params: string,
        _bytes: string
    ): (boolean, string?)
        return false, "the bytes are not audio"
    end
    local mixer = audio.newAudio({backend = recorder.backend})
    test.equal(mixer:play(newSound(freshName())), 0)
    test.equal(mixer:sounding(), 0)
end

function suite.reReadsASoundThroughItsReload(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local sound = newSound(freshName())
    local reloads = {0}
    sound.reload = function(): (boolean, string?)
        reloads[1] = reloads[1] + 1
        sound.duration = 2

        return true
    end

    local unknown, unknownReason = mixer:reload(sound.name)
    test.assert(not unknown)
    test.matches(assert(unknownReason), "nothing has played or added")

    test.equal(mixer:addSound(sound), idOf(sound))
    local ok, reason = mixer:reload(sound.name)
    test.assert(ok)
    test.equal(reason, nil)
    test.equal(reloads[1], 1)
    test.equal(sound.duration, 2)

    local fixed = loaded(mixer)
    local refused, refusedReason = mixer:reload(fixed.name)
    test.assert(not refused)
    test.matches(assert(refusedReason), "cannot be re%-read")
end

function suite.carriesASoundThroughASnapshotByName(): nil
    local name = freshName()
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})
    local sound = newSound(name)
    world:spawn(audio.SoundComponent(mixer:addSound(sound)))
    world:commit()
    local snapshot = world:saveSnapshot()

    -- Another world and another mixer, which does not know the Sound yet.
    local otherRecorder = newRecorder()
    local other = ecs.newWorld()
    local otherMixer = audio.install(other, {backend = otherRecorder.backend})
    other:loadSnapshot(snapshot)
    other:update(0)
    test.equal(countOf(otherRecorder, audiobackend.PLAY), 0)

    -- The row names the Sound, so it starts once this mixer knows it.
    otherMixer:addSound(newSound(name))
    other:update(0)
    test.equal(assert(lastOf(otherRecorder, audiobackend.PLAY)).clip, audio.soundId(name))
end

function suite.sendsOnePlayCarryingEveryStartingSetting(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)

    local handle = mixer:play(clip, {gain = 0.5, pitch = 1.5, loop = true, loopStart = 2, start = 1, fadeIn = 0.25,})
    test.assert(handle > 0)
    mixer:flush()

    local command = assert(lastOf(recorder, audiobackend.PLAY))
    test.equal(command.handle, handle)
    test.equal(command.clip, idOf(clip))
    test.equal(command.gain, 0.5)
    test.equal(command.pitch, 1.5)
    test.equal(command.loopStart, 2)
    test.equal(command.start, 1)
    test.equal(command.fade, 0.25)
    test.equal(command.flags % 2, audiobackend.LOOP)
    test.assert(mixer:playing(handle))
    test.assert(mixer:looping(handle))
    test.equal(mixer:sounding(), 1)
end

function suite.keepsAStaleHandleFromReachingTheVoiceThatReplacedIt(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 1})
    local clip = loaded(mixer)

    local first = mixer:play(clip)
    mixer:stop(first)
    test.assert(not mixer:playing(first))

    local second = mixer:play(clip)
    test.assert(second > 0)
    test.notEqual(second, first)
    test.assert(mixer:playing(second))

    mixer:flush()
    clear(recorder)
    mixer:setGain(first, 0.1)
    mixer:stop(first)
    mixer:pause(first)
    mixer:flush()
    test.equal(#recorder.log, 0)
    test.assert(mixer:playing(second))
end

function suite.declinesRatherThanStealingWhenEveryVoiceIsBusy(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 2})
    local clip = loaded(mixer)

    local first = mixer:play(clip)
    local second = mixer:play(clip)
    test.assert(first > 0)
    test.assert(second > 0)
    test.equal(mixer:play(clip), 0)
    test.equal(mixer:sounding(), 2)
    test.assert(mixer:playing(first))
    test.assert(mixer:playing(second))
    test.equal(mixer:maxVoices(), 2)
end

function suite.holdsAFadingVoiceUntilTheBackendReportsItFinished(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)

    clear(recorder)
    mixer:stop(handle, 0.5)
    mixer:flush()
    local stop = assert(lastOf(recorder, audiobackend.STOP))
    test.equal(stop.handle, handle)
    test.equal(stop.fade, 0.5)
    -- Still sounding: the fade is the backend's to run.
    test.assert(mixer:playing(handle))
    test.equal(mixer:update(0), 1)

    -- A second stop does not shorten a fade in progress.
    clear(recorder)
    mixer:stop(handle, 0.1)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.STOP), 0)

    recorder.finished[1] = handle
    test.equal(mixer:update(0), 0)
    test.assert(not mixer:playing(handle))
end

function suite.freesASlotWithinTheCallWhenAStopHasNoFade(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)

    mixer:stop(handle)
    test.assert(not mixer:playing(handle))
    test.equal(mixer:sounding(), 0)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.STOP)).fade, 0)
end

function suite.ignoresAFinishedHandleForARecycledSlot(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 1})
    local clip = loaded(mixer)

    local first = mixer:play(clip)
    mixer:stop(first)
    local second = mixer:play(clip)

    -- The backend reports the voice it was told to stop, after the slot has
    -- already been taken again.
    recorder.finished[1] = first
    test.equal(mixer:update(0), 1)
    test.assert(mixer:playing(second))
end

function suite.stopsEverythingWithAndWithoutAFade(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 4})
    local clip = loaded(mixer)
    mixer:play(clip)
    mixer:play(clip)

    clear(recorder)
    mixer:stopAll(0.2)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.STOP), 2)
    test.equal(mixer:sounding(), 2)

    mixer:stopAll()
    test.equal(mixer:sounding(), 0)
end

function suite.sendsGainPitchAndLoopOnlyWhenTheyMove(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip, {gain = 0.5, pitch = 2, loop = true})

    mixer:flush()
    clear(recorder)
    mixer:setGain(handle, 0.5)
    mixer:setPitch(handle, 2)
    mixer:setLoop(handle, true)
    mixer:flush()
    test.equal(#recorder.log, 0)

    mixer:setGain(handle, 0.25)
    mixer:setPitch(handle, 0.5)
    mixer:setLoop(handle, false)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.SET_GAIN)).gain, 0.25)
    test.equal(assert(lastOf(recorder, audiobackend.SET_PITCH)).pitch, 0.5)
    test.equal(assert(lastOf(recorder, audiobackend.SET_LOOP)).flags, 0)
    test.assert(not mixer:looping(handle))
end

function suite.stampsEveryVoiceCommandWithTheTimeItWasGiven(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip, {at = 1.25, resample = "nearest"})
    mixer:flush()
    local play = assert(lastOf(recorder, audiobackend.PLAY))
    test.equal(play.at, 1.25)
    test.equal(play.flags // audiobackend.NEAREST % 2, 1)
    test.equal(mixer:resample(handle), "nearest")

    clear(recorder)
    mixer:setGain(handle, 0.5, 1.5)
    mixer:setPitch(handle, 2, 1.5)
    mixer:setLoop(handle, true, 1.75)
    mixer:setPosition(handle, 1, 2, 3, 2)
    mixer:setStereo(handle, 0.25, 0.75, 2.25)
    mixer:setResample(handle, "linear", 2.5)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.SET_GAIN)).at, 1.5)
    test.equal(assert(lastOf(recorder, audiobackend.SET_PITCH)).at, 1.5)
    test.equal(assert(lastOf(recorder, audiobackend.SET_LOOP)).at, 1.75)
    test.equal(assert(lastOf(recorder, audiobackend.SET_POSITION)).at, 2)
    test.equal(assert(lastOf(recorder, audiobackend.SET_STEREO)).at, 2.25)
    local resample = assert(lastOf(recorder, audiobackend.SET_RESAMPLE))
    test.equal(resample.at, 2.5)
    test.equal(resample.flags, 0)
    test.equal(mixer:resample(handle), "linear")
    test.equal(mixer:resample(0), nil)

    -- A command sent with no time carries none, even from a reused record.
    clear(recorder)
    mixer:setGain(handle, 0.25)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.SET_GAIN)).at, 0)
end

function suite.sendsATimedValueEvenWhenItRepeatsTheLastOne(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip, {pitch = 2})
    mixer:flush()
    clear(recorder)
    -- The second lands after the first only if the backend says so, so both go.
    mixer:setPitch(handle, 3, 2)
    mixer:setPitch(handle, 3, 1)
    mixer:setResample(handle, "linear", 1)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.SET_PITCH), 2)
    test.equal(countOf(recorder, audiobackend.SET_RESAMPLE), 1)
    -- An untimed repeat of the last value sent is still skipped.
    clear(recorder)
    mixer:setPitch(handle, 3)
    mixer:setResample(handle, "linear")
    mixer:flush()
    test.equal(#recorder.log, 0)
end

function suite.holdsATimedStopsSlotUntilTheBackendReportsItFinished(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)
    mixer:flush()
    clear(recorder)
    mixer:stop(handle, nil, 3)
    mixer:flush()
    local stop = assert(lastOf(recorder, audiobackend.STOP))
    test.equal(stop.at, 3)
    test.equal(stop.fade, 0)
    test.assert(mixer:playing(handle))
    test.equal(mixer:update(0), 1)
    recorder.finished[1] = handle
    test.equal(mixer:update(0), 0)
    test.assert(not mixer:playing(handle))
end

function suite.holdsATimedStartIntoAPausedGroupOnItsOwnFrame(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    mixer:pauseGroup("music")
    clear(recorder)
    local handle = mixer:play(clip, {group = "music", at = 4})
    mixer:flush()
    -- The Bus holds it from its first frame, with no pause of its own to
    -- race the start.
    test.equal(assert(lastOf(recorder, audiobackend.PLAY)).at, 4)
    test.equal(countOf(recorder, audiobackend.PAUSE), 0)
    test.assert(mixer:paused(handle))
end

function suite.readsTheOutputClockAndFrequencyFromTheBackend(): nil
    -- A backend with no clock reads as zero.
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    test.equal(mixer:now(), 0)
    test.equal(mixer:frequency(), 48000)

    local backend = newRecorder().backend
    local frames = {0}
    backend.now = function(): number
        return frames[1] / 48000
    end
    local clocked = audio.newAudio({backend = backend})
    frames[1] = 1200
    test.equal(clocked:now(), 0.025)
    clocked:destroy()
    test.equal(clocked:now(), 0)

    local silent = audio.newAudio({backend = audiobackend.silent()})
    test.equal(silent:now(), 0)
    test.equal(silent:frequency(), 0)
    -- Taken and dropped like any other command.
    test.equal(silent:play(nil, {at = 1}), 0)

    -- What `newAudio` falls back to reports the configured frequency, so a
    -- count of frames over it is still a time.
    test.equal(audiobackend.silent(44100).frequency, 44100)
end

function suite.refusesATimeThatIsNotFinite(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)
    test.raises(
        function(): nil
            mixer:play(clip, {at = 1 / 0})
        end,
        "finite"
    )
    test.raises(
        function(): nil
            mixer:setGain(handle, 0.5, 0 / 0)
        end,
        "finite"
    )
    test.raises(
        function(): nil
            mixer:stop(handle, 0, -1 / 0)
        end,
        "finite"
    )
    -- A time already mixed is still a time.
    mixer:setGain(handle, 0.5, -1)
    mixer:destroy()
end

function suite.logsRefusalsAndCountsThem(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 1})
    local clip = loaded(mixer)
    local first = mixer:play(clip, {group = "sfx"})
    test.equal(mixer:play(clip), 0)
    mixer:stop(first)
    local events = mixer:events()
    test.equal(#events, 3)
    test.equal(events[1].event, "start")
    test.equal(events[1].group, "sfx")
    test.equal(events[2].event, "refuse")
    test.equal(events[2].reason, "voices")
    test.equal(events[3].event, "stop")
    test.equal(mixer:stats().refused, 1)
    mixer:destroy()
end

function suite.ticksUpdateOnlyWhenTheGameDidNot(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    mixer:play(clip)
    -- The tick flushes what the game queued, as update does.
    mixer:tick(0.016)
    test.assert(#recorder.log >= 1)
    local sent = #recorder.log
    mixer:play(clip)
    mixer:update(0.016)
    test.equal(#recorder.log, sent + 1)
    -- Already updated this frame: the tick leaves it.
    mixer:tick(0.016)
    test.equal(#recorder.log, sent + 1)
    mixer:destroy()
end

function suite.stealsTheOldestOverATracksPolyphonyAndRefusesAnEqualOverTheBudget(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 3})
    local clip = loaded(mixer)
    local track = mixer:track({polyphony = 2})
    test.equal(track:polyphony(), 2)
    local first = track:play(clip)
    local second = track:play(clip)
    local third = track:play(clip)
    test.assert(third ~= 0)
    test.assert(not mixer:playing(first), "the oldest went")
    test.assert(mixer:playing(second))
    test.equal(track:sounding(), 2)
    test.equal(mixer:stats().steals, 1)
    -- One more on the default Track fills the budget; another of equal
    -- priority is refused, and a higher one steals the lowest.
    test.assert(mixer:play(clip) ~= 0)
    test.equal(mixer:play(clip), 0)
    local urgent = mixer:play(clip, {priority = 5})
    test.assert(urgent ~= 0)
    test.equal(mixer:stats().steals, 2)
    local logged = mixer:events()
    local steals = 0
    for _, entry in ipairs(logged) do
        if entry.event == "steal" then
            steals = steals + 1
        end
    end
    test.equal(steals, 2)
    mixer:destroy()
end

function suite.routesATrackAndItsEffectsThroughTheCommands(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, limiter = false})
    local effects = require("tecs.audio.effects")
    clear(recorder)
    local track = mixer:track({bus = "sfx", sends = {room = 0.25}})
    local filter = track:insert(effects.filter({shape = "highpass", frequency = 200}))
    filter:set("frequency", 400, 2)
    mixer:flush()
    local insert = assert(lastOf(recorder, audiobackend.EFFECT_INSERT))
    test.equal(insert.target, track.id)
    test.equal(insert.data, filter.id)
    local param = assert(lastOf(recorder, audiobackend.EFFECT_PARAM))
    test.equal(param.gain, 400)
    test.equal(param.at, 2)
    test.equal(filter:get("frequency"), 400)
    test.equal(assert(lastOf(recorder, audiobackend.SEND)).gain, 0.25)
    test.raises(
        function(): nil
            filter:set("resonance", 1)
        end,
        "no parameter"
    )
    test.raises(
        function(): nil
            effects.filter({shape = "comb"})
        end,
        "no shape"
    )
    filter:remove()
    test.equal(#track:effects(), 0)
    track:destroy()
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.TRACK_DESTROY)).target, track.id)
    test.equal(track:play(loaded(mixer)), 0, "a destroyed Track refuses")
    local master = mixer:masterBus()
    test.raises(
        function(): nil
            master:destroy()
        end,
        "Master"
    )
    mixer:destroy()
end

function suite.placesAnEmitterTrackAgainstTheListenerAndSendsItToItsZone(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend, maxVoices = 4, limiter = false})
    local clip = loaded(mixer)
    world:spawn(ecs.Transform2D(100, 50), audio.ListenerComponent(10))
    local emitter = world:spawn(ecs.Transform2D(130, 10), audio.TrackComponent(idOf(clip), true, 1, true, 1, true))
    world:spawn(ecs.Transform2D(130, 10), audio.ReverbZoneComponent(audio.groupId("cave"), 50, 0.5))
    world:commit()
    clear(recorder)
    world:update(0)

    -- The row's position is the transform less the listener's, over the
    -- scale, with world y flipped into the listener's frame.
    local row = assert(world:get(emitter, audio.TrackComponent))
    test.equal(row.x, 3)
    test.equal(row.y, 4)
    test.assert(row.voice > 0)
    -- The voice sounds on an emitter Track of its own, placed there.
    local play = assert(lastOf(recorder, audiobackend.PLAY))
    test.assert(play.target ~= 0, "an emitter Track, not the default")
    test.equal(play.flags & audiobackend.SPATIAL, 0, "the Track is placed, not the voice")
    local placed = assert(lastOf(recorder, audiobackend.TRACK_SET))
    test.equal(placed.param, audiobackend.TRACK_POSITION)
    test.equal(placed.x, 3)
    test.equal(placed.y, 4)
    -- At the zone's centre it sends at the zone's level.
    local send = assert(lastOf(recorder, audiobackend.SEND))
    test.equal(send.target, play.target)
    test.equal(send.param, mixer:bus("cave").id)
    test.equal(send.gain, 0.5)

    -- Moving the listener moves the Track, not the voice.
    clear(recorder)
    world:update(0)
    test.equal(countOf(recorder, audiobackend.TRACK_SET), 0, "nothing moved, nothing sent")
    -- Stopping the row destroys its Track with its voice.
    assert(world:getMut(emitter, audio.TrackComponent)).playing = false
    world:update(0)
    test.equal(assert(lastOf(recorder, audiobackend.TRACK_DESTROY)).target, play.target)
end

function suite.playsASoundAssetThroughItsHandle(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local name = freshName()
    local made = {0}
    local kind = new assets.Kind(
        name = assets.SOUND .. ".test",
        open = function(path: string): (assets.Job?, string?)
            return new assets.Job(
                poll = function(): (assets.Status, any?, string?)
                    made[1] = made[1] + 1

                    return "ready", newSound(path), nil
                end,
                cancel = function(): nil
                end
            )
        end,
        release = nil
    )
    local loader = assets.newAssets()
    local handle: assets.Handle? = nil
    local pump = hostpump.newPump()
    local state = pump:start(function(): boolean
        handle = loader:request(kind, name)

        return true
    end)
    local passes: integer = 0
    while state == "parked" and passes < 256 do
        passes = passes + 1
        state = pump:poll()
    end
    local requested = assert(handle)

    local first = mixer:play(requested)
    local second = mixer:play(requested)
    test.assert(first ~= 0 and second ~= 0)
    test.equal(made[1], 1, "one Sound for both plays")
    test.equal(#recorder.registered, 1)
    -- The handle's Sound joins the mixer's, by name.
    test.equal(assert(mixer:sound(name)).name, name)
    test.equal(#mixer:sounds(), 1)
    mixer:destroy()
    loader:shutdown()
end

function suite.refusesAnOutputItDoesNotKnow(): nil
    test.raises(
        function(): nil
            audio.newAudio({output = "speakers" as any})
        end,
        "output"
    )
end

function suite.spreadsPitchAroundTheRequestedRate(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 8})
    local clip = loaded(mixer)

    local seen: {number} = {}
    for _ = 1, 8 do
        mixer:play(clip, {pitch = 1, pitchVariance = 0.1})
    end
    mixer:flush()
    for index = 1, #recorder.log do
        local command = recorder.log[index]
        if command.kind == audiobackend.PLAY then
            seen[#seen + 1] = command.pitch
            test.assert(command.pitch >= 0.9 and command.pitch <= 1.1)
        end
    end
    test.equal(#seen, 8)
    -- The variance actually varies rather than answering the same rate twice.
    local distinct = false
    for index = 2, #seen do
        if seen[index] ~= seen[1] then
            distinct = true
        end
    end
    test.assert(distinct)
end

function suite.restoresAndReseedsWorldManagedPitchVariance(): nil
    const world = ecs.newWorld()
    world:seedRandom(42)
    const recorder = newRecorder()
    const mixer = audio.install(world, {backend = recorder.backend, maxVoices = 8})
    const clip = loaded(mixer)
    const unrelated = world:randomStream("game.loot")
    const before = unrelated:state()
    const saved = world:saveSnapshot()
    mixer:play(clip, {pitchVariance = 0.1})
    mixer:flush()
    const expected = assert(lastOf(recorder, audiobackend.PLAY)).pitch
    world:loadSnapshot(saved)
    clear(recorder)
    mixer:play(clip, {pitchVariance = 0.1})
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.PLAY)).pitch, expected)
    world:seedRandom(42)
    clear(recorder)
    mixer:play(clip, {pitchVariance = 0.1})
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.PLAY)).pitch, expected)
    const after = unrelated:state()
    for index = 1, 4 do
        test.equal(after[index], before[index])
    end
    test.assert(world:randomStream("tecs.audio") ~= unrelated)
end

function suite.holdsOnePlacementPerVoice(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)

    mixer:setPosition(handle, 1, 2, 3)
    mixer:flush()
    local placed = assert(lastOf(recorder, audiobackend.SET_POSITION))
    test.equal(placed.x, 1)
    test.equal(placed.y, 2)
    test.equal(placed.z, 3)
    test.assert(assert(mixer:voiceList()[1]).spatial)

    clear(recorder)
    mixer:setStereo(handle, 0.8, 0.2)
    mixer:flush()
    local panned = assert(lastOf(recorder, audiobackend.SET_STEREO))
    test.equal(panned.x, 0.8)
    test.equal(panned.y, 0.2)
    local info = assert(mixer:voiceList()[1])
    test.assert(info.stereo)
    test.assert(not info.spatial)

    clear(recorder)
    mixer:clearSpatial(handle)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.CLEAR_PLACEMENT), 1)
    -- Nothing to clear the second time.
    mixer:clearSpatial(handle)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.CLEAR_PLACEMENT), 1)
end

function suite.readsAndMovesAVoicePositionThroughTheBackend(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)

    test.equal(mixer:tell(handle), 0.25)
    test.assert(mixer:seek(handle, 1))
    test.equal(mixer:tell(0), nil)
    test.assert(not mixer:seek(0, 1))
end

function suite.pausesAndResumesOneVoiceWithoutHolderCounting(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)

    clear(recorder)
    mixer:pause(handle)
    mixer:pause(handle)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.PAUSE), 1)
    test.assert(mixer:paused(handle))
    -- A paused voice has not finished.
    test.equal(mixer:sounding(), 1)

    mixer:resume(handle)
    mixer:resume(handle)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.RESUME), 1)
    test.assert(not mixer:paused(handle))
end

function suite.composesGroupGainAndMuteOverEachVoiceGain(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip, {gain = 0.5, group = "sfx"})
    local sfx = mixer:bus("sfx")

    clear(recorder)
    mixer:setGroupGain("sfx", 0.5)
    mixer:flush()
    -- One command for the Bus's fader, none for its voices.
    local gain = assert(lastOf(recorder, audiobackend.BUS_SET))
    test.equal(gain.target, sfx.id)
    test.equal(gain.param, audiobackend.BUS_GAIN)
    test.equal(gain.gain, 0.5)
    test.equal(countOf(recorder, audiobackend.SET_GAIN), 0)
    test.equal(mixer:groupGain("sfx"), 0.5)

    clear(recorder)
    mixer:setGroupMuted("sfx", true)
    mixer:flush()
    local mute = assert(lastOf(recorder, audiobackend.BUS_SET))
    test.equal(mute.param, audiobackend.BUS_MUTE)
    test.equal(mute.gain, 1)
    test.assert(mixer:groupMuted("sfx"))

    clear(recorder)
    mixer:setGroupMuted("sfx", false)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.BUS_SET)).gain, 0)
    test.equal(assert(mixer:voiceList()[1]).applied, 0.5, "the voice keeps its own gain")
    test.assert(mixer:playing(handle))
end

function suite.appliesAGroupSettingToAVoiceThatJoinsLater(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)

    mixer:setGroupGain("music", 0.25)
    mixer:pauseGroup("music")
    local music = mixer:bus("music")

    clear(recorder)
    local handle = mixer:play(clip, {gain = 1, group = "music"})
    mixer:flush()
    -- The group is a Bus: the voice keeps its own gain and sounds on the
    -- Bus's default Track, whose fader and pause the backend applies.
    local play = assert(lastOf(recorder, audiobackend.PLAY))
    test.equal(play.gain, 1)
    test.equal(play.target, music:track().id)
    test.equal(countOf(recorder, audiobackend.PAUSE), 0)
    test.assert(mixer:paused(handle), "a voice under a paused Bus is held")
    test.assert(mixer:groupPaused("music"))
    test.equal(music:gain(), 0.25)

    clear(recorder)
    mixer:resumeGroup("music")
    mixer:flush()
    local resume = assert(lastOf(recorder, audiobackend.BUS_SET))
    test.equal(resume.param, audiobackend.BUS_PAUSE)
    test.equal(resume.gain, 0)
    test.assert(not mixer:paused(handle))
    test.assert(not mixer:groupPaused("music"))
end

function suite.stopsAGroupWithoutDiscardingItsSettings(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 4})
    local clip = loaded(mixer)
    mixer:setGroupGain("sfx", 0.5)
    mixer:play(clip, {group = "sfx"})
    mixer:play(clip, {group = "sfx"})
    mixer:play(clip)

    clear(recorder)
    mixer:stopGroup("sfx")
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.STOP), 2)
    test.equal(mixer:sounding(), 1)
    test.equal(mixer:groupGain("sfx"), 0.5)
end

function suite.listsGroupsThatHaveSettingsOrVoices(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    mixer:setGroupGain("ambient", 0.5)
    mixer:play(clip, {group = "sfx"})

    local names = mixer:groups()
    test.equal(#names, 2)
    test.equal(names[1], "ambient")
    test.equal(names[2], "sfx")
end

function suite.dropsANewVoiceAtAKeyCeiling(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 8})
    local clip = loaded(mixer)
    mixer:setLimit("footstep", {voices = 2})

    local first = mixer:play(clip, {key = "footstep"})
    local second = mixer:play(clip, {key = "footstep"})
    test.assert(first > 0)
    test.assert(second > 0)
    test.equal(mixer:play(clip, {key = "footstep"}), 0)
    test.equal(mixer:keyCount("footstep"), 2)
    -- The ceiling never steals: both older voices are untouched.
    test.assert(mixer:playing(first))
    test.assert(mixer:playing(second))

    mixer:stop(first)
    test.equal(mixer:keyCount("footstep"), 1)
    test.assert(mixer:play(clip, {key = "footstep"}) > 0)
end

function suite.holdsAKeyBackUntilItsCooldownPasses(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend, maxVoices = 8})
    local clip = loaded(mixer)
    mixer:setLimit("footstep", {cooldown = 0.05})

    test.assert(mixer:play(clip, {key = "footstep"}) > 0)
    test.equal(mixer:play(clip, {key = "footstep"}), 0)

    -- The cooldown advances against the time passed to `update`, so a mixer
    -- nothing steps never advances one.
    mixer:update(0.02)
    test.equal(mixer:play(clip, {key = "footstep"}), 0)
    mixer:update(0.05)
    test.assert(mixer:play(clip, {key = "footstep"}) > 0)

    test.equal(#mixer:keys(), 1)
    test.equal(mixer:keys()[1], "footstep")
    test.equal(assert(mixer:limit("footstep")).cooldown, 0.05)
    mixer:setLimit("footstep", nil)
    test.equal(mixer:limit("footstep"), nil)
end

function suite.scalesAndMutesTheWholeOutput(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})

    mixer:setMasterGain(0.5)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.SET_MASTER_GAIN)).gain, 0.5)
    test.equal(mixer:masterGain(), 0.5)

    clear(recorder)
    mixer:setMuted(true)
    mixer:setMuted(true)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.SET_MASTER_GAIN), 1)
    test.equal(assert(lastOf(recorder, audiobackend.SET_MASTER_GAIN)).gain, 0)
    test.assert(mixer:muted())

    -- Setting the level while muted changes what an unmute returns to and
    -- nothing audible now.
    clear(recorder)
    mixer:setMasterGain(0.25)
    mixer:flush()
    test.equal(countOf(recorder, audiobackend.SET_MASTER_GAIN), 0)
    mixer:setMuted(false)
    mixer:flush()
    test.equal(assert(lastOf(recorder, audiobackend.SET_MASTER_GAIN)).gain, 0.25)
end

function suite.releasesVoicesAndTheOutputOnDestroy(): nil
    local recorder = newRecorder()
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    mixer:play(clip)

    test.equal(#mixer:decoders(), 1)
    test.equal(#mixer:sounds(), 1)
    mixer:destroy()
    test.equal(#mixer:sounds(), 0)
    test.equal(mixer:sounding(), 0)
    test.assert(not mixer.available)
    test.assert(recorder.closed[1])
end

function suite.startsFollowsAndStopsAVoiceFromTheSoundComponent(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend, maxVoices = 4})
    local clip = loaded(mixer)

    local entity = world:spawn(audio.SoundComponent(idOf(clip)))
    world:commit()
    world:update(0)

    local sound = assert(world:get(entity, audio.SoundComponent))
    test.assert(sound.voice > 0)
    test.assert(mixer:playing(sound.voice))
    test.assert(assert(mixer:voiceList()[1]).owned)

    -- The pass follows gain without restarting the voice.
    clear(recorder)
    assert(world:getMut(entity, audio.SoundComponent)).gain = 0.5
    world:update(0)
    test.equal(assert(lastOf(recorder, audiobackend.SET_GAIN)).gain, 0.5)
    test.equal(countOf(recorder, audiobackend.PLAY), 0)

    -- Clearing `playing` stops the voice and returns the row to zero rather
    -- than to finished, so setting it again starts a second one.
    assert(world:getMut(entity, audio.SoundComponent)).playing = false
    world:update(0)
    test.equal(assert(world:get(entity, audio.SoundComponent)).voice, 0)
    test.equal(mixer:sounding(), 0)

    assert(world:getMut(entity, audio.SoundComponent)).playing = true
    world:update(0)
    test.assert(assert(world:get(entity, audio.SoundComponent)).voice > 0)
end

function suite.marksARowFinishedOnceItsVoiceEnds(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})
    local clip = loaded(mixer)

    local entity = world:spawn(audio.SoundComponent(idOf(clip)))
    world:commit()
    world:update(0)
    local handle = assert(world:get(entity, audio.SoundComponent)).voice

    recorder.finished[1] = handle
    mixer:update(0)
    world:update(0)
    test.equal(assert(world:get(entity, audio.SoundComponent)).voice, -1)
    -- A finished one-shot stays spent until the game asks again.
    world:update(0)
    test.equal(assert(world:get(entity, audio.SoundComponent)).voice, -1)
end

function suite.takesBackTheVoiceOfADespawnedEntity(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})
    local clip = loaded(mixer)

    local entity = world:spawn(audio.SoundComponent(idOf(clip)))
    world:commit()
    world:update(0)
    test.equal(mixer:sounding(), 1)

    world:despawn(entity)
    world:commit()
    world:update(0)
    test.equal(mixer:sounding(), 0)
end

function suite.silencesADisabledEntityAndStartsItAgainOnEnabling(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})
    local clip = loaded(mixer)

    local entity = world:spawn(audio.SoundComponent(idOf(clip)))
    world:commit()
    world:update(0)
    test.equal(mixer:sounding(), 1)

    world:set(entity, ecs.Disabled)
    world:commit()
    world:update(0)
    test.equal(mixer:sounding(), 0)
    -- The handle is cleared rather than left naming a voice that has gone, so
    -- the sound returns with the entity instead of reading as spent.
    test.equal(assert(world:get(entity, audio.SoundComponent)).voice, 0)

    world:remove(entity, ecs.Disabled)
    world:commit()
    world:update(0)
    test.equal(mixer:sounding(), 1)
end

function suite.carriesTheClipPathAndGroupNameThroughASnapshot(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})
    local clip = loaded(mixer)
    local group = audio.groupId("sfx")

    local entity = world:spawn(audio.SoundComponent(idOf(clip), true, 0.5, true, 2, true, 1, 2, 3, group))
    world:commit()
    mixer:setMasterGain(0.5)
    mixer:setGroupGain("sfx", 0.25)
    mixer:setGroupMuted("sfx", true)
    mixer:pauseGroup("sfx")

    local snapshot = world:saveSnapshot()
    mixer:setMasterGain(1)
    mixer:setGroupGain("sfx", 1)
    mixer:setGroupMuted("sfx", false)
    mixer:resumeGroup("sfx")
    world:clearEntities()

    world:loadSnapshot(snapshot)
    test.equal(mixer:masterGain(), 0.5)
    test.equal(mixer:groupGain("sfx"), 0.25)
    test.assert(mixer:groupMuted("sfx"))
    test.assert(mixer:groupPaused("sfx"))

    local restored = assert(world:get(entity, audio.SoundComponent))
    test.equal(restored.clip, idOf(clip))
    test.equal(restored.group, group)
    test.equal(restored.gain, 0.5)
    test.assert(restored.loop)
    test.equal(restored.pitch, 2)
    test.assert(restored.spatial)
    test.equal(restored.x, 1)
    test.equal(restored.z, 3)
    -- A snapshot records that an entity has a sound, not how far through it the
    -- backend had got.
    test.equal(restored.voice, 0)
end

function suite.returnsAnOmittedGroupToItsDefaultsOnLoad(): nil
    local recorder = newRecorder()
    local world = ecs.newWorld()
    local mixer = audio.install(world, {backend = recorder.backend})

    local snapshot = world:saveSnapshot()
    mixer:setGroupGain("later", 0.25)
    mixer:setGroupMuted("later", true)
    world:loadSnapshot(snapshot)

    test.equal(mixer:groupGain("later"), 1)
    test.assert(not mixer:groupMuted("later"))
end

function suite.refusesASecondMixerInOneWorld(): nil
    local world = ecs.newWorld()
    audio.install(world, {backend = newRecorder().backend})
    test.raises(
        function(): nil
            audio.install(world, {backend = newRecorder().backend})
        end,
        "already has a mixer"
    )
end

function suite.answersTheMixerInstalledIntoAWorld(): nil
    local world = ecs.newWorld()
    test.equal(audio.of(world), nil)
    local mixer = audio.install(world, {backend = newRecorder().backend})
    test.equal(audio.of(world), mixer)
    mixer:destroy()
    test.equal(audio.of(world), nil)
end

function suite.aReopenedOutputKeepsTheMixerAvailableAndItsVoices(): nil
    local recorder = newRecorder()
    local status = new audiobackend.OutputStatus(
        state = "playing",
        drops = 0,
        reopens = 0,
        reason = nil,
        frequency = 48000,
        channels = 2
    )
    local asked = {0}
    recorder.backend.outputChanges = function(): integer
        return status.drops + status.reopens
    end
    recorder.backend.output = function(): audiobackend.OutputStatus
        asked[1] = asked[1] + 1
        return new audiobackend.OutputStatus(
            state = status.state,
            drops = status.drops,
            reopens = status.reopens,
            reason = status.reason,
            frequency = status.frequency,
            channels = status.channels
        )
    end
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)
    test.assert(handle > 0)

    -- An unchanged count costs no status record.
    test.equal(mixer:update(), 1)
    test.equal(asked[1], 0)

    -- The headset turns its microphone on: dropped, then reopened at its new
    -- format, both inside one frame.
    status.drops = 1
    status.reopens = 1
    status.reason = "the output's format changed from 48000 Hz, 2 channels to 24000 Hz, 1 channel"
    status.frequency = 24000
    status.channels = 1
    test.equal(mixer:update(), 1)
    test.equal(asked[1], 1)
    test.assert(mixer.available)
    test.equal(mixer.failureReason, nil)
    test.assert(mixer:playing(handle))
    test.assert(mixer:play(clip) > 0)

    local report = mixer:output()
    test.equal(report.state, "playing")
    test.equal(report.reopens, 1)
    test.equal(report.frequency, 24000)
    test.equal(report.channels, 1)
    test.matches(assert(report.reason), "24000 Hz")
    mixer:destroy()
end

function suite.answersAnOutputReportForABackendWithNone(): nil
    local mixer = audio.newAudio({backend = newRecorder().backend})
    local report = mixer:output()
    test.equal(report.state, "playing")
    test.equal(report.frequency, 48000)
    test.equal(report.channels, 2)
    test.equal(report.drops, 0)
    mixer:destroy()
    test.equal(mixer:output().state, "offline")

    local silent = audio.newAudio({backend = audiobackend.silent()})
    test.equal(silent:output().state, "offline")
    silent:destroy()
end

function suite.outputLossClearsVoicesAndDoesNotReplay(): nil
    local recorder = newRecorder()
    local failure: {string} = {""}
    recorder.backend.failure = function(): string?
        return failure[1] ~= "" and failure[1] or nil
    end
    local mixer = audio.newAudio({backend = recorder.backend})
    local clip = loaded(mixer)
    local handle = mixer:play(clip)
    test.assert(handle > 0)
    failure[1] = "output disconnected"
    test.equal(mixer:update(), 0)
    test.equal(mixer.available, false)
    test.equal(mixer.failureReason, "output disconnected")
    test.equal(mixer:play(clip), 0)
    test.equal(recorder.log[#recorder.log].kind, audiobackend.STOP)
    failure[1] = ""
    test.equal(mixer:update(), 0)
    test.equal(mixer.available, false)
    mixer:destroy()
    mixer:destroy()
    test.equal(mixer:update(), 0)
end

return suite
