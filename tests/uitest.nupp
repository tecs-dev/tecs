const ecs = require("tecs.ecs")
const ui = require("tecs.ui")
const test = require("nupp.test")
const gfx = require("tecs.gfx")
const clips = require("tecs.gfx.clips")
const {Event} = require("tecs.ui")
const {type Event} = require("tecs.ui")
const events = require("tecs.platform.events")
const text2 = require("tecs.gfx.text")
const files = require("nupp.io.files")
const fonts = require("tecs.gfx.fonts")

local suite = {}
function suite.laysOutFlexAndSkipsUnchangedNativeWork(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 300, height = 100})
    local root = world:spawn(ui.Root(), ui.Style({width = "100%", height = "100%", gap = 10}))
    local a = world:spawn(ecs.ChildOf(root), ui.Style({width = 50, height = 20}), ui.Paint(true))
    local b = world:spawn(ecs.ChildOf(root), ui.Style({flexGrow = 1, height = 30}))
    world:update(0)
    local box = assert(world:get(b, ui.Layout))
    test.equal(box.x, 60)
    test.equal(box.width, 240)
    local pose = assert(world:get(a, ecs.Transform2D))
    test.equal(pose.x, 25)
    test.equal(pose.scaleX, 50)
    local calls = ui.layouts(world)
    world:update(0)
    test.equal(ui.layouts(world), calls)
    ui.resize(world, 400, 100)
    world:update(0)
    test.equal(assert(world:get(b, ui.Layout)).width, 340)
    world:shutdown()
end

function suite.clipsScrollAndRevealsChildren(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 200, height = 100})
    local root = world:spawn(ui.Root(), ui.Style({width = 100, height = 50, flexDirection = "column"}), ui.Scroll())
    local child = world:spawn(ecs.ChildOf(root), ui.Style({width = 80, height = 100, flexShrink = 0}), ui.Interaction())
    world:update(0)
    test.equal(assert(world:get(root, ui.Scroll)).contentHeight, 100)
    test.assert(ui.reveal(world, child, "end"))
    world:update(0)
    test.equal(assert(world:get(root, ui.Scroll)).y, 50)
    local clip = assert(world:get(child, gfx.Clip)).index
    test.assert(clip > 0)
    test.assert(clips.contains(clip, 10, 25))
    test.assert(not clips.contains(clip, 10, 75))
    world:shutdown()
end

function suite.routesPointerActivationAndFocus(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 200, height = 100})
    local root = world:spawn(ui.Root(), ui.Style({width = 200, height = 100}))
    local button = world:spawn(ecs.ChildOf(root), ui.Style({width = 80, height = 30}), ui.Interaction())
    local activated = 0
    world:observe(button, Event, function(event: Event): nil
        if event.kind == "activate" then
            activated = activated + 1
        end
    end)
    world:update(0)
    events.dispatch(world, events.pointerButton(true, 1, 10, 10))
    events.dispatch(world, events.pointerButton(false, 1, 10, 10))
    world:update(0)
    test.equal(activated, 1)
    test.equal(ui.focused(world), button)
    world:shutdown()
end

function suite.sharesClipsAndReleasesTheLastRoot(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 300, height = 100, firstClip = 1, lastClip = 1})
    local root = world:spawn(ui.Root(), ui.Style({width = 100, height = 50}), ui.Scroll())
    local a = world:spawn(ecs.ChildOf(root), ui.Style({width = 20, height = 20}))
    local b = world:spawn(ecs.ChildOf(root), ui.Style({width = 20, height = 20}))
    world:update(0)
    test.equal(assert(world:get(a, gfx.Clip)).index, assert(world:get(b, gfx.Clip)).index)
    world:despawn(root);
    world:commit();
    world:update(0)
    test.equal(world.liveCount, 0)
    world:shutdown()
end

function suite.sizesAndDragsScrollbarThumbs(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 200, height = 100, dragThreshold = 0})
    local root = world:spawn(ui.Root(), ui.Style({width = 100, height = 100, flexDirection = "column"}), ui.Scroll())
    world:spawn(ecs.ChildOf(root), ui.Style({width = 80, height = 300, flexShrink = 0}))
    local thumb = world:spawn(
        ecs.ChildOf(root),
        ui.Scrollbar({
            thickness = 10,
            inset = 0,
            minLength = 10
        }),
        gfx.Renderable2D
    )
    world:update(0)
    local box = assert(world:get(thumb, ui.Layout))
    test.assert(math.abs(box.height - 100 / 3) < 0.01)
    events.dispatch(world, events.pointerButton(true, 1, 95, 10))
    events.dispatch(world, events.pointerMoved(95, 40))
    world:update(0)
    test.assert(assert(world:get(root, ui.Scroll)).y > 80)
    assert(world:getMut(root, ui.Style)).style.height = 400
    world:update(0)
    test.equal(assert(world:get(thumb, ui.Layout)).height, 0)
    world:shutdown()
end

function suite.paintsAtDisplayDensityAndRestoresFocusScopes(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 200, height = 100, pixelDensity = 2})
    local root = world:spawn(ui.Root(), ui.Style({width = 200, height = 100}))
    local button = world:spawn(ecs.ChildOf(root), ui.Style({width = 40, height = 20}), ui.Paint(true), ui.Interaction())
    local modal = world:spawn(ecs.ChildOf(root), ui.FocusScope, ui.Style({width = 80, height = 50}))
    world:update(0)
    test.equal(assert(world:get(button, ecs.Transform2D)).scaleX, 80)
    test.assert(ui.focus(world, button))
    test.assert(ui.pushFocusScope(world, modal))
    test.assert(not ui.focus(world, button))
    test.assert(ui.popFocusScope(world, modal))
    test.equal(ui.focused(world), button)
    world:shutdown()
end

function suite.restoresLayoutsAndCancelsHiddenInteractions(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 300, height = 100})
    local root = world:spawn(ui.Root(), ui.Style({width = "100%", height = "100%"}))
    local button = world:spawn(ecs.ChildOf(root), ui.Style({width = 80, height = 30}), ui.Interaction())
    local activated = 0
    world:observe(button, Event, function(event: Event): nil
        if event.kind == "activate" then
            activated = activated + 1
        end
    end)
    world:update(0)
    local snapshot = world:saveSnapshot();
    world:loadSnapshot(snapshot);
    world:update(0)
    test.equal(assert(world:get(button, ui.Layout)).width, 80)
    events.dispatch(world, events.pointerButton(true, 1, 10, 10));
    world:update(0)
    assert(world:getMut(button, ui.Style)).style.display = "none"
    events.dispatch(world, events.pointerButton(false, 1, 10, 10));
    world:update(0)
    test.equal(activated, 0)
    test.equal(ui.focused(world), 0)
    world:shutdown()
end

function suite.wrapsTextAndClipsEveryGlyph(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 300, height = 100})
    text2.install(world)
    local bytes = assert(files.read("assets/fonts/JetBrainsMono-ExtraBold.ttf"))
    local font = assert(fonts.newTTF({bytes = bytes, name = "uitest/font", size = 24}))
    local root = world:spawn(ui.Root(), ui.Style({width = 100, height = 30, flexDirection = "column"}), ui.Scroll())
    local label = world:spawn(
        ecs.ChildOf(root),
        ui.Style({
            width = 90,
            flexShrink = 0
        }),
        ui.Intrinsic({
            source = "text",
            wrap = true
        }),
        gfx.Text("alpha beta gamma delta", font, 16)
    )
    world:update(0)
    local box = assert(world:get(label, ui.Layout))
    test.assert(box.height > 30)
    test.equal(assert(world:get(label, gfx.Text)).wrapWidth, 90)
    local glyphs = text2.glyphsOf(world, label)
    test.assert(#glyphs > 0)
    for _, glyph in ipairs(glyphs) do
        test.equal(assert(world:get(glyph, gfx.Clip)).index, assert(world:get(label, gfx.Clip)).index)
    end
    world:shutdown()
end

function suite.keepsNaturallySizedTextOnOneLine(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 400, height = 100})
    local bytes = assert(files.read("assets/fonts/JetBrainsMono-ExtraBold.ttf"))
    local font = assert(fonts.newTTF({bytes = bytes, name = "uitest/rounding", size = 32}))
    local root = world:spawn(ui.Root(), ui.Style({width = 400, height = 48, padding = 12}))
    local label = world:spawn(
        ecs.ChildOf(root),
        ui.Style({
            flexShrink = 0
        }),
        ui.Intrinsic({
            source = "text",
            wrap = true
        }),
        gfx.Text("01  Explore this world", font, 16)
    )
    world:update(0)
    local text = assert(world:get(label, gfx.Text))
    local _, naturalHeight = text2.measureIntrinsic(text)
    local _, actualHeight = text2.measureText(text)
    test.equal(actualHeight, naturalHeight)
    world:shutdown()
end

function suite.alignsWrappedRowsToStart(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 100, height = 200})
    local root = world:spawn(
        ui.Root(),
        ui.Style({
            width = 100,
            height = 200,
            flexWrap = "wrap",
            alignContent = "start",
            alignItems = "start",
            gap = 10
        })
    )
    local first = world:spawn(ecs.ChildOf(root), ui.Style({width = 60, height = 20}))
    local second = world:spawn(ecs.ChildOf(root), ui.Style({width = 60, height = 20}))
    world:update(0)
    test.equal(assert(world:get(first, ui.Layout)).y, 0)
    test.equal(assert(world:get(second, ui.Layout)).y, 30)
    world:shutdown()
end

function suite.handsUnusedWheelToParentAndHonorsConsumption(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 100, height = 100, wheelStep = 40})
    local root = world:spawn(ui.Root(), ui.Style({width = 100, height = 100}), ui.Scroll())
    local content = world:spawn(ecs.ChildOf(root), ui.Style({width = 100, height = 300, flexShrink = 0}))
    local inner = world:spawn(ecs.ChildOf(content), ui.Style({width = 80, height = 80}), ui.Scroll())
    world:spawn(ecs.ChildOf(inner), ui.Style({width = 80, height = 100, flexShrink = 0}))
    world:update(0)
    events.dispatch(world, events.wheel(0, -1, nil, nil, 10, 10))
    world:update(0)
    test.equal(assert(world:get(inner, ui.Scroll)).y, 20)
    test.equal(assert(world:get(root, ui.Scroll)).y, 20)
    world:observe(root, Event, function(event: Event): nil
        if event.kind == "wheel" then
            event.consumed = true
        end
    end)
    events.dispatch(world, events.wheel(0, -1, nil, nil, 10, 10))
    world:update(0)
    test.equal(assert(world:get(root, ui.Scroll)).y, 20)
    world:shutdown()
end

function suite.hidesAndRestoresSceneGlyphs(): nil
    local world = ecs.newWorld()
    ui.install(world, {width = 200, height = 100})
    text2.install(world)
    local font = assert(
        fonts.newTTF({
            source = "assets/fonts/JetBrainsMono-ExtraBold.ttf",
            name = "uitest/scenes",
            size = 16
        })
    )
    local root = world:spawn(ui.Root(), ui.Style({width = 200, height = 100}))
    local scene = world:spawn(ecs.ChildOf(root), ui.Style({width = 100, height = 80}))
    local label = world:spawn(ecs.ChildOf(scene), ui.Intrinsic({source = "text"}), gfx.Text("Scene", font, 16))
    world:update(0)
    test.equal(#text2.glyphsOf(world, label), 5)
    for cycle = 1, 3 do
        assert(world:getMut(scene, ui.Style)).style.display = "none"
        world:update(0)
        test.equal(#text2.glyphsOf(world, label), 0)
        assert(world:getMut(scene, ui.Style)).style.display = "flex"
        world:update(0)
        test.equal(#text2.glyphsOf(world, label), 5)
    end
    world:shutdown()
end

return suite
