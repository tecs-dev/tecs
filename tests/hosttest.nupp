
local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local application = require("tecs.application")
local host = require("tecs.host")
local platformevents = require("tecs.platform.events")
local images = require("tecs.gfx.images")
local window = require("tecs.platform.window")

local suite = {}

local function attach(exclusive session: host.Session): nil
    host.attachWindow(
        session,
        1,
        "host test",
        640,
        360,
        1280,
        720,
        2,
        10,
        20,
        true,
        true,
        false,
        false,
        false,
        false,
        true,
        true,
        "none"
    )
end

function suite.sealsTranslatedEventsIntoOneApplicationFrame(): nil
    local session = host.create("host test", 640, 360, true, nil)
    host.init(session)
    attach(session)
    session.input:emit(host.INPUT_ADDRESS, host.FocusInput, false, 1, 1)
    session.input:emit(host.INPUT_ADDRESS, host.ResizeInput, false, 800, 450, 1600, 900, 2, 1.1, 2)
    session.input:emit(host.INPUT_ADDRESS, host.KeyInput, true, "KeyW", "w", "w", 0, false, 1.2, 3)

    assert.eq(host.iterate(session, 0.25), "continue")

    local width, height = session.app.window:getSize()
    assert.eq(width, 800)
    assert.eq(height, 450)
    assert(not session.app.window:hasFocus())
    assert(session.app.input:keyPressed("KeyW"))
    assert.eq(session.app.elapsed, 0.25)
    assert(host.shutdown(session))
end

function suite.keepsInputInArrivalOrderAcrossKinds(): nil
    local seen: {string} = {}
    const session = host.newSession({
        onEvent = function(event: platformevents.Event, exclusive _app: application.Application): nil
            seen[#seen + 1] = event.kind .. ":" .. event.sequence
        end,
    })
    host.init(session)
    -- Routes deliver in push order, so interleaved kinds reach the frame as
    -- the host observed them.
    session.input:emit(host.INPUT_ADDRESS, host.KeyInput, true, "KeyA", nil, nil, 0, false, 0.1, 1)
    session.input:emit(host.INPUT_ADDRESS, host.PointerMoveInput, 1, 2, 0, 0, 0.2, 2)
    session.input:emit(host.INPUT_ADDRESS, host.KeyInput, false, "KeyA", nil, nil, 0, false, 0.3, 3)
    session.input:emit(host.INPUT_ADDRESS, host.PointerMoveInput, 3, 4, 0, 0, 0.4, 4)

    assert.eq(host.iterate(session, 0), "continue")
    assert.eq(table.concat(seen, " "), "keyDown:1 mouseMotion:2 keyUp:3 mouseMotion:4")
    assert(host.shutdown(session))
end

function suite.queuesTouchAsOneFingerTheInputStateTracks(): nil
    local session = host.create("host test", 640, 360, true, nil)
    host.init(session)
    attach(session)
    session.input:emit(
        host.INPUT_ADDRESS,
        host.TouchInput,
        "fingerDown",
        "screen",
        "9",
        12,
        34,
        0.25,
        0.5,
        0.75,
        0,
        0,
        1,
        1
    )

    assert.eq(host.iterate(session, 0.1), "continue")

    local held = session.app.input:touches()
    assert.eq(#held, 1)
    assert.eq(held[1].finger, "9")
    assert.eq(held[1].x, 12)
    assert.eq(held[1].normalX, 0.25)
    assert.eq(held[1].pressure, 0.75)

    assert.raises(
        function(): nil
            session.input:emit(
                host.INPUT_ADDRESS,
                host.TouchInput,
                "fingerHover",
                "screen",
                "9",
                0,
                0,
                0,
                0,
                0,
                0,
                0,
                1,
                2
            )
        end,
        "unknown touch phase"
    )
    assert(host.shutdown(session))
end

function suite.exposesTaggedCommandsAndCorrelatedFailures(): nil
    local session = host.create(nil, nil, nil, false, nil)
    host.init(session)
    local serial = session.app.window:setTitle("changed")

    local kind, returnedSerial, text, x, y, flag = host.nextWindowCommand(session)
    assert.eq(kind, "setTitle")
    assert.eq(returnedSerial, serial)
    assert.eq(text, "changed")
    assert.eq(x, nil)
    assert.eq(y, nil)
    assert.eq(flag, nil)
    assert.eq(host.nextWindowCommand(session), nil)

    host.windowCommandFailed(session, assert(returnedSerial), "desktop rejected the title")
    local failures = window.takeFailures(session.app.window)
    assert.eq(failures[1].serial, serial)
    assert.eq(failures[1].reason, "desktop rejected the title")
    assert(host.shutdown(session))
end

function suite.supportsBoundedHeadlessSmokeRuns(): nil
    local session = host.create(nil, nil, nil, false, 1)
    host.init(session)

    assert.eq(host.iterate(session, 0), "stopped")
    assert.eq(session.app.frame, 1)
    assert(host.shutdown(session))
end

function suite.exposesOneBatchedRenderPacketAfterACompletedFrame(): nil
    local session = host.create(nil, 320, 180, false, nil)
    session.app.world:spawn(ecs.Transform2D(40, 50, 0, 1, 0, 20, 30), gfx.Tint(), gfx.Renderable2D)
    session.app.world:commit()
    host.init(session)

    assert.eq(host.iterate(session, 0), "continue")
    local reader = io.Reader.of(host.renderPacket(session)):scalar()
    assert.eq(reader:readuint32(), 0x54454353)
    assert.eq(reader:readuint32(), 9)
    assert.eq(reader:readuint32(), 140)
    assert.eq(reader:readuint32(), 0)
    -- The graph revision and the section's byte length, neither of which this
    -- test pins: the render graph is declared elsewhere and may grow.
    reader:skip(4)
    reader:skip(4)
    assert.eq(reader:readuint32(), 20)
    assert.eq(reader:readuint32(), 1)
    assert.eq(reader:readuint32(), 80)
    assert.eq(reader:readuint32(), 1)
    assert.eq(reader:readfloat32(), 320)
    assert.eq(reader:readfloat32(), 180)
    own.drop(reader)
    assert(host.shutdown(session))
end

function suite.projectsThePacketThroughThePhysicalDrawableSize(): nil
    local session = host.create(nil, 320, 180, false, nil)
    session.app.world:spawn(ecs.Transform2D(40, 50, 0, 1, 0, 20, 30), gfx.Tint(), gfx.Renderable2D)
    session.app.world:commit()
    -- A window on a two-times display draws into a 640 by 360 swapchain, and
    -- the camera projects into those pixels rather than the logical size.
    host.attachWindow(
        session,
        1,
        "tecs",
        320,
        180,
        640,
        360,
        2,
        0,
        0,
        true,
        true,
        false,
        false,
        false,
        false,
        true,
        true,
        "none"
    )
    host.init(session)

    assert.eq(host.iterate(session, 0), "continue")
    local reader = io.Reader.of(host.renderPacket(session)):scalar()
    reader:skip(40)
    assert.eq(reader:readfloat32(), 640)
    assert.eq(reader:readfloat32(), 360)
    assert.eq(reader:readfloat32(), 320)
    assert.eq(reader:readfloat32(), 180)
    own.drop(reader)
    assert(host.shutdown(session))
end

function suite.followsTheDrawableThroughAResize(): nil
    local session = host.create("host test", 640, 360, false, nil)
    session.app.world:spawn(ecs.Transform2D(40, 50, 0, 1, 0, 20, 30), gfx.Tint(), gfx.Renderable2D)
    session.app.world:commit()
    attach(session)
    host.init(session)

    assert.eq(host.iterate(session, 0), "continue")
    local before = io.Reader.of(host.renderPacket(session)):scalar()
    before:skip(40)
    assert.eq(before:readfloat32(), 1280)
    assert.eq(before:readfloat32(), 720)
    assert.eq(before:readfloat32(), 640)
    assert.eq(before:readfloat32(), 360)
    own.drop(before)

    session.input:emit(host.INPUT_ADDRESS, host.ResizeInput, false, 800, 450, 1600, 900, 2, 1, 1)
    assert.eq(host.iterate(session, 0), "continue")
    local after = io.Reader.of(host.renderPacket(session)):scalar()
    after:skip(40)
    assert.eq(after:readfloat32(), 1600)
    assert.eq(after:readfloat32(), 900)
    -- The default view recenters on the new drawable, so a resize moves the
    -- window's edges rather than the content under the middle of it.
    assert.eq(after:readfloat32(), 800)
    assert.eq(after:readfloat32(), 450)
    own.drop(after)
    assert(host.shutdown(session))
end

function suite.leavesImageCommandsQueuedWithoutAHost(): nil
    local session = host.create(nil, 320, 180, false, nil)
    host.init(session)
    -- The registry is process-wide, so drop anything an earlier suite queued.
    images.drain()

    local id = images.upload({
        name = "hosttest/checker",
        width = 1,
        height = 2,
        pixels = "\255\0\0\255\0\255\0\255",
        filter = "linear",
        address = "repeat",
    })
    -- With no embedding host to ask, a frame finishes without applying the
    -- upload, and it stays queued for whoever drives the registry.
    assert.eq(host.iterate(session, 0), "continue")
    local commands = images.drain()
    assert.eq(#commands, 1)
    const upload = commands[1]
    assert(upload is images.UploadImageCommand)
    if upload is images.UploadImageCommand then
        assert.eq(upload.image, id)
        assert.eq(upload.width, 1)
        assert.eq(upload.height, 2)
        assert.eq(upload.sampler, images.samplerIndex("linear", "repeat"))
        assert.eq(upload.format, "rgba8")
        assert.eq(#upload.pixels, 8)
        assert.eq(images.stateOf(id), "pending")
        images.complete(upload.image, upload.serial, true, nil)
    end
    assert.eq(images.stateOf(id), "resident")
    assert(images.release("hosttest/checker"))
    images.drain()
    assert(host.shutdown(session))
end

function suite.resumesAParkedUpdateOnALaterHostTurn(): nil
    local session = host.create(nil, nil, nil, false, nil)
    local polls = 0
    local resumed = false
    session.app.world:addSystem({
        name = "test.host.parked",
        phase = ecs.phases.Update,
        run = function(): nil
            if resumed then
                return
            end
            resumed = coroutine.suspend("host test wait", function(resume, context): function()
                context:source("test.host.parked", 50, function(): integer
                    polls = polls + 1
                    if polls == 2 then
                        resume(true)
                        return 1
                    end

                    return 0
                end)

                return function(): nil
                end
            end)
        end,
    })
    host.init(session)

    assert.eq(host.iterate(session, 0.25), "parked")
    assert.eq(session.app.frame, 0)
    assert.eq(host.iterate(session, 99), "parked")
    assert.eq(session.app.frame, 0)
    assert.eq(host.iterate(session, 99), "continue")
    assert(resumed)
    assert.eq(session.app.frame, 1)
    assert.eq(session.app.elapsed, 0.25)
    assert(host.shutdown(session))
end

function suite.shutdownUnwindsAParkedUpdateWithoutReportingACrash(): nil
    local session = host.create(nil, nil, nil, false, nil)
    session.app.world:addSystem({
        name = "test.host.cancel",
        phase = ecs.phases.Update,
        run = function(): nil
            coroutine.suspend("host test never ready", function(_resume): function()
                return function(): nil
                end
            end)
        end,
    })
    host.init(session)

    assert.eq(host.iterate(session, 0), "parked")
    assert(host.shutdown(session))
    assert.eq(host.crashed(session), nil)
end

function suite.reportsAHeldTurnApartFromAFrameThatRan(): nil
    local session = host.create(nil, nil, nil, false, nil)
    host.init(session)
    assert.eq(host.iterate(session, 0.25), "continue")
    session.app:pause()

    -- A held turn runs no frame, which is what lets a host skip drawing it.
    assert.eq(host.iterate(session, 0.25), "held")
    assert.eq(host.iterate(session, 0.25), "held")
    assert.eq(session.app.frame, 1)
    session.app:step(1, 0.5)
    assert.eq(host.iterate(session, 0.25), "continue")
    assert.eq(session.app.frame, 2)
    assert.eq(session.app.elapsed, 0.75)
    assert.eq(host.iterate(session, 0.25), "held")

    -- A quit is still honored on a held turn, and stops rather than holds.
    session.app:queueEvent(platformevents.quit())
    assert.eq(host.iterate(session, 0.25), "stopped")
    assert.eq(session.app.frame, 2)
    assert(host.shutdown(session))
end

return suite
