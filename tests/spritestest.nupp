local framepacket = require("tecs.internal.framepacket")
local gfx = require("tecs.gfx")
local host = require("tecs.host")
local images = require("tecs.gfx.images")
local sprites = require("sprites")
local test = require("nupp.test")

local suite = {}

function suite.drawsACameraAndTwoImagesThroughItsEntry(): nil
    -- The image registry is process-wide, so drop whatever an earlier suite in
    -- this worker left queued before counting this example's own uploads.
    images.drain()
    const session = sprites.create(nil, 800, 450, false, 2)
    test.assert(host.init(session))

    -- One camera plus the field, and both images queued for the backend.
    test.equal(session.app.world.liveCount, 601)
    local uploads = 0
    while true do
        const kind, serial, image, width, height, sampler, format, pixels = host.nextImageCommand(session)
        if kind == nil then
            break
        end
        test.equal(kind, "uploadImage")
        test.equal(format, "rgba8")
        test.equal(#(pixels as string), (width as integer) * (height as integer) * 4)
        test.assert((sampler as integer) < images.SAMPLER_COUNT)
        host.imageCommandResult(session, image as integer, serial as integer, true, nil)
        uploads = uploads + 1
    end
    test.equal(uploads, 2)
    test.equal(images.stateOf(images.id("example/sprites/checker")), "resident")
    test.equal(images.stateOf(images.id("example/sprites/disc")), "resident")

    test.equal(host.iterate(session, 0.25), "continue")
    const reader = nupp.io.newScalarReader(host.renderPacket(session))
    test.equal(reader:readUint32(), framepacket.MAGIC)
    test.equal(reader:readUint32(), framepacket.VERSION)
    reader:skip(20)
    const batches = reader:readUint32() as integer
    reader:skip(4)
    test.equal(reader:readUint32(), 600)
    test.equal(reader:readFloat32(), 800)
    test.equal(reader:readFloat32(), 450)
    -- The camera moved off the field center on the first frame, so the packet
    -- carries the game's view rather than the target-centered default.
    const cameraX = reader:readFloat32()
    test.notEqual(cameraX, 400)
    reader:skip(4)
    test.assert(reader:readFloat32() > 0, "the zoom projects")
    reader:drop()

    -- Both images are resident and the field alternates between them, so the
    -- run-length batching splits the frame rather than collapsing it.
    test.assert(batches > 1, "textured runs batch separately")
    test.equal(host.iterate(session, 0.25), "stopped")
    test.equal(host.crashed(session), nil)
    test.assert(host.shutdown(session))
end

function suite.buildsTheSameSceneEveryRun(): nil
    const first = sprites.create(nil, 320, 180, false, 1)
    test.assert(host.init(first))
    const firstPacket = host.renderPacket(first)
    test.assert(host.shutdown(first))

    const second = sprites.create(nil, 320, 180, false, 1)
    test.assert(host.init(second))
    const secondPacket = host.renderPacket(second)
    test.assert(host.shutdown(second))

    test.equal(secondPacket, firstPacket, "the field is authored, not sampled")
end

function suite.spawnsExactlyOneActiveCamera(): nil
    const session = sprites.create(nil, 320, 180, false, 1)
    test.assert(host.init(session))
    const eyes = session.app.world:newQuery({include = {gfx.Camera2D, gfx.ActiveCamera}})
    local found = 0
    for _, count in eyes:iter() do
        found = found + (count as integer)
    end
    test.equal(found, 1)
    test.assert(host.shutdown(session))
end

return suite
