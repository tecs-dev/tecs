local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local lighting = require("tecs.gfx.lighting")
local test = require("nupp.test")

local suite = {}

function suite.startsWhiteWithNeitherLaneOn(): nil
    lighting.reset()
    const r, g, b = lighting.ambient()
    test.equal(r, 1)
    test.equal(g, 1)
    test.equal(b, 1)
    -- Neither shadows nor bloom until a game asks: the passes are declared
    -- either way and the frame's own flags decide.
    test.equal(lighting.shadows(), nil)
    test.equal(lighting.bloom(), nil)
end

function suite.holdsTheAmbientToWhatALightCanBe(): nil
    lighting.reset()
    lighting.setAmbient(0.25, 0.5, 2.0)
    const r, g, b = lighting.ambient()
    test.equal(r, 0.25)
    test.equal(g, 0.5)
    -- Above one is meaningful, because the resolve writes a target wider than
    -- eight bits a channel.
    test.equal(b, 2.0)
    test.raises(
        function(): nil
            lighting.setAmbient(-0.1, 0, 0)
        end,
        "at or above zero"
    )
    test.raises(
        function(): nil
            lighting.setAmbient(0, 0 / 0, 0)
        end,
        "at or above zero"
    )
    lighting.reset()
end

function suite.takesTheShadowDefaultsAndHoldsTheRanges(): nil
    lighting.reset()
    lighting.setShadows({})
    const held = assert(lighting.shadows())
    test.equal(held.steps, 24)
    -- The default matches `PointLight2D`'s own default height, so an occluder at
    -- height one and a light at its default are level.
    test.equal(held.height, 64)
    test.equal(held.margin, 200)
    test.equal(held.dropOpacity, 0.4)
    test.equal(held.dropLength, 512)

    lighting.setShadows({steps = 8, height = 32, margin = 0, dropOpacity = 1, dropLength = 0})
    const tuned = assert(lighting.shadows())
    test.equal(tuned.steps, 8)
    test.equal(tuned.height, 32)
    test.equal(tuned.dropLength, 0)

    -- Four is the floor because the march clamps its adaptive count to it, so a
    -- lower ceiling would be a ceiling below the floor.
    test.raises(
        function(): nil
            lighting.setShadows({steps = 2})
        end,
        "shadow steps"
    )
    test.raises(
        function(): nil
            lighting.setShadows({dropOpacity = 1.5})
        end,
        "drop shadow opacity"
    )
    test.raises(
        function(): nil
            lighting.setShadows({margin = -1})
        end,
        "shadow margin"
    )
    test.raises(
        function(): nil
            lighting.setShadows({height = 0})
        end,
        "shadow height"
    )

    lighting.setShadows(nil)
    test.equal(lighting.shadows(), nil)
    lighting.reset()
end

function suite.takesTheBloomDefaultsAndHoldsTheRanges(): nil
    lighting.reset()
    lighting.setBloom({})
    const held = assert(lighting.bloom())
    test.equal(held.threshold, 0.8)
    test.equal(held.knee, 0.1)
    test.equal(held.intensity, 0.7)

    lighting.setBloom({threshold = 2, knee = 0.5, intensity = 0})
    const tuned = assert(lighting.bloom())
    test.equal(tuned.threshold, 2)
    test.equal(tuned.intensity, 0)

    -- The knee divides, so zero is out of range rather than merely sharp.
    test.raises(
        function(): nil
            lighting.setBloom({knee = 0})
        end,
        "bloom knee"
    )
    test.raises(
        function(): nil
            lighting.setBloom({threshold = -1})
        end,
        "bloom threshold"
    )

    lighting.setBloom(nil)
    test.equal(lighting.bloom(), nil)
    lighting.reset()
end

function suite.spawnsALightAndTwoKindsOfCaster(): nil
    local world = ecs.newWorld({maxEntities = 4})
    const lamp = world:spawn(ecs.Transform2D(10, 20), gfx.PointLight2D(48, 200, 1, 0.5, 0.25, 2))
    const wall = world:spawn(ecs.Transform2D(30, 40), gfx.Tint(), gfx.Occluder2D(0.75), gfx.Renderable2D)
    const crate = world:spawn(ecs.Transform2D(50, 60), gfx.Tint(), gfx.DropShadow2D(), gfx.Renderable2D)
    world:commit()

    const light: gfx.PointLight2D = assert(world:get(lamp, gfx.PointLight2D))
    test.equal(light.height, 48)
    test.equal(light.radius, 200)
    test.equal(light.intensity, 2)
    test.equal(light.g, 0.5)

    const occluder: gfx.Occluder2D = assert(world:get(wall, gfx.Occluder2D))
    test.equal(occluder.height, 0.75)
    -- A caster defaults to full height, which is the world's configured shadow
    -- height rather than one world unit.
    const shadow: gfx.DropShadow2D = assert(world:get(crate, gfx.DropShadow2D))
    test.equal(shadow.height, 1.0)

    -- The default light is white at full strength, reaching two hundred and
    -- fifty-six world units from ninety-six above the plane.
    const plain = world:spawn(ecs.Transform2D(), gfx.PointLight2D())
    world:commit()
    const fallback: gfx.PointLight2D = assert(world:get(plain, gfx.PointLight2D))
    test.equal(fallback.height, 64)
    test.equal(fallback.radius, 256)
    test.equal(fallback.intensity, 1)
end

return suite
