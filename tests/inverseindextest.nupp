local test = require("nupp.test")
local inverseindex = require("tecs.internal.inverseindex")
local suite = {}

local function collect(index: inverseindex.InverseIndex, targetId: integer): {[integer]: boolean}
    local found: {[integer]: boolean} = {}
    index:forEachSource(targetId, function(sourceId: integer, _: any): nil found[sourceId] = true end, nil)
    return found
end

function suite.linksSourcesIdempotently(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(10, 100)
    index:link(20, 100)
    local found = collect(index, 100)
    test.equal(found[10], true)
    test.equal(found[20], true)
    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    test.equal(count, 2)
end

function suite.unlinksOneEdge(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(20, 100)
    index:unlink(10, 100)
    local found = collect(index, 100)
    test.equal(found[10], nil)
    test.equal(found[20], true)
end

function suite.reportsTargetLifetime(): nil
    local index = inverseindex.new()
    local added: {integer} = {}
    local removed: {integer} = {}
    index.onTargetAdded = function(targetId: integer): nil added[#added + 1] = targetId end
    index.onTargetRemoved = function(targetId: integer): nil removed[#removed + 1] = targetId end

    index:link(10, 100)
    index:link(20, 100)
    test.equal(#added, 1)
    test.equal(added[1], 100)

    index:unlink(10, 100)
    test.equal(#removed, 0)
    index:unlink(20, 100)
    test.equal(#removed, 1)
    test.equal(removed[1], 100)
end

function suite.removesWholeTarget(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(20, 100)
    local sources = index:removeTarget(100)
    test.equal(sources[10], true)
    test.equal(sources[20], true)
    test.equal(next(collect(index, 100)), nil)
end

function suite.removesSourceFromKnownTargets(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(10, 200)
    index:link(20, 200)
    index:unlinkSourceFromTargets(10, {100, 200})
    test.equal(next(collect(index, 100)), nil)
    local found = collect(index, 200)
    test.equal(found[10], nil)
    test.equal(found[20], true)
end

function suite.absentTargetUsesEmptySentinel(): nil
    local index = inverseindex.new()
    test.equal(next(index:removeTarget(999)), nil)
end

return suite
