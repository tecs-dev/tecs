const ecs = require("tecs.ecs")
const {ArchetypeCreated} = require("tecs.ecs")
const {type ArchetypeCreated} = require("tecs.ecs")
const {OnSnapshotSave} = require("tecs.ecs")
const {type OnSnapshotSave} = require("tecs.ecs")
const {StartSnapshotLoad} = require("tecs.ecs")
const {type StartSnapshotLoad} = require("tecs.ecs")
const {FinishSnapshotLoad} = require("tecs.ecs")
const {type FinishSnapshotLoad} = require("tecs.ecs")
const {type World} = require("tecs.ecs")
const {type PhaseDefinition} = require("tecs.ecs")
const {OnSpawn} = require("tecs.ecs")
const {type OnSpawn} = require("tecs.ecs")
const {type SystemConfig} = require("tecs.ecs")
const {type Pipeline} = require("tecs.ecs")
const {type SystemInfo} = require("tecs.ecs")
const files = require("nupp.io.files")

local archetype = require("tecs.internal.archetype")
local events = require("events")
local buffer = require("string.buffer")
local ffi = require("ffi")
local fixedtracking = require("tecs.internal.fixedtracking")
local entityworld = require("tecs.internal.world")
local suite = {}

function suite.observesArchetypeRowsAndTracksResidue(): nil
    const world = ecs.newWorld()
    const value = ecs.newScalarComponent({name = "test.Parity.Value", kind = "number"})
    const marker = ecs.newTagComponent({name = "test.Parity.Marker"})
    local created: integer = 0
    local added: integer = 0
    local removed: integer = 0
    local activated: integer = 0
    local deactivated: integer = 0
    local moved: integer = 0
    world:observe(0, ArchetypeCreated, function(borrows event: ArchetypeCreated): nil
        created = created + 1
        event.archetype:addEntityObserver({
            onEntitiesAdded = function(
                _observer: archetype.EntityObserver,
                candidate: archetype.Archetype,
                first: integer,
                last: integer,
                count: integer,
                source: archetype.Archetype?
            ): nil
                assert.eq(last - first + 1, count)
                assert(candidate.entities[first] ~= nil)
                if source ~= nil then
                    assert(source ~= candidate)
                end
                added = added + count
            end,
            onEntitiesRemoved = function(
                _observer: archetype.EntityObserver,
                candidate: archetype.Archetype,
                first: integer,
                _last: integer,
                count: integer,
                _target: archetype.Archetype?
            ): nil
                assert(candidate.entities[first] ~= nil)
                removed = removed + count
            end,
            onEntityMove = function(
                _observer: archetype.EntityObserver,
                candidate: archetype.Archetype,
                entity: integer,
                fromRow: integer,
                toRow: integer
            ): nil
                assert.eq(fromRow, 2)
                assert.eq(toRow, 0)
                assert.eq(candidate.entities[toRow + 1], entity)
                moved = moved + 1
            end,
            onActivated = function(_observer: archetype.EntityObserver, _candidate: archetype.Archetype): nil
                activated = activated + 1
            end,
            onDeactivated = function(_observer: archetype.EntityObserver, candidate: archetype.Archetype): nil
                assert.eq(#candidate.entities, 0)
                deactivated = deactivated + 1
            end
        })
    end)
    const first = world:spawn(value(1))
    world:spawn(value(2))
    world:spawn(value(3))
    world:commit()
    const source = assert((world:findArchetypes(value)()))
    world:update(0)
    const version = source:structuralCount()
    source:trackValueCount(value)
    source:set(1, value(7))
    assert.eq(source:valueCount(), 1)
    assert.eq(world:get(first, value), 7)
    world:despawn(first)
    world:commit()
    const rows, count = source:structuralTouched()
    assert.eq(count, 1)
    assert.eq(rows[1], 1)
    assert(source:structuralDescribed(version))
    world:batchSet(world:newQuery({include = {value}}), marker)
    world:commit()
    assert.eq(created, 2)
    assert.eq(added, 5)
    assert.eq(removed, 3)
    assert.eq(activated, 2)
    assert.eq(deactivated, 1)
    assert.eq(moved, 1)
    const stats = world:getStats()
    assert(world:getStats(stats) == stats)
end

function suite.dirtyArchetypesFollowFirstWriteOrder(): nil
    const world = ecs.newWorld()
    const left = ecs.newTagComponent({name = "test.Parity.Left"})
    const right = ecs.newTagComponent({name = "test.Parity.Right"})
    world:spawn(left)
    world:spawn(right)
    world:commit()
    world:update(0)
    const a = assert((world:findArchetypes(left)()))
    const b = assert((world:findArchetypes(right)()))
    b:markComponentDirty(right)
    a:markComponentDirty(left)
    b:markComponentDirty(right)
    const next = world:dirtyArchetypes()
    assert(next() == b)
    assert(next() == a)
    assert(next() == nil)
end

function suite.snapshotEventsFilterAndFanOut(): nil
    const world = ecs.newWorld()
    const derived = ecs.newTagComponent({name = "test.Parity.Derived"})
    const retained = world:spawn(ecs.Transform3D(1, 2, 3))
    world:spawn(derived)
    world:commit()
    local loaded: integer = 0
    local finished = false
    world:observe(0, OnSnapshotSave, function(borrows event: OnSnapshotSave): nil
        event:addData("test.parity", 7)
        event:exclude(derived)
    end)
    world:observe(0, StartSnapshotLoad, function(borrows event: StartSnapshotLoad): nil
        assert.eq(event.prelude.entityCount, 1)
        event:onData("test.parity", function(value: any): nil
            loaded = loaded + (value as integer)
        end)
        event:onData("test.parity", function(value: any): nil
            loaded = loaded + (value as integer)
        end)
    end)
    world:observe(0, FinishSnapshotLoad, function(borrows event: FinishSnapshotLoad): nil
        assert.eq(event.prelude.entityCount, 1)
        assert.eq(loaded, 14)
        finished = true
    end)
    world:disablePhase("Update")
    const saved = world:saveSnapshot()
    world:enablePhase("Update")
    world:loadSnapshot(saved)
    assert(finished)
    assert(not world:isPhaseEnabled("Update"))
    const pose = assert(world:get(retained, ecs.Transform3D))
    assert.eq(pose.z, 3)
    assert.eq(pose.rotationW, 1)
    assert.eq(pose.scaleZ, 1)
    assert.eq(world:newQuery({include = {derived}}):count(), 0)
    assert.eq(events.name(OnSnapshotSave), "OnSnapshotSave")
end

function suite.snapshotNilSerializerOmitsTheComponent(): nil
    local record Value
        x: number
    end
    const value = ecs.newComponent(Value, {
        name = "test.Parity.NilCodec",
        construct = function(): Value
            return Value(x = 1)
        end,
        default = function(): Value
            return Value(x = 0)
        end,
        save = function(_value: Value): any
            return nil
        end,
        load = function(_value: any): Value
            error("nil must not reach deserialize")
        end
    })
    const world = ecs.newWorld()
    const id = world:spawn(value())
    world:commit()
    world:loadSnapshot(world:saveSnapshot())
    assert(world:isAlive(id))
    assert(world:get(id, value) == nil)
end

function suite.binarySnapshotsRestoreNativeColumnsAndRetainTheInputBuffer(): nil
    const world = ecs.newWorld()
    const count = 1000
    world:batchSpawn(count, {ecs.Transform3D(1, 2, 3)})
    world:commit()
    const output = buffer.new()
    const saved = world:saveSnapshot({format = "binary", buffer = output})
    assert(saved.buffer == output)
    const length = #output
    assert(length > count * 80)
    world:loadSnapshot(saved)
    assert.eq(#output, length)
    assert.eq(world:newQuery({include = {ecs.Transform3D}}):count(), count)
    for candidate, rows in world:newQuery({include = {ecs.Transform3D}}):iter() do
        const values = assert(candidate:get(ecs.Transform3D))
        @unsafe do
            for row = 1, assert(rows) do
                assert.eq(values[row].z, 3);
                assert.eq(values[row].scaleX, 1)
            end
        end
    end
    world:loadSnapshot(output:tostring())
    world:loadSnapshot(output)
    assert.eq(#output, length)
    assert.raises(function(): nil
        world:loadSnapshot(output:tostring():sub(1, -2))
    end)
    assert.eq(world:getStats().entities, count)
end

function suite.readsColumnIndexedTablesAndMigratesBinarySchemas(): nil
    const world = ecs.newWorld()
    const native = ecs.Transform3D
    world:loadSnapshot({
        version = 1,
        nextEntityId = 2,
        componentTable = {{name = "Transform3D"}},
        archetypes = {
            {
                columnIndices = {1},
                entities = {{1, {x = 4, y = 5, z = 6, rotationW = 1, scaleX = 1, scaleY = 1, scaleZ = 1}}}
            }
        },
        data = {}
    })
    assert.eq(assert(world:get(1, native)).x, 4)
    const encoded = buffer.new()
    encoded:encode(1):encode(2):encode(1):encode(1):encode(1)
    encoded:encode("Transform3D"):encode("z:double,x:double|16")
    encoded:encode(1):encode(1):encode(1):encode(0)
    const ids: any = ffi.new("double[1]", 1)
    const old: any = ffi.new("double[2]", 7, 9)
    encoded:putcdata(ids as voidptr, 8):putcdata(old as voidptr, 16):encode(false)
    world:loadSnapshot(encoded)
    assert.eq(assert(world:get(1, native)).x, 9)
    assert.eq(assert(world:get(1, native)).z, 7)
end

local struct NestedPose
    x: number
end

local struct Nested
    pose: NestedPose
    pointer: uint8*?
end

function suite.nativeNestedAndPointerLayoutsUseCustomCodecs(): nil
    const component = ecs.newComponent(Nested, {
        name = "test.Parity.Nested",
        construct = function(x: number): Nested
            return Nested(NestedPose(x), nil)
        end,
        default = function(): Nested
            return Nested()
        end,
        save = function(value: Nested): any
            return {x = value.pose.x}
        end,
        load = function(value: any): Nested
            return Nested(NestedPose(value.x as number), nil)
        end
    })
    const world = ecs.newWorld()
    const id = world:spawn(component(17))
    world:commit()
    world:loadSnapshot(world:saveSnapshot({format = "binary"}))
    const restored = assert(world:get(id, component))
    assert.eq(restored.pose.x, 17)
    assert(assert(world:get(id, component)).pointer == nil)
end

function suite.savesAndLoadsInsideAnActiveSystem(): nil
    const world = ecs.newWorld()
    const marker = ecs.newTagComponent({name = "test.Parity.InSystem"})
    world:addSystem({
        name = "test.parity.snapshot",
        phase = "Update",
        run = function(_dt: number, exclusive running: World): nil
            running:spawn(marker)
            running:loadSnapshot(running:saveSnapshot({format = "binary"}))
        end
    })
    world:update(0)
    assert.eq(world:newQuery({include = {marker}}):count(), 1)
end

function suite.customPhaseTreesDispatchAndEnableRecursively(): nil
    const world = ecs.newWorld()
    const first: PhaseDefinition = {name = "test.CustomFirst"}
    world:registerPhase(first)
    world:registerPhase({name = "test.CustomLast"})
    world:registerPhase({name = "test.CustomGroup", children = {first.name, "test.CustomLast"}})
    local order = ""
    world:addSystem({
        name = "test.custom.first",
        phase = first.name,
        run = function(): nil
            order = order .. "a"
        end
    })
    world:addSystem({
        name = "test.custom.last",
        phase = "test.CustomLast",
        run = function(): nil
            order = order .. "b"
        end
    })
    world:update(0)
    assert.eq(order, "")
    world:runPhase("test.CustomGroup")
    assert.eq(order, "ab")
    world:disablePhase("test.CustomGroup")
    world:runPhase("test.CustomGroup")
    assert.eq(order, "ab")
    world:enablePhase("test.CustomLast")
    world:runPhase("test.CustomGroup")
    assert.eq(order, "abb")
    assert(first.position ~= nil)
    assert.raises(
        function(): nil
            world:registerPhase({name = "test.Cycle", children = {"test.Cycle"}})
        end,
        "unknown"
    )
end

function suite.worldAwareDeserializersReceiveTheDestination(): nil
    local record Value
        count: integer
    end
    const destination = ecs.newWorld()
    local seen = false
    const value = ecs.newComponent(Value, {
        name = "test.Parity.WorldAware",
        construct = function(): Value
            return Value(count = 17)
        end,
        default = function(): Value
            return Value(count = 0)
        end,
        save = function(input: Value): any
            return input.count
        end,
        deserialize = function(exclusive world: World, input: any): Value
            seen = world == destination
            return Value(count = input as integer)
        end
    })
    const id = destination:spawn(value())
    destination:commit()
    destination:loadSnapshot(destination:saveSnapshot({format = "binary"}))
    assert(seen)
    assert.eq(assert(destination:get(id, value)).count, 17)
end

function suite.fixedTrackingDistinguishesVariableRateOverwrites(): nil
    const world = ecs.newWorld({timestep = 0.1})
    const value = ecs.newScalarComponent({name = "test.Parity.Fixed", kind = "number"})
    const id = world:spawn(value(1))
    world:commit()
    const candidate = assert((world:findArchetypes(value)()))
    fixedtracking.track(world, value)
    local before: integer = 0
    local after: integer = 0
    fixedtracking.beforeStep(world, function(): nil
        before = before + 1
    end)
    fixedtracking.afterStep(world, function(exclusive current: World): nil
        after = after + 1
        assert(fixedtracking.wroteThisStep(current, candidate, value))
    end)
    world:addSystem({
        name = "test.parity.fixed",
        phase = "FixedUpdate",
        run = function(_dt: number, exclusive current: World): nil
            current:getMut(id, value)
        end
    })
    world:update(0.21)
    assert.eq(before, 2)
    assert.eq(after, 2)
    assert.eq(fixedtracking.currentStep(world), 2)
    assert.eq(fixedtracking.version(candidate, value), 2)
    world:getMut(id, value)
    assert(not fixedtracking.wroteThisStep(world, candidate, value))
end

function suite.flatQueuesPreserveCoalescingAndMixedPublicationOrder(): nil
    const world = ecs.newWorld()
    const a = ecs.newScalarComponent({name = "test.Parity.FlatA", kind = "number"})
    const b = ecs.newScalarComponent({name = "test.Parity.FlatB", kind = "number"})
    const relation = ecs.newRelationship({name = "test.Parity.FlatEdge", exclusive = true, reverseIndex = true})
    const bundle = world:newBundle("test.parity.flat", {required = {a}})
    const parent = world:spawn()
    const first = bundle:spawn(a(1))
    world:set(first, b(2))
    world:set(first, a(3))
    const related = world:spawn(relation(parent))
    const last = bundle:spawn(a(4))
    const order: {integer} = {}
    world:observe(0, OnSpawn, function(borrows event: OnSpawn): nil
        order[#order + 1] = event.entity
    end)
    world:commit()
    assert.eq(order[1], parent)
    assert.eq(order[2], first)
    assert.eq(order[3], related)
    assert.eq(order[4], last)
    assert.eq(world:get(first, a), 3)
    assert.eq(world:get(first, b), 2)
    world:set(first, a(10))
    world:remove(first, b)
    world:set(first, a(11))
    world:set(last, b(12))
    world:set(first, relation(parent))
    world:commit()
    assert.eq(world:get(first, a), 11)
    assert(not world:has(first, b))
    assert.eq(world:get(last, b), 12)
    assert.eq(#world:relationshipSources(relation, parent), 2)
    const canceled = bundle:spawn(a(20))
    world:despawn(canceled)
    world:commit()
    assert(not world:isAlive(canceled))
end

function suite.sparseFramesKeepAbsentTagsAndFalseScalarsDistinct(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.Parity.SparseTag"})
    const flag = ecs.newScalarComponent({name = "test.Parity.SparseBool", kind = "boolean"})
    const encoded = buffer.new()
    encoded:encode(1):encode(3):encode(2):encode(1):encode(2)
    encoded:encode(tag.componentName):encode(nil):encode(flag.componentName):encode(nil)
    encoded:encode(2):encode(2):encode(1):encode(2):encode(1)
    encoded:encode(1):encode(1):encode(nil)
    encoded:encode(2):encode(2):encode(false):encode(false)
    world:loadSnapshot(encoded)
    assert(world:has(1, tag))
    assert(not world:has(2, tag))
    assert(not world:has(1, flag))
    assert.eq(world:get(2, flag), false)
    world:loadSnapshot(world:saveSnapshot({format = "binary"}))
    assert.eq(world:get(2, flag), false)
end

local struct NativeEdge
    target: number
    weight: number
end

function suite.binaryRelationshipsRestoreDenseNativeAndSparseEdgeSets(): nil
    const world = ecs.newWorld()
    const dense = ecs.newRelationship(NativeEdge, {
        name = "test.Parity.NativeEdge",
        reverseIndex = true,
        construct = function(target: integer, weight: number): NativeEdge
            return NativeEdge(target, weight)
        end
    })
    const sparse = ecs.newRelationship({name = "test.Parity.SparseEdge", sparse = true, reverseIndex = true})
    const left = world:spawn()
    const right = world:spawn()
    const source = world:spawn(dense(left, 3), dense(right, 7))
    const second = world:spawn(sparse(left), sparse(right))
    world:commit()
    world:loadSnapshot(world:saveSnapshot({format = "binary"}))
    assert.eq(assert(world:get(source, dense:targeting(left))).weight, 3)
    assert.eq(assert(world:get(source, dense:targeting(right))).weight, 7)
    assert.eq(world:relationshipSources(dense, right)[1], source)
    assert.eq(world:relationshipSources(sparse, left)[1], second)
    assert.eq(world:relationshipSources(sparse, right)[1], second)
end

function suite.coldTransitionHooksObserveEntityAndStateChanges(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.Parity.Transitions"})
    local transitions: integer = 0
    local states: integer = 0
    entityworld.setTransitionObserver(world, {
        entity = function(id: integer, before: archetype.Archetype?, after: archetype.Archetype?): nil
            assert(id > 0)
            assert(before ~= after)
            transitions = transitions + 1
        end,
        state = function(_kind: string, _before: string?, _after: string?, changed: string): nil
            assert.eq(changed, "test.parity.state")
            states = states + 1
        end
    })
    const id = world:spawn()
    world:commit()
    world:set(id, tag)
    world:commit()
    world:despawn(id)
    world:commit()
    world:createState("test.parity.state")
    world:pushState("test.parity.state")
    world:popState()
    assert.eq(transitions, 3)
    assert.eq(states, 2)
    entityworld.setTransitionObserver(world, nil)
end

function suite.customPipelineOwnsDispatchControlsAndSnapshotClock(): nil
    const systems: {SystemConfig} = {}
    const enabled: {[string]: boolean} = {}
    local factoryCalls: integer = 0
    local registeredPhase = ""
    local ran: integer = 0
    const pipeline: Pipeline = {
        count = 0,
        fixedTimestep = 0.25,
        fixedAccumulator = 0.125,
        fixedMaxSteps = 4,
        fixedOverload = "accumulate",
        fixedStepCount = 7,
        fixedTimeDropped = 0,
        fixedStepsDropped = 0,
        phaseStates = {true},
        update = function(self: Pipeline, dt: number, exclusive world: World, borrows scope: coroutine.Scope): nil
            self:run("Update", dt, world, scope)
        end,
        run = function(
            self: Pipeline,
            phase: string,
            dt: number,
            exclusive world: World,
            borrows scope: coroutine.Scope
        ): nil
            if not self.phaseStates[1] then
                return
            end
            for index = 1, #systems do
                const system = systems[index]
                if system.phase == phase and enabled[assert(system.name)] ~= false then
                    system.run(dt, world, scope)
                end
            end
        end,
        addSystem = function(self: Pipeline, config: SystemConfig): string
            systems[#systems + 1] = config
            self.count = self.count + 1
            return assert(config.name)
        end,
        removeSystem = function(self: Pipeline, name: string): boolean
            for index = 1, #systems do
                if systems[index].name == name then
                    table.remove(systems, index);
                    self.count = self.count - 1;
                    return true
                end
            end

            return false
        end,
        listSystems = function(_self: Pipeline): {SystemInfo}
            const result: {SystemInfo} = {}
            for index = 1, #systems do
                const system = systems[index]
                result[
                    index
                ] = {
                    name = assert(system.name),
                    phase = system.phase,
                    position = index,
                    enabled = enabled[assert(system.name)] ~= false,
                    hasRunIf = system.runIf ~= nil
                }
            end

            return result
        end,
        setSystemEnabled = function(_self: Pipeline, name: string, active: boolean): (boolean, string?)
            enabled[name] = active;
            return true, nil
        end,
        enablePhase = function(self: Pipeline, _phase: string): nil
            self.phaseStates[1] = true
        end,
        disablePhase = function(self: Pipeline, _phase: string): nil
            self.phaseStates[1] = false
        end,
        isPhaseEnabled = function(self: Pipeline, _phase: string): boolean
            return self.phaseStates[1]
        end,
        registerPhase = function(_self: Pipeline, phase: PhaseDefinition): nil
            registeredPhase = phase.name
        end
    }
    const world = ecs.newWorld({
        pipelineFactory = function(): Pipeline
            factoryCalls = factoryCalls + 1;
            return pipeline
        end
    })
    world:registerPhase({name = "test.CustomPipeline"})
    assert.eq(registeredPhase, "test.CustomPipeline")
    const initial = pipeline.count
    world:addSystem({
        name = "test.parity.pipeline",
        phase = "Update",
        run = function(_dt: number, exclusive current: World): nil
            current:spawn()
            ran = ran + 1
        end
    })
    assert.eq(world:getStats().systems, initial + 1)
    assert.eq(#world:listSystems(), initial + 1)
    world:update(0.01)
    assert.eq(ran, 1)
    assert.eq(world:getStats().entities, 1)
    world:disablePhase("Update")
    const saved = world:saveSnapshot({format = "binary"})
    world:enablePhase("Update")
    pipeline.fixedAccumulator = 0
    world:loadSnapshot(saved)
    assert.eq(pipeline.fixedAccumulator, 0.125)
    assert(not world:isPhaseEnabled("Update"))
    world:runPhase("Update")
    assert.eq(ran, 1)
    world:enablePhase("Update")
    world:setSystemEnabled("test.parity.pipeline", false)
    world:update(0)
    assert.eq(ran, 1)
    assert(world:removeSystem("test.parity.pipeline"))
    assert.eq(pipeline.count, initial)
    assert.eq(world:fixedStepCount(), 7)
    assert.eq(factoryCalls, 1)
end

function suite.snapshotLayersAndMalformedPipelineValidateBeforeReplacement(): nil
    const world = ecs.newWorld()
    const left = world:spawn(ecs.Transform2D(1, 2, 0, 1))
    const right = world:spawn(ecs.Transform2D(3, 4, 0, 2))
    const unlayered = world:spawn()
    world:commit()
    const selected = world:saveSnapshot({format = "binary", layers = {2}})
    world:loadSnapshot(selected)
    assert(not world:isAlive(left))
    assert(world:isAlive(right) and world:isAlive(unlayered))
    const saved: any = world:saveSnapshot()
    saved.pipeline.phaseStates = {"invalid"}
    assert.raises(
        function(): nil
            world:loadSnapshot(saved)
        end,
        "phase states"
    )
    assert(world:isAlive(right) and world:isAlive(unlayered))
    assert.raises(
        function(): nil
            world:saveSnapshot({customData = {["__tecs.pipeline"] = {}}})
        end,
        "reserved"
    )
end

function suite.relationshipCodecsReceiveTheDestinationWorld(): nil
    const world = ecs.newWorld()
    local seen: integer = 0
    const edge = ecs.newRelationship(NativeEdge, {
        name = "test.Parity.WorldAwareEdge",
        exclusive = true,
        construct = function(target: integer, weight: number): NativeEdge
            return NativeEdge(target, weight)
        end,
        save = function(value: NativeEdge): any
            return {target = value.target, weight = value.weight}
        end,
        deserialize = function(exclusive destination: World, value: any): NativeEdge
            assert(destination == world)
            seen = seen + 1
            return NativeEdge(value.target as number, value.weight as number)
        end
    })
    const parent = world:spawn()
    const source = world:spawn(edge(parent, 17))
    world:commit()
    world:loadSnapshot(world:saveSnapshot({format = "binary"}))
    assert.eq(seen, 1)
    assert.eq(assert(world:get(source, edge)).weight, 17)
end

function suite.binarySnapshotFileMatchesItsReusableBuffer(): nil
    const world = ecs.newWorld()
    const id = world:spawn(ecs.Transform3D(3, 4, 5))
    world:commit()
    do
        local temporary = assert(files.createTemporaryFile())
        const output = buffer.new()
        world:saveSnapshot({format = "binary", buffer = output, path = temporary:toString()})
        const bytes = assert(files.read(temporary:toString()))
        assert.eq(bytes, output:tostring())
        world:loadSnapshot(bytes)
        assert.eq(assert(world:get(id, ecs.Transform3D)).z, 5)
    end
end

return suite
