local test = require("nupp.test")
local components = require("tecs.internal.components")
local ecs = require("tecs.ecs")
local publicEvents = require("tecs.events")
local world = require("tecs.internal.world")
local suite = {}

local record Message
    text: string
end

local function messageEvent(name: string): publicEvents.Event<Message>
    return publicEvents.newEvent({
        name = name,
        construct = function(text: string): Message
            return new Message(text = text)
        end
    })
end

function suite.constructsAndDeliversTypedAddressedEvents(): nil
    local message = messageEvent("test.EventMessage")
    local value = world.new(2)
    local seen: string = ""
    value:observe(
        0,
        message,
        function(event: Message, exclusive running: world.World): nil
            test.assert(running == value)
            seen = event.text
        end,
        "listener"
    )
    value:emit(0, message("hello"))
    test.equal(seen, "hello")
    test.equal(value.observerCount, 1)
end

function suite.keepsAddressesIndependent(): nil
    local message = messageEvent("test.EventAddress")
    local value = world.new(2)
    local worldCalls: integer = 0
    local entityCalls: integer = 0
    local entity = value:spawn()
    value:commit()
    value:observe(0, message, function(_event: Message, exclusive _running: world.World): nil
        worldCalls = worldCalls + 1
    end)
    value:observe(entity, message, function(_event: Message, exclusive _running: world.World): nil
        entityCalls = entityCalls + 1
    end)
    value:emit(entity, message("entity"))
    value:emit(0, message("world"))
    test.equal(worldCalls, 1)
    test.equal(entityCalls, 1)
end

function suite.defersNamedStopsUntilTheCurrentEmitFinishes(): nil
    local message = messageEvent("test.EventDeferredStop")
    local value = world.new(2)
    local firstCalls: integer = 0
    local secondCalls: integer = 0
    value:observe(
        0,
        message,
        function(_event: Message, exclusive running: world.World): nil
            firstCalls = firstCalls + 1
            running:stopObserving(0, message, "second")
        end,
        "first"
    )
    value:observe(
        0,
        message,
        function(_event: Message, exclusive _running: world.World): nil
            secondCalls = secondCalls + 1
        end,
        "second"
    )
    value:emit(0, message("one"))
    value:emit(0, message("two"))
    test.equal(firstCalls, 2)
    test.equal(secondCalls, 1)
end

function suite.supportsNestedDelivery(): nil
    local message = messageEvent("test.EventNested")
    local value = world.new(2)
    local seen: {string} = {}
    value:observe(0, message, function(event: Message, exclusive running: world.World): nil
        seen[#seen + 1] = event.text
        if event.text == "outer" then
            running:emit(0, message("inner"))
        end
    end)
    value:emit(0, message("outer"))
    test.equal(table.concat(seen, ","), "outer,inner")
end

function suite.finishesCurrentDeliveryWhenItsAddressIsCleared(): nil
    local message = messageEvent("test.EventClearDuringEmit")
    local value = world.new(2)
    local secondRan: boolean = false
    value:observe(0, message, function(_event: Message, exclusive running: world.World): nil
        running:clearObservers(0)
    end)
    value:observe(0, message, function(_event: Message, exclusive _running: world.World): nil
        secondRan = true
    end)
    value:emit(0, message("first"))
    test.assert(secondRan)
    test.assert(not value:hasObservers(0, message))
    test.equal(value.observerCount, 0)
end

function suite.clearsEntityObserversButPreservesWorldObservers(): nil
    local message = messageEvent("test.EventDespawnCleanup")
    local value = world.new(2)
    local entity = value:spawn()
    value:commit()
    value:observe(0, message, function(_event: Message, exclusive _running: world.World): nil
    end)
    value:observe(entity, message, function(_event: Message, exclusive _running: world.World): nil
    end)
    value:despawn(entity)
    value:commit()
    test.assert(value:hasObservers(0, message))
    test.assert(not value:hasObservers(entity, message))
    test.equal(value.observerCount, 1)
end

function suite.recoversEmitBookkeepingAfterAnObserverRaises(): nil
    local message = messageEvent("test.EventFailure")
    local value = world.new(2)
    value:observe(
        0,
        message,
        function(_event: Message, exclusive _running: world.World): nil
            error("expected observer failure")
        end,
        "failing"
    )
    test.raises(
        function(): nil
            value:emit(0, message("fail"))
        end,
        "expected observer failure"
    )
    test.assert(value:stopObserving(0, message, "failing"))
    test.equal(value.observerCount, 0)
end

function suite.emitsLifecycleEventsAtPublication(): nil
    local value = world.new(2)
    local spawned: integer = 0
    local entityDespawn: integer = 0
    local globalDespawn: integer = 0
    value:observe(0, ecs.OnSpawn, function(event: ecs.EntityLifecycle, exclusive _running: world.World): nil
        spawned = event.entity
    end)
    value:observe(0, ecs.OnDespawn, function(event: ecs.EntityLifecycle, exclusive _running: world.World): nil
        globalDespawn = event.entity
    end)
    local entity = value:spawn()
    value:observe(entity, ecs.OnDespawn, function(event: ecs.EntityLifecycle, exclusive running: world.World): nil
        test.assert(running:isAlive(event.entity))
        entityDespawn = event.entity
    end)
    test.equal(spawned, 0)
    value:commit()
    test.equal(spawned, entity)
    value:despawn(entity)
    value:commit()
    test.equal(entityDespawn, entity)
    test.equal(globalDespawn, entity)
end

function suite.drainsMutationsStagedByLifecycleObservers(): nil
    local marked = components.newTagComponent({name = "test.EventLifecycleMarked"})
    local value = world.new(3)
    value:observe(0, ecs.OnSpawn, function(event: ecs.EntityLifecycle, exclusive running: world.World): nil
        running:set(event.entity, marked)
        running:commit()
    end)
    local entity = value:spawn()
    value:commit()
    test.assert(value:has(entity, marked))
end

function suite.doesNotEmitSpawnForACancelledReservation(): nil
    local value = world.new(2)
    local calls: integer = 0
    value:observe(0, ecs.OnSpawn, function(_event: ecs.EntityLifecycle, exclusive _running: world.World): nil
        calls = calls + 1
    end)
    local entity = value:spawn()
    value:despawn(entity)
    value:commit()
    test.equal(calls, 0)
end

return suite
