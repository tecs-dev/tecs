local test = require("nupp.test")
local components = require("tecs.internal.components")
local ecs = require("tecs.ecs")
local events = require("nupp.events")
local world = require("tecs.internal.world")
local suite = {}

--- A test event: a declaration, constructed by the world into pooled storage.
@derive(events.Event)
@event(name = "test.EventMessage")
local record Message
    text: string
end

function suite.constructsAndDeliversTypedAddressedEvents(): nil
    local value = world.new(2)
    local seen: string = ""
    value:observe(
        0,
        Message,
        function(event: Message): nil
            test.equal(value.observers.count, 1)
            seen = event.text
        end,
        "listener"
    )
    value:emit(0, Message, "hello")
    test.equal(seen, "hello")
    value:emit(0, Message, text = "named")
    test.equal(seen, "named")
    test.equal(value.observers.count, 1)
    test.equal(events.name(Message), "test.EventMessage")
end

function suite.keepsAddressesIndependent(): nil
    local value = world.new(2)
    local worldCalls: integer = 0
    local entityCalls: integer = 0
    local entity = value:spawn()
    value:commit()
    value:observe(0, Message, function(_event: Message): nil
        worldCalls = worldCalls + 1
    end)
    value:observe(entity, Message, function(_event: Message): nil
        entityCalls = entityCalls + 1
    end)
    value:emit(entity, Message, "entity")
    value:emit(0, Message, "world")
    test.equal(worldCalls, 1)
    test.equal(entityCalls, 1)
end

function suite.stopsAnObserverNotYetReachedDuringDelivery(): nil
    -- A removal during a delivery takes effect at once: the observer removed by
    -- an earlier one in the same delivery does not run. The Teal router let it
    -- run once more before the removal applied; the bus does not.
    local value = world.new(2)
    local firstCalls: integer = 0
    local secondCalls: integer = 0
    value:observe(
        0,
        Message,
        function(_event: Message): nil
            firstCalls = firstCalls + 1
            value:stopObserving(0, Message, "second")
        end,
        "first"
    )
    value:observe(
        0,
        Message,
        function(_event: Message): nil
            secondCalls = secondCalls + 1
        end,
        "second"
    )
    value:emit(0, Message, "one")
    value:emit(0, Message, "two")
    test.equal(firstCalls, 2)
    test.equal(secondCalls, 0)
    test.equal(value.observers.count, 1)
end

function suite.removesEveryRegistrationOfACallback(): nil
    local value = world.new(2)
    local calls: integer = 0
    local function count(borrows _event: Message): nil
        calls = calls + 1
    end

    value:observe(0, Message, count)
    value:observe(0, Message, count, "named")
    value:emit(0, Message, "twice")
    test.equal(calls, 2)
    test.assert(value:stopObserving(0, Message, count))
    test.assert(not value:stopObserving(0, Message, count))
    value:emit(0, Message, "none")
    test.equal(calls, 2)
    test.equal(value.observers.count, 0)
end

function suite.consumesAOnceObserverBeforeItRuns(): nil
    local value = world.new(2)
    local calls: integer = 0
    value:observeOnce(0, Message, function(_event: Message): nil
        calls = calls + 1
        value:emit(0, Message, "nested")
    end)
    value:emit(0, Message, "first")
    value:emit(0, Message, "second")
    test.equal(calls, 1)
    test.assert(not value:hasObservers(0, Message))
end

function suite.supportsNestedDelivery(): nil
    local value = world.new(2)
    local seen: {string} = {}
    value:observe(0, Message, function(event: Message): nil
        seen[#seen + 1] = event.text
        if event.text == "outer" then
            value:emit(0, Message, "inner")
        end
    end)
    value:emit(0, Message, "outer")
    test.equal(table.concat(seen, ","), "outer,inner")
end

function suite.deliversAnInstanceTheCallerHoldsAndKeepsItsWrites(): nil
    local value = world.new(2)
    value:observe(0, Message, function(event: Message): nil
        event.text = event.text .. "!"
    end)
    local held = new Message(text = "hello")
    value:deliver(0, Message, held)
    test.equal(held.text, "hello!")
end

function suite.finishesCurrentDeliveryWhenItsAddressIsCleared(): nil
    local value = world.new(2)
    local secondRan: boolean = false
    value:observe(0, Message, function(_event: Message): nil
        value:clearObservers(0)
    end)
    value:observe(0, Message, function(_event: Message): nil
        secondRan = true
    end)
    value:emit(0, Message, "first")
    test.assert(secondRan)
    test.assert(not value:hasObservers(0, Message))
    test.equal(value.observers.count, 0)
end

function suite.clearsEntityObserversButPreservesWorldObservers(): nil
    local value = world.new(2)
    local entity = value:spawn()
    value:commit()
    value:observe(0, Message, function(_event: Message): nil
    end)
    value:observe(entity, Message, function(_event: Message): nil
    end)
    value:despawn(entity)
    value:commit()
    test.assert(value:hasObservers(0, Message))
    test.assert(not value:hasObservers(entity, Message))
    test.equal(value.observers.count, 1)
end

function suite.clearingEveryEntityKeepsTheWorldsObservers(): nil
    local value = world.new(4)
    local first = value:spawn()
    local second = value:spawn()
    value:commit()
    value:observe(0, Message, function(_event: Message): nil
    end)
    value:observe(first, Message, function(_event: Message): nil
    end)
    value:observe(second, Message, function(_event: Message): nil
    end)
    value:clearEntities()
    test.assert(value:hasObservers(0, Message))
    test.assert(not value:hasObservers(first, Message))
    test.assert(not value:hasObservers(second, Message))
    test.equal(value.observers.count, 1)
end

function suite.recoversEmitBookkeepingAfterAnObserverRaises(): nil
    local value = world.new(2)
    value:observe(
        0,
        Message,
        function(_event: Message): nil
            error("expected observer failure")
        end,
        "failing"
    )
    test.raises(
        function(): nil
            value:emit(0, Message, "fail")
        end,
        "expected observer failure"
    )
    test.assert(value:stopObserving(0, Message, "failing"))
    test.equal(value.observers.count, 0)
    local delivered: string = ""
    value:observe(0, Message, function(event: Message): nil
        delivered = event.text
    end)
    value:emit(0, Message, "after")
    test.equal(delivered, "after")
end

function suite.emitsLifecycleEventsAtPublication(): nil
    local value = world.new(2)
    local spawned: integer = 0
    local entityDespawn: integer = 0
    local globalDespawn: integer = 0
    value:observe(0, ecs.OnSpawn, function(event: ecs.OnSpawn): nil
        spawned = event.entity
    end)
    value:observe(0, ecs.OnDespawn, function(event: ecs.OnDespawn): nil
        globalDespawn = event.entity
    end)
    local entity = value:spawn(ecs.Name("alive"))
    value:observe(entity, ecs.OnDespawn, function(event: ecs.OnDespawn): nil
        test.equal(event:get(ecs.Name), "alive")
        entityDespawn = event.entity
    end)
    test.equal(spawned, 0)
    value:commit()
    test.equal(spawned, entity)
    value:despawn(entity)
    value:commit()
    test.equal(entityDespawn, entity)
    test.equal(globalDespawn, entity)
end

function suite.drainsMutationsStagedByLifecycleObservers(): nil
    local marked = components.newTagComponent({name = "test.EventLifecycleMarked"})
    local value = world.new(3)
    value:observe(0, ecs.OnSpawn, function(event: ecs.OnSpawn): nil
        value:set(event.entity, marked)
        value:commit()
    end)
    local entity = value:spawn()
    value:commit()
    test.assert(value:has(entity, marked))
end

function suite.despawnObserversCanRequestDependentTeardown(): nil
    local value = world.new(3)
    local owner = value:spawn()
    local dependent = value:spawn()
    value:commit()
    value:observe(owner, ecs.OnDespawn, function(event: ecs.OnDespawn): nil
        event:despawn(dependent)
    end)
    value:despawn(owner)
    value:commit()
    test.assert(not value:isAlive(owner))
    test.assert(not value:isAlive(dependent))
end

function suite.doesNotEmitSpawnForACancelledReservation(): nil
    local value = world.new(2)
    local calls: integer = 0
    value:observe(0, ecs.OnSpawn, function(_event: ecs.OnSpawn): nil
        calls = calls + 1
    end)
    local entity = value:spawn()
    value:despawn(entity)
    value:commit()
    test.equal(calls, 0)
end

return suite
