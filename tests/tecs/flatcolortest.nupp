local flatcolor = require("flatcolor")
local framepacket = require("tecs.internal.framepacket")
local host = require("tecs.host")

local suite = {}

function suite.installsACompleteGameThroughItsEntry(): nil
    local session = flatcolor.create(nil, 800, 450, false, 1)
    assert(host.init(session))
    assert.eq(session.app.world.liveCount, 3)

    local reader = io.Reader.of(host.renderPacket(session)):scalar()
    assert.eq(reader:readuint32(), framepacket.MAGIC)
    assert.eq(reader:readuint32(), framepacket.VERSION)
    assert.eq(reader:readuint32(), framepacket.HEADER_SIZE)
    assert.eq(reader:readuint32(), 0)
    -- The graph revision, then the section's byte length, which the batch table
    -- sits behind.
    reader:skip(4)
    local graphBytes = reader:readuint32() as integer
    assert.eq(reader:readuint32(), framepacket.BATCH_STRIDE)
    -- Two of the three quads carry an alpha below one, so the scene splits into
    -- an opaque run and a blended one.
    assert.eq(reader:readuint32(), 2)
    assert.eq(reader:readuint32(), framepacket.INSTANCE_STRIDE)
    assert.eq(reader:readuint32(), 3)
    assert.eq(reader:readfloat32(), 800)
    assert.eq(reader:readfloat32(), 450)
    -- No camera entity, so the view centers on the target and the example's
    -- target-pixel placement lands where it was authored.
    assert.eq(reader:readfloat32(), 400)
    assert.eq(reader:readfloat32(), 225)
    assert.eq(reader:readfloat32(), 1)
    assert.eq(reader:readfloat32(), 0)
    -- The light table stride and its three counts, then the ambient and the
    -- shadow and bloom tuning, which this example leaves at the defaults.
    assert.eq(reader:readuint32(), framepacket.LIGHT_STRIDE)
    assert.eq(reader:readuint32(), 0)
    assert.eq(reader:readuint32(), 0)
    reader:skip(4 + 12 * 4)
    -- The animation clock, then the two section lengths that stand between the
    -- header and the graph. This example has neither lights nor tile grids, so
    -- the two batches are all that remains before the first instance.
    reader:skip(4)
    local frameTableBytes = reader:readuint32() as integer
    local particleBytes = reader:readuint32() as integer
    reader:skip(frameTableBytes + particleBytes + graphBytes + 2 * (framepacket.BATCH_STRIDE as integer))
    assert.eq(reader:readfloat32(), 240)
    assert.eq(reader:readfloat32(), 225)
    own.drop(reader)

    assert.eq(host.iterate(session, 1), "stopped")
    assert.eq(host.crashed(session), nil)
    assert(host.shutdown(session))
end

return suite
