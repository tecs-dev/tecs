const frametable = require("tecs.gfx.frametable")
const layers = require("tecs.gfx.layers")
const clips = require("tecs.gfx.clips")

local ecs = require("tecs.ecs")
local framepacket = require("tecs.internal.framepacket")
local gfx = require("tecs.gfx")
local images = require("tecs.gfx.images")
local lighting = require("tecs.gfx.lighting")
local materials = require("tecs.gpu.materials")
local passes = require("tecs.gpu.passes")

local suite = {}

local record Header
    flags: integer
    graphBytes: integer
    graphRevision: integer
    batches: integer
    instances: integer
    targetWidth: number
    targetHeight: number
    cameraX: number
    cameraY: number
    zoom: number
    rotation: number
    lights: integer
    casters: integer
    ambientR: number
    ambientG: number
    ambientB: number
    shadowSteps: number
    shadowHeight: number
    shadowMargin: number
    dropOpacity: number
    dropLength: number
    bloomThreshold: number
    bloomKnee: number
    bloomIntensity: number
end

local record Light
    x: number
    y: number
    height: number
    radius: number
    r: number
    g: number
    b: number
    intensity: number
end

local record Batch
    image: integer
    sampler: integer
    lane: integer
    first: integer
    count: integer
end

--- Reads the versioned header, holds the packet to every constant in it, and
--- steps past the graph section so the light table is next.
local function header(borrows reader: io.ScalarReader): Header
    assert.eq(reader:readuint32(), framepacket.MAGIC)
    assert.eq(reader:readuint32(), framepacket.VERSION)
    assert.eq(reader:readuint32(), framepacket.HEADER_SIZE)
    local flags = reader:readuint32()
    local revision = reader:readuint32()
    local graphBytes = reader:readuint32()
    assert.eq(reader:readuint32(), framepacket.BATCH_STRIDE)
    local batches = reader:readuint32()
    assert.eq(reader:readuint32(), framepacket.INSTANCE_STRIDE)
    local instances = reader:readuint32()
    local targetWidth = reader:readfloat32()
    local targetHeight = reader:readfloat32()
    local cameraX = reader:readfloat32()
    local cameraY = reader:readfloat32()
    local zoom = reader:readfloat32()
    local rotation = reader:readfloat32()
    assert.eq(reader:readuint32(), framepacket.LIGHT_STRIDE)
    local lights = reader:readuint32()
    local casters = reader:readuint32()
    assert.eq(reader:readuint32(), 0)

    local read = Header(
        flags = flags as integer,
        graphBytes = graphBytes as integer,
        graphRevision = revision as integer,
        batches = batches as integer,
        instances = instances as integer,
        targetWidth = targetWidth,
        targetHeight = targetHeight,
        cameraX = cameraX,
        cameraY = cameraY,
        zoom = zoom,
        rotation = rotation,
        lights = lights as integer,
        casters = casters as integer,
        ambientR = reader:readfloat32(),
        ambientG = reader:readfloat32(),
        ambientB = reader:readfloat32(),
        shadowSteps = reader:readfloat32(),
        shadowHeight = reader:readfloat32(),
        shadowMargin = reader:readfloat32(),
        dropOpacity = reader:readfloat32(),
        dropLength = reader:readfloat32(),
        bloomThreshold = reader:readfloat32(),
        bloomKnee = reader:readfloat32(),
        bloomIntensity = reader:readfloat32()
    )
    assert.eq(reader:readuint32(), 0)
    reader:readfloat32()
    const tableBytes = reader:readuint32() as integer
    const particleBytes = reader:readuint32() as integer
    reader:skip(tableBytes + particleBytes + read.graphBytes)

    return read
end

local function light(borrows reader: io.ScalarReader): Light
    return Light(
        x = reader:readfloat32(),
        y = reader:readfloat32(),
        height = reader:readfloat32(),
        radius = reader:readfloat32(),
        r = reader:readfloat32(),
        g = reader:readfloat32(),
        b = reader:readfloat32(),
        intensity = reader:readfloat32()
    )
end

local function batch(borrows reader: io.ScalarReader): Batch
    return Batch(
        image = reader:readuint32() as integer,
        sampler = reader:readuint32() as integer,
        lane = reader:readuint32() as integer,
        first = reader:readuint32() as integer,
        count = reader:readuint32() as integer
    )
end

--- Skips one instance and answers the fields the ordering tests read.
local function instance(borrows reader: io.ScalarReader): number, number, number
    local x = reader:readfloat32()
    local y = reader:readfloat32()
    reader:skip(4)
    local depth = reader:readfloat32()
    reader:skip(64)

    return x, y, depth
end

--- Reads one instance's cast height and flags, which sit at the far end of it.
local function castOf(borrows reader: io.ScalarReader): number, integer
    reader:skip(28)
    local height = reader:readfloat32()
    reader:skip(36)
    local flags = reader:readuint32() as integer
    reader:skip(8)

    return height, flags
end

--- Makes one image resident without a host, so extraction sees a live id.
local function resident(name: string): integer
    local id = images.upload({name = name, width = 1, height = 1, pixels = "\255\255\255\255"})
    local commands = images.drain()
    for index = 1, #commands do
        images.complete(commands[index].image, commands[index].serial, true, nil)
    end
    assert.eq(images.stateOf(id), "resident")

    return id
end

function suite.exposesTheMinimumDrawableComponents(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local entity = world:spawn(
        ecs.Transform2D(10, 20, 3, 4, 0.25, 30, 40),
        gfx.Tint(0.1, 0.2, 0.3, 0.4),
        gfx.Sprite(7, 0.25, 0.5, 0.75, 1),
        gfx.Material(materials.id("rounded"), 0.5),
        gfx.Renderable2D
    )
    local eye = world:spawn(gfx.Camera2D(5, 6, 2, 0.5), gfx.ActiveCamera)
    world:commit()

    local transform: ecs.Transform2D = assert(world:get(entity, ecs.Transform2D))
    local tint: gfx.Tint = assert(world:get(entity, gfx.Tint))
    local sprite: gfx.Sprite = assert(world:get(entity, gfx.Sprite))
    local material: gfx.Material = assert(world:get(entity, gfx.Material))
    local camera: gfx.Camera2D = assert(world:get(eye, gfx.Camera2D))
    assert.eq(transform.x, 10)
    assert.eq(transform.layer, 4)
    assert.eq(transform.scaleY, 40)
    assert.eq(tint.a, 0.4)
    assert.eq(sprite.image, 7)
    assert.eq(sprite.u1, 0.75)
    assert.eq(material.id, materials.id("rounded"))
    assert.eq(material.param, 0.5)
    assert.eq(camera.zoom, 2)
    assert(world:has(entity, gfx.Renderable2D))
    assert(world:has(eye, gfx.ActiveCamera))
end

function suite.defaultsToACameraCenteredOnTheTarget(): nil
    local world = ecs.newWorld({maxEntities = 1})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 2, 0, 1, 0, 3, 4), gfx.Tint(), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.targetWidth, 640)
    assert.eq(read.targetHeight, 360)
    -- The default view puts one world unit on one target pixel with the origin
    -- at the top left corner, which is what an unconfigured scene authors in.
    assert.eq(read.cameraX, 320)
    assert.eq(read.cameraY, 180)
    assert.eq(read.zoom, 1)
    assert.eq(read.rotation, 0)
    own.drop(reader)
end

function suite.tracksTheTargetThroughAResize(): nil
    local world = ecs.newWorld({maxEntities = 1})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 2, 0, 1, 0, 3, 4), gfx.Tint(), gfx.Renderable2D)
    world:commit()

    local first = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(first).cameraX, 320)
    own.drop(first)

    local second = io.Reader.of(extractor:packet(1920, 1080)):scalar()
    local read = header(second)
    assert.eq(read.targetWidth, 1920)
    assert.eq(read.targetHeight, 1080)
    assert.eq(read.cameraX, 960)
    assert.eq(read.cameraY, 540)
    own.drop(second)

    assert.raises(
        function(): nil
            extractor:packet(0, 360)
        end,
        "viewport dimensions must be positive"
    )
end

function suite.projectsThroughTheLowestActiveCamera(): nil
    local world = ecs.newWorld({maxEntities = 4})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 2, 0, 1, 0, 3, 4), gfx.Tint(), gfx.Renderable2D)
    -- A camera with no `ActiveCamera` tag is the fallback, so the tagged one
    -- spawned after it still wins.
    world:spawn(gfx.Camera2D(11, 12, 3, 0.75))
    local chosen = world:spawn(gfx.Camera2D(100, 200, 2, 0.5), gfx.ActiveCamera)
    world:spawn(gfx.Camera2D(-1, -2, 4, 1), gfx.ActiveCamera)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.cameraX, 100)
    assert.eq(read.cameraY, 200)
    assert.eq(read.zoom, 2)
    assert.eq(read.rotation, 0.5)
    own.drop(reader)

    world:despawn(chosen)
    world:commit()
    local after = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(after).cameraX, -1)
    own.drop(after)
end

function suite.fallsBackToAnUntaggedCamera(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 2, 0, 1, 0, 3, 4), gfx.Tint(), gfx.Renderable2D)
    world:spawn(gfx.Camera2D(64, 32, 0.5, 0))
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.cameraX, 64)
    assert.eq(read.zoom, 0.5)
    own.drop(reader)
end

function suite.rejectsACameraZoomThatCannotProject(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 2, 0, 1, 0, 3, 4), gfx.Tint(), gfx.Renderable2D)
    world:spawn(gfx.Camera2D(0, 0, 0, 0), gfx.ActiveCamera)
    world:commit()

    assert.raises(
        function(): nil
            extractor:packet(640, 360)
        end,
        "zoom must be greater than zero"
    )
end

function suite.encodesOneOrderedBatchForRust(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(200, 100, 0, 2, 0, 20, 30), gfx.Tint(1, 0, 0, 1), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(50, 60, 0, 1, 0.5, 70, 80), gfx.Tint(0, 1, 0, 1), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(1, 2, 0, 0, 0, 3, 4), gfx.Tint(1, 1, 1, 1))
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.batches, 1)
    assert.eq(read.instances, 2)

    -- Untextured opaque rows share the fallback image, its nearest clamped
    -- sampler, and the opaque lane, so one run covers the scene.
    local only = batch(reader)
    assert.eq(only.image, 0)
    assert.eq(only.sampler, 0)
    assert.eq(only.lane, framepacket.LANE_OPAQUE)
    assert.eq(only.first, 0)
    assert.eq(only.count, 2)

    -- Layer 1 sits farther from the viewer than layer 2, so it is written first.
    assert.eq(reader:readfloat32(), 50)
    assert.eq(reader:readfloat32(), 60)
    assert.eq(reader:readfloat32(), 0.5)
    local farDepth = reader:readfloat32()
    assert.eq(reader:readfloat32(), 70)
    assert.eq(reader:readfloat32(), 80)
    assert.eq(reader:readfloat32(), 0.25)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 1)
    assert.eq(reader:readfloat32(), 1)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 1)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 1)
    assert.eq(reader:readuint32(), 0)
    assert.eq(reader:readuint32(), 0)
    assert.eq(reader:readuint32(), 0)
    assert.eq(reader:readuint32(), 0)

    local nearX, nearY, nearDepth = instance(reader)
    assert.eq(nearX, 200)
    assert.eq(nearY, 100)
    assert(nearDepth < farDepth, "a higher layer draws nearer")
    assert(reader:atend())
    own.drop(reader)
end

function suite.splitsBatchesOnTheBlendedLane(): nil
    local world = ecs.newWorld({maxEntities = 4})
    local extractor = framepacket.new(world)
    -- One image, one sampler, and two lanes. A run breaks on the lane so that
    -- every batch belongs to one visible list.
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(1, 1, 1, 1), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(2, 1, 0, 2, 0, 1, 1), gfx.Tint(1, 1, 1, 0.5), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(3, 1, 0, 3, 0, 1, 1), gfx.Tint(1, 1, 1, 0.25), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(4, 1, 0, 4, 0, 1, 1), gfx.Tint(1, 1, 1, 1), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.instances, 4)
    assert.eq(read.batches, 3)

    local opaque = batch(reader)
    assert.eq(opaque.lane, framepacket.LANE_OPAQUE)
    assert.eq(opaque.first, 0)
    assert.eq(opaque.count, 1)

    local blended = batch(reader)
    assert.eq(blended.lane, framepacket.LANE_BLEND)
    assert.eq(blended.first, 1)
    assert.eq(blended.count, 2)

    local nearest = batch(reader)
    assert.eq(nearest.lane, framepacket.LANE_OPAQUE)
    assert.eq(nearest.first, 3)
    assert.eq(nearest.count, 1)
    own.drop(reader)
end

function suite.carriesTheMaterialAndItsParameter(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    local ring = materials.id("ring")
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Material(ring, 0.75), gfx.Renderable2D)
    -- An entity with no `Material` draws through `textured` at id zero.
    world:spawn(ecs.Transform2D(2, 1, 0, 2, 0, 1, 1), gfx.Tint(), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(reader).instances, 2)
    assert.eq(batch(reader).count, 2)

    reader:skip(24)
    assert.eq(reader:readfloat32(), 0.75)
    reader:skip(36)
    assert.eq(reader:readuint32(), ring)
    assert.eq(reader:readuint32(), 0)
    reader:skip(8)

    reader:skip(24)
    assert.eq(reader:readfloat32(), 0.25)
    reader:skip(36)
    assert.eq(reader:readuint32(), 0)
    own.drop(reader)
end

function suite.rejectsAMaterialTheBuildDoesNotCarry(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Material(9999, 0.5), gfx.Renderable2D)
    world:commit()

    assert.raises(
        function(): nil
            extractor:packet(640, 360)
        end,
        "is not one this build carries"
    )
end

function suite.carriesTheDeclaredGraphInEveryPacket(): nil
    local world = ecs.newWorld({maxEntities = 1})
    local extractor = framepacket.new(world)
    world:commit()

    local section = passes.section()
    local reader = io.Reader.of(extractor:packet(320, 200)):scalar()
    local read = header(reader)
    assert.eq(read.graphBytes, #section)
    assert.eq(read.graphRevision, passes.revision())
    own.drop(reader)

    -- The declaration rides in every packet rather than being sent once, so a
    -- backend that lost its device rebuilds from the next frame.
    local again = io.Reader.of(extractor:packet(320, 200)):scalar()
    assert.eq(header(again).graphBytes, #section)
    own.drop(again)
end

function suite.ordersEqualDepthsByEntityId(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    local first = world:spawn(ecs.Transform2D(1, 5, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Renderable2D)
    local second = world:spawn(ecs.Transform2D(2, 5, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Renderable2D)
    local third = world:spawn(ecs.Transform2D(3, 5, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Renderable2D)
    world:commit()
    assert(first < second and second < third)

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(reader).instances, 3)
    assert.eq(batch(reader).count, 3)
    local firstX = instance(reader)
    local secondX = instance(reader)
    local thirdX = instance(reader)
    assert.eq(firstX, 1)
    assert.eq(secondX, 2)
    assert.eq(thirdX, 3)
    own.drop(reader)
end

function suite.repeatsItselfExactlyBetweenFrames(): nil
    local world = ecs.newWorld({maxEntities = 8})
    local extractor = framepacket.new(world)
    for index = 1, 8 do
        world:spawn(
            ecs.Transform2D(index * 3, index * 7, index % 3, 1 + index % 4, 0, 5, 5),
            gfx.Tint(),
            gfx.Renderable2D
        )
    end
    world:commit()

    local first = extractor:packet(640, 360)
    local second = extractor:packet(640, 360)
    assert.eq(second, first, "extraction is deterministic across frames")

    -- The row arrays are reused, so a shrinking scene must not leave stale rows
    -- behind in the sort order.
    world:despawn(1)
    world:commit()
    local shrunk = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(shrunk).instances, 7)
    own.drop(shrunk)
end

function suite.carriesSpriteIdentityAndSamplerIntoBatches(): nil
    local world = ecs.newWorld({maxEntities = 4})
    local extractor = framepacket.new(world)
    local grass = resident("framepacket/grass")
    local stone = images.upload({
        name = "framepacket/stone",
        width = 1,
        height = 1,
        pixels = "\0\0\0\255",
        filter = "linear",
        address = "repeat",
    })
    local pending = images.drain()
    for index = 1, #pending do
        images.complete(pending[index].image, pending[index].serial, true, nil)
    end

    -- Layer 1 is farthest, so the written order is grass, grass, stone.
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Sprite(grass, 0, 0, 0.5, 0.5), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(2, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Sprite(grass), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(3, 1, 0, 2, 0, 1, 1), gfx.Tint(), gfx.Sprite(stone), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.instances, 3)
    assert.eq(read.batches, 2)

    local grassBatch = batch(reader)
    assert.eq(grassBatch.image, grass)
    assert.eq(grassBatch.sampler, images.samplerIndex("nearest", "clamp"))
    assert.eq(grassBatch.first, 0)
    assert.eq(grassBatch.count, 2)

    local stoneBatch = batch(reader)
    assert.eq(stoneBatch.image, stone)
    assert.eq(stoneBatch.sampler, images.samplerIndex("linear", "repeat"))
    assert.eq(stoneBatch.first, 2)
    assert.eq(stoneBatch.count, 1)

    -- The first sprite's UV rectangle survives the crossing intact.
    reader:skip(32)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 0)
    assert.eq(reader:readfloat32(), 0.5)
    assert.eq(reader:readfloat32(), 0.5)
    own.drop(reader)
end

function suite.drawsAMissingImageAgainstTheFallback(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    local missing = images.id("framepacket/never-uploaded")
    local failed = images.upload({name = "framepacket/rejected", width = 1, height = 1, pixels = "\1\2\3\4"})
    local queued = images.drain()
    for index = 1, #queued do
        images.complete(queued[index].image, queued[index].serial, false, "the backend rejected it")
    end
    assert.eq(images.stateOf(missing), "unknown")
    assert.eq(images.stateOf(failed), "failed")

    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Sprite(missing), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(2, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Sprite(failed), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.instances, 2)
    -- Neither image is resident, so both rows fall into the fallback run rather
    -- than dropping out of the frame.
    assert.eq(read.batches, 1)
    local only = batch(reader)
    assert.eq(only.image, 0)
    assert.eq(only.count, 2)
    own.drop(reader)
end

function suite.keepsTransparentRowsInBackToFrontOrder(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    -- One archetype, three alpha values, three layers. Blending depends on the
    -- write order, so the packet has to place the farthest row first whatever
    -- order the world spawned them in.
    world:spawn(ecs.Transform2D(3, 1, 0, 3, 0, 1, 1), gfx.Tint(1, 1, 1, 0.25), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(1, 1, 1, 1), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(2, 1, 0, 2, 0, 1, 1), gfx.Tint(1, 1, 1, 0.5), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(reader).instances, 3)
    -- The opaque row is farthest and leads, then the two blended ones follow in
    -- one run of their own lane.
    assert.eq(batch(reader).count, 1)
    assert.eq(batch(reader).count, 2)
    local firstX, _, firstDepth = instance(reader)
    local secondX, _, secondDepth = instance(reader)
    local thirdX, _, thirdDepth = instance(reader)
    assert.eq(firstX, 1)
    assert.eq(secondX, 2)
    assert.eq(thirdX, 3)
    assert(firstDepth > secondDepth and secondDepth > thirdDepth, "written back to front")
    own.drop(reader)
end

function suite.encodesAnEmptyScene(): nil
    local world = ecs.newWorld({maxEntities = 1})
    local extractor = framepacket.new(world)
    world:commit()

    local packed = extractor:packet(16, 9)
    assert.eq(#packed, (framepacket.HEADER_SIZE as integer) + #frametable.packed() + #passes.section())
    local reader = io.Reader.of(packed):scalar()
    local read = header(reader)
    assert.eq(read.batches, 0)
    assert.eq(read.instances, 0)
    assert(reader:atend())
    own.drop(reader)
end

function suite.carriesLightsInAscendingEntityOrder(): nil
    local world = ecs.newWorld({maxEntities = 8})
    local extractor = framepacket.new(world)
    -- Spawned out of order, and the light table has to come out in entity order
    -- so a tile accumulates the same lights in the same order every frame.
    -- Two archetypes, so the two lights sit in different columns and the query
    -- reaches them in whatever order the world lays those out. The table still
    -- has to come out in entity order, which here is spawn order.
    const first = world:spawn(ecs.Transform2D(10, 20), gfx.PointLight2D(32, 128, 1, 0.5, 0.25, 3))
    const second = world:spawn(ecs.Transform2D(30, 40), gfx.PointLight2D(10, 20, 0.25, 0.5, 0.75, 2), gfx.Renderable2D)
    world:commit()
    assert(first < second, "an earlier spawn takes a lower id")

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.lights, 2)
    local leading = light(reader)
    local trailing = light(reader)
    assert.eq(leading.x, 10)
    assert.eq(leading.y, 20)
    assert.eq(leading.height, 32)
    assert.eq(leading.radius, 128)
    assert.eq(leading.intensity, 3)
    assert.eq(trailing.x, 30)
    assert.eq(trailing.radius, 20)
    own.drop(reader)
end

function suite.carriesTheTuningEveryFrameAndFlagsWhatIsOn(): nil
    lighting.reset()
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    world:commit()

    local reader = io.Reader.of(extractor:packet(64, 64)):scalar()
    local off = header(reader)
    assert.eq(off.flags, 0)
    assert.eq(off.ambientR, 1)
    -- The tuning is written whether or not its flag is set, so a backend reads
    -- one layout and the flag alone decides.
    assert.eq(off.shadowSteps, 24)
    assert(off.bloomThreshold > 0.79 and off.bloomThreshold < 0.81, "the default threshold rides too")
    own.drop(reader)

    lighting.setAmbient(0.25, 0.5, 0.75)
    lighting.setShadows({steps = 8, margin = 12, height = 50, dropOpacity = 0.5, dropLength = 64})
    lighting.setBloom({threshold = 1.5, knee = 0.25, intensity = 0.5})
    local second = io.Reader.of(extractor:packet(64, 64)):scalar()
    local on = header(second)
    assert.eq(on.flags, (framepacket.FRAME_SHADOWS as integer) + (framepacket.FRAME_BLOOM as integer))
    assert.eq(on.ambientG, 0.5)
    assert.eq(on.shadowSteps, 8)
    assert.eq(on.shadowMargin, 12)
    assert.eq(on.shadowHeight, 50)
    assert.eq(on.dropOpacity, 0.5)
    assert.eq(on.dropLength, 64)
    assert.eq(on.bloomThreshold, 1.5)
    assert.eq(on.bloomKnee, 0.25)
    assert.eq(on.bloomIntensity, 0.5)
    own.drop(second)
    lighting.reset()
end

function suite.marksACasterAndLeavesATranslucentOneAlone(): nil
    local world = ecs.newWorld({maxEntities = 8})
    local extractor = framepacket.new(world)
    -- One layer and one position band, so every depth ties and the packet falls
    -- back to ascending entity id, which is spawn order.
    world:spawn(ecs.Transform2D(1, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.Occluder2D(0.75), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(2, 1, 0, 1, 0, 1, 1), gfx.Tint(), gfx.DropShadow2D(0.5), gfx.Renderable2D)
    -- Both components on one entity is an occluder, because dropping that half
    -- would silently unblock a light.
    world:spawn(
        ecs.Transform2D(3, 1, 0, 1, 0, 1, 1),
        gfx.Tint(),
        gfx.Occluder2D(0.25),
        gfx.DropShadow2D(1),
        gfx.Renderable2D
    )
    -- Translucent, so it casts nothing at all: it never reaches the G-buffer.
    world:spawn(ecs.Transform2D(4, 1, 0, 1, 0, 1, 1), gfx.Tint(1, 1, 1, 0.5), gfx.Occluder2D(1), gfx.Renderable2D)
    world:commit()

    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    local read = header(reader)
    assert.eq(read.instances, 4)
    assert.eq(read.casters, 3)
    for index = 1, read.batches do
        batch(reader)
    end
    local firstHeight, firstFlags = castOf(reader)
    assert.eq(firstFlags, framepacket.FLAG_OCCLUDER)
    assert.eq(firstHeight, 0.75)
    local secondHeight, secondFlags = castOf(reader)
    assert.eq(secondFlags, framepacket.FLAG_DROP_SHADOW)
    assert.eq(secondHeight, 0.5)
    local thirdHeight, thirdFlags = castOf(reader)
    assert.eq(thirdFlags, framepacket.FLAG_OCCLUDER)
    assert.eq(thirdHeight, 0.25)
    local fourthHeight, fourthFlags = castOf(reader)
    assert.eq(fourthFlags, framepacket.FLAG_BLENDED)
    assert.eq(fourthHeight, 0)
    own.drop(reader)
end

function suite.dropsTheLightsPastTheCeiling(): nil
    local world = ecs.newWorld({maxEntities = lighting.MAX_LIGHTS + 4})
    local extractor = framepacket.new(world)
    for index = 1, lighting.MAX_LIGHTS + 3 do
        world:spawn(ecs.Transform2D(index, 0), gfx.PointLight2D())
    end
    world:commit()

    local reader = io.Reader.of(extractor:packet(64, 64)):scalar()
    assert.eq(header(reader).lights, lighting.MAX_LIGHTS)
    own.drop(reader)
end

function suite.refusesALightThatCannotProject(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(0, 0), gfx.PointLight2D(64, 0))
    world:commit()

    assert.raises(
        function(): nil
            extractor:packet(64, 64)
        end,
        "radius must be greater than zero"
    )
end

function suite.bulkInstancesMatchScalarRoundingAndOwnTheirBytes(): nil
    local world = ecs.newWorld({maxEntities = 300})
    local extractor = framepacket.new(world)
    local values: {number} = {0.1, -7.2, 16777217, 1e-38, -0.0}
    local entities: {integer} = {}
    for index = 1, 300 do
        local x = values[(index - 1) % #values + 1]
        entities[index] = world:spawn(ecs.Transform2D(x, -0.1, 0, 1, 0.3), gfx.Tint(), gfx.Renderable2D)
    end
    world:commit()
    local original = extractor:packet(640, 360)
    local reader = io.Reader.of(original):scalar()
    local read = header(reader)
    assert.eq(read.instances, 300)
    assert.eq(batch(reader).count, 300)
    local at = original:len() - 300 * 80 + 1
    for index = 1, 300 do
        local x = values[(index - 1) % #values + 1]
        local expected = bytes.Buffer.create()
        local writer = expected:writer():scalar()
        writer:writefloat32(math.f32.narrow(x)):writefloat32(math.f32.narrow(-0.1)):writefloat32(math.f32.narrow(0.3))
        own.drop(writer)
        assert.eq(original:sub(at, at + 11), expected:tostring())
        own.drop(expected)
        at = at + 80
    end
    own.drop(reader)
    for index = 1, #entities do
        world:despawn(entities[index])
    end
    world:commit()
    local empty = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(empty).instances, 0)
    assert(empty:atend())
    own.drop(empty)
    -- Returned strings survive subsequent packets and buffer reclamation.
    collectgarbage("collect")
    local retained = io.Reader.of(original):scalar()
    assert.eq(header(retained).instances, 300)
    own.drop(retained)
end

function suite.refreshesCachedOrderAfterChangesAndARefusedPacket(): nil
    local world = ecs.newWorld({maxEntities = 2})
    local extractor = framepacket.new(world)
    local first = world:spawn(ecs.Transform2D(10, 20, 0, 1), gfx.Tint(), gfx.Material(), gfx.Renderable2D)
    local second = world:spawn(ecs.Transform2D(30, 40, 0, 2), gfx.Tint(), gfx.Material(), gfx.Renderable2D)
    world:commit()
    local original = extractor:packet(640, 360)
    assert.eq(extractor:packet(640, 360), original)
    assert(world:getMut(first, ecs.Transform2D)).layer = 3
    assert(world:getMut(second, gfx.Material)).id = 9999
    assert.raises(
        function(): nil
            extractor:packet(640, 360)
        end,
        "is not one this build carries"
    )
    assert(world:getMut(second, gfx.Material)).id = 0
    local reader = io.Reader.of(extractor:packet(640, 360)):scalar()
    assert.eq(header(reader).instances, 2)
    assert.eq(batch(reader).count, 2)
    assert.eq(select(1, instance(reader)), 30)
    assert.eq(select(1, instance(reader)), 10)
    own.drop(reader)
    -- Another depth edit invalidates the cached order without an error path.
    assert(world:getMut(first, ecs.Transform2D)).layer = 1
    assert.eq(extractor:packet(640, 360), original)
end

function suite.packsClipsAndKeepsScreenOverlaysStillUnderACamera(): nil
    local world = ecs.newWorld()
    layers.configure(16, {sort = "z", screenSpace = true, overlay = true, unlit = true})
    clips.setRegion(250, {x = 10.8, y = 20.2, width = 100, height = 50})
    world:spawn(gfx.Camera2D(1000, 2000, 2, math.pi / 2), gfx.ActiveCamera)
    world:spawn(ecs.Transform2D(100, 50, 0, 16, 0, 40, 20), gfx.Tint(), gfx.Renderable2D, gfx.Clip(250))
    world:commit()
    local extractor = framepacket.new(world)
    local reader = io.Reader.of(extractor:packet(800, 600)):scalar()
    local h = header(reader)
    local b = batch(reader)
    assert.eq(b.lane, framepacket.LANE_BLEND)
    assert(math.abs(reader:readfloat32() - 1125) < 0.001)
    assert(math.abs(reader:readfloat32() - 1850) < 0.001)
    assert(math.abs(reader:readfloat32() - math.pi / 2) < 0.001)
    reader:skip(4)
    assert.eq(reader:readfloat32(), 20)
    assert.eq(reader:readfloat32(), 10)
    reader:skip(10 * 4)
    reader:skip(4)
    assert.eq(reader:readuint32(), 9)
    assert.eq(reader:readuint32(), 11 + 20 * 65536)
    assert.eq(reader:readuint32(), 111 + 70 * 65536)
    own.drop(reader)
    clips.clearRegion(250)
    layers.configure(16, {sort = "topdown"})
    assert.eq(h.instances, 1)
end

return suite
