
local framepacket = require("tecs.internal.framepacket")
local gfx = require("tecs.gfx")
local host = require("tecs.host")
local images = require("tecs.gfx.images")
local sprites = require("sprites")

local suite = {}

function suite.drawsACameraAndTwoImagesThroughItsEntry(): nil
    -- The image registry is process-wide, so drop whatever an earlier suite in
    -- this worker left queued before counting this example's own uploads.
    images.drain()
    const session = sprites.create(nil, 800, 450, false, 2)
    assert(host.init(session))

    -- One camera plus the field, and both images queued for the backend.
    assert.eq(session.app.world.liveCount, 601)
    local uploads = 0
    for _, command in ipairs(images.drain()) do
        assert(command is images.UploadImageCommand)
        if command is images.UploadImageCommand then
            assert.eq(command.format, "rgba8")
            assert.eq(#command.pixels, command.width * command.height * 4)
            assert(command.sampler < images.SAMPLER_COUNT)
            images.complete(command.image, command.serial, true, nil)
            uploads = uploads + 1
        end
    end
    assert.eq(uploads, 2)
    assert.eq(images.stateOf(images.id("example/sprites/checker")), "resident")
    assert.eq(images.stateOf(images.id("example/sprites/disc")), "resident")

    assert.eq(host.iterate(session, 0.25), "continue")
    const reader = io.Reader.of(host.renderPacket(session)):scalar()
    assert.eq(reader:readuint32(), framepacket.MAGIC)
    assert.eq(reader:readuint32(), framepacket.VERSION)
    reader:skip(20)
    const batches = reader:readuint32() as integer
    reader:skip(4)
    assert.eq(reader:readuint32(), 600)
    assert.eq(reader:readfloat32(), 800)
    assert.eq(reader:readfloat32(), 450)
    -- The camera moved off the field center on the first frame, so the packet
    -- carries the game's view rather than the target-centered default.
    const cameraX = reader:readfloat32()
    assert.ne(cameraX, 400)
    reader:skip(4)
    assert(reader:readfloat32() > 0, "the zoom projects")
    reader:skip(4)
    assert.eq(reader:readuint32(), framepacket.LIGHT_STRIDE)
    own.drop(reader)

    -- Both images are resident and the field alternates between them, so the
    -- run-length batching splits the frame rather than collapsing it.
    assert(batches > 1, "textured runs batch separately")
    assert.eq(host.iterate(session, 0.25), "stopped")
    assert.eq(host.crashed(session), nil)
    assert(host.shutdown(session))
end

function suite.buildsTheSameSceneEveryRun(): nil
    const first = sprites.create(nil, 320, 180, false, 1)
    assert(host.init(first))
    const firstPacket = host.renderPacket(first)
    assert(host.shutdown(first))

    const second = sprites.create(nil, 320, 180, false, 1)
    assert(host.init(second))
    const secondPacket = host.renderPacket(second)
    assert(host.shutdown(second))

    assert.eq(secondPacket, firstPacket, "the field is authored, not sampled")
end

function suite.spawnsExactlyOneActiveCamera(): nil
    const session = sprites.create(nil, 320, 180, false, 1)
    assert(host.init(session))
    const eyes = session.app.world:newQuery({include = {gfx.Camera2D, gfx.ActiveCamera}})
    local found = 0
    for _, count in eyes:iter() do
        found = found + (count as integer)
    end
    assert.eq(found, 1)
    assert(host.shutdown(session))
end

return suite
