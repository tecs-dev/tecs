local nativelibrary = require("tecs.internal.nativelibrary")
local assetnative = require("tecs.internal.assetnative")
local suite = {}

function suite.opensOneHandlePerStem(): nil
    local first = nativelibrary.open("tecs_assets", "TECS_ASSETS_LIBRARY")
    assert(first == nativelibrary.open("tecs_assets", "TECS_ASSETS_LIBRARY"), "a second open reloaded the library")
end

-- A declaration copies its function pointer out of the handle when its module
-- loads. The handle alone keeps the library mapped, so a collection that
-- reached it unloaded the library under every bound function.
function suite.boundFunctionsSurviveACollection(): nil
    collectgarbage("collect")
    collectgarbage("collect")
    local source = assetnative.load("tests/fixtures/tiled/maps/level.tmx", 0)
    assert(#source > 0, "the asset library returned an empty map")
end

return suite
