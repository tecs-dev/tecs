local inverseindex = require("tecs.internal.inverseindex")
local suite = {}

local function collect(index: inverseindex.InverseIndex, targetId: integer): {[integer]: boolean}
    local found: {[integer]: boolean} = {}
    index:forEachSource(
        targetId,
        function(sourceId: integer, _: any): nil
            found[sourceId] = true
        end,
        nil
    )

    return found
end

function suite.linksSourcesIdempotently(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(10, 100)
    index:link(20, 100)
    local found = collect(index, 100)
    assert.eq(found[10], true)
    assert.eq(found[20], true)
    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    assert.eq(count, 2)
end

function suite.unlinksOneEdge(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(20, 100)
    index:unlink(10, 100)
    local found = collect(index, 100)
    assert.eq(found[10], nil)
    assert.eq(found[20], true)
end

function suite.reportsTargetLifetime(): nil
    local index = inverseindex.new()
    local added: {integer} = {}
    local removed: {integer} = {}
    index.onTargetAdded = function(targetId: integer): nil
        added[#added + 1] = targetId
    end
    index.onTargetRemoved = function(targetId: integer): nil
        removed[#removed + 1] = targetId
    end

    index:link(10, 100)
    index:link(20, 100)
    assert.eq(#added, 1)
    assert.eq(added[1], 100)

    index:unlink(10, 100)
    assert.eq(#removed, 0)
    index:unlink(20, 100)
    assert.eq(#removed, 1)
    assert.eq(removed[1], 100)
end

function suite.removesWholeTarget(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(20, 100)
    local sources = index:removeTarget(100)
    assert.eq(sources[10], true)
    assert.eq(sources[20], true)
    assert.eq(next(collect(index, 100)), nil)
end

function suite.removesSourceFromKnownTargets(): nil
    local index = inverseindex.new()
    index:link(10, 100)
    index:link(10, 200)
    index:link(20, 200)
    index:unlinkSourceFromTargets(10, {100, 200})
    assert.eq(next(collect(index, 100)), nil)
    local found = collect(index, 200)
    assert.eq(found[10], nil)
    assert.eq(found[20], true)
end

function suite.absentTargetUsesEmptySentinel(): nil
    local index = inverseindex.new()
    assert.eq(next(index:removeTarget(999)), nil)
end

return suite
