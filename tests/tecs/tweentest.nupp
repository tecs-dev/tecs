local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local sequence = require("tecs.sequence")
local tweeneval = require("tecs.internal.tweeneval")
local test = require("nupp.test")

local suite = {}

local nextName = 0

local function uniqueName(prefix: string): string
    nextName = nextName + 1
    return prefix .. tostring(nextName)
end

-- A timeline runs on the presentation clock, which ticks once per frame in the
-- Update phase, so one update of any length advances it exactly once and hands
-- the evaluator that update's own elapsed time.
local function newWorld(): ecs.World
    local world = ecs.newWorld({timestep = 1})
    sequence.plugin(world)

    return world
end

local function newActor(exclusive world: ecs.World): integer
    local actor = world:spawn(ecs.Transform2D(0, 0), gfx.Tint(1, 1, 1, 1))
    world:commit()

    return actor
end

local function positionOf(borrows world: ecs.World, actor: integer): number
    return assert(world:get(actor, ecs.Transform2D)).x
end

local function near(actual: number, expected: number): nil
    test.assert(math.abs(actual - expected) < 1e-9, actual, expected)
end

function suite.holdsTheStartValueAtTheFirstTick(): nil
    local world = newWorld()
    local actor = newActor(world)
    local fade = sequence.timeline(uniqueName("test.slide."), {sequence.tweenTo(1, "linear", "transform.x", 100),})

    sequence.play(world, fade, {owner = actor})
    -- The first update reaches the evaluating instruction with no elapsed time
    -- of its own, so the slot captures its start and writes it unchanged.
    world:update(0)

    near(positionOf(world, actor), 0)
end

function suite.landsExactlyOnTheDestinationAtTheEnd(): nil
    local world = newWorld()
    local actor = newActor(world)
    local slide = sequence.timeline(uniqueName("test.slide."), {sequence.tweenTo(1, "linear", "transform.x", 100),})
    local handle = sequence.play(world, slide, {owner = actor})

    world:update(0)
    world:update(0.5)
    near(positionOf(world, actor), 50)

    -- Overshooting the last tick still lands on the destination rather than
    -- past it, because the advance snaps to the boundary before evaluating.
    world:update(0.9)
    near(positionOf(world, actor), 100)
    test.equal(assert(sequence.status(world, handle)).state, "completed")
end

function suite.startsFromWhereTheEntityIsRatherThanFromCompileTime(): nil
    local world = newWorld()
    local actor = newActor(world)
    local transform = assert(world:getMut(actor, ecs.Transform2D))
    transform.x = 20
    local slide = sequence.timeline(uniqueName("test.relative."), {sequence.tweenTo(1, "linear", "transform.x", 40),})

    sequence.play(world, slide, {owner = actor})
    world:update(0)
    world:update(0.5)

    near(positionOf(world, actor), 30)
end

function suite.appliesAdjustAsASignedDeltaFromTheStart(): nil
    local world = newWorld()
    local actor = newActor(world)
    local transform = assert(world:getMut(actor, ecs.Transform2D))
    transform.x = 5
    local nudge = sequence.timeline(uniqueName("test.adjust."), {
        sequence.tweenAdjust(1, "linear", "transform.x", -10),
    })

    sequence.play(world, nudge, {owner = actor})
    world:update(0)
    world:update(1)

    near(positionOf(world, actor), -5)
end

function suite.interpolatesEveryColorChannelTogether(): nil
    local world = newWorld()
    local actor = newActor(world)
    local recolor = sequence.timeline(uniqueName("test.color."), {
        sequence.tweenTo(1, "linear", "color.rgba", 0, 0.5, 1, 0),
    })

    sequence.play(world, recolor, {owner = actor})
    world:update(0)
    world:update(1)

    local tint = assert(world:get(actor, gfx.Tint))
    near(tint.r, 0)
    near(tint.g, 0.5)
    near(tint.b, 1)
    near(tint.a, 0)
end

function suite.mapsEveryBuiltInEasingCurveThroughItsEndpoints(): nil
    local names: {
        string
    } = {
        "linear",
        "quadIn",
        "quadOut",
        "quadInOut",
        "quadOutIn",
        "cubicIn",
        "cubicOut",
        "cubicInOut",
        "cubicOutIn",
        "quartIn",
        "quartOut",
        "quartInOut",
        "quartOutIn",
        "quintIn",
        "quintOut",
        "quintInOut",
        "quintOutIn",
        "sineIn",
        "sineOut",
        "sineInOut",
        "sineOutIn",
        "expoIn",
        "expoOut",
        "expoInOut",
        "expoOutIn",
        "backIn",
        "backOut",
        "backInOut",
        "backOutIn",
        "elasticIn",
        "elasticOut",
        "elasticInOut",
        "elasticOutIn",
        "bounceIn",
        "bounceOut",
        "bounceInOut",
        "bounceOutIn",
    }
    test.equal(#names, 37)
    for index = 1, #names do
        local curve = assert(sequence.easing(names[index] as sequence.EasingName), names[index])
        test.assert(math.abs(curve(0)) < 1e-6, names[index])
        test.assert(math.abs(curve(1) - 1) < 1e-6, names[index])
    end
end

function suite.rejectsACurveItCannotName(): nil
    test.raises(
        function(): nil
            sequence.tweenTo(1, "notACurve" as sequence.EasingName, "transform.x", 1)
        end,
        "unknown easing"
    )
    test.raises(
        function(): nil
            sequence.tweenTo(
                1,
                function(t: number): number
                    return t
                end,
                "transform.x",
                1
            )
        end,
        "built%-in easing"
    )
end

function suite.runsParallelBranchesFromASharedStart(): nil
    local world = newWorld()
    local actor = newActor(world)
    local both = sequence.timeline(uniqueName("test.both."), {
        sequence.tweenParallel({
            {sequence.tweenTo(1, "linear", "transform.x", 10)},
            {sequence.tweenTo(2, "linear", "transform.y", 20)},
        }),
    })

    local handle = sequence.play(world, both, {owner = actor})
    world:update(0)
    world:update(1)

    local transform = assert(world:get(actor, ecs.Transform2D))
    near(transform.x, 10)
    near(transform.y, 10)
    -- The block ends with the longest branch, so the playback is still going.
    test.equal(assert(sequence.status(world, handle)).state, "running")

    world:update(1)
    test.equal(assert(sequence.status(world, handle)).state, "completed")
end

function suite.repeatsALoopedTimelineItsCountedNumberOfTimes(): nil
    local world = newWorld()
    local actor = newActor(world)
    local pulse = sequence.timeline(uniqueName("test.pulse."), {sequence.tweenTo(1, "linear", "transform.x", 10),})

    local handle = sequence.play(world, pulse, {owner = actor, params = {mode = "loop", count = 2}})
    world:update(0)
    world:update(1)
    test.equal(assert(sequence.status(world, handle)).state, "running")

    world:update(1)
    near(positionOf(world, actor), 10)
    test.equal(assert(sequence.status(world, handle)).state, "completed")
end

function suite.returnsToTheStartOnAPingPongLeg(): nil
    local world = newWorld()
    local actor = newActor(world)
    local swing = sequence.timeline(uniqueName("test.swing."), {sequence.tweenTo(1, "linear", "transform.x", 10),})

    sequence.play(world, swing, {owner = actor, params = {mode = "pingPong", count = 2}})
    world:update(0)
    world:update(1)
    near(positionOf(world, actor), 10)

    world:update(0.5)
    near(positionOf(world, actor), 5)
end

function suite.holdsAPlaybackBackForItsDelayAndScalesItBySpeed(): nil
    local world = newWorld()
    local actor = newActor(world)
    local slide = sequence.timeline(uniqueName("test.delayed."), {sequence.tweenTo(1, "linear", "transform.x", 100),})

    sequence.play(world, slide, {owner = actor, params = {delay = 1, speed = 2}})
    world:update(0)
    world:update(0.5)
    near(positionOf(world, actor), 0)

    -- Half the delay is left, and the remaining quarter second runs at double
    -- speed, so the playback lands halfway.
    world:update(0.75)
    near(positionOf(world, actor), 50)
end

function suite.firesTimelineEmitsAsTheCursorPassesThemGoingForward(): nil
    local world = newWorld()
    local actor = newActor(world)
    local seen: {string} = {}
    world:observe(0, sequence.Event, function(value: sequence.Emission, exclusive _world: ecs.World): nil
        seen[#seen + 1] = value.name
    end)
    local marked = sequence.timeline(uniqueName("test.marked."), {
        sequence.tweenEmit("start"),
        sequence.tweenTo(1, "linear", "transform.x", 10),
        sequence.tweenEmit("finish"),
    })

    sequence.play(world, marked, {owner = actor, params = {mode = "pingPong", count = 2}})
    -- The tick a playback activates on runs the evaluating instruction after
    -- the active walk, so the first evaluation is the tick after it.
    world:update(0)
    test.equal(#seen, 0)

    world:update(0)
    test.equal(table.concat(seen, ","), "start")

    world:update(1)
    test.equal(table.concat(seen, ","), "start,finish")

    -- The return leg passes both points again and fires neither.
    world:update(1)
    test.equal(table.concat(seen, ","), "start,finish")
end

function suite.completesOnItsFirstTickWithoutAnOwner(): nil
    local world = newWorld()
    local slide = sequence.timeline(uniqueName("test.ownerless."), {sequence.tweenTo(1, "linear", "transform.x", 100),})

    local handle = sequence.play(world, slide)
    world:update(0)
    world:update(0)

    test.equal(assert(sequence.status(world, handle)).state, "completed")
end

function suite.chasesATrackedSourceWhileItKeepsMoving(): nil
    local world = newWorld()
    local actor = newActor(world)
    local quarry = newActor(world)
    local link = ecs.newRelationship({name = uniqueName("test.Chases."), exclusive = true, reverseIndex = true})
    world:set(actor, link(quarry))
    world:commit()
    local quarryTransform = assert(world:getMut(quarry, ecs.Transform2D))
    quarryTransform.x = 100
    local chase = sequence.timeline(uniqueName("test.chase."), {
        sequence.tweenTrack(1, "linear", "transform.x", sequence.sourceRelated(link, ecs.Transform2D, {"x"})),
    })

    sequence.play(world, chase, {owner = actor})
    world:update(0)
    world:update(0.5)
    near(positionOf(world, actor), 50)

    -- The destination moves underneath the interpolation.
    quarryTransform = assert(world:getMut(quarry, ecs.Transform2D))
    quarryTransform.x = 200
    world:update(0.25)
    near(positionOf(world, actor), 150)
end

function suite.playsATimelineFromASequenceAndWaitsForIt(): nil
    local world = newWorld()
    local actor = newActor(world)
    local done = false
    sequence.registerAction(world, "test.tweenDone", function(
        exclusive _world: ecs.World,
        _context: sequence.ActionContext
    ): nil
        done = true
    end)
    local slide = sequence.timeline(uniqueName("test.driven."), {sequence.tweenTo(1, "linear", "transform.x", 10),})
    local script = sequence.define(uniqueName("test.script."), {
        sequence.playTween(slide.name, sequence.bind("actor")),
        sequence.waitTween(),
        sequence.call("test.tweenDone"),
    })

    local handle = sequence.play(world, script, {bindings = {actor = actor}})
    world:update(1)
    test.assert(not done)

    world:update(1)
    near(positionOf(world, actor), 10)
    test.assert(not done)

    world:update(1)
    test.assert(done)
    test.equal(assert(sequence.status(world, handle)).tweenOutcome, "completed")
end

function suite.reportsTargetLostWhenTheBindingIsGone(): nil
    local world = newWorld()
    local slide = sequence.timeline(uniqueName("test.lost."), {sequence.tweenTo(1, "linear", "transform.x", 10),})
    local script = sequence.define(uniqueName("test.lostScript."), {
        sequence.playTween(slide.name, sequence.bind("actor")),
        sequence.waitTween(),
    })

    local handle = sequence.play(world, script)
    world:update(1)

    local status = assert(sequence.status(world, handle))
    test.equal(status.state, "completed")
    test.equal(status.tweenOutcome, "targetLost")
end

function suite.faultsAnUndefinedTimelineName(): nil
    local world = newWorld()
    local actor = newActor(world)
    local script = sequence.define(uniqueName("test.missingTimeline."), {
        sequence.playTween("test.neverCompiled", sequence.bind("actor")),
    })

    local handle = sequence.play(world, script, {bindings = {actor = actor}})
    world:update(1)

    local status = assert(sequence.status(world, handle))
    test.equal(status.state, "faulted")
    test.equal(status.fault, "unregisteredTween")
end

function suite.roundTripsACompiledTimelineThroughItsPlainDataForm(): nil
    local compiled = tweeneval.compile({
        tweeneval.to(1, "quadOut", "transform.xy", 3, 4),
        tweeneval.emit("half"),
        tweeneval.run({tweeneval.to(0.5, "linear", "color.a", 0)}, "loop", 2),
    })

    local restored = tweeneval.deserializeTimeline(tweeneval.serializeTimeline(compiled))

    test.equal(restored.totalDuration, compiled.totalDuration)
    test.equal(restored.stateSize, compiled.stateSize)
    test.equal(#restored.slots, 1)
    test.equal(restored.slots[1].easingName, "quadOut")
    test.equal(restored.slots[1].target.id, "transform.xy")
    test.equal(restored.slots[1].t2, 4)
    test.equal(#restored.emits, 1)
    test.equal(restored.emits[1].name, "half")
    test.equal(#restored.runs, 1)
    test.equal(restored.runs[1].passCount, 2)
    test.equal(restored.runs[1].timeline.slots[1].target.id, "color.a")
end

function suite.rejectsInvalidTimelineOperations(): nil
    test.raises(
        function(): nil
            tweeneval.compile({tweeneval.to(0, "linear", "transform.x", 1)})
        end,
        "greater than zero"
    )
    test.raises(
        function(): nil
            tweeneval.compile({tweeneval.wait(-1)})
        end,
        "at least zero"
    )
    test.raises(
        function(): nil
            tweeneval.compile({tweeneval.run({tweeneval.wait(1)}, "loop")})
        end,
        "finite count"
    )
    test.raises(
        function(): nil
            sequence.timeline("test.badTimelineClock", {}, {clock = "frame"})
        end,
        "clock must be"
    )
end

return suite
