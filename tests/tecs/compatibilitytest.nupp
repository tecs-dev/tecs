-------------------------------------------------------------------------------
-- Platform event kinds
--
-- A kind is what the debug server's `send_event` takes and what an event
-- payload carries in its `kind` field.
-------------------------------------------------------------------------------

function suite.platformEventNames(): nil
    local on = platformevents.on
    test.equal(on.quit.eventName, "tecs.platform.events.quit")
    test.equal(on.windowCloseRequested.eventName, "tecs.platform.events.windowCloseRequested")
    test.equal(on.windowResized.eventName, "tecs.platform.events.windowResized")
    test.equal(on.windowScaleChanged.eventName, "tecs.platform.events.windowScaleChanged")
    test.equal(on.windowFocusGained.eventName, "tecs.platform.events.windowFocusGained")
    test.equal(on.windowFocusLost.eventName, "tecs.platform.events.windowFocusLost")
    test.equal(on.keyDown.eventName, "tecs.platform.events.keyDown")
    test.equal(on.keyUp.eventName, "tecs.platform.events.keyUp")
    test.equal(on.mouseMotion.eventName, "tecs.platform.events.mouseMotion")
    test.equal(on.mouseDown.eventName, "tecs.platform.events.mouseDown")
    test.equal(on.mouseUp.eventName, "tecs.platform.events.mouseUp")
    test.equal(on.mouseWheel.eventName, "tecs.platform.events.mouseWheel")
    test.equal(on.textInput.eventName, "tecs.platform.events.textInput")
    test.equal(on.fingerDown.eventName, "tecs.platform.events.fingerDown")
    test.equal(on.fingerUp.eventName, "tecs.platform.events.fingerUp")
    test.equal(on.fingerMotion.eventName, "tecs.platform.events.fingerMotion")
    test.equal(on.fingerCanceled.eventName, "tecs.platform.events.fingerCanceled")
    test.equal(on.gamepadAdded.eventName, "tecs.platform.events.gamepadAdded")
    test.equal(on.gamepadRemoved.eventName, "tecs.platform.events.gamepadRemoved")
    test.equal(on.gamepadButtonDown.eventName, "tecs.platform.events.gamepadButtonDown")
    test.equal(on.gamepadButtonUp.eventName, "tecs.platform.events.gamepadButtonUp")
    test.equal(on.gamepadAxis.eventName, "tecs.platform.events.gamepadAxis")
end

function suite.platformEventKinds(): nil
    test.equal(platformevents.quit().kind, "quit")
    test.equal(platformevents.closeRequested().kind, "windowCloseRequested")
    test.equal(platformevents.resized(64, 48).kind, "windowResized")
    test.equal(platformevents.scaleChanged(2.0, 64, 48).kind, "windowScaleChanged")
    test.equal(platformevents.focused(true).kind, "windowFocusGained")
    test.equal(platformevents.focused(false).kind, "windowFocusLost")
    test.equal(platformevents.key(true, "KeyA").kind, "keyDown")
    test.equal(platformevents.key(false, "KeyA").kind, "keyUp")
    test.equal(platformevents.pointerMoved(1.0, 2.0).kind, "mouseMotion")
    test.equal(platformevents.pointerButton(true, 1, 1.0, 2.0).kind, "mouseDown")
    test.equal(platformevents.pointerButton(false, 1, 1.0, 2.0).kind, "mouseUp")
    test.equal(platformevents.wheel(0.0, 1.0).kind, "mouseWheel")
    test.equal(platformevents.text("a").kind, "textInput")
end

-------------------------------------------------------------------------------
-- Logger names
--
-- The unit a developer types into a filter, so it is configuration rather than
-- an identifier. Tecs no longer wraps logging: a module names its logger to
-- `nupp.log.named` directly, so the names live at those call sites and there
-- is no table here to compare against. `nupp.log` exposes no way to read the
-- registered names back, so this asserts the one thing it can: a name stamps
-- the line it is given to.
-------------------------------------------------------------------------------

function suite.aLoggerNameStampsItsLines(): nil
    local seen: {string} = {}
    local previousLevel = nupplog.level("debug")
    local previousSink = nupplog.sink(function(
        _severity: integer,
        module: string,
        _line: integer,
        _message: string
    ): nil
        seen[#seen + 1] = module
    end)
    nupplog.named("tecs.audio"):info("probe")
    nupplog.sink(previousSink)
    nupplog.level(previousLevel)
    test.equal(#seen, 1)
    test.equal(seen[1], "tecs.audio")
end

