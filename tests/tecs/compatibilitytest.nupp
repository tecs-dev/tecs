-------------------------------------------------------------------------------
-- System names
--
-- The debug server reports these and an agent selects on one, so a rename is a
-- broken tool call rather than a refactor.
-------------------------------------------------------------------------------

--- Returns every registered system name in the world, in execution order.
local function systemNames(world: ecs.World): {string}
    local reported = world:listSystems()
    local names: {string} = {}
    for index = 1, #reported do
        names[index] = reported[index].name
    end

    return names
end

function suite.audioSystemNames(): nil
    local world = ecs.newWorld()
    audio.install(world, {backend = silentBackend()})
    containsAll(systemNames(world), {"tecs.PlaySounds"})
end

function suite.sequenceSystemNames(): nil
    local world = ecs.newWorld()
    sequence.plugin(world)
    containsAll(systemNames(world), {"sequence.Advance", "sequence.AdvanceFrame", "sequence.AdvancePresentation"})
end

function suite.animationSystemNames(): nil
    local world = ecs.newWorld()
    animation.plugin(world)
    containsAll(systemNames(world), {"tecs.EncodeAnimation", "tecs.ReportAnimation"})
end

function suite.textSystemNames(): nil
    local world = ecs.newWorld()
    text.install(world)
    containsAll(systemNames(world), {"tecs.TextLayout"})
end

function suite.inputSystemNames(): nil
    local world = ecs.newWorld()
    input.install(world, gamepadbackend.none())
    containsAll(systemNames(world), {"tecs.PollGamepads", "tecs.EnterFixedInput", "tecs.ExitFixedInput"})
end

-------------------------------------------------------------------------------
-- Snapshot handler keys
--
-- `random.tl`'s restore falls through to reseeding when it finds no state, and
-- a handler whose key changed spelling loads that way rather than erroring.
-- That is what makes these absolute rather than preferred.
-------------------------------------------------------------------------------

--- Returns every snapshot data key the world writes, sorted.
local function snapshotKeys(world: ecs.World): {string}
    local snapshot = world:saveSnapshot()
    local keys: {string} = {}
    for index = 1, #snapshot.data do
        keys[index] = snapshot.data[index].key
    end
    table.sort(keys)

    return keys
end

function suite.audioSnapshotHandlerKey(): nil
    local world = ecs.newWorld()
    audio.install(world, {backend = silentBackend()})
    equalList(snapshotKeys(world), {"tecs.audio"})
end

function suite.sequenceSnapshotHandlerKey(): nil
    local world = ecs.newWorld()
    sequence.plugin(world)
    equalList(snapshotKeys(world), {"tecs.sequence"})
end

function suite.physicsSnapshotHandlerKey(): nil
    local world = ecs.newWorld()
    physics.install(world, {simulation = physicsreference.create().simulation})
    equalList(snapshotKeys(world), {"tecs.physics"})
end

-------------------------------------------------------------------------------
-- Snapshot payload keys
--
-- A component that writes something other than its own fields names the keys
-- it writes, and those travel in the file beside the component name.
-------------------------------------------------------------------------------

--- Returns the keys of one component's saved payload, sorted.
--- @param component the registered component whose codec to run
--- @param value the component value to save
--- @return the payload's keys, sorted
local function savedKeys(component: ecs.Component, value: any): {string}
    local saved = (component as {[string]: any}).snapshotSave as function(any): any
    local payload = saved(value) as {[string]: any}
    local keys: {string} = {}
    for key in pairs(payload) do
        keys[#keys + 1] = key
    end
    table.sort(keys)

    return keys
end

--- Loads `payload` back through a component's snapshot codec.
---
--- The payload is written with literal keys, so this is the half of the pin
--- that a save file actually exercises: a renamed key stops arriving and the
--- restored value falls back to its default.
--- @param component the registered component whose codec to run
--- @param payload the saved form, keyed exactly as a file holds it
--- @return the restored component value
local function loadPayload(component: ecs.Component, payload: {[string]: any}): {[string]: any}
    local load = (component as {[string]: any}).snapshotLoad as function(any): any

    return load(payload) as {[string]: any}
end

--- Asserts that every key in `values` appears in `allowed`.
---
--- A saved payload omits a key whose value is nil, which is how a sprite with
--- no resolvable image or a sound with no group is written, so the save side
--- is pinned as a subset and `loadPayload` pins the rest.
local function subsetOf(values: {string}, allowed: {string}): nil
    local permitted: {[string]: boolean} = {}
    for index = 1, #allowed do
        permitted[allowed[index]] = true
    end
    for index = 1, #values do
        test.assert(permitted[values[index]] == true, "unexpected saved key '" .. values[index] .. "'")
    end
end

function suite.spriteSnapshotKeys(): nil
    local keys: {string} = {"image", "u0", "u1", "v0", "v1"}
    subsetOf(savedKeys(gfx.Sprite, gfx.Sprite(0, 0.0, 0.0, 1.0, 1.0).value), keys)
    local restored = loadPayload(gfx.Sprite, {image = "", u0 = 0.125, v0 = 0.25, u1 = 0.5, v1 = 0.75})
    test.equal(restored.u0, 0.125)
    test.equal(restored.v0, 0.25)
    test.equal(restored.u1, 0.5)
    test.equal(restored.v1, 0.75)
end

function suite.materialSnapshotKeys(): nil
    materials.reset()
    equalList(savedKeys(gfx.Material, gfx.Material(0, 0.25).value), {"material", "param"})
    local restored = loadPayload(gfx.Material, {material = "circle", param = 0.5})
    test.equal(restored.id, materials.id("circle"))
    test.equal(restored.param, 0.5)
end

function suite.soundSnapshotKeys(): nil
    local keys: {string} = {"clip", "gain", "group", "loop", "pitch", "playing", "spatial", "x", "y", "z"}
    subsetOf(savedKeys(audio.SoundComponent, audio.SoundComponent().value), keys)
    local restored = loadPayload(audio.SoundComponent, {
        clip = "",
        playing = false,
        gain = 0.5,
        loop = true,
        pitch = 1.5,
        spatial = true,
        x = 1.0,
        y = 2.0,
        z = 3.0,
        group = "",
    })
    test.equal(restored.playing, false)
    test.equal(restored.gain, 0.5)
    test.equal(restored.loop, true)
    test.equal(restored.pitch, 1.5)
    test.equal(restored.spatial, true)
    test.equal(restored.x, 1.0)
    test.equal(restored.y, 2.0)
    test.equal(restored.z, 3.0)
end

function suite.animationSnapshotKeys(): nil
    local keys: {string} = {"loop", "playing", "sheet", "speed", "tag", "time"}
    subsetOf(savedKeys(gfx.Animation, gfx.Animation().value), keys)
    local restored = loadPayload(gfx.Animation, {
        sheet = "",
        tag = "",
        speed = 2.0,
        time = 0.5,
        loop = false,
        playing = false
    })
    test.equal(restored.speed, 2.0)
    test.equal(restored.time, 0.5)
    test.equal(restored.loop, false)
    test.equal(restored.playing, false)
end

function suite.textSnapshotKeys(): nil
    local keys: {string} = {"align", "font", "size", "text", "wrapWidth"}
    subsetOf(savedKeys(gfx.Text, gfx.Text("hello").value), keys)
    local restored = loadPayload(gfx.Text, {
        text = "hello",
        font = nil,
        size = 24.0,
        align = "center",
        wrapWidth = 80.0
    })
    test.equal(restored.text, "hello")
    test.equal(restored.size, 24.0)
    test.equal(restored.align, "center")
    test.equal(restored.wrapWidth, 80.0)
end

-------------------------------------------------------------------------------
-- MCP tool names and argument keys
--
-- An agent sends these in a JSON payload written against a build this tree
-- cannot see.
-------------------------------------------------------------------------------

function suite.mcpToolNames(): nil
    local tools = mcp.listTools()
    local names: {string} = {}
    for index = 1, #tools do
        names[index] = tools[index].name
    end
    table.sort(names)
    equalList(names, {
        "clear_crash",
        "components_info",
        "context",
        "despawn",
        "get_logs",
        "info",
        "modify",
        "ping",
        "query",
        "remove",
        "run_lua",
        "send_event",
        "set",
        "spawn",
        "states_info",
        "states_pop",
        "states_push",
        "stats",
        "systems_info",
        "systems_list",
        "systems_start",
        "systems_stop",
    })
end

--- Returns the property keys of one tool's input schema, sorted.
--- @param name the tool's registered name
--- @return the argument keys, sorted
--- @raises when no tool carries that name, because a missing tool is the
---     failure this suite exists to report
local function argumentKeys(name: string): {string}
    local tools = mcp.listTools()
    local keys: {string} = {}
    for index = 1, #tools do
        if tools[index].name == name then
            local schema = tools[index].inputSchema
            local properties = schema ~= nil and schema.properties as {[string]: any}? or nil
            if properties ~= nil then
                for key in pairs(properties) do
                    keys[#keys + 1] = key
                end
            end
            table.sort(keys)

            return keys
        end
    end

    error("no MCP tool named '" .. name .. "'", 2)
end

function suite.mcpArgumentKeys(): nil
    equalList(argumentKeys("get_logs"), {"after", "contains"})
    equalList(argumentKeys("run_lua"), {"code"})
    equalList(argumentKeys("components_info"), {})
    equalList(argumentKeys("query"), {"include", "limit", "values"})
    equalList(argumentKeys("info"), {"entity"})
    equalList(argumentKeys("spawn"), {"components"})
    equalList(argumentKeys("set"), {"component", "entity", "values"})
    equalList(argumentKeys("modify"), {"component", "entity", "values"})
    equalList(argumentKeys("remove"), {"component", "entity"})
    equalList(argumentKeys("despawn"), {"entity"})
    equalList(argumentKeys("systems_list"), {"disabled", "phase"})
    equalList(argumentKeys("systems_info"), {"name"})
    equalList(argumentKeys("systems_start"), {"name"})
    equalList(argumentKeys("systems_stop"), {"name"})
    equalList(argumentKeys("states_push"), {"name"})
end

function suite.sendEventArgumentKeys(): nil
    -- `kind`, `button`, `x`, `y`, `clicks`, `wheelX`, `wheelY`, `wheelTicksX`,
    -- `wheelTicksY`, `flipped`, `repeated` and `which` carry across from the
    -- SDL implementation. The rest are new with the `winit` boundary, and the
    -- SDL keys `scancode`, `penState`, `scale`, `recording`, `data1` and
    -- `data2` are gone with the events they described.
    equalList(argumentKeys("send_event"), {
        "axis",
        "button",
        "clicks",
        "dx",
        "dy",
        "finger",
        "flipped",
        "height",
        "kind",
        "logicalKey",
        "modifiers",
        "normalX",
        "normalY",
        "physicalKey",
        "pressure",
        "repeated",
        "scaleFactor",
        "text",
        "touchDevice",
        "value",
        "wheelTicksX",
        "wheelTicksY",
        "wheelX",
        "wheelY",
        "which",
        "width",
        "window",
        "x",
        "y",
    })
end

-------------------------------------------------------------------------------
-- Render pass and target names
--
-- A game places a pass of its own beside one of these by name.
-------------------------------------------------------------------------------

function suite.deferredTargetNames(): nil
    passes.reset()
    local declared = passes.targets()
    local names: {string} = {}
    for index = 1, #declared do
        names[index] = declared[index].name
    end
    equalList(names, {
        "albedo",
        "normal",
        "orm",
        "emission",
        "lit",
        "scene",
        "occluders",
        "occludersTemp",
        "dropShadowAO",
        "bloomA",
        "bloomB",
    })
end

function suite.deferredPassNames(): nil
    passes.reset()
    local declared = passes.passes()
    local names: {string} = {}
    for index = 1, #declared do
        names[index] = declared[index].name
    end
    equalList(names, {
        "geometry",
        "occluders",
        "occluderBlurH",
        "occluderBlurV",
        "dropShadowAO",
        "lighting",
        "bloomExtract",
        "bloomBlurX",
        "bloomBlurY",
        "composite",
        "forward",
        "present",
    })
end

function suite.depthTargetNameIsReserved(): nil
    passes.reset()
    -- Not a declared target, and the graph refuses to let one take the name.
    test.raises(
        function(): nil
            passes.declareTarget({name = "depth", format = "rgba8"})
        end,
        "depth"
    )
end

-------------------------------------------------------------------------------
-- Material names
--
-- A snapshot writes a material by name, because an id holds only for the file
-- set one build was made from.
-------------------------------------------------------------------------------

function suite.builtinMaterialNames(): nil
    materials.reset()
    test.equal(materials.DEFAULT, "textured")
    test.equal(materials.id("textured"), 0)
    equalList(materials.names(), {
        "textured",
        "capsule",
        "circle",
        "ellipse",
        "emissive",
        "frame",
        "glyph",
        "glyphalpha",
        "line",
        "pie",
        "ring",
        "rounded",
        "star",
        "triangle",
    })
end

-------------------------------------------------------------------------------
-- Layer configuration
--
-- A sort mode is a string a game writes into a layer's configuration.
-------------------------------------------------------------------------------

function suite.layerSortNames(): nil
    layers.configure(1, {sort = "topdown"})
    layers.configure(2, {sort = "z"})
    layers.configure(3, {sort = "isometric"})
    test.equal(layers.SORT_TOPDOWN, 0)
    test.equal(layers.SORT_Z, 1)
    test.equal(layers.SORT_ISOMETRIC, 2)
    test.raises(
        function(): nil
            layers.configure(4, {sort = "topDown" as layers.Sort})
        end,
        "sort mode"
    )
end

-------------------------------------------------------------------------------
-- Asset content kinds
--
-- A file-watching filter and the debug tools name a kind.
-------------------------------------------------------------------------------

function suite.contentKindNames(): nil
    test.equal(assets.DOCUMENT, "document")
    test.equal(assets.IMAGE, "image")
    test.equal(assets.SOUND, "sound")
    test.equal(assets.MODEL, "model")
    -- New with the rewrite: the SDL tree noted no font or shader content.
    test.equal(assets.FONT, "font")
    test.equal(assets.SHADER, "shader")
end

-------------------------------------------------------------------------------
-- Input vocabulary
--
-- A game persists a binding by name, so a button name is a save-file string
-- rather than an identifier.
-------------------------------------------------------------------------------

--- Returns `value`, so a literal the union no longer admits fails
--- `nupp check --strict` at this call rather than passing through as a string.
--- @param value one gamepad button name
--- @return the same name
local function gamepadButton(value: input.GamepadButton): string
    return value as string
end

--- Returns `value`, pinning one gamepad axis name the same way.
--- @param value one gamepad axis name
--- @return the same name
local function gamepadAxis(value: input.GamepadAxis): string
    return value as string
end

function suite.gamepadButtonNames(): nil
    equalList(
        {
            gamepadButton("south"),
            gamepadButton("east"),
            gamepadButton("west"),
            gamepadButton("north"),
            gamepadButton("back"),
            gamepadButton("guide"),
            gamepadButton("start"),
            gamepadButton("leftStick"),
            gamepadButton("rightStick"),
            gamepadButton("leftShoulder"),
            gamepadButton("rightShoulder"),
            gamepadButton("dpadUp"),
            gamepadButton("dpadDown"),
            gamepadButton("dpadLeft"),
            gamepadButton("dpadRight"),
        },
        {
            "south",
            "east",
            "west",
            "north",
            "back",
            "guide",
            "start",
            "leftStick",
            "rightStick",
            "leftShoulder",
            "rightShoulder",
            "dpadUp",
            "dpadDown",
            "dpadLeft",
            "dpadRight",
        }
    )
end

function suite.gamepadAxisNames(): nil
    equalList(
        {
            gamepadAxis("leftX"),
            gamepadAxis("leftY"),
            gamepadAxis("rightX"),
            gamepadAxis("rightY"),
            gamepadAxis("leftTrigger"),
            gamepadAxis("rightTrigger"),
        },
        {"leftX", "leftY", "rightX", "rightY", "leftTrigger", "rightTrigger"}
    )
end

function suite.mouseButtonNames(): nil
    local state = input.newInput(gamepadbackend.none())
    test.equal(state:mouseDown("left"), false)
    test.equal(state:mouseDown("middle"), false)
    test.equal(state:mouseDown("right"), false)
    -- `winit` spells these `Back` and `Forward` where SDL spelled them `x1`
    -- and `x2`. A device vocabulary follows the library reporting it, so this
    -- records a deliberate break rather than a name to preserve. The numeric
    -- codes four and five did not move, which is why both still answer.
    test.equal(state:mouseDown("back"), false)
    test.equal(state:mouseDown("forward"), false)
    test.equal(state:mouseDown(4), false)
    test.equal(state:mouseDown(5), false)
end

-------------------------------------------------------------------------------
-- Physics vocabulary and wire numbering
--
-- The body kind and collider shape names reach the engine from a game, and the
-- integers behind them are what a component column holds and a snapshot writes.
-------------------------------------------------------------------------------

function suite.physicsBodyAndShapeNumbering(): nil
    test.equal(physicscontract.BODY_STATIC, 0)
    test.equal(physicscontract.BODY_KINEMATIC, 1)
    test.equal(physicscontract.BODY_DYNAMIC, 2)
    test.equal(physicscontract.SHAPE_BOX, 0)
    test.equal(physicscontract.SHAPE_CIRCLE, 1)
    test.equal(physicscontract.SHAPE_CAPSULE, 2)
end

-------------------------------------------------------------------------------
-- Sequencing
--
-- A program's bytecode travels in a save file, so the opcode numbers are as
-- persisted as any string here. So is the evaluator name a suspended playback
-- records, and the easing and target names a timeline's constant pool holds.
-------------------------------------------------------------------------------

function suite.sequenceOpcodeNumbering(): nil
    test.equal(sequenceprogram.WAIT, 1)
    test.equal(sequenceprogram.CALL, 2)
    test.equal(sequenceprogram.EMIT, 3)
    test.equal(sequenceprogram.JUMP, 4)
    test.equal(sequenceprogram.END, 5)
    test.equal(sequenceprogram.WAIT_SIGNAL, 6)
    test.equal(sequenceprogram.FORK, 7)
    test.equal(sequenceprogram.JOIN, 8)
    test.equal(sequenceprogram.WAIT_QUERY, 9)
    test.equal(sequenceprogram.PLAY_TWEEN, 10)
    test.equal(sequenceprogram.WAIT_TWEEN, 11)
    test.equal(sequenceprogram.EVAL, 12)
    test.equal(sequenceprogram.AWAIT, 13)
    test.equal(sequenceprogram.STRIDE, 3)
end

function suite.tweenEvaluatorName(): nil
    test.equal(tweenrun.EVALUATOR, "tecs.tween")
end

function suite.easingNames(): nil
    test.assert(sequence.easing("linear") ~= nil)
    test.assert(sequence.easing("quadIn") ~= nil)
    test.assert(sequence.easing("quadOut") ~= nil)
    test.assert(sequence.easing("quadInOut") ~= nil)
    test.assert(sequence.easing("quadOutIn") ~= nil)
    test.assert(sequence.easing("cubicIn") ~= nil)
    test.assert(sequence.easing("cubicOut") ~= nil)
    test.assert(sequence.easing("cubicInOut") ~= nil)
    test.assert(sequence.easing("cubicOutIn") ~= nil)
    test.assert(sequence.easing("quartIn") ~= nil)
    test.assert(sequence.easing("quartOut") ~= nil)
    test.assert(sequence.easing("quartInOut") ~= nil)
    test.assert(sequence.easing("quartOutIn") ~= nil)
    test.assert(sequence.easing("quintIn") ~= nil)
    test.assert(sequence.easing("quintOut") ~= nil)
    test.assert(sequence.easing("quintInOut") ~= nil)
    test.assert(sequence.easing("quintOutIn") ~= nil)
    test.assert(sequence.easing("sineIn") ~= nil)
    test.assert(sequence.easing("sineOut") ~= nil)
    test.assert(sequence.easing("sineInOut") ~= nil)
    test.assert(sequence.easing("sineOutIn") ~= nil)
    test.assert(sequence.easing("expoIn") ~= nil)
    test.assert(sequence.easing("expoOut") ~= nil)
    test.assert(sequence.easing("expoInOut") ~= nil)
    test.assert(sequence.easing("expoOutIn") ~= nil)
    test.assert(sequence.easing("backIn") ~= nil)
    test.assert(sequence.easing("backOut") ~= nil)
    test.assert(sequence.easing("backInOut") ~= nil)
    test.assert(sequence.easing("backOutIn") ~= nil)
    test.assert(sequence.easing("elasticIn") ~= nil)
    test.assert(sequence.easing("elasticOut") ~= nil)
    test.assert(sequence.easing("elasticInOut") ~= nil)
    test.assert(sequence.easing("elasticOutIn") ~= nil)
    test.assert(sequence.easing("bounceIn") ~= nil)
    test.assert(sequence.easing("bounceOut") ~= nil)
    test.assert(sequence.easing("bounceInOut") ~= nil)
    test.assert(sequence.easing("bounceOutIn") ~= nil)
end

function suite.tweenTargetNames(): nil
    test.assert(tweeneval.resolveTarget("transform.x") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.y") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.xy") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.rotation") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.rotationShortest") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.scaleX") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.scaleY") ~= nil)
    test.assert(tweeneval.resolveTarget("transform.scaleXY") ~= nil)
    test.assert(tweeneval.resolveTarget("color.rgba") ~= nil)
    test.assert(tweeneval.resolveTarget("color.a") ~= nil)
end

return suite
