--[[
Pins every externally typed string the ported tree declares.

A save file written last year, a filter a developer types into a shell, a JSON
payload an agent sends, and a pass a game inserts by name all reach these
strings from outside the tree. Nothing here can see those call sites, so nothing
here may move them: `AGENTS.md` states the rule, and this suite is what holds
the tree to it.

Every assertion compares a literal against the value a module publishes, never
against another identifier. `test.equal(ecs.EntityKey.componentName, "Key")`
fails when someone tidies the spelling and passes when someone renames the Lua
binding, which is the only shape that distinguishes the two.

Read this file as the specification of the compatibility surface. A name that
belongs to a subsystem the rewrite has not ported yet is absent here and
recorded in the migration plan instead, so the set below is what the tree
actually carries rather than what it eventually should.
]]

local test = require("nupp.test")

local assets = require("tecs.assets")
local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local ecs = require("tecs.ecs")
local animation = require("tecs.gfx.animation")
local gamepadbackend = require("tecs.platform.gamepadbackend")
local gfx = require("tecs.gfx")
local input = require("tecs.input")
local layers = require("tecs.gfx.layers")
local nupplog = require("nupp.log")
local materials = require("tecs.gpu.materials")
local mcp = require("tecs.mcp")
local passes = require("tecs.gpu.passes")
local physics = require("tecs.physics")
local physicscontract = require("tecs.physics.contract")
local platformevents = require("tecs.platform.events")
local sequence = require("tecs.sequence")
local text = require("tecs.gfx.text")

-- Internal modules carry three surfaces no public name reaches: the sequence
-- bytecode's opcode numbering, the tween evaluator's registered name, and the
-- tween target vocabulary. That is why the suite lives under `tests/tecs`.
local components = require("tecs.internal.components")
local phases = require("tecs.internal.phases")
local sequenceprogram = require("tecs.internal.sequenceprogram")
local tweeneval = require("tecs.internal.tweeneval")
local tweenrun = require("tecs.internal.tweenrun")

-- The reference simulation, so installing physics names its snapshot handler
-- and its systems with no native solver present.
local physicsreference = require("physicsreference")

local suite = {}

-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------

--- Asserts that `values` holds exactly `expected`, in order.
local function equalList(values: {string}, expected: {string}): nil
    test.equal(#values, #expected, "the list has " .. tostring(#values) .. " entries")
    for index = 1, #expected do
        test.equal(values[index], expected[index])
    end
end

--- Asserts that every name in `expected` appears in `values`.
---
--- Used where a process-wide registry may legitimately hold more than the
--- engine's own entries, so exact equality would fail on a game's additions
--- rather than on a rename.
local function containsAll(values: {string}, expected: {string}): nil
    local present: {[string]: boolean} = {}
    for index = 1, #values do
        present[values[index]] = true
    end
    for index = 1, #expected do
        test.assert(present[expected[index]] == true, "missing '" .. expected[index] .. "'")
    end
end

--- Asserts that a component registered under `name` carries that exact name.
---
--- Reaching the registry by the literal proves the string is what a snapshot
--- would write, and reading `componentName` back proves the registry is not
--- answering under an alias.
local function registeredAs(name: string): nil
    local component = components.findByName(name)
    test.assert(component ~= nil, "no component registered as '" .. name .. "'")
    test.equal(assert(component).componentName, name)
end

--- A device-free audio backend, so installing a mixer names its systems and its
--- snapshot handler without opening an output.
local function silentBackend(): audiobackend.Backend
    return new audiobackend.Backend(
        available = false,
        frequency = 48000,
        channels = 2,
        submit = function(_commands: {audiobackend.Command}, _count: integer): nil
        end,
        drain = function(_out: {integer}): integer
            return 0
        end,
        loadClip = function(
            _path: string,
            _clip: integer,
            _mode: audiobackend.LoadMode,
            _streamSeconds: number
        ): (audiobackend.ClipInfo?, string?)
            return nil, "the compatibility suite loads no clips"
        end,
        releaseClip = function(_clip: integer): nil
        end,
        position = function(_handle: integer): number?
            return nil
        end,
        seek = function(_handle: integer, _seconds: number): boolean
            return false
        end,
        decoders = function(): {string}
            return {}
        end,
        close = function(): nil
        end
    )
end

