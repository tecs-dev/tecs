-- Component, relationship, and event names
--
-- A snapshot names components by string, so these are the strings a save file
-- from an earlier build holds.
-------------------------------------------------------------------------------

function suite.ecsBuiltinComponentNames(): nil
    -- `EntityKey` is the public binding and `Key` is the registered name. The
    -- two differ deliberately, and the registered one is what persists.
    test.equal(ecs.EntityKey.componentName, "Key")
    test.equal(ecs.Paused.componentName, "Paused")
    test.equal(ecs.Disabled.componentName, "Disabled")
    test.equal(ecs.Transform2D.componentName, "Transform2D")
end

