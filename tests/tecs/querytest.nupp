const ecs = require("tecs.ecs")
const {type QueryDescriptor} = require("tecs.ecs")
const {type Archetype} = require("tecs.ecs")

local archetype = require("tecs.internal.archetype")
local components = require("tecs.internal.components")
local query = require("tecs.internal.query")
local suite = {}

function suite.matchesIncludeAndExcludeConstraints(): nil
    local visible = components.newTagComponent({name = "test.QueryVisible"})
    local hidden = components.newTagComponent({name = "test.QueryHidden"})
    local value = query.new({include = {visible}, exclude = {hidden}})
    assert(query.matches(value, archetype.new(1, {visible})))
    assert(not query.matches(value, archetype.new(2, {})))
    assert(not query.matches(value, archetype.new(3, {visible, hidden})))
end

function suite.iteratesOnlyNonemptyMatches(): nil
    local tag = components.newTagComponent({name = "test.QueryIteration"})
    local value = query.new({include = {tag}})
    local empty = archetype.new(1, {tag})
    local populated = archetype.new(2, {tag})
    populated.entities[1] = 41
    populated.entities[2] = 42
    query.addArchetype(value, empty)
    query.addArchetype(value, populated)

    local seen: integer = 0
    for candidate, count in value:iter() do
        assert(candidate == populated)
        assert.eq(count, 2)
        seen = seen + 1
    end
    assert.eq(seen, 1)
end

local record QueryPoint
    x: number
end

function suite.exposesTypedRawColumnsOnMatchingArchetypes(): nil
    local position = components.newComponent({
        name = "test.QueryPosition",
        construct = function(x: number): QueryPoint
            return QueryPoint(x = x)
        end,
        default = function(): QueryPoint
            return QueryPoint(x = 0)
        end
    })
    local candidate = archetype.new(1, {position})
    archetype.append(candidate, 7, {[position.componentId] = QueryPoint(x = 11)})
    local positions: {QueryPoint} = assert(candidate:get(position))
    assert.eq(positions[1].x, 11)
end

function suite.restoresAutomaticStateFilteringWithoutMutatingDescriptors(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.QueryStateTag"})
    world:spawn(tag)
    world:spawn(tag, ecs.Paused)
    world:spawn(tag, ecs.Disabled)
    world:commit()
    const descriptor: QueryDescriptor = {include = {tag}}
    assert.eq(world:newQuery(descriptor):count(), 2)
    assert(descriptor.exclude == nil)
    assert.eq(world:newQuery({type = "logic", include = {tag}}):count(), 1)
    assert.eq(world:newQuery({type = "render", include = {tag}}):count(), 2)
    assert.eq(world:newQuery({include = {tag, ecs.Disabled}}):count(), 1)
    assert.eq(world:newQuery({type = "logic", include = {tag, ecs.Paused}}):count(), 1)
end

function suite.groupsOrMatchesAndKeepsNestedIteratorsIndependent(): nil
    const world = ecs.newWorld()
    const first = ecs.newTagComponent({name = "test.QueryGroupFirst"})
    const second = ecs.newTagComponent({name = "test.QueryGroupSecond"})
    const grouped = world:newQuery({
        includeAny = {first, second},
        groupBy = function(candidate: Archetype): integer
            return archetype.has(candidate, first) and -2 or 7
        end
    })
    world:spawn(second)
    const firstEntity = world:spawn(first)
    world:spawn(first, second)
    world:spawn()
    world:commit()
    assert.eq(grouped:count(), 3)
    assert.eq(grouped:getGroupCount(-2), 2)
    assert.eq(grouped:getGroupCount(99), 0)
    const groups, groupState = grouped:groups()
    assert.eq(groups(groupState, nil) as integer, -2)
    assert.eq(groups(groupState, -2) as integer, 7)
    assert(groups(groupState, 7) == nil)
    local nested: integer = 0
    for candidate, count, entities in grouped:iter() do
        assert.eq(#assert(entities), count as integer)
        assert(grouped:getGroup(assert(candidate)) ~= nil)
        for _inner, innerCount in grouped:iter() do
            nested = nested + (innerCount as integer)
        end
    end
    assert.eq(nested, 9)
    const left, leftState = grouped:group(-2)
    const right, rightState = grouped:group(7)
    const leftFirst = left(leftState, nil)
    const rightFirst = right(rightState, nil)
    assert(leftFirst ~= nil)
    assert(rightFirst ~= nil)
    assert(left(leftState, leftFirst) ~= nil)
    assert(right(rightState, rightFirst) == nil)
    world:despawn(firstEntity)
    world:commit()
    assert.eq(grouped:getGroupCount(-2), 1)
end

function suite.reportsOnlyQueryMembershipTransitionsWithReadableRows(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.QueryObserved"})
    const extra = ecs.newTagComponent({name = "test.QueryObservedExtra"})
    const first = world:spawn(tag)
    world:commit()
    local added, removed = 0, 0
    world:newQuery({
        include = {tag},
        onEntitiesAdded = function(candidate: Archetype, start: integer, last: integer, count: integer): nil
            assert.eq(last - start + 1, count)
            assert(world:isAlive(candidate.entities[start]))
            added = added + count
        end,
        onEntitiesRemoved = function(candidate: Archetype, start: integer, last: integer, count: integer): nil
            assert.eq(last - start + 1, count)
            assert(world:has(candidate.entities[start], tag))
            removed = removed + count
        end
    })
    assert.eq(added, 1)
    world:set(first, extra)
    world:commit()
    assert.eq(added, 1)
    assert.eq(removed, 0)
    world:remove(first, tag)
    world:commit()
    assert.eq(removed, 1)
    world:set(first, tag)
    world:commit()
    assert.eq(added, 2)
    world:despawn(first)
    world:commit()
    assert.eq(removed, 2)
end

function suite.temporaryQueriesFreezeArchetypesButReadLiveRows(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.QueryTemporary"})
    const extra = ecs.newTagComponent({name = "test.QueryTemporaryExtra"})
    world:spawn(tag)
    world:commit()
    const frozen = world:newQuery({include = {tag}, temp = true})
    world:spawn(tag)
    world:spawn(tag, extra)
    world:commit()
    assert.eq(frozen:count(), 2)
    assert.eq(world:newQuery({include = {tag}}):count(), 3)
    assert.raises(
        function(): nil
            world:newQuery({
                temp = true,
                onEntitiesAdded = function(_candidate: Archetype, _first: integer, _last: integer, _count: integer): nil
                end
            })
        end,
        "temporary queries"
    )
end

function suite.observersCanStageWorkAndInitialCallbacksCanPublishNewArchetypes(): nil
    const world = ecs.newWorld()
    const tag = ecs.newTagComponent({name = "test.QueryReentrant"})
    const extra = ecs.newTagComponent({name = "test.QueryReentrantExtra"})
    world:spawn(tag)
    world:commit()
    local calls = 0
    const observed = world:newQuery({
        include = {tag},
        onEntitiesAdded = function(_candidate: Archetype, _first: integer, _last: integer, _count: integer): nil
            calls = calls + 1
            if calls == 1 then
                world:spawn(tag, extra);
                world:commit()
            end
        end
    })
    assert.eq(calls, 2)
    assert.eq(observed:count(), 2)
end

function suite.stagesObserverMutationsAgainstTheDestinationSignature(): nil
    const world = ecs.newWorld()
    const leaving = ecs.newTagComponent({name = "test.QueryLeavingMutation"})
    const added = ecs.newTagComponent({name = "test.QueryAddedMutation"})
    const id = world:spawn(leaving)
    world:commit()
    world:newQuery({
        include = {leaving},
        onEntitiesRemoved = function(candidate: Archetype, first: integer, _last: integer, _count: integer): nil
            world:set(candidate.entities[first], added)
        end
    })
    world:remove(id, leaving)
    world:commit()
    assert(not world:has(id, leaving))
    assert(world:has(id, added))
end

return suite
