const {type Key} = require("nupp.util")
const util = require("nupp.util")

local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local physics = require("tecs.physics")
local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local mcp = require("tecs.mcp")
local application = require("tecs.application")
local screenshot = require("tecs.gfx.screenshot")
local registry = require("tecs.internal.mcpregistry")
local schemas = require("tecs.internal.mcpschemas")
local entityworld = require("tecs.internal.world")
local json = require("nupp.codec.json")
local files = require("nupp.io.files")
local test = require("nupp.test")
local suite = {}

-- The snapshot tools write under the application data root, which
-- `nupp.io.files` resolves from a process-wide identity. A host names one
-- through `tecs.application`; a suite that binds a world without an application
-- names it here.
if files.applicationIdentity() == nil then
    files.setApplicationIdentity("tecs", "tecs")
end

local function call(name: string, arguments: {[string]: any}?): any
    local reply = json.decode(
        mcp.dispatch(
            json.encode({
                jsonrpc = "2.0",
                id = 1,
                method = "tools/call",
                params = {name = name, arguments = arguments or json.EMPTY_OBJECT}
            })
        )
    )

    return reply.result
end

local function content(name: string, arguments: {[string]: any}?): any
    local result = call(name, arguments)
    test.assert(result.isError == nil, name .. ": " .. tostring(result.content[1].text))
    return result.structuredContent
end

local function equalTree(actual: any, expected: any): nil
    test.equal(type(actual), type(expected))
    if type(expected) ~= "table" then
        test.equal(actual, expected)
        return
    end
    for key, value in pairs(expected) do
        equalTree(actual[key], value)
    end
    for key in pairs(actual) do
        test.assert(expected[key] ~= nil, "unexpected schema key: " .. tostring(key))
    end
end

function suite.restoredInputSchemasMatchTheHistoricalWireListing(): nil
    local historical = json.decode(assert(files.read("tests/fixtures/mcp/historical-tools.json")))
    local checked = 0
    for _, tool in ipairs(historical.tools) do
        if schemas.inputs[tool.name] ~= nil then
            equalTree(schemas.inputs[tool.name], tool.inputSchema)
            local found = registry.findTool(tool.name)
            assert(found ~= nil, "missing restored tool " .. tool.name)
            equalTree(found.inputSchema, tool.inputSchema)
            checked = checked + 1
        end
    end
    test.equal(checked, 22)
    for _, name in ipairs({"sample_pixels", "reload_shaders", "reload_image", "watch", "physics_debug"}) do
        test.equal(registry.findTool(name), nil)
    end
end

function suite.inspectionReadsCommittedArchetypesAndAnonymousResources(): nil
    local world = ecs.newWorld()
    local entity = world:spawn(gfx.Camera2D(3, 4))
    world:commit()
    local key: Key<string> = util.newKey("test.mcp.resource")
    local anonymous: Key<integer> = util.newKey(nil)
    world.resources:set(key, "data")
    world.resources:set(anonymous, 4)
    mcp.bind(world)
    local listed = content("archetypes_list")
    test.assert(listed.total > 0)
    local info = content("archetypes_info", {id = listed.archetypes[1].id})
    test.assert(info.entities > 0)
    local resources = content("resources_list")
    test.equal(resources.total, 2)
    test.equal(content("resources_info", {name = "test.mcp.resource"}).present, true)
    test.equal(content("resources_info", {name = "missing"}).present, false)
    local detached = entityworld.inspectArchetypes(world)
    detached[1].components[1] = "changed"
    test.assert(content("archetypes_list").archetypes[1].components[1] ~= "changed")
    world:despawn(entity)
    world:commit()
    test.equal(content("archetypes_list").total, 0)
    test.assert(content("archetypes_list", {empty = true}).total > 0)
    mcp.bind(nil)
end

function suite.cameraMovementUsesTheRenderersSelectedEntity(): nil
    local world = ecs.newWorld()
    world:spawn(gfx.Camera2D(1, 2))
    local selected = world:spawn(gfx.Camera2D(10, 20, 2, 0.5), gfx.ActiveCamera)
    world:spawn(gfx.Camera2D(30, 40), gfx.ActiveCamera)
    world:commit()
    mcp.bind(world)
    test.equal(content("camera_info").entity, selected)
    local moved = content("camera_move", {x = 50, zoom = 3})
    test.equal(moved.x, 50)
    test.equal(moved.y, 20)
    test.equal(moved.zoom, 3)
    test.equal(call("camera_move", {zoom = 0}).isError, true)
    test.equal(call("camera_move", {extra = true}).isError, true)
    test.equal(content("render_info").observations.gpuCounters, false)
    test.equal(content("layers_list").total, 16)
    test.equal(content("layers_info", {layer = 1}).layer, 1)
    test.equal(call("layers_info", {layer = 1.5}).isError, true)
    mcp.bind(nil)
end

function suite.discoveryDescribesFamiliesAndRemainsAvailableAfterCrash(): nil
    local contract = content("describe", {command = "snapshot"})
    test.equal(#contract.verbs, 2)
    test.equal(content("help", {command = "camera"}).command.name, "camera")
    test.equal(content("capabilities").tools, #mcp.listTools())
    mcp.setCrashed("test failure")
    test.assert(#content("help").sections > 0)
    test.equal(call("physics_info").isError, true)
    mcp.setCrashed(nil)
end

function suite.realPhysicsInspectionAndRaycast(): nil
    local world = ecs.newWorld()
    physics.install(world, {gravity = {0, 0}})
    local body = world:spawn(ecs.Transform2D(20, 20), physics.Body(0), physics.Collider(0, 5, 5))
    world:update(1 / 60)
    mcp.bind(world)
    test.equal(content("physics_info").bodies, 1)
    local hit = content("physics_raycast", {x1 = 0, y1 = 20, x2 = 40, y2 = 20})
    test.equal(hit.hit, true)
    test.equal(hit.entity, body)
    local saved = content("snapshot_save", {name = "mcp-contract-rapier-test.bin"})
    world:despawn(body)
    world:update(1 / 60)
    test.equal(content("physics_info").bodies, 0)
    content("snapshot_load", {path = saved.path})
    world:update(1 / 60)
    test.equal(content("physics_info").bodies, 1)
    test.equal(content("physics_raycast", {x1 = 0, y1 = 20, x2 = 40, y2 = 20}).entity, body)
    assert(files.remove(saved.path))
    world:shutdown()
    mcp.bind(nil)
end

function suite.snapshotToolRoundTripPreservesBinaryHandlerDataAndNumericKeys(): nil
    local world = ecs.newWorld()
    local restored: any = nil
    world:addSnapshotHandler({
        name = "test.mcp.binary",
        save = function(exclusive _world: ecs.World): any
            return {[0] = "\0\255\128", [4.5] = false}
        end,
        load = function(exclusive _world: ecs.World, value: any): nil
            restored = value
        end
    })
    local entity = world:spawn(ecs.Name("saved"))
    world:commit()
    mcp.bind(world)
    local name = "mcp-contract-snapshot-test.bin"
    local saved = content("snapshot_save", {name = name})
    test.equal(saved.format, "binary")
    world:despawn(entity)
    world:commit()
    local loaded = content("snapshot_load", {path = saved.path})
    test.equal(loaded.entities, 1)
    test.equal(restored[0], "\0\255\128")
    test.equal(restored[4.5], false)
    test.equal(world:get(entity, ecs.Name), "saved")
    test.equal(call("snapshot_save", {name = "../escape.bin"}).isError, true)
    assert(files.write(saved.path, "invalid"))
    test.equal(call("snapshot_load", {path = saved.path}).isError, true)
    test.equal(world:getStats().entities, 1)
    assert(files.remove(saved.path))
    mcp.bind(nil)
end

function suite.audioInspectionUsesTheWorldMixer(): nil
    local world = ecs.newWorld()
    mcp.bind(world)
    test.equal(content("audio").installed, false)
    local mixer = audio.install(world, {backend = audiobackend.silent()})
    test.equal(content("audio").available, false)
    test.equal(content("audio").installed, true)
    test.equal(call("reload_sound", {path = "not-loaded.wav"}).isError, true)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.audioToolsPlayAndReloadASoundTheMixerKnows(): nil
    local world = ecs.newWorld()
    mcp.bind(world)
    local backend = audiobackend.silent(48000)
    backend.available = true
    backend.registerDecoder = function(_vtable: any): (integer?, string?)
        return 3
    end
    local mixer = audio.install(world, {backend = backend})
    test.equal(#content("audio").decoders, 0)
    local reloads = {0}
    local sound = new audio.Sound(
        name = "mcp/known.wav",
        duration = 1,
        decoder = "test",
        vtable = function(): any
            return nil
        end,
        params = "",
        bytes = "",
        reload = function(): (boolean, string?)
            reloads[1] = reloads[1] + 1

            return true
        end
    )
    test.equal(call("audio_play", {path = sound.name}).isError, true, "nothing has added it yet")
    mixer:addSound(sound)
    test.equal(content("audio_play", {path = sound.name}).started, true)
    local report = content("audio")
    test.equal(#report.decoders, 1)
    test.equal(report.decoders[1], "test")
    test.equal(content("reload_sound", {path = sound.name}).reloaded, true)
    test.equal(reloads[1], 1)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.audioToolsReportAndDriveTheConsoleOnAMemoryOutput(): nil
    local loaded = pcall(require, "tecs.platform.audionative")
    if not loaded then
        test.skip("libtecsaudio is not on the loader path")
    end
    local world = ecs.newWorld()
    mcp.bind(world)
    local mixer = audio.install(world, {output = "memory"})
    mixer:bus("sfx")
    local line = mixer:timeline({tempo = 90})
    local snapshot = content("audio_snapshot")
    test.equal(snapshot.output.state, "offline")
    test.equal(#snapshot.buses, 2, "Master and sfx")
    test.equal(snapshot.buses[1].name, "master")
    test.equal(snapshot.buses[1].effects[1].name, "limiter")
    test.equal(snapshot.timelines[1].tempo, 90)
    test.equal(content("audio_control", {bus = "sfx", gain = 0.5, muted = true}).gain, 0.5)
    test.assert(mixer:bus("sfx"):muted())
    test.equal(content("audio_timeline", {index = 1, action = "pause"}).paused, true)
    test.assert(line:paused())
    test.equal(content("audio_step", {seconds = 0.25}).rendered, 0.25)
    test.equal(content("audio_listen", {seconds = 0.1}).listening, true)
    content("audio_step", {seconds = 0.1})
    test.equal(content("audio_listening").frames, 4800)
    test.equal(call("audio_play", {path = "never-loaded.wav"}).isError, true)
    test.equal(#content("audio_events").events, 0)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.profileToolsWriteAReportAndCanStartAgain(): nil
    content("profile_start", {intervalMs = 1, zone = "test-never-entered"})
    test.equal(call("profile_start").isError, true)
    local report = content("profile_stop", {name = "mcp-contract-profile-test.collapsed"})
    test.equal(report.samples, 0)
    test.equal(assert(files.read(report.path)), "")
    assert(files.remove(report.path))
    test.equal(call("profile_stop").isError, true)
end

--- Builds a bound application whose Update system counts frames and records
--- whether Space was pressed on each.
local function steppedApplication(): (application.Application, {number}, {boolean})
    local deltas: {number} = {}
    local pressed: {boolean} = {}
    local app = application.newApplication({
        plugin = function(exclusive running: application.Application): nil
            const input = running.input
            running.world:addSystem({
                name = "test.mcp.clock",
                phase = ecs.phases.Update,
                run = function(dt: number): nil
                    deltas[#deltas + 1] = dt
                    pressed[#pressed + 1] = input:keyPressed("Space")
                end
            })
        end
    })
    app:init()
    mcp.bind(app.world, app)

    return app, deltas, pressed
end

function suite.clockToolsPauseStepAndResumeTheSimulation(): nil
    local app, deltas, pressed = steppedApplication()
    app:iterate(0.5, nil)

    local info = content("clock_info")
    test.equal(info.paused, false)
    test.equal(info.settled, false)
    test.equal(info.frame, 1)
    test.equal(call("clock_step").isError, true)

    test.equal(content("clock_pause").paused, true)
    content("send_event", {kind = "keyDown", physicalKey = "Space", logicalKey = " "})
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    test.equal(#deltas, 1)
    info = content("clock_info")
    test.equal(info.settled, true)
    test.equal(info.pendingEvents, 1)

    local stepped = content("clock_step", {frames = 2, dt = 0.125})
    test.equal(stepped.pendingSteps, 2)
    test.equal(stepped.stepDt, 0.125)
    test.equal(stepped.settled, false)
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    test.equal(#deltas, 3)
    test.equal(deltas[2], 0.125)
    test.equal(deltas[3], 0.125)
    test.assert(pressed[2])
    test.assert(not pressed[3])
    info = content("clock_info")
    test.equal(info.frame, 3)
    test.equal(info.elapsed, 0.75)
    test.equal(info.settled, true)

    test.equal(call("clock_step", {frames = 1.5}).isError, true)
    test.equal(call("clock_step", {dt = 0}).isError, true)
    test.equal(call("clock_step", {frames = 0}).isError, true)

    content("clock_step", {frames = 4})
    test.equal(content("clock_resume").paused, false)
    test.equal(content("clock_info").pendingSteps, 0)
    app:iterate(0.5, nil)
    test.equal(deltas[4], 0.5)

    mcp.bind(nil, nil)
    app:shutdown()
end

function suite.clockAndInputToolsAnswerWhileAFrameIsParked(): nil
    local app = steppedApplication()
    content("clock_pause")
    for _, name in ipairs({"clock_info", "clock_step", "send_event", "screenshot", "screenshot_info"}) do
        test.equal(assert(registry.findTool(name)).whenParked, true)
    end
    local parked = registry.callTool(assert(registry.findTool("clock_info")), {}, true)
    test.equal(parked.structuredContent.parked, true)
    test.equal(parked.structuredContent.settled, false)
    local sent = registry.callTool(
        assert(registry.findTool("send_event")),
        {kind = "keyDown", physicalKey = "KeyA"},
        true
    )
    test.equal(sent.isError, nil)
    test.equal(app:pendingEvents(), 1)
    -- A tool that touches the world still waits for the frame.
    test.equal(registry.callTool(assert(registry.findTool("stats")), {}, true).isError, true)

    mcp.bind(nil, nil)
    app:shutdown()
end

function suite.screenshotToolWritesTheNextRenderedFrame(): nil
    local app = steppedApplication()
    screenshot.cancelPending()
    local requested = content("screenshot", {name = "mcp-screenshot-test.png"})
    test.equal(requested.ready, false)
    test.assert(requested.path:find("mcp-screenshot-test.png", 1, true) ~= nil)
    test.equal(content("screenshot_info", {id = requested.id}).ready, false)

    -- What the host does after it renders: it consumes the request and
    -- answers with the frame.
    local id = assert(screenshot.nextRequest())
    screenshot.complete(id, 1, 1, "\1\2\3\255", "PNG-BYTES", nil)
    local server = assert(mcp.listen(0))
    mcp.poll(server)
    test.equal(assert(files.read(requested.path)), "PNG-BYTES")
    local written = content("screenshot_info", {id = requested.id})
    test.equal(written.ready, true)
    test.equal(written.saved, true)
    test.equal(written.width, 1)
    test.equal(written.height, 1)
    test.equal(written.bytes, 9)
    assert(files.remove(requested.path))

    -- A failed readback is reported rather than written.
    local failing = content("screenshot", {name = "mcp-screenshot-failed.png"})
    screenshot.complete(assert(screenshot.nextRequest()), 0, 0, "", "", "GPU readback failed")
    local failed = content("screenshot_info", {id = failing.id})
    test.equal(failed.ready, true)
    test.equal(failed.saved, false)
    test.equal(failed.reason, "GPU readback failed")

    test.equal(call("screenshot", {path = "relative.png"}).isError, true)
    test.equal(call("screenshot_info", {id = 999999}).isError, true)
    test.equal(content("describe", {command = "screenshot"}).action.name, "screenshot")
    test.equal(#content("describe", {command = "clock"}).verbs, 4)

    mcp.destroy(server)
    mcp.bind(nil, nil)
    app:shutdown()
end

return suite
