const {type Key} = require("types")

local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local physics = require("tecs.physics")
local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local mcp = require("tecs.mcp")
local application = require("tecs.application")
local screenshot = require("tecs.gfx.screenshot")
local registry = require("tecs.internal.mcpregistry")
local schemas = require("tecs.internal.mcpschemas")
local entityworld = require("tecs.internal.world")
local json = require("serde.json")
local suite = {}

-- The snapshot tools write under the application data root, which
-- `nupp.io.files` resolves from a process-wide identity. A host names one
-- through `tecs.application`; a suite that binds a world without an application
-- names it here.
if os.appid() == nil then
    os.setappid("tecs", "tecs")
end

local function call(name: string, arguments: {[string]: any}?): any
    local reply = json.decodevalue(
        mcp.dispatch(
            json.encodevalue({
                jsonrpc = "2.0",
                id = 1,
                method = "tools/call",
                params = {name = name, arguments = arguments or json.EMPTY_OBJECT}
            })
        )
    )

    return reply.result
end

local function content(name: string, arguments: {[string]: any}?): any
    local result = call(name, arguments)
    assert(result.isError == nil, name .. ": " .. tostring(result.content[1].text))
    return result.structuredContent
end

local function equalTree(actual: any, expected: any): nil
    assert.eq(type(actual), type(expected))
    if type(expected) ~= "table" then
        assert.eq(actual, expected)
        return
    end
    for key, value in pairs(expected) do
        equalTree(actual[key], value)
    end
    for key in pairs(actual) do
        assert(expected[key] ~= nil, "unexpected schema key: " .. tostring(key))
    end
end

function suite.restoredInputSchemasMatchTheHistoricalWireListing(): nil
    local historical = json.decodevalue(assert(assert(io.open("tests/fixtures/mcp/historical-tools.json", "rb")):read("a")))
    local checked = 0
    for _, tool in ipairs(historical.tools) do
        if schemas.inputs[tool.name] ~= nil then
            equalTree(schemas.inputs[tool.name], tool.inputSchema)
            local found = registry.findTool(tool.name)
            assert(found ~= nil, "missing restored tool " .. tool.name)
            equalTree(found.inputSchema, tool.inputSchema)
            checked = checked + 1
        end
    end
    assert.eq(checked, 22)
    for _, name in ipairs({"sample_pixels", "reload_shaders", "reload_image", "watch", "physics_debug"}) do
        assert.eq(registry.findTool(name), nil)
    end
end

function suite.inspectionReadsCommittedArchetypesAndAnonymousResources(): nil
    local world = ecs.newWorld()
    local entity = world:spawn(gfx.Camera2D(3, 4))
    world:commit()
    local key: Key<string> = types.Key("test.mcp.resource")
    local anonymous: Key<integer> = types.Key(nil)
    world.resources:set(key, "data")
    world.resources:set(anonymous, 4)
    mcp.bind(world)
    local listed = content("archetypes_list")
    assert(listed.total > 0)
    local info = content("archetypes_info", {id = listed.archetypes[1].id})
    assert(info.entities > 0)
    local resources = content("resources_list")
    assert.eq(resources.total, 2)
    assert.eq(content("resources_info", {name = "test.mcp.resource"}).present, true)
    assert.eq(content("resources_info", {name = "missing"}).present, false)
    local detached = entityworld.inspectArchetypes(world)
    detached[1].components[1] = "changed"
    assert(content("archetypes_list").archetypes[1].components[1] ~= "changed")
    world:despawn(entity)
    world:commit()
    assert.eq(content("archetypes_list").total, 0)
    assert(content("archetypes_list", {empty = true}).total > 0)
    mcp.bind(nil)
end

function suite.cameraMovementUsesTheRenderersSelectedEntity(): nil
    local world = ecs.newWorld()
    world:spawn(gfx.Camera2D(1, 2))
    local selected = world:spawn(gfx.Camera2D(10, 20, 2, 0.5), gfx.ActiveCamera)
    world:spawn(gfx.Camera2D(30, 40), gfx.ActiveCamera)
    world:commit()
    mcp.bind(world)
    assert.eq(content("camera_info").entity, selected)
    local moved = content("camera_move", {x = 50, zoom = 3})
    assert.eq(moved.x, 50)
    assert.eq(moved.y, 20)
    assert.eq(moved.zoom, 3)
    assert.eq(call("camera_move", {zoom = 0}).isError, true)
    assert.eq(call("camera_move", {extra = true}).isError, true)
    assert.eq(content("render_info").observations.gpuCounters, false)
    assert.eq(content("layers_list").total, 16)
    assert.eq(content("layers_info", {layer = 1}).layer, 1)
    assert.eq(call("layers_info", {layer = 1.5}).isError, true)
    mcp.bind(nil)
end

function suite.discoveryDescribesFamiliesAndRemainsAvailableAfterCrash(): nil
    local contract = content("describe", {command = "snapshot"})
    assert.eq(#contract.verbs, 2)
    assert.eq(content("help", {command = "camera"}).command.name, "camera")
    assert.eq(content("capabilities").tools, #mcp.listTools())
    mcp.setCrashed("test failure")
    assert(#content("help").sections > 0)
    assert.eq(call("physics_info").isError, true)
    mcp.setCrashed(nil)
end

function suite.realPhysicsInspectionAndRaycast(): nil
    local world = ecs.newWorld()
    physics.install(world, {gravity = {0, 0}})
    local body = world:spawn(ecs.Transform2D(20, 20), physics.Body(0), physics.Collider(0, 5, 5))
    world:update(1 / 60)
    mcp.bind(world)
    assert.eq(content("physics_info").bodies, 1)
    local hit = content("physics_raycast", {x1 = 0, y1 = 20, x2 = 40, y2 = 20})
    assert.eq(hit.hit, true)
    assert.eq(hit.entity, body)
    local saved = content("snapshot_save", {name = "mcp-contract-rapier-test.bin"})
    world:despawn(body)
    world:update(1 / 60)
    assert.eq(content("physics_info").bodies, 0)
    content("snapshot_load", {path = saved.path})
    world:update(1 / 60)
    assert.eq(content("physics_info").bodies, 1)
    assert.eq(content("physics_raycast", {x1 = 0, y1 = 20, x2 = 40, y2 = 20}).entity, body)
    assert(os.remove(saved.path))
    world:shutdown()
    mcp.bind(nil)
end

function suite.snapshotToolRoundTripPreservesBinaryHandlerDataAndNumericKeys(): nil
    local world = ecs.newWorld()
    local restored: any = nil
    world:addSnapshotHandler({
        name = "test.mcp.binary",
        save = function(exclusive _world: ecs.World): any
            return {[0] = "\0\255\128", [4.5] = false}
        end,
        load = function(exclusive _world: ecs.World, value: any): nil
            restored = value
        end
    })
    local entity = world:spawn(ecs.Name("saved"))
    world:commit()
    mcp.bind(world)
    local name = "mcp-contract-snapshot-test.bin"
    local saved = content("snapshot_save", {name = name})
    assert.eq(saved.format, "binary")
    world:despawn(entity)
    world:commit()
    local loaded = content("snapshot_load", {path = saved.path})
    assert.eq(loaded.entities, 1)
    assert.eq(restored[0], "\0\255\128")
    assert.eq(restored[4.5], false)
    assert.eq(world:get(entity, ecs.Name), "saved")
    assert.eq(call("snapshot_save", {name = "../escape.bin"}).isError, true)
    assert(assert(io.open(saved.path, "wb")):write("invalid"))
    assert.eq(call("snapshot_load", {path = saved.path}).isError, true)
    assert.eq(world:getStats().entities, 1)
    assert(os.remove(saved.path))
    mcp.bind(nil)
end

function suite.audioInspectionUsesTheWorldMixer(): nil
    local world = ecs.newWorld()
    mcp.bind(world)
    assert.eq(content("audio").installed, false)
    local mixer = audio.install(world, {backend = audiobackend.silent()})
    assert.eq(content("audio").available, false)
    assert.eq(content("audio").installed, true)
    assert.eq(call("reload_sound", {path = "not-loaded.wav"}).isError, true)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.audioToolsPlayAndReloadASoundTheMixerKnows(): nil
    local world = ecs.newWorld()
    mcp.bind(world)
    local backend = audiobackend.silent(48000)
    backend.available = true
    backend.registerDecoder = function(_vtable: any): (integer?, string?)
        return 3
    end
    local mixer = audio.install(world, {backend = backend})
    assert.eq(#content("audio").decoders, 0)
    local reloads = {0}
    local sound = audio.Sound(
        name = "mcp/known.wav",
        duration = 1,
        decoder = "test",
        vtable = function(): any
            return nil
        end,
        params = "",
        bytes = "",
        reload = function(): (boolean, string?)
            reloads[1] = reloads[1] + 1

            return true
        end
    )
    assert.eq(call("audio_play", {path = sound.name}).isError, true, "nothing has added it yet")
    mixer:addSound(sound)
    assert.eq(content("audio_play", {path = sound.name}).started, true)
    local report = content("audio")
    assert.eq(#report.decoders, 1)
    assert.eq(report.decoders[1], "test")
    assert.eq(content("reload_sound", {path = sound.name}).reloaded, true)
    assert.eq(reloads[1], 1)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.audioToolsReportAndDriveTheConsoleOnAMemoryOutput(): nil
    local loaded = pcall(require, "tecs.platform.audionative")
    if not loaded then
        assert.suite.skip("libtecsaudio is not on the loader path")
    end
    local world = ecs.newWorld()
    mcp.bind(world)
    local mixer = audio.install(world, {output = "memory"})
    mixer:bus("sfx")
    local line = mixer:timeline({tempo = 90})
    local snapshot = content("audio_snapshot")
    assert.eq(snapshot.output.state, "offline")
    assert.eq(#snapshot.buses, 2, "Master and sfx")
    assert.eq(snapshot.buses[1].name, "master")
    assert.eq(snapshot.buses[1].effects[1].name, "limiter")
    assert.eq(snapshot.timelines[1].tempo, 90)
    assert.eq(content("audio_control", {bus = "sfx", gain = 0.5, muted = true}).gain, 0.5)
    assert(mixer:bus("sfx"):muted())
    assert.eq(content("audio_timeline", {index = 1, action = "pause"}).paused, true)
    assert(line:paused())
    assert.eq(content("audio_step", {seconds = 0.25}).rendered, 0.25)
    assert.eq(content("audio_listen", {seconds = 0.1}).listening, true)
    content("audio_step", {seconds = 0.1})
    assert.eq(content("audio_listening").frames, 4800)
    assert.eq(call("audio_play", {path = "never-loaded.wav"}).isError, true)
    assert.eq(#content("audio_events").events, 0)
    mixer:destroy()
    world:shutdown()
    mcp.bind(nil)
end

function suite.profileToolsWriteAReportAndCanStartAgain(): nil
    content("profile_start", {intervalMs = 1, zone = "test-never-entered"})
    assert.eq(call("profile_start").isError, true)
    local report = content("profile_stop", {name = "mcp-contract-profile-test.collapsed"})
    assert.eq(report.samples, 0)
    assert.eq(assert(assert(io.open(report.path, "rb")):read("a")), "")
    assert(os.remove(report.path))
    assert.eq(call("profile_stop").isError, true)
end

--- Builds a bound application whose Update system counts frames and records
--- whether Space was pressed on each.
local function steppedApplication(): (application.Application, {number}, {boolean})
    local deltas: {number} = {}
    local pressed: {boolean} = {}
    local app = application.newApplication({
        plugin = function(exclusive running: application.Application): nil
            const input = running.input
            running.world:addSystem({
                name = "test.mcp.clock",
                phase = ecs.phases.Update,
                run = function(dt: number): nil
                    deltas[#deltas + 1] = dt
                    pressed[#pressed + 1] = input:keyPressed("Space")
                end
            })
        end
    })
    app:init()
    mcp.bind(app.world, app)

    return app, deltas, pressed
end

function suite.clockToolsPauseStepAndResumeTheSimulation(): nil
    local app, deltas, pressed = steppedApplication()
    app:iterate(0.5, nil)

    local info = content("clock_info")
    assert.eq(info.paused, false)
    assert.eq(info.settled, false)
    assert.eq(info.frame, 1)
    assert.eq(call("clock_step").isError, true)

    assert.eq(content("clock_pause").paused, true)
    content("send_event", {kind = "keyDown", physicalKey = "Space", logicalKey = " "})
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    assert.eq(#deltas, 1)
    info = content("clock_info")
    assert.eq(info.settled, true)
    assert.eq(info.pendingEvents, 1)

    local stepped = content("clock_step", {frames = 2, dt = 0.125})
    assert.eq(stepped.pendingSteps, 2)
    assert.eq(stepped.stepDt, 0.125)
    assert.eq(stepped.settled, false)
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    app:iterate(0.5, nil)
    assert.eq(#deltas, 3)
    assert.eq(deltas[2], 0.125)
    assert.eq(deltas[3], 0.125)
    assert(pressed[2])
    assert(not pressed[3])
    info = content("clock_info")
    assert.eq(info.frame, 3)
    assert.eq(info.elapsed, 0.75)
    assert.eq(info.settled, true)

    assert.eq(call("clock_step", {frames = 1.5}).isError, true)
    assert.eq(call("clock_step", {dt = 0}).isError, true)
    assert.eq(call("clock_step", {frames = 0}).isError, true)

    content("clock_step", {frames = 4})
    assert.eq(content("clock_resume").paused, false)
    assert.eq(content("clock_info").pendingSteps, 0)
    app:iterate(0.5, nil)
    assert.eq(deltas[4], 0.5)

    mcp.bind(nil, nil)
    app:shutdown()
end

function suite.clockAndInputToolsAnswerWhileAFrameIsParked(): nil
    local app = steppedApplication()
    content("clock_pause")
    for _, name in ipairs({"clock_info", "clock_step", "send_event", "screenshot", "screenshot_info"}) do
        assert.eq(assert(registry.findTool(name)).whenParked, true)
    end
    local parked = registry.callTool(assert(registry.findTool("clock_info")), {}, true)
    assert.eq(parked.structuredContent.parked, true)
    assert.eq(parked.structuredContent.settled, false)
    local sent = registry.callTool(
        assert(registry.findTool("send_event")),
        {kind = "keyDown", physicalKey = "KeyA"},
        true
    )
    assert.eq(sent.isError, nil)
    assert.eq(app:pendingEvents(), 1)
    -- A tool that touches the world still waits for the frame.
    assert.eq(registry.callTool(assert(registry.findTool("stats")), {}, true).isError, true)

    mcp.bind(nil, nil)
    app:shutdown()
end

function suite.screenshotToolWritesTheNextRenderedFrame(): nil
    local app = steppedApplication()
    screenshot.cancelPending()
    local requested = content("screenshot", {name = "mcp-screenshot-test.png"})
    assert.eq(requested.ready, false)
    assert(requested.path:find("mcp-screenshot-test.png", 1, true) ~= nil)
    assert.eq(content("screenshot_info", {id = requested.id}).ready, false)

    -- What the host does after it renders: it consumes the request and
    -- answers with the frame.
    local id = assert(screenshot.nextRequest())
    screenshot.complete(id, 1, 1, "\1\2\3\255", "PNG-BYTES", nil)
    local server = assert(mcp.listen(0))
    mcp.poll(server)
    assert.eq(assert(assert(io.open(requested.path, "rb")):read("a")), "PNG-BYTES")
    local written = content("screenshot_info", {id = requested.id})
    assert.eq(written.ready, true)
    assert.eq(written.saved, true)
    assert.eq(written.width, 1)
    assert.eq(written.height, 1)
    assert.eq(written.bytes, 9)
    assert(os.remove(requested.path))

    -- A failed readback is reported rather than written.
    local failing = content("screenshot", {name = "mcp-screenshot-failed.png"})
    screenshot.complete(assert(screenshot.nextRequest()), 0, 0, "", "", "GPU readback failed")
    local failed = content("screenshot_info", {id = failing.id})
    assert.eq(failed.ready, true)
    assert.eq(failed.saved, false)
    assert.eq(failed.reason, "GPU readback failed")

    assert.eq(call("screenshot", {path = "relative.png"}).isError, true)
    assert.eq(call("screenshot_info", {id = 999999}).isError, true)
    assert.eq(content("describe", {command = "screenshot"}).action.name, "screenshot")
    assert.eq(#content("describe", {command = "clock"}).verbs, 4)

    mcp.destroy(server)
    mcp.bind(nil, nil)
    app:shutdown()
end

return suite
