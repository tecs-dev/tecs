local animation = require("tecs.gfx.animation")
local archetype = require("tecs.internal.archetype")
local ecs = require("tecs.ecs")
local gfx = require("tecs.gfx")
local sheet = require("tecs.gfx.sheet")
local test = require("nupp.test")

local suite = {}

--- Names a sheet uniquely inside this suite, because the sheet registry is
--- process-wide and building under a taken name replaces what `byName` answers.
local sequence = 0

local function uniqueName(): string
    sequence = sequence + 1

    return "test.animation." .. tostring(sequence)
end

--- A four-frame strip a tenth of a second a frame, with an eight-frame image so
--- a tag can name a span inside it.
---
--- Every frame is a quarter of the image wide, so a frame index is readable
--- straight off a sprite's `u0`.
local function strip(image: integer): sheet.Sheet
    const built = sheet.grid({
        name = uniqueName(),
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        duration = 100,
        tags = {run = {from = 2, to = 3}},
    })

    return built:bind(image)
end

--- Runs enough whole frames of the world's fixed clock to cover `seconds`.
---
--- The world's timestep divides a tenth of a second exactly at the default
--- sixty hertz, so a step boundary never lands inside a frame by accident.
local function advance(exclusive world: ecs.World, seconds: number): nil
    const timestep = world:getFixedTiming()
    local elapsed = 0.0
    while elapsed < seconds - 1e-9 do
        world:update(timestep)
        elapsed = elapsed + timestep
    end
end

function suite.showsTheFirstFrameOnItsFirstStep(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built))
    world:commit()

    -- Spawned, the entity carries whatever `sprite` gave it and no frame has
    -- been written yet.
    test.equal(assert(world:get(entity, animation.AnimationComponent)).frame, 0)
    test.equal(animation.frameOf(world, entity), 1)

    advance(world, 0.05)
    test.equal(animation.frameOf(world, entity), 1)
    const sprite = assert(world:get(entity, gfx.Sprite))
    test.equal(sprite.image, 5)
    test.equal(sprite.u0, 0)
    test.equal(sprite.u1, 0.25)
end

function suite.advancesOneFrameAtATimeAndWritesTheSpriteRegion(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built))
    world:commit()

    advance(world, 0.15)
    test.equal(animation.frameOf(world, entity), 2)
    test.equal(assert(world:get(entity, gfx.Sprite)).u0, 0.25)

    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 3)
    test.equal(assert(world:get(entity, gfx.Sprite)).u0, 0.5)

    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 4)
    test.equal(assert(world:get(entity, gfx.Sprite)).u0, 0.75)
end

function suite.wrapsALoopingTagBackToItsFirstFrame(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built))
    world:commit()

    -- Four frames of a tenth, so a whole cycle plus a little is back on the
    -- first frame with the phase inside the cycle rather than past it.
    advance(world, 0.45)
    test.equal(animation.frameOf(world, entity), 1)
    test.assert(animation.timeOf(world, entity) < 0.1, "the phase wrapped rather than growing")
    test.assert(assert(world:get(entity, animation.AnimationComponent)).playing, "a looping tag keeps playing")
end

function suite.holdsTheLastFrameOfAOneShotAndStops(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {loop = false}))
    world:commit()

    advance(world, 1.0)
    test.equal(animation.frameOf(world, entity), 4)
    const instance = assert(world:get(entity, animation.AnimationComponent))
    test.assert(not instance.playing, "a one-shot stops when it runs out of frames")

    -- It stays there however long the world runs, rather than starting over.
    advance(world, 1.0)
    test.equal(animation.frameOf(world, entity), 4)
end

function suite.playsOnlyTheFramesATagNames(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, "run"))
    world:commit()

    advance(world, 0.05)
    test.equal(animation.frameOf(world, entity), 2)
    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 3)
    -- The tag is two frames long, so it wraps to its own first frame rather
    -- than running on into frame four.
    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 2)
end

function suite.refusesATagTheSheetDoesNotCarry(): nil
    const built = strip(5)
    test.raises(
        function(): nil
            animation.of(built, "swim")
        end,
        "has no tag"
    )
end

function suite.runsAtTheSpeedTheAnimationAsks(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const fast = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {speed = 2}))
    const slow = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {speed = 0.5}))
    world:commit()

    -- Three tenths of authored time for one, and a lot less than one for the
    -- other, out of the same run of fixed steps.
    advance(world, 0.175)
    test.equal(animation.frameOf(world, fast), 4)
    test.equal(animation.frameOf(world, slow), 1)
end

function suite.holdsItsFrameWhenSpeedIsZeroOrPlayingIsFalse(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const stopped = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {playing = false}))
    const held = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {speed = 0}))
    world:commit()

    advance(world, 0.5)
    test.equal(animation.frameOf(world, stopped), 1)
    test.equal(animation.frameOf(world, held), 1)
    test.equal(animation.timeOf(world, stopped), 0)
end

function suite.holdsAPausedEntityWhereItWas(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built))
    world:commit()
    advance(world, 0.15)
    test.equal(animation.frameOf(world, entity), 2)

    world:set(entity, ecs.Paused)
    world:commit()
    advance(world, 0.5)
    test.equal(animation.frameOf(world, entity), 2)

    -- A thaw carries on from where the freeze left it rather than starting
    -- over.
    world:remove(entity, ecs.Paused)
    world:commit()
    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 3)
end

function suite.pointsALiveEntityAtAnotherTagAndRestartsIt(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built))
    world:commit()
    advance(world, 0.25)
    test.equal(animation.frameOf(world, entity), 3)

    animation.play(world, entity, built, "run")
    test.equal(animation.timeOf(world, entity), 0)
    advance(world, 0.05)
    test.equal(animation.frameOf(world, entity), 2)

    -- An entity carrying no animation is given one.
    const plain = world:spawn(ecs.Transform2D(0, 0), built:sprite())
    world:commit()
    animation.play(world, plain, built, "run")
    world:commit()
    advance(world, 0.05)
    test.equal(animation.frameOf(world, plain), 2)
end

function suite.replaysAOneShotThatHasFinished(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {loop = false}))
    world:commit()
    advance(world, 1.0)
    test.equal(animation.frameOf(world, entity), 4)

    test.assert(animation.restart(world, entity), "there was an animation to restart")
    test.equal(animation.timeOf(world, entity), 0)
    advance(world, 0.05)
    test.equal(animation.frameOf(world, entity), 1)

    const bare = world:spawn(ecs.Transform2D(0, 0))
    world:commit()
    test.assert(not animation.restart(world, bare), "there is nothing to say what a bare entity would play")
    test.equal(animation.frameOf(world, bare), 0)
    test.equal(animation.timeOf(world, bare), 0)
end

function suite.reportsCompletionOnceForASubscriber(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    local completions = 0
    local reportedTag = "unset"
    local reportedSheet = ""
    world:observe(0, animation.Completed, function(value: animation.CycleEnd, exclusive _world: ecs.World): nil
        completions = completions + 1
        reportedTag = value.tag
        reportedSheet = value.sheet.name
    end)

    const entity = world:spawn(
        ecs.Transform2D(0, 0),
        built:sprite(),
        animation.of(built, "run", {
            loop = false
        }),
        gfx.AnimationEvents
    )
    world:commit()

    advance(world, 0.15)
    test.equal(completions, 0)

    advance(world, 0.2)
    test.equal(completions, 1)
    test.equal(reportedTag, "run")
    test.equal(reportedSheet, built.name)
    test.equal(animation.frameOf(world, entity), 3)

    -- Once per playthrough and never again until something restarts it.
    advance(world, 1.0)
    test.equal(completions, 1)

    animation.restart(world, entity)
    advance(world, 0.3)
    test.equal(completions, 2)
end

function suite.reportsALoopWhenTheCycleWraps(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    local loops = 0
    local reportedTag = "unset"
    world:observe(0, animation.Looped, function(value: animation.CycleEnd, exclusive _world: ecs.World): nil
        loops = loops + 1
        reportedTag = value.tag
    end)

    world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built), gfx.AnimationEvents)
    world:commit()

    advance(world, 0.35)
    test.equal(loops, 0)

    advance(world, 0.1)
    test.equal(loops, 1)
    -- The whole sheet reports the empty string rather than a tag name.
    test.equal(reportedTag, "")

    advance(world, 0.4)
    test.equal(loops, 2)
end

function suite.stopsAOneShotWithNoSubscriberAllTheSame(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    -- No `AnimationEvents`, so nothing is emitted, and the stop still happens:
    -- `Completed` reports a stop rather than causing one.
    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, nil, {loop = false}))
    world:commit()

    advance(world, 1.0)
    test.assert(not assert(world:get(entity, animation.AnimationComponent)).playing, "the one-shot parked")
    test.equal(animation.frameOf(world, entity), 4)
end

function suite.carriesPlaybackThroughASnapshot(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const built = strip(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), built:sprite(), animation.of(built, "run", {speed = 2}))
    world:commit()
    advance(world, 0.1)
    const phase = animation.timeOf(world, entity)
    test.equal(animation.frameOf(world, entity), 3)

    const saved = world:saveSnapshot()

    const restored = ecs.newWorld()
    animation.plugin(restored)
    restored:loadSnapshot(saved)

    -- One entity came back, and the save named its sheet and its tag rather
    -- than the ids this process happened to hand out.
    const query = restored:newQuery({include = {animation.AnimationComponent}})
    local found: integer = 0
    local recovered: integer = 0
    for candidate, count in query:iter() do
        const active = candidate as archetype.Archetype
        for row = 1, count as integer do
            found = found + 1
            recovered = active.entities[row]
        end
    end
    test.equal(found, 1)

    const instance = assert(restored:get(recovered, animation.AnimationComponent))
    test.equal(instance.sheet, built.id)
    test.equal(instance.tag, built:tagId("run"))
    test.equal(instance.speed, 2)
    test.equal(instance.time, phase)
    -- The frame is deliberately dropped, so the first step rewrites the sprite.
    test.equal(instance.frame, 0)
    test.equal(animation.frameOf(restored, recovered), 3)
end

function suite.showsTheNewFramesAfterASheetIsFoldedIn(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const name = uniqueName()
    const options = {
        name = name,
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        duration = 100,
        tags = {run = {from = 2, to = 3}},
    }
    const live = sheet.grid(options)
    live:bind(5)

    const entity = world:spawn(ecs.Transform2D(0, 0), live:sprite(), animation.of(live))
    world:commit()
    advance(world, 0.05)
    test.equal(assert(world:get(entity, gfx.Sprite)).u1, 0.25)

    -- A re-export with the same tags but wider frames keeps the entity's id,
    -- tag, and phase and shows the new frames from its next step.
    const rebuilt = sheet.grid({
        name = name,
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 64,
        frameHeight = 32,
        tags = {run = {from = 1, to = 2}},
    })
    const folded, reason = sheet.replace(rebuilt)
    test.assert(reason == nil, "the fold was accepted")
    test.equal(assert(folded).id, live.id)

    advance(world, 0.1)
    test.equal(animation.frameOf(world, entity), 2)
    test.equal(assert(world:get(entity, gfx.Sprite)).u1, 1)
end

function suite.showsNothingForASheetThisRunDoesNotHave(): nil
    const world = ecs.newWorld()
    animation.plugin(world)

    -- What a snapshot naming a sheet nothing built looks like: playback leaves
    -- the sprite alone rather than raising.
    const entity = world:spawn(ecs.Transform2D(0, 0), gfx.Sprite(7), animation.AnimationComponent)
    world:commit()

    advance(world, 0.5)
    test.equal(animation.frameOf(world, entity), 0)
    test.equal(assert(world:get(entity, gfx.Sprite)).image, 7)
end

function suite.installsItsSystemsOnceUnderTheirEstablishedNames(): nil
    const world = ecs.newWorld()
    animation.plugin(world)
    const before = world.systemCount
    animation.plugin(world)
    test.equal(world.systemCount, before)

    local names: {[string]: boolean} = {}
    for _, info in ipairs(world:listSystems()) do
        names[info.name] = true
    end
    test.assert(names["tecs.EncodeAnimation"], "the advance keeps its established name")
    test.assert(names["tecs.ReportAnimation"], "the reporter keeps its established name")
end

return suite
