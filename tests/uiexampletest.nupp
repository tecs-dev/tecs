const {type Session} = require("tecs.host")
const test = require("nupp.test")
const host = require("tecs.host")
const {type World} = require("tecs.ecs")
const gfx = require("tecs.gfx")
const ecs = require("tecs.ecs")
const {type Archetype} = require("tecs.ecs")
const {type Layout as Layout2} = require("tecs.ui")
const ui = require("tecs.ui")
const {type Font} = require("tecs.gfx.fonts")
const files = require("tecs.files")
const text2 = require("tecs.gfx.text")

local showcase = require("ui")
local standalone = require("uistandalone")
local suite = {}

local function frame(exclusive session: Session): nil
    local target = session.app.frame + 1
    local started = os.clock()
    while session.app.frame < target do
        test.assert(os.clock() - started < 10, "demo startup did not complete")
        host.iterate(session, 0)
        test.equal(host.crashed(session), nil)
    end
end

local function textEntity(world: World, value: string): integer
    -- Scene assertions inspect hidden labels too; game queries exclude them by default.
    for _, texts in ipairs({
        world:newQuery({
            include = {gfx.Text},
            temp = true
        }),
        world:newQuery({
            include = {gfx.Text, ecs.Disabled},
            temp = true
        }),
    }) do
        for candidate, count in texts:iter() do
            local column = assert(candidate:get(gfx.Text))
            for row = 1, count as integer do
                if column[row].text == value then
                    return (candidate as Archetype).entities[row]
                end
            end
        end
    end
    error("missing demo label: " .. value)
end

local function controlBox(world: World, label: string): Layout2
    const entity = textEntity(world, label)
    const control = assert(world:get(entity, ecs.ChildOf)).target
    return assert(world:get(control, ui.Layout))
end

local function checkSharedFonts(world: World, density: number): nil
    local fonts: {[number]: Font} = {}
    local checked = 0
    for _, texts in ipairs({
        world:newQuery({
            include = {gfx.Text},
            temp = true
        }),
        world:newQuery({
            include = {gfx.Text, ecs.Disabled},
            temp = true
        }),
    }) do
        for candidate, count in texts:iter() do
            const column = assert(candidate:get(gfx.Text))
            for row = 1, count as integer do
                const text = column[row]
                const font = assert(text.font)
                test.equal(font.size, text.size * density)
                const shared = fonts[text.size]
                if shared then
                    test.assert(font == shared, "demo labels overwrite the same image with different font atlases")
                    checked = checked + 1
                else
                    fonts[text.size] = font
                end
            end
        end
    end
    test.assert(checked > 0, "demo must contain labels sharing a font size")
end

local function checkSceneGeometry(world: World, scene: string): nil
    if scene == "Flex" then
        const fixed = controlBox(world, "88px")
        test.equal(fixed.width, 88)
        test.equal(fixed.height, 104)
        const first = controlBox(world, "grow 1")
        const second = controlBox(world, "grow 2")
        test.equal(first.x, 96)
        test.assert(first.width > 0)
        test.assert(math.abs(second.width - first.width * 2) <= 1)
        for index = 1, 8 do
            const chip = controlBox(world, ("item %d"):format(index))
            test.equal(chip.width, index % 3 == 0 and 128 or 96)
            test.equal(chip.height, 54)
            test.equal(chip.y, math.floor((index - 1) / 3) * 62)
        end
    elseif scene == "Overlay" then
        const area = controlBox(world, "absolute + z")
        for index, label in ipairs({"top-left", "top-right", "bottom-left", "bottom-right"}) do
            const card = controlBox(world, label)
            test.equal(card.width, 142)
            test.equal(card.height, 54)
            test.equal(card.x, index % 2 == 1 and 14 or area.width - 156)
            test.equal(card.y, index <= 2 and 14 or area.height - 68)
        end
    end
end

function suite.switchesEveryOriginalSceneThroughPointerInput(): nil
    files.setAssetRoot("assets")
    local session = showcase.create(nil, 1280, 720, false, nil)
    host.init(session)
    frame(session)
    local world = session.app.world
    local scenes = {"Compose", "Flex", "Overlay", "Scroll", "Compose", "Overlay", "Flex"}
    local labels = {
        "Image leaf",
        "Fixed width + flexGrow",
        "absolute + z",
        "01  Viewport stays fixed",
        "Image leaf",
        "absolute + z",
        "Fixed width + flexGrow"
    }
    for index = 1, #scenes do
        local label = textEntity(world, scenes[index])
        local control = assert(world:get(label, ecs.ChildOf)).target
        local pose = assert(world:get(control, ecs.Transform2D))
        local box = assert(world:get(control, ui.Layout))
        local x, y = pose.x + box.width / 2, pose.y + box.height / 2
        host.pushPointerButton(session, true, 1, x, y, index, index * 2 as integer)
        host.pushPointerButton(session, false, 1, x, y, index, (index * 2 + 1) as integer)
        frame(session)
        checkSceneGeometry(world, scenes[index])
        frame(session)
        checkSceneGeometry(world, scenes[index])
        test.equal(host.crashed(session), nil)
        local shown = textEntity(world, labels[index])
        test.assert(not world:has(shown, ecs.Disabled))
        test.assert(#text2.glyphsOf(world, shown) > 0)
        for other = 1, 4 do
            if labels[other] ~= labels[index] then
                test.equal(#text2.glyphsOf(world, textEntity(world, labels[other])), 0)
            end
        end
    end
    host.pushResize(session, false, 1280, 720, 2560, 1440, 2, 10, 20)
    frame(session)
    local cameras = world:newQuery({include = {gfx.Camera2D, gfx.ActiveCamera}})
    for candidate, _ in cameras:iter() do
        unsafe do
            const cameras = assert(candidate:get(gfx.Camera2D))
            test.equal(cameras[1].zoom, 2)
        end
    end
    local heading = assert(world:get(textEntity(world, "Tecs UI"), gfx.Text))
    test.equal(assert(heading.font).size, 64)
    checkSharedFonts(world, 2)
    host.shutdown(session)
    files.reset()
end

function suite.keepsTheCenteredStandalonePanel(): nil
    files.setAssetRoot("assets")
    local session = standalone.create(nil, 960, 640, false, nil)
    host.init(session)
    frame(session)
    test.equal(host.crashed(session), nil)
    local world = session.app.world
    local heading = textEntity(world, "Retained, composed UI")
    local headingBox = assert(world:get(heading, ecs.ChildOf)).target
    local panel = assert(world:get(headingBox, ecs.ChildOf)).target
    local layout = assert(world:get(panel, ui.Layout))
    test.equal(layout.x, 270)
    test.equal(layout.y, 50)
    test.equal(layout.width, 420)
    test.equal(layout.height, 540)
    test.assert(#text2.glyphsOf(world, textEntity(world, "Rectangle instance")) > 0)
    checkSharedFonts(world, 1)
    for index, density in ipairs({2, 1, 2}) do
        host.pushResize(session, false, 960, 640, 960 * density, 640 * density, density, index, index)
        frame(session)
        checkSharedFonts(world, density)
    end
    host.shutdown(session)
    files.reset()
end

return suite
