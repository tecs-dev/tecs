local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local test = require("nupp.test")
local time = require("nupp.time")

local suite = {}

--- Returns the native binding, or skips when the build has not staged
--- `libtecsaudio` where the dynamic loader will find it.
---
--- These are the only tests in the suite that cross into Rust, and every one of
--- them uses the device-free opener. Opening a real output can block inside the
--- platform's audio daemon on a machine that has one wedged or restricted, and
--- a headless suite must not be able to stop there.
local function binding(): {[string]: any}
    local ok, loaded = pcall(require, "tecs.platform.audionative")
    if not ok then
        test.skip("libtecsaudio is not on the loader path: " .. tostring(loaded))
    end

    return loaded as {[string]: any}
end

--- Opens a device-free native backend, skipping when the library refused.
local function opened(): audiobackend.Backend
    local native = binding()
    local backend, reason = native.openOffline(48000, 2, 8)
    if backend == nil then
        test.skip("libtecsaudio did not open: " .. tostring(reason))
    end

    return backend as audiobackend.Backend
end

function suite.agreesWithTheLibraryAboutEveryStructOnTheSeam(): nil
    -- The opener compares LuaJIT's view of each struct against the library's
    -- before it hands anything back, so reaching a backend at all is the
    -- layout assertion.
    local backend = opened()
    test.equal(backend.frequency, 48000)
    test.equal(backend.channels, 2)
    test.assert(not backend.available)
    backend.close()
end

function suite.carriesACommandBatchAcrossAndDrainsNothingBack(): nil
    local backend = opened()
    local commands: {audiobackend.Command} = {}
    for index = 1, 4 do
        commands[index] = audiobackend.newCommand()
    end
    commands[1].kind = audiobackend.SET_MASTER_GAIN
    commands[1].gain = 0.5
    -- A stop naming a voice that never existed, which is the stale-handle case
    -- Tecs relies on reaching nothing.
    commands[2].kind = audiobackend.STOP
    commands[2].handle = 65537
    commands[3].kind = audiobackend.SET_PITCH
    commands[3].handle = 65537
    commands[3].pitch = 2
    commands[4].kind = audiobackend.CLEAR_PLACEMENT
    commands[4].handle = 65537
    backend.submit(commands, 4)

    local finished: {integer} = {0, 0, 0, 0}
    test.equal(backend.drain(finished), 0)
    test.equal(backend.position(65537), nil)
    test.assert(not backend.seek(65537, 1))
    backend.close()
end

function suite.reportsAnOfflineOutputThatNeverDroppedOrReopened(): nil
    local backend = opened()
    test.equal(assert(backend.outputChanges)(), 0)
    local status = assert(backend.output)()
    test.equal(status.state, "offline")
    test.equal(status.drops, 0)
    test.equal(status.reopens, 0)
    test.equal(status.reason, nil)
    test.equal(status.frequency, 0)
    test.equal(status.channels, 0)
    backend.close()
    test.equal(assert(backend.output)().state, "offline")
end

function suite.takesADecoderOnlyThroughItsSeam(): nil
    -- The core links no codec: a Decoder comes from an extension's library,
    -- and the backend offers the seam it registers through.
    local backend = opened()
    test.assert(backend.registerDecoder ~= nil)
    test.assert(backend.openDecoded ~= nil)
    local mixer = audio.newAudio({backend = backend})
    test.equal(#mixer:decoders(), 0)
    mixer:destroy()
end

function suite.drivesAWholeMixerOverTheNativeBackend(): nil
    local backend = opened()
    local mixer = audio.newAudio({backend = backend, maxVoices = 4})
    -- The offline backend reports no output, and Tecs answers zero rather than
    -- taking a slot, which is what a machine with no sound card gets.
    test.assert(not mixer.available)
    mixer:setMasterGain(0.25)
    mixer:setGroupGain("sfx", 0.5)
    mixer:setLimit("footstep", {voices = 2, cooldown = 0.05})
    test.equal(mixer:update(0.016), 0)
    mixer:destroy()
end

function suite.fallsBackToSilenceWhenTheLibraryIsAbsent(): nil
    -- This one needs no library: it proves the fallback rather than the
    -- binding, so it runs on every machine.
    local mixer = audio.newAudio({backend = audiobackend.silent(), maxVoices = 4})
    test.assert(not mixer.available)
    test.equal(mixer:maxVoices(), 4)
    test.equal(mixer:sounding(), 0)
    mixer:destroy()
end

--- Opens a native void output, skipping when the library refused.
---
--- A void output never touches a device, so it is as safe in a headless suite
--- as the offline opener, and unlike it, it is available and keeps time.
local function voided(): audiobackend.Backend
    local native = binding()
    local backend, reason = native.openVoid(48000, 2, 8)
    if backend == nil then
        test.skip("libtecsaudio did not open a void output: " .. tostring(reason))
    end

    return backend as audiobackend.Backend
end

function suite.keepsTimeOnAVoidOutput(): nil
    local backend = voided()
    test.assert(backend.available)
    test.equal(assert(backend.output)().state, "void")
    local mixer = audio.newAudio({backend = backend, maxVoices = 4})
    test.assert(mixer.available)
    local started = time.now()
    while mixer:now() < 0.05 do
        test.assert(time.now() - started < 5000, "the void clock never moved")
        time.sleep(10)
        mixer:update(0.01)
    end
    mixer:destroy()
end

function suite.rendersAndHearsSilenceOnAMemoryOutput(): nil
    binding()
    local mixer = audio.newAudio({output = "memory", maxVoices = 4})
    test.assert(mixer.available)
    test.equal(mixer:output().state, "offline")
    test.assert(mixer:listen(0.5))
    test.equal(mixer:now(), 0, "nothing moves a memory clock but step")
    test.equal(mixer:step(0.5), 0.5)
    test.equal(mixer:now(), 0.5)
    local heard = assert(mixer:listening())
    test.equal(heard.frames, 24000)
    test.equal(heard.clipped, 0)
    test.equal(#heard.onsets, 0)
    test.equal(#mixer:events(), 0)
    mixer:destroy()
end

function suite.stepsAHeldVoidOutputAndLetsItRunAgain(): nil
    local backend = voided()
    local mixer = audio.newAudio({backend = backend})
    test.equal(mixer:step(0.1), 0, "a running void output is not stepped")
    test.assert(mixer:hold(true))
    local before = mixer:now()
    test.equal(mixer:step(0.25), 0.25)
    test.assert(math.abs(mixer:now() - before - 0.25) < 0.02)
    -- Held, the application's tick steps it by the frame's delta.
    mixer:tick(0.05)
    test.assert(math.abs(mixer:now() - before - 0.3) < 0.02)
    test.assert(not mixer:hold(false))
    mixer:destroy()
end

function suite.mapsTheDefaultTimelineOntoTheClock(): nil
    binding()
    local mixer = audio.newAudio({output = "memory", maxVoices = 8, limiter = false})
    mixer:step(0.25)
    local clock = mixer:defaultTimeline()
    test.assert(math.abs(clock:now() - mixer:now()) < 1e-9)
    test.assert(math.abs(clock:toClock(3) - 3) < 1e-9)
    test.equal(mixer:defaultTimeline(), clock)
    mixer:destroy()
end

return suite
