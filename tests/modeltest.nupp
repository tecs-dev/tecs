local test = require("nupp.test")
local models = require("tecs.gfx.models")
local suite = {}
function suite.samplesIndependentPosesWithSkinAndMorphWeights(): nil
    const model, reason = models.load("tests/assets/models/posed.gltf")
    test.assert(model ~= nil, reason)
    const loaded = assert(model)
    const first, second = loaded:newInstance(), loaded:newInstance()
    first:sample("Move", 0.25)
    second:sample("Move", 0.75)
    test.assert(math.abs(first.primitives[1].transform.value.y - 0.25) < 1e-6)
    test.assert(math.abs(second.primitives[1].transform.value.y - 0.75) < 1e-6)
    test.assert(math.abs(first.primitives[1].skin.value.matrices[13] - 0.25) < 1e-6)
    test.assert(math.abs(second.primitives[1].skin.value.matrices[13] - 0.75) < 1e-6)
    test.equal(first.primitives[1].morph.value.weights[1], 0.25)
    test.equal(second.primitives[1].morph.value.weights[1], 0.75)
    const world = tecs.ecs.newWorld()
    const p = first.primitives[1]
    const entity = world:spawn(p.transform, p.mesh, p.bounds, p.material, p.skin, p.morph, tecs.gfx.Renderable3D)
    world:commit()
    first:bind(world, 1, entity)
    first:play("Move", {loop = false})
    first:update(1)
    test.equal(assert(world:get(entity, tecs.ecs.Transform3D)).y, 1)
    test.equal(first.playing, false)
    first:sample("Rotate", 0.5)
    test.assert(math.abs(math.abs(first.primitives[1].transform.value.rotationZ) - math.sqrt(0.5)) < 1e-6)
end

function suite.cameraProjectionAndInverseRoundTrip(): nil
    const camera = tecs.gfx.newCamera3D({x = 2, y = 3, z = 8})
    const matrix, inverse = camera:matrices(1280, 720)
    for column = 0, 3 do
        for row = 0, 3 do
            local sum = 0.0
            for lane = 0, 3 do
                sum = sum + assert(matrix[lane * 4 + row]) * assert(inverse[column * 4 + lane])
            end
            test.assert(math.abs(sum - (row == column and 1 or 0)) < 1e-6)
        end
    end
end

function suite.loadsTheOriginalHeroAndMorphDemoAssets(): nil
    const hero, reason = models.load("assets/models/hero.glb")
    test.assert(hero ~= nil, reason)
    test.assert(assert(hero).animationCount > 0)
    const model, why = models.load("assets/models/morph-cube.gltf")
    test.assert(model ~= nil, why)
end

function suite.tunesImportedMaterialsBeforeUploadingTheirSharedGeometry(): nil
    local visited: integer = 0
    const model = assert(
        models.load("assets/models/triangle.gltf", {
            material = function(exclusive value: models.MaterialInfo): nil
                visited = visited + 1
                value.name = "tuned-triangle"
                value.model, value.metallic, value.roughness = models.MATERIAL_LAMBERT, 0, 1
            end
        })
    )
    test.assert(visited > 0)
    const instance = model:newInstance()
    test.assert(#instance.primitives > 0)
    test.equal(instance.primitives[1].materialName, "tuned-triangle")
end

return suite
