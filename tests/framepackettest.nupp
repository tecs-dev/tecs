local ecs = require("tecs.ecs")
local framepacket = require("tecs.internal.framepacket")
local gfx = require("tecs.gfx")
local test = require("nupp.test")

local suite = {}

function suite.exposesTheMinimumDrawableComponents(): nil
    local world = ecs.newWorld({maxEntities = 1})
    local entity = world:spawn(
        ecs.Transform2D(10, 20, 3, 4, 0.25, 30, 40),
        gfx.Tint(0.1, 0.2, 0.3, 0.4),
        gfx.Renderable2D
    )
    world:commit()

    local transform: ecs.Transform2D = assert(world:get(entity, ecs.Transform2D))
    local tint: gfx.Tint = assert(world:get(entity, gfx.Tint))
    test.equal(transform.x, 10)
    test.equal(transform.layer, 4)
    test.equal(transform.scaleY, 40)
    test.equal(tint.a, 0.4)
    test.assert(world:has(entity, gfx.Renderable2D))
end

function suite.encodesOneOrderedBatchForRust(): nil
    local world = ecs.newWorld({maxEntities = 3})
    local extractor = framepacket.new(world)
    world:spawn(ecs.Transform2D(200, 100, 0, 2, 0, 20, 30), gfx.Tint(1, 0, 0, 1), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(50, 60, 0, 1, 0.5, 70, 80), gfx.Tint(0, 1, 0, 0.5), gfx.Renderable2D)
    world:spawn(ecs.Transform2D(1, 2, 0, 0, 0, 3, 4), gfx.Tint(1, 1, 1, 1))
    world:commit()

    local reader = nupp.io.newScalarReader(extractor:packet(640, 360))
    test.equal(reader:readUint32(), framepacket.MAGIC)
    test.equal(reader:readUint32(), framepacket.VERSION)
    test.equal(reader:readUint32(), framepacket.INSTANCE_STRIDE)
    test.equal(reader:readUint32(), 2)
    test.equal(reader:readFloat32(), 640)
    test.equal(reader:readFloat32(), 360)

    test.equal(reader:readFloat32(), 50)
    test.equal(reader:readFloat32(), 60)
    test.equal(reader:readFloat32(), 0.5)
    test.equal(reader:readFloat32(), 70)
    test.equal(reader:readFloat32(), 80)
    test.equal(reader:readFloat32(), 0)
    test.equal(reader:readFloat32(), 1)
    test.equal(reader:readFloat32(), 0)
    test.equal(reader:readFloat32(), 0.5)

    test.equal(reader:readFloat32(), 200)
    test.equal(reader:readFloat32(), 100)
    test.equal(reader:readFloat32(), 0)
    test.equal(reader:readFloat32(), 20)
    test.equal(reader:readFloat32(), 30)
    test.equal(reader:readFloat32(), 1)
    test.equal(reader:readFloat32(), 0)
    test.equal(reader:readFloat32(), 0)
    test.equal(reader:readFloat32(), 1)
    test.assert(reader:atEnd())
    reader:drop()
end

return suite
