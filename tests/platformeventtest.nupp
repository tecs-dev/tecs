local ecs = require("tecs.ecs")
local platformevents = require("tecs.platform.events")
local test = require("nupp.test")

local suite = {}

function suite.constructsTypedWindowEvents(): nil
    local resized = platformevents.resized(1280, 720, 4, 2, 10.5, 7)
    test.equal(resized.kind, "windowResized")
    test.equal(resized.width, 1280)
    test.equal(resized.height, 720)
    test.equal(resized.pixelWidth, 2560)
    test.equal(resized.pixelHeight, 1440)
    test.equal(resized.window, 4)
    test.equal(resized.scaleFactor, 2)
    test.equal(resized.timestamp, 10.5)
    test.equal(resized.sequence, 7)

    local focused = platformevents.focused(false, 4)
    test.equal(focused.kind, "windowFocusLost")
    test.assert(not focused.focused)

    local scaled = platformevents.scaleChanged(1.5, 800, 600, 4)
    test.equal(scaled.kind, "windowScaleChanged")
    test.equal(scaled.scaleFactor, 1.5)
    test.equal(scaled.pixelWidth, 1200)
    test.equal(scaled.pixelHeight, 900)
end

function suite.constructsPhysicalAndLogicalKeyData(): nil
    local key = platformevents.key(true, "KeyW", "w", "w", 3, true, 2, 9, 11)

    test.equal(key.kind, "keyDown")
    test.equal(key.physicalKey, "KeyW")
    test.equal(key.logicalKey, "w")
    test.equal(key.text, "w")
    test.equal(key.modifiers, 3)
    test.assert(key.repeated)
    test.assert(key.down)
end

function suite.dispatchesOnlyTheMatchingTypedEvent(): nil
    local world = ecs.newWorld()
    local downs = 0
    local ups = 0
    world:observe(0, platformevents.on.keyDown, function(
        event: platformevents.KeyEvent,
        exclusive _running: ecs.World
    ): nil
        test.assert(event.down)
        downs = downs + 1
    end)
    world:observe(0, platformevents.on.keyUp, function(
        event: platformevents.KeyEvent,
        exclusive _running: ecs.World
    ): nil
        test.assert(not event.down)
        ups = ups + 1
    end)

    platformevents.dispatch(world, platformevents.key(true, "Space"))
    platformevents.dispatch(world, platformevents.key(false, "Space"))

    test.equal(downs, 1)
    test.equal(ups, 1)
end

function suite.preservesCompatibilitySensitiveKindNames(): nil
    test.equal(platformevents.pointerMoved(1, 2).kind, "mouseMotion")
    test.equal(platformevents.pointerButton(true, 1, 1, 2).kind, "mouseDown")
    test.equal(platformevents.pointerButton(false, 1, 1, 2).kind, "mouseUp")
    test.equal(platformevents.wheel(1, -1).kind, "mouseWheel")
    test.equal(platformevents.text("hello").kind, "textInput")
    test.equal(platformevents.quit().kind, "quit")
    test.equal(platformevents.closeRequested(1).kind, "windowCloseRequested")
end

function suite.routesPointerAndTextPayloads(): nil
    local world = ecs.newWorld()
    local pointerX = 0
    local typed = ""
    world:observe(0, platformevents.on.mouseMotion, function(
        event: platformevents.PointerMoveEvent,
        exclusive _running: ecs.World
    ): nil
        pointerX = event.x
    end)
    world:observe(0, platformevents.on.textInput, function(
        event: platformevents.TextEvent,
        exclusive _running: ecs.World
    ): nil
        typed = event.text
    end)

    platformevents.dispatch(world, platformevents.pointerMoved(12, 20, 2, 3))
    platformevents.dispatch(world, platformevents.text("nupp"))

    test.equal(pointerX, 12)
    test.equal(typed, "nupp")
end

function suite.rejectsInvalidTranslatedValues(): nil
    test.raises(
        function(): nil
            platformevents.resized(-1, 720)
        end,
        "dimensions"
    )
    test.raises(
        function(): nil
            platformevents.resized(1, 1, nil, 1, nil, nil, -1, 1)
        end,
        "pixel dimensions"
    )
    test.raises(
        function(): nil
            platformevents.key(true, "")
        end,
        "physicalKey"
    )
    test.raises(
        function(): nil
            platformevents.pointerButton(true, 0, 0, 0)
        end,
        "button"
    )
end

function suite.namesEveryKindItDeclaresIncludingTouchAndGamepad(): nil
    local kinds = platformevents.kinds()
    local seen: {[string]: boolean} = {}
    for index = 1, #kinds do
        test.assert(not seen[kinds[index]], "kind listed twice: " .. kinds[index])
        seen[kinds[index]] = true
    end
    test.equal(#kinds, 22)
    local expected: {
        string
    } = {
        "fingerDown",
        "fingerUp",
        "fingerMotion",
        "fingerCanceled",
        "gamepadAdded",
        "gamepadRemoved",
        "gamepadButtonDown",
        "gamepadButtonUp",
        "gamepadAxis",
    }
    for index = 1, #expected do
        test.assert(seen[expected[index]], "kind missing: " .. expected[index])
    end
end

function suite.constructsTouchAndGamepadEvents(): nil
    local touch = platformevents.touch("fingerMotion", "screen", "3", 40, 60, 0.4, 0.6, 0.5, 2, -1, 5, 1.5, 8)
    test.equal(touch.kind, "fingerMotion")
    test.equal(touch.touchDevice, "screen")
    test.equal(touch.finger, "3")
    test.equal(touch.dx, 2)
    test.equal(touch.dy, -1)
    test.equal(touch.window, 5)
    test.assert(touch.down)

    local gone = platformevents.touch("fingerUp", "screen", "3", 40, 60)
    test.assert(not gone.down)

    local added = platformevents.gamepadDevice(true, 2)
    test.equal(added.kind, "gamepadAdded")
    test.equal(added.which, 2)
    -- A gamepad belongs to no window, which is what lets the window fold pass
    -- it through untouched.
    test.equal(added.window, 0)

    local pressed = platformevents.gamepadButton(true, 2, 1)
    test.equal(pressed.kind, "gamepadButtonDown")
    test.equal(pressed.button, 1)
    test.assert(pressed.down)

    local moved = platformevents.gamepadAxis(2, 5, 0.5)
    test.equal(moved.kind, "gamepadAxis")
    test.equal(moved.axis, 5)
    test.equal(moved.value, 0.5)

    test.raises(
        function(): nil
            local _ = platformevents.gamepadButton(true, 2, 0)
        end,
        "button must be positive"
    )
    test.raises(
        function(): nil
            local _ = platformevents.gamepadAxis(2, 0, 0)
        end,
        "axis must be positive"
    )
end

function suite.dispatchesTouchAndGamepadToTheirOwnObservers(): nil
    local world = ecs.newWorld()
    local seen: {string} = {}
    world:observe(0, platformevents.on.fingerDown, function(
        event: platformevents.TouchEvent,
        exclusive _running: ecs.World
    ): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.on.fingerCanceled, function(
        event: platformevents.TouchEvent,
        exclusive _running: ecs.World
    ): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.on.gamepadRemoved, function(
        event: platformevents.GamepadDeviceEvent,
        exclusive _running: ecs.World
    ): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.on.gamepadAxis, function(
        event: platformevents.GamepadAxisEvent,
        exclusive _running: ecs.World
    ): nil
        seen[#seen + 1] = event.kind
    end)

    platformevents.dispatch(world, platformevents.touch("fingerDown", "screen", "1", 0, 0))
    platformevents.dispatch(world, platformevents.touch("fingerMotion", "screen", "1", 1, 1))
    platformevents.dispatch(world, platformevents.touch("fingerCanceled", "screen", "1", 1, 1))
    platformevents.dispatch(world, platformevents.gamepadDevice(false, 1))
    platformevents.dispatch(world, platformevents.gamepadAxis(1, 2, 0.25))
    world:update(0)

    test.equal(#seen, 4)
    test.equal(seen[1], "fingerDown")
    test.equal(seen[2], "fingerCanceled")
    test.equal(seen[3], "gamepadRemoved")
    test.equal(seen[4], "gamepadAxis")
end

return suite
