local ecs = require("tecs.ecs")
local platformevents = require("tecs.platform.events")

local suite = {}

function suite.constructsTypedWindowEvents(): nil
    local resized = platformevents.resized(1280, 720, 4, 2, 10.5, 7)
    assert.eq(resized.kind, "windowResized")
    assert.eq(resized.width, 1280)
    assert.eq(resized.height, 720)
    assert.eq(resized.pixelWidth, 2560)
    assert.eq(resized.pixelHeight, 1440)
    assert.eq(resized.window, 4)
    assert.eq(resized.scaleFactor, 2)
    assert.eq(resized.timestamp, 10.5)
    assert.eq(resized.sequence, 7)

    local focused = platformevents.focused(false, 4)
    assert.eq(focused.kind, "windowFocusLost")
    assert(not focused.focused)

    local scaled = platformevents.scaleChanged(1.5, 800, 600, 4)
    assert.eq(scaled.kind, "windowScaleChanged")
    assert.eq(scaled.scaleFactor, 1.5)
    assert.eq(scaled.pixelWidth, 1200)
    assert.eq(scaled.pixelHeight, 900)
end

function suite.constructsPhysicalAndLogicalKeyData(): nil
    local key = platformevents.key(true, "KeyW", "w", "w", 3, true, 2, 9, 11)

    assert.eq(key.kind, "keyDown")
    assert.eq(key.physicalKey, "KeyW")
    assert.eq(key.logicalKey, "w")
    assert.eq(key.text, "w")
    assert.eq(key.modifiers, 3)
    assert(key.repeated)
    assert(key.down)
end

function suite.dispatchesOnlyTheMatchingTypedEvent(): nil
    local world = ecs.newWorld()
    local downs = 0
    local ups = 0
    world:observe(0, platformevents.KeyDown, function(event: platformevents.KeyEvent): nil
        assert(event.down)
        downs = downs + 1
    end)
    world:observe(0, platformevents.KeyUp, function(event: platformevents.KeyEvent): nil
        assert(not event.down)
        ups = ups + 1
    end)

    platformevents.dispatch(world, platformevents.key(true, "Space"))
    platformevents.dispatch(world, platformevents.key(false, "Space"))

    assert.eq(downs, 1)
    assert.eq(ups, 1)
end

function suite.preservesCompatibilitySensitiveKindNames(): nil
    assert.eq(platformevents.pointerMoved(1, 2).kind, "mouseMotion")
    assert.eq(platformevents.pointerButton(true, 1, 1, 2).kind, "mouseDown")
    assert.eq(platformevents.pointerButton(false, 1, 1, 2).kind, "mouseUp")
    assert.eq(platformevents.wheel(1, -1).kind, "mouseWheel")
    assert.eq(platformevents.text("hello").kind, "textInput")
    assert.eq(platformevents.quit().kind, "quit")
    assert.eq(platformevents.closeRequested(1).kind, "windowCloseRequested")
end

function suite.routesPointerAndTextPayloads(): nil
    local world = ecs.newWorld()
    local pointerX = 0
    local typed = ""
    world:observe(0, platformevents.MouseMotion, function(event: platformevents.PointerMoveEvent): nil
        pointerX = event.x
    end)
    world:observe(0, platformevents.TextInput, function(event: platformevents.TextEvent): nil
        typed = event.text
    end)

    platformevents.dispatch(world, platformevents.pointerMoved(12, 20, 2, 3))
    platformevents.dispatch(world, platformevents.text("nupp"))

    assert.eq(pointerX, 12)
    assert.eq(typed, "nupp")
end

function suite.rejectsInvalidTranslatedValues(): nil
    assert.raises(
        function(): nil
            platformevents.resized(-1, 720)
        end,
        "dimensions"
    )
    assert.raises(
        function(): nil
            platformevents.resized(1, 1, nil, 1, nil, nil, -1, 1)
        end,
        "pixel dimensions"
    )
    assert.raises(
        function(): nil
            platformevents.key(true, "")
        end,
        "physicalKey"
    )
    assert.raises(
        function(): nil
            platformevents.pointerButton(true, 0, 0, 0)
        end,
        "button"
    )
end

function suite.namesEveryKindItDeclaresIncludingTouchAndGamepad(): nil
    local kinds = platformevents.kinds()
    local seen: {[string]: boolean} = {}
    for index = 1, #kinds do
        assert(not seen[kinds[index]], "kind listed twice: " .. kinds[index])
        seen[kinds[index]] = true
    end
    assert.eq(#kinds, 22)
    local expected: {
        string
    } = {
        "fingerDown",
        "fingerUp",
        "fingerMotion",
        "fingerCanceled",
        "gamepadAdded",
        "gamepadRemoved",
        "gamepadButtonDown",
        "gamepadButtonUp",
        "gamepadAxis",
    }
    for index = 1, #expected do
        assert(seen[expected[index]], "kind missing: " .. expected[index])
    end
end

function suite.constructsTouchAndGamepadEvents(): nil
    local touch = platformevents.touch("fingerMotion", "screen", "3", 40, 60, 0.4, 0.6, 0.5, 2, -1, 5, 1.5, 8)
    assert.eq(touch.kind, "fingerMotion")
    assert.eq(touch.touchDevice, "screen")
    assert.eq(touch.finger, "3")
    assert.eq(touch.dx, 2)
    assert.eq(touch.dy, -1)
    assert.eq(touch.window, 5)
    assert(touch.down)

    local gone = platformevents.touch("fingerUp", "screen", "3", 40, 60)
    assert(not gone.down)

    local added = platformevents.gamepadDevice(true, 2)
    assert.eq(added.kind, "gamepadAdded")
    assert.eq(added.which, 2)
    -- A gamepad belongs to no window, which is what lets the window fold pass
    -- it through untouched.
    assert.eq(added.window, 0)

    local pressed = platformevents.gamepadButton(true, 2, 1)
    assert.eq(pressed.kind, "gamepadButtonDown")
    assert.eq(pressed.button, 1)
    assert(pressed.down)

    local moved = platformevents.gamepadAxis(2, 5, 0.5)
    assert.eq(moved.kind, "gamepadAxis")
    assert.eq(moved.axis, 5)
    assert.eq(moved.value, 0.5)

    assert.raises(
        function(): nil
            local _ = platformevents.gamepadButton(true, 2, 0)
        end,
        "button must be positive"
    )
    assert.raises(
        function(): nil
            local _ = platformevents.gamepadAxis(2, 0, 0)
        end,
        "axis must be positive"
    )
end

function suite.dispatchesTouchAndGamepadToTheirOwnObservers(): nil
    local world = ecs.newWorld()
    local seen: {string} = {}
    world:observe(0, platformevents.FingerDown, function(event: platformevents.TouchEvent): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.FingerCanceled, function(event: platformevents.TouchEvent): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.GamepadRemoved, function(event: platformevents.GamepadDeviceEvent): nil
        seen[#seen + 1] = event.kind
    end)
    world:observe(0, platformevents.GamepadAxis, function(event: platformevents.GamepadAxisEvent): nil
        seen[#seen + 1] = event.kind
    end)

    platformevents.dispatch(world, platformevents.touch("fingerDown", "screen", "1", 0, 0))
    platformevents.dispatch(world, platformevents.touch("fingerMotion", "screen", "1", 1, 1))
    platformevents.dispatch(world, platformevents.touch("fingerCanceled", "screen", "1", 1, 1))
    platformevents.dispatch(world, platformevents.gamepadDevice(false, 1))
    platformevents.dispatch(world, platformevents.gamepadAxis(1, 2, 0.25))
    world:update(0)

    assert.eq(#seen, 4)
    assert.eq(seen[1], "fingerDown")
    assert.eq(seen[2], "fingerCanceled")
    assert.eq(seen[3], "gamepadRemoved")
    assert.eq(seen[4], "gamepadAxis")
end

return suite
