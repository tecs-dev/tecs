local application = require("tecs.application")
local ecs = require("tecs.ecs")
local input = require("tecs.input")
local platformevents = require("tecs.platform.events")

local suite = {}

local function key(down: boolean, repeated: boolean?): platformevents.KeyEvent
    return platformevents.key(down, "Space", " ", nil, 0, repeated)
end

function suite.keepsHeldStateAcrossFrameEdges(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))
    assert(state:keyDown("Space"))
    assert(state:keyPressed("Space"))
    assert(not state:keyReleased("Space"))

    state:beginFrame()
    assert(state:keyDown("Space"))
    assert(not state:keyPressed("Space"))
    state:handleEvent(key(false))
    assert(not state:keyDown("Space"))
    assert(state:keyReleased("Space"))
end

function suite.doesNotTurnKeyRepeatsIntoPresses(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))
    state:beginFrame()
    state:handleEvent(key(true, true))

    assert(state:keyDown("Space"))
    assert(not state:keyPressed("Space"))
end

function suite.latchesEdgesAcrossFramesUntilAFixedStep(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))
    state:beginFrame()
    state:handleEvent(key(false))
    assert(not state:keyPressed("Space"))

    state:enterFixedPhase()
    assert(state:keyPressed("Space"))
    assert(state:keyReleased("Space"))
    state:exitFixedPhase()

    state:enterFixedPhase()
    assert(not state:keyPressed("Space"))
    assert(not state:keyReleased("Space"))
    state:exitFixedPhase()
end

function suite.accumulatesPointerWheelAndTextForOneFrame(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(platformevents.pointerMoved(10, 20, 2, 3))
    state:handleEvent(platformevents.pointerMoved(14, 25, 4, 5))
    state:handleEvent(platformevents.wheel(0.5, -1, 0, -1, 14, 25))
    state:handleEvent(platformevents.text("nu"))
    state:handleEvent(platformevents.text("pp"))

    assert.eq(state.mouseX, 14)
    assert.eq(state.mouseY, 25)
    assert.eq(state.mouseDeltaX, 6)
    assert.eq(state.mouseDeltaY, 8)
    assert.eq(state.wheelY, -1)
    assert.eq(state.wheelTicksY, -1)
    assert.eq(state.text, "nupp")

    state:beginFrame()
    assert.eq(state.mouseX, 14)
    assert.eq(state.mouseDeltaX, 0)
    assert.eq(state.wheelY, 0)
    assert.eq(state.text, "")
end

function suite.tracksPointerButtonsByNameOrNumber(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(platformevents.pointerButton(true, 1, 4, 5))
    assert(state:mouseDown("left"))
    assert(state:mousePressed(1))

    state:beginFrame()
    state:handleEvent(platformevents.pointerButton(false, 1, 4, 5))
    assert(not state:mouseDown("left"))
    assert(state:mouseReleased("left"))
end

function suite.releasesHeldControlsWhenFocusIsLost(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))
    state:handleEvent(platformevents.pointerButton(true, 1, 0, 0))
    state:beginFrame()

    state:handleEvent(platformevents.focused(false))

    assert(not state:keyDown("Space"))
    assert(state:keyReleased("Space"))
    assert(not state:mouseDown("left"))
    assert(state:mouseReleased("left"))
end

function suite.movesCaptureAtBlockingLayerBoundaries(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))

    local menu = state:pushLayer("menu")
    assert(state:keyDown("Space", menu))
    assert(not state:keyDown("Space"))
    assert(not state:keyPressed("Space", menu))

    state:popLayer()
    assert(state:keyDown("Space"))
    assert(not state:keyPressed("Space"))
end

function suite.keepsEdgesAcrossNonblockingLayers(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(key(true))

    local overlay = state:pushLayer("overlay", false)

    assert(state:keyPressed("Space"))
    assert(state:keyPressed("Space", overlay))
    state:popLayer()
    assert(state:keyPressed("Space"))
end

function suite.applicationFoldsInputBeforeObserversAndFixedSystems(): nil
    local observerSawHeld = false
    local fixedSawPress = false
    local fixedSawRelease = false
    local app = application.newApplication({
        world = {timestep = 0.1},
        plugin = function(exclusive running: application.Application): nil
            local inputState = running.input
            running.world:observe(0, platformevents.KeyDown, function(_event: platformevents.KeyEvent): nil
                observerSawHeld = inputState:keyDown("Space")
            end)
            running.world:addSystem({
                phase = ecs.phases.FixedUpdate,
                run = function(_dt: number, exclusive world: ecs.World): nil
                    local state = assert(input.of(world))
                    fixedSawPress = state:keyPressed("Space")
                    fixedSawRelease = state:keyReleased("Space")
                end,
            })
        end,
    })
    app:init()

    app:iterate(0.05, {key(true)})
    app:iterate(0.05, {key(false)})

    assert(observerSawHeld)
    assert(fixedSawPress)
    assert(fixedSawRelease)
end

local function finger(
    phase: "fingerDown" | "fingerUp" | "fingerMotion" | "fingerCanceled",
    id: string,
    x: number,
    y: number,
    device: string?
): platformevents.TouchEvent
    return platformevents.touch(phase, device ?? "screen", id, x, y, x / 100, y / 100, 0.5, 0, 0)
end

function suite.tracksAFingerFromDownThroughMotionToUp(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(finger("fingerDown", "1", 10, 20))

    local held = state:touches()
    assert.eq(#held, 1)
    assert.eq(held[1].device, "screen")
    assert.eq(held[1].finger, "1")
    assert.eq(held[1].x, 10)
    assert.eq(held[1].normalY, 0.2)
    assert.eq(held[1].pressure, 0.5)

    state:handleEvent(finger("fingerMotion", "1", 30, 40))
    assert.eq(#state:touches(), 1)
    assert.eq(state:touches()[1].y, 40)

    -- A finger survives the frame boundary, because it is live state rather
    -- than an edge.
    state:beginFrame()
    assert.eq(#state:touches(), 1)

    state:handleEvent(finger("fingerUp", "1", 30, 40))
    assert.eq(#state:touches(), 0)
end

function suite.forgetsAFingerTheSurfaceCancels(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(finger("fingerDown", "2", 1, 1))
    state:handleEvent(finger("fingerCanceled", "2", 1, 1))
    assert.eq(#state:touches(), 0)
end

function suite.keepsTheSameFingerNumberOnTwoSurfacesApart(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(finger("fingerDown", "1", 5, 5, "screen"))
    state:handleEvent(finger("fingerDown", "1", 9, 9, "tablet"))
    assert.eq(#state:touches(), 2)

    state:handleEvent(finger("fingerUp", "1", 5, 5, "screen"))
    local left = state:touches()
    assert.eq(#left, 1)
    assert.eq(left[1].device, "tablet")
end

function suite.hidesTouchesBehindABlockingLayer(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(finger("fingerDown", "1", 5, 5))

    local menu = state:pushLayer("menu")
    assert.eq(#state:touches(), 0)
    assert.eq(#state:touches(menu), 1)

    state:popLayer()
    assert.eq(#state:touches(), 1)
end

function suite.dropsEveryFingerWhenFocusIsLost(): nil
    local state = input.newInput()
    state:beginFrame()
    state:handleEvent(finger("fingerDown", "1", 5, 5))
    state:handleEvent(platformevents.focused(false))
    assert.eq(#state:touches(), 0)
end

function suite.raisesForATouchWithNoFingerIdentity(): nil
    assert.raises(
        function(): nil
            local _ = platformevents.touch("fingerDown", "screen", "", 0, 0)
        end,
        "finger must not be empty"
    )
end

return suite
