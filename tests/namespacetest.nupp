const {type World} = require("tecs.ecs")
const ecs = require("tecs.ecs")
const gfx = require("tecs.gfx")
const materials = require("tecs.gpu.materials")
const {type Transform2D} = require("tecs.ecs")
const test = require("nupp.test")
const {type Material} = require("tecs.gfx")

local suite = {}

function suite.usesQualifiedValuesTypesAndNestedModulesWithoutImports(): nil
    local world: World = ecs.newWorld({maxEntities = 4})
    local square = world:spawn(ecs.Transform2D(80, 80, 0, 1, 0, 64, 64), gfx.Tint(1, 0.4, 0.2, 1), gfx.Renderable2D)
    local circle = world:spawn(
        ecs.Transform2D(180, 80, 0, 1, 0, 64, 64),
        gfx.Tint(0.2, 0.6, 1, 1),
        gfx.Material(materials.id("circle")),
        gfx.Renderable2D
    )
    local query = world:newQuery({include = {ecs.Transform2D, gfx.Renderable2D}})
    world:addSystem({
        name = "namespace.move",
        phase = ecs.phases.Update,
        run = function(dt: number): nil
            unsafe do
                for candidate, count in query:iter() do
                    local transforms: Transform2D[?] = assert(candidate:getMut(ecs.Transform2D))
                    for index = 1, count as integer do
                        transforms[index].x = transforms[index].x + 30 * dt
                    end
                end
            end
        end,
    })
    world:update(0.1)
    local pose: Transform2D = assert(world:get(square, ecs.Transform2D))
    test.equal(pose.x, 83)
    local material: Material = assert(world:get(circle, gfx.Material))
    test.equal(materials.name(material.id), "circle")
    test.equal(world.liveCount, 2)
end

return suite
