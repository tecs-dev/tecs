local sheet = require("tecs.gfx.sheet")
local test = require("nupp.test")

local suite = {}

--- Names a sheet uniquely inside this suite, because the registry is
--- process-wide and building under a taken name replaces what `byName` answers.
local sequence = 0

--- Compares two durations that were summed frame by frame, because a cycle is
--- an accumulation of floats and no two of them land on the same bits.
local function nearly(actual: number, expected: number, message: string): nil
    test.assert(math.abs(actual - expected) < 1e-9, message)
end

local function uniqueName(prefix: string): string
    sequence = sequence + 1

    return "test." .. prefix .. "." .. tostring(sequence)
end

function suite.cutsAGridIntoRowMajorFrames(): nil
    const built = sheet.grid({
        name = uniqueName("grid"),
        imageWidth = 64,
        imageHeight = 64,
        frameWidth = 32,
        frameHeight = 32,
    })
    test.equal(built.count, 4)

    const x, y, w, h = built:rect(4)
    test.equal(x, 32)
    test.equal(y, 32)
    test.equal(w, 32)
    test.equal(h, 32)

    const secondX, secondY = built:rect(2)
    test.equal(secondX, 32)
    test.equal(secondY, 0)

    -- Unbound, a frame's region is its plain fraction of the image.
    const u0, v0, u1, v1 = built:uv(4)
    test.equal(u0, 0.5)
    test.equal(v0, 0.5)
    test.equal(u1, 1)
    test.equal(v1, 1)

    test.equal(built:duration(1), sheet.DEFAULT_DURATION / 1000.0)
end

function suite.leavesTheMarginAndSpacingBetweenCells(): nil
    const built = sheet.grid({
        name = uniqueName("spaced"),
        imageWidth = 70,
        imageHeight = 36,
        frameWidth = 32,
        frameHeight = 32,
        margin = 2,
        spacing = 2,
    })
    test.equal(built.count, 2)

    const firstX, firstY = built:rect(1)
    test.equal(firstX, 2)
    test.equal(firstY, 2)

    const secondX = built:rect(2)
    test.equal(secondX, 36)
end

function suite.cutsAnExplicitFrameList(): nil
    const built = sheet.rects({
        name = uniqueName("rects"),
        imageWidth = 100,
        imageHeight = 50,
        frames = {{x = 0, y = 0, w = 10, h = 20, duration = 250}, {x = 10, y = 0, w = 30, h = 20}},
    })
    test.equal(built.count, 2)
    test.equal(built:duration(1), 0.25)
    test.equal(built:duration(2), 0.1)

    const left, top, w, h = built:rect(2)
    test.equal(left, 10)
    test.equal(top, 0)
    test.equal(w, 30)
    test.equal(h, 20)
end

function suite.walksATagInEachDirection(): nil
    const built = sheet.grid({
        name = uniqueName("tags"),
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        duration = 100,
        tags = {
            ahead = {from = 1, to = 3},
            back = {from = 1, to = 3, direction = "reverse"},
            there = {from = 1, to = 3, direction = "pingpong"},
        },
    })

    -- Ids follow the names in sorted order, so the same table produces the same
    -- ids on every run.
    test.equal(built:tagId("ahead"), 1)
    test.equal(built:tagId("back"), 2)
    test.equal(built:tagId("there"), 3)
    test.equal(built:tagCount(), 3)

    const forward = built:tagId("ahead")
    nearly(built:cycle(forward), 0.3, "three frames of a tenth make a third of a second")
    test.equal(built:frameAt(forward, 0.0), 1)
    test.equal(built:frameAt(forward, 0.15), 2)
    test.equal(built:frameAt(forward, 0.29), 3)

    const reverse = built:tagId("back")
    test.equal(built:frameAt(reverse, 0.0), 3)
    test.equal(built:frameAt(reverse, 0.29), 1)

    -- Neither end is repeated, so a three-frame pingpong is 1, 2, 3, 2 and its
    -- cycle is four frames long rather than six.
    const pingpong = built:tagId("there")
    nearly(built:cycle(pingpong), 0.4, "a three-frame pingpong visits four frames")
    test.equal(built:frameAt(pingpong, 0.0), 1)
    test.equal(built:frameAt(pingpong, 0.15), 2)
    test.equal(built:frameAt(pingpong, 0.25), 3)
    test.equal(built:frameAt(pingpong, 0.35), 2)

    -- Outside the cycle this clamps rather than wrapping, because wrapping is
    -- the caller's decision about looping.
    test.equal(built:frameAt(forward, 99.0), 3)
end

function suite.playsTheWholeSheetUnderTagZero(): nil
    const built = sheet.grid({
        name = uniqueName("whole"),
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
    })
    test.equal(built:tagId(nil), 0)
    -- The empty string is what a snapshot stores for tag zero.
    test.equal(built:tagId(""), 0)
    test.equal(built:tagName(0), "")
    nearly(built:cycle(0), 0.4, "the whole sheet is four frames of a tenth")
    test.equal(built:frameAt(0, 0.35), 4)
end

function suite.answersTheWholeSheetForATagItDoesNotCarry(): nil
    const built = sheet.grid({
        name = uniqueName("typo"),
        imageWidth = 64,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        tags = {idle = {from = 1, to = 2}},
    })

    test.assert(built:hasTag("idle"), "the sheet carries the tag it was built with")
    test.assert(not built:hasTag("run"), "and not one it was not")

    -- A misspelled tag is reported once and then read as the whole sheet, which
    -- is why `tag` raises and this does not.
    test.equal(built:tagId("run"), 0)
    test.equal(built:tagId("run"), 0)
    test.raises(
        function(): nil
            built:tag("run")
        end,
        "has no tag"
    )
end

function suite.readsAPivotOutOfASliceThatMoves(): nil
    const built = sheet.build(uniqueName("slices"), 64, 32)
        :frame(0, 0, 32, 32)
        :frame(32, 0, 32, 32)
        :sliceKeys("hand", "right", {
        {frame = 1, x = 8, y = 8, w = 8, h = 8, pivotX = 4, pivotY = 4},
        {frame = 2, x = 16, y = 8, w = 8, h = 8, pivotX = 0, pivotY = 0},
    })
        :slice("foot", 0, 24, 8, 8)
        :finish()

    const hand = built:sliceId("hand")
    test.equal(hand, 1)
    test.equal(built:sliceName(hand), "hand")
    test.equal(assert(built:slice("hand")).data, "right")

    -- The pivot is a fraction of the frame, so nothing downstream has to know
    -- the sheet's pixel sizes.
    const x, y = built:pivotOf(hand, 1)
    test.equal(x, 12 / 32)
    test.equal(y, 12 / 32)

    -- A slice holds its key until the next one, so frame two reads the second.
    const movedX, movedY = built:pivotOf(hand, 2)
    test.equal(movedX, 0.5)
    test.equal(movedY, 0.25)

    -- A slice naming no pivot answers the middle of its own rectangle.
    const foot = built:sliceId("foot")
    const footX, footY = built:pivotOf(foot, 1)
    test.equal(footX, 4 / 32)
    test.equal(footY, 28 / 32)

    -- A slice the sheet does not carry answers the middle of the frame, which
    -- is where a quad sits with no pivot at all.
    const missingX, missingY = built:pivotOf(built:sliceId("nose"), 1)
    test.equal(missingX, 0.5)
    test.equal(missingY, 0.5)
    test.equal(built:sliceName(0), "")
    test.assert(built:slice("nose") == nil, "an absent slice is nil rather than an error")
end

function suite.takesANineSliceCenterAsItsPivot(): nil
    const built = sheet.build(uniqueName("patch"), 32, 32):frame(0, 0, 32, 32):sliceKeys("panel", nil, {
        {frame = 1, x = 0, y = 0, w = 32, h = 32, centerX = 8, centerY = 8, centerW = 16, centerH = 16,}
    }):finish()

    const x, y = built:pivotOf(built:sliceId("panel"), 1)
    test.equal(x, 0.5)
    test.equal(y, 0.5)
end

function suite.resolvesFramesAgainstABoundImage(): nil
    const built = sheet.grid({
        name = uniqueName("bound"),
        imageWidth = 64,
        imageHeight = 64,
        frameWidth = 32,
        frameHeight = 32,
    })
    test.equal(built:boundImage(), 0)

    built:bind(9)
    test.equal(built:boundImage(), 9)
    const u0, v0, u1, v1 = built:uv(1)
    test.equal(u0, 0)
    test.equal(v0, 0)
    test.equal(u1, 0.5)
    test.equal(v1, 0.5)

    const spawned = built:sprite(4)
    test.equal(spawned.value.image, 9)
    test.equal(spawned.value.u0, 0.5)
    test.equal(spawned.value.v1, 1)

    -- A region names the part of the image the sheet occupies, and binding
    -- again rescales from the pixel rectangles rather than from the previous
    -- result, so nothing accumulates.
    built:bind(9, 0.5, 0.0, 1.0, 0.5)
    const regionU0, regionV0, regionU1, regionV1 = built:uv(1)
    test.equal(regionU0, 0.5)
    test.equal(regionV0, 0)
    test.equal(regionU1, 0.75)
    test.equal(regionV1, 0.25)

    built:bind(9)
    test.equal(built:uv(1), 0)
end

function suite.reportsAFrameRevision(): nil
    const before = sheet.revision()
    const built = sheet.grid({
        name = uniqueName("revision"),
        imageWidth = 32,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
    })
    const afterBuild = sheet.revision()
    test.assert(afterBuild > before, "registration moves the revision")
    built:bind(3)
    test.assert(sheet.revision() > afterBuild, "binding moves the revision")
end

function suite.findsARegisteredSheetByIdAndByName(): nil
    const name = uniqueName("registry")
    const built = sheet.grid({name = name, imageWidth = 32, imageHeight = 32, frameWidth = 32, frameHeight = 32,})
    test.assert(built.id > 0, "registration hands out an id")
    test.equal(assert(sheet.byId(built.id)).name, name)
    test.equal(assert(sheet.byName(name)).id, built.id)
    test.assert(sheet.byId(0) == nil, "zero names no sheet")
    test.assert(sheet.byName("test.nothing.registered") == nil, "an unknown name is nil")
end

function suite.foldsAReExportIntoTheSheetAlreadyRegistered(): nil
    const name = uniqueName("reload")
    const options = {
        name = name,
        imageWidth = 64,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        tags = {idle = {from = 1, to = 2}},
    }
    const live = sheet.grid(options)
    live:bind(4)
    const liveId = live.id

    const rebuilt = sheet.grid({
        name = name,
        imageWidth = 128,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        tags = {idle = {from = 1, to = 4}},
    })
    const folded, reason = sheet.replace(rebuilt)
    test.assert(reason == nil, "the fold was accepted")
    test.equal(assert(folded).id, liveId)
    test.equal(live.count, 4)
    -- The live sheet's bind is kept, so the new frames are already resolved.
    test.equal(live:boundImage(), 4)
    test.equal(live:uv(1), 0)
    const secondU0 = live:uv(2)
    test.equal(secondU0, 0.25)
    -- The build is spent: its id now resolves to the sheet its frames ended up
    -- in.
    test.equal(assert(sheet.byId(rebuilt.id)).id, liveId)
end

function suite.refusesAReExportThatWouldRenumberTags(): nil
    const name = uniqueName("renumber")
    const live = sheet.grid({
        name = name,
        imageWidth = 64,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        tags = {idle = {from = 1, to = 2}},
    })

    const rebuilt = sheet.grid({
        name = name,
        imageWidth = 64,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
        tags = {idle = {from = 1, to = 2}, attack = {from = 1, to = 1}},
    })
    const folded, reason = sheet.replace(rebuilt)
    test.assert(folded == nil, "the fold was refused")
    test.matches(assert(reason), "renumber its tags")

    -- A refusal leaves the live sheet exactly as it was.
    test.equal(assert(sheet.byName(name)).id, live.id)
    test.equal(live:tagCount(), 1)

    -- Replacing a sheet nothing displaced has nothing to fold into.
    const alone = sheet.grid({
        name = uniqueName("alone"),
        imageWidth = 32,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
    })
    const nothing, why = sheet.replace(alone)
    test.assert(nothing == nil, "there was nothing to replace")
    test.matches(assert(why), "nothing to replace")
end

function suite.rejectsASheetItCannotCut(): nil
    test.raises(
        function(): nil
            sheet.grid({name = "", imageWidth = 32, imageHeight = 32, frameWidth = 32, frameHeight = 32,})
        end,
        "needs a name"
    )
    test.raises(
        function(): nil
            sheet.grid({name = uniqueName("bad"), imageWidth = 0, imageHeight = 32, frameWidth = 32, frameHeight = 32,})
        end,
        "pixel size"
    )
    test.raises(
        function(): nil
            sheet.grid({
                name = uniqueName("bad"),
                imageWidth = 16,
                imageHeight = 16,
                frameWidth = 32,
                frameHeight = 32,
            })
        end,
        "fits no"
    )
    test.raises(
        function(): nil
            sheet.grid({
                name = uniqueName("bad"),
                imageWidth = 64,
                imageHeight = 32,
                frameWidth = 32,
                frameHeight = 32,
                count = 9,
            })
        end,
        "asks for"
    )
    test.raises(
        function(): nil
            sheet.rects({name = uniqueName("bad"), imageWidth = 32, imageHeight = 32, frames = {}})
        end,
        "lists no frames"
    )
    test.raises(
        function(): nil
            sheet.rects({
                name = uniqueName("bad"),
                imageWidth = 32,
                imageHeight = 32,
                frames = {{x = 0, y = 0, w = 0, h = 8}},
            })
        end,
        "positive size"
    )
    test.raises(
        function(): nil
            sheet.grid({
                name = uniqueName("bad"),
                imageWidth = 64,
                imageHeight = 32,
                frameWidth = 32,
                frameHeight = 32,
                tags = {idle = {from = 1, to = 9}},
            })
        end,
        "outside its"
    )
    test.raises(
        function(): nil
            sheet.grid({
                name = uniqueName("bad"),
                imageWidth = 64,
                imageHeight = 32,
                frameWidth = 32,
                frameHeight = 32,
                tags = {idle = {from = 1, to = 2, direction = "sideways" as sheet.Direction}},
            })
        end,
        "no direction"
    )
    test.raises(
        function(): nil
            sheet.build(uniqueName("bad"), 32, 32):finish()
        end,
        "no frames"
    )
    test.raises(
        function(): nil
            sheet.build(uniqueName("bad"), 32, 32):frame(0, 0, 0, 8)
        end,
        "positive size"
    )
end

function suite.raisesOnAFrameIndexTheSheetHasNot(): nil
    const built = sheet.grid({
        name = uniqueName("range"),
        imageWidth = 32,
        imageHeight = 32,
        frameWidth = 32,
        frameHeight = 32,
    })
    test.raises(
        function(): nil
            built:rect(2)
        end,
        "has no frame"
    )
    test.raises(
        function(): nil
            built:uv(0)
        end,
        "has no frame"
    )
    test.raises(
        function(): nil
            built:duration(7)
        end,
        "has no frame"
    )
    test.raises(
        function(): nil
            built:sprite(3)
        end,
        "has no frame"
    )
end

function suite.readsAnAsepriteArrayExport(): nil
    const name = uniqueName("aseprite")
    const built = sheet.fromAseprite({
        name = name,
        json = '{"frames":['
        .. '{"frame":{"x":0,"y":0,"w":16,"h":16},"duration":50},'
        .. '{"frame":{"x":16,"y":0,"w":16,"h":16},"duration":150}],'
        .. '"meta":{"image":"hero.png","size":{"w":32,"h":16},'
        .. '"frameTags":[{"name":"idle","from":0,"to":1,"direction":"pingpong"}],'
        .. '"slices":[{"name":"hand","data":"right","keys":['
        .. '{"frame":0,"bounds":{"x":2,"y":3,"w":4,"h":5},"pivot":{"x":1,"y":1}}]}]}}',
    })

    test.equal(built.name, name)
    test.equal(built.count, 2)
    test.equal(built.imageWidth, 32)
    test.equal(built.imageHeight, 16)
    test.equal(built:duration(1), 0.05)
    test.equal(built:duration(2), 0.15)

    -- Aseprite counts frames from zero and this model counts from one, so the
    -- span moves by one at the boundary and nowhere else.
    const from, to, direction = built:tag("idle")
    test.equal(from, 1)
    test.equal(to, 2)
    test.equal(direction, "pingpong")

    const hand = built:sliceId("hand")
    test.equal(assert(built:sliceKeyAt(hand, 1)).frame, 1)
    const x, y = built:pivotOf(hand, 1)
    test.equal(x, 3 / 16)
    test.equal(y, 4 / 16)
end

function suite.readsAnAsepriteObjectExportInFrameOrder(): nil
    const built = sheet.fromAseprite({
        json = '{"frames":{'
        .. '"hero 1.png":{"frame":{"x":16,"y":0,"w":16,"h":16}},'
        .. '"hero 0.png":{"frame":{"x":0,"y":0,"w":16,"h":16}}},'
        .. '"meta":{"image":"'
        .. "test.aseprite.object"
        .. '","size":{"w":32,"h":16}}}',
    })

    -- The frame names carry the frame number, so sorting them is what puts the
    -- object's frames back in order.
    test.equal(built.name, "test.aseprite.object")
    test.equal(built.count, 2)
    test.equal(built:rect(1), 0)
    test.equal(built:rect(2), 16)
end

function suite.refusesAMalformedAsepriteExport(): nil
    -- Not JSON at all.
    test.raises(function(): nil
        sheet.fromAseprite({name = uniqueName("broken"), json = "{this is not json"})
    end)

    -- Valid JSON that is not an export.
    test.raises(
        function(): nil
            sheet.fromAseprite({name = uniqueName("broken"), json = '{"meta":{"size":{"w":32,"h":32}}}'})
        end,
        "names no frames"
    )

    -- An export naming no image, with no name of its own to fall back on.
    test.raises(
        function(): nil
            sheet.fromAseprite({json = '{"frames":[],"meta":{"size":{"w":32,"h":32}}}'})
        end,
        "needs a name of its own"
    )

    -- A frame carrying no rectangle.
    test.raises(
        function(): nil
            sheet.fromAseprite({
                name = uniqueName("broken"),
                json = '{"frames":[{"duration":100}],"meta":{"size":{"w":32,"h":32}}}',
            })
        end,
        "has no rectangle"
    )

    -- A frame tag carrying no span.
    test.raises(
        function(): nil
            sheet.fromAseprite({
                name = uniqueName("broken"),
                json = '{"frames":[{"frame":{"x":0,"y":0,"w":8,"h":8}}],'
                .. '"meta":{"size":{"w":32,"h":32},"frameTags":[{"name":"idle"}]}}',
            })
        end,
        "has no span"
    )
end

return suite
