function love.conf(t: love.Configuration)
    t.window.title = "Tecs Audio - Spatial Audio Demo"
    t.identity = "tecs2d.audio_example"
    t.console = false
    t.window.width = 1400
    t.window.height = 1000
    t.window.borderless = false
    t.window.resizable = false
    t.window.vsync = 0
    t.window.msaa = 0
end
