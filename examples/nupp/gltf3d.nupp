module gltf3d

const {type Application} = require("tecs.application")
const gfx = require("tecs.gfx")
const meshes = require("tecs.gfx.meshes")
const flycamera3d = require("tecs.gfx.flycamera3d")
const ecs = require("tecs.ecs")
const models = require("tecs.gfx.models")
const files = require("tecs.files")
const {type Session} = require("tecs.host")
const host = require("tecs.host")

local function install(exclusive app: Application): nil
    const world = app.world
    const camera = gfx.newCamera3D()
    const lighting = meshes.newLighting()
    lighting.ambient = 1
    lighting.intensity = 0
    world:spawn(gfx.View({camera3D = camera, lighting = lighting}))
    camera.z = 2.5
    camera.verticalFov = math.rad(55)

    const controller = flycamera3d.new(app.input, app.window, camera, {moveSpeed = 3, sprintMultiplier = 4})
    world:addSystem({
        name = "example.GltfFlyCamera",
        phase = ecs.phases.Update,
        run = function(dt: number): nil
            controller:update(dt)
        end,
    })
    print("gltf3d: click to look; WASD moves, Q/E changes height, Shift sprints, Tab releases")

    const model = assert(models.load(files.assetPath("models/triangle.gltf")))
    const instance = model:newInstance()
    for _, primitive in ipairs(instance.primitives) do
        if primitive.skin ~= nil then
            world:spawn(
                primitive.transform,
                primitive.mesh,
                primitive.bounds,
                primitive.material,
                primitive.skin,
                gfx.Tint(1, 1, 1, 1),
                gfx.Renderable3D
            )
        else
            world:spawn(
                primitive.transform,
                primitive.mesh,
                primitive.bounds,
                primitive.material,
                gfx.Tint(1, 1, 1, 1),
                gfx.Renderable3D
            )
        end
    end
    print("gltf3d: loaded textured glTF geometry and transparent PBR material data")
end

--- Creates the Tecs glTF 3D example.
--- @param title optional window title
--- @param width logical width
--- @param height logical height
--- @param debug enable guarded failures
--- @param maxFrames optional bounded run
--- @return native host session
export function create(title: string?, width: integer?, height: integer?, debug: boolean?, maxFrames: integer?): Session
    return host.createWithPlugin(install, title or "Tecs glTF 3D", width or 960, height or 640, debug, maxFrames)
end
