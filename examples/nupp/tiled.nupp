module tiled

--[[An editable TMX map with TSX animation, Rapier boundaries and a moving camera.
Run with `nupp task ex-tiled`. Arrow keys pan; Space toggles a wall tile; F12 saves tiled.png.
]]
const {type Application} = require("tecs.application")
const tiled2 = require("tecs.tiled")
const files = require("tecs.files")
const physics = require("tecs.physics")
const gfx = require("tecs.gfx")
const ecs = require("tecs.ecs")
const materials = require("tecs.gpu.materials")
const {type Capture} = require("tecs.gfx.screenshot")
const {type World} = require("tecs.ecs")
const screenshot = require("tecs.gfx.screenshot")
const {type Session} = require("tecs.host")
const host = require("tecs.host")

local function install(exclusive app: Application): nil
    local map = tiled2.load(files.assetPath("maps/demo.tmx"))
    physics.install(app.world, {gravityY = 180})
    tiled2.spawn(app.world, map, {collision = true})
    local camera = app.world:spawn(gfx.Camera2D(512, 320, 1.5), gfx.ActiveCamera)
    for index = 1, 8 do
        local ball = app.world:spawn(
            ecs.Transform2D(180 + index * 22, 80 + index * 8, 5, 1, 0, 20, 20),
            gfx.Tint(1, 0.72, 0.28, 1),
            gfx.Material(materials.id("circle")),
            gfx.Renderable2D
        )
        physics.attach(app.world, ball, {radius = 10, restitution = 0.75})
    end
    local input = app.input
    local wall = true
    local capture: Capture? = nil
    app.world:addSystem({
        name = "example.tiled.controls",
        phase = ecs.phases.Update,
        run = function(dt: number, exclusive world: World): nil
            if input:keyPressed("F12") and capture == nil then
                capture = screenshot.request()
            end
            const ready = capture
            if ready ~= nil and ready.ready then
                const ok, reason = screenshot.save(ready, "tiled.png")
                print(ok and "Saved tiled.png" or tostring(reason))
                capture = nil
            end
            local dx, dy = 0, 0
            if input:keyDown("ArrowLeft") then
                dx = dx - 1
            end
            if input:keyDown("ArrowRight") then
                dx = dx + 1
            end
            if input:keyDown("ArrowUp") then
                dy = dy - 1
            end
            if input:keyDown("ArrowDown") then
                dy = dy + 1
            end
            if dx ~= 0 or dy ~= 0 then
                local eye = assert(world:getMut(camera, gfx.Camera2D));
                eye.x = eye.x + dx * dt * 250;
                eye.y = eye.y + dy * dt * 250
            end
            if input:keyPressed("Space") then
                wall = not wall;
                tiled2.setTile(map, 1, 10, 15, {tileset = 1, id = wall and 1 or 4})
            end
        end
    })
    print("tiled: TMX, TSX, TileChunks, animated sprites and collision ready")
end

--- Creates the Tiled demonstration session.
--- @param title the window title
--- @param width the initial logical width
--- @param height the initial logical height
--- @param debug whether guarded failures can be cleared
--- @param maxFrames an optional frame limit
--- @return the host session
export function create(title: string?, width: integer?, height: integer?, debug: boolean?, maxFrames: integer?): Session
    return host.createWithPlugin(
        install,
        title or "Tecs Tiled | Arrows: pan, Space: edit wall",
        width or 1100,
        height or 720,
        debug,
        maxFrames
    )
end
