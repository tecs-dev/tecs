module animated3d

--[[Lights and animates the original CC0 glTF character and morph cube.
Click to look, WASD moves, Q/E changes height, Shift sprints and Tab releases.]]

const FLOOR_VERTICES: {
    number
} = {
    -5,
    0,
    -4,
    0,
    1,
    0,
    1,
    0,
    0,
    1,
    0,
    0,
    5,
    0,
    -4,
    0,
    1,
    0,
    1,
    0,
    0,
    1,
    1,
    0,
    5,
    0,
    4,
    0,
    1,
    0,
    1,
    0,
    0,
    1,
    1,
    1,
    -5,
    0,
    4,
    0,
    1,
    0,
    1,
    0,
    0,
    1,
    0,
    1
}
const CLIPS: {string} = {"idle", "walk", "attack"}

local function spawn(world: tecs.ecs.World, instance: tecs.gfx.models.Instance, margin: number): nil
    local entities: {integer} = {}
    for index, primitive in ipairs(instance.primitives) do
        const bound = primitive.bounds.value
        entities[
            index
        ] = world:spawn(
            primitive.transform,
            primitive.mesh,
            tecs.gfx.Bounds3D(bound.centerX, bound.centerY, bound.centerZ, bound.radius + margin),
            primitive.material,
            primitive.skin,
            primitive.morph,
            tecs.gfx.Tint(),
            tecs.gfx.Renderable3D
        )
    end
    world:commit()
    for index, entity in ipairs(entities) do
        instance:bind(world, index, entity)
    end
end

local function install(exclusive app: tecs.application.Application): nil
    const camera = tecs.gfx.newCamera3D({y = 3.25, z = 11, verticalFov = math.rad(46), near = 0.1, far = 50})
    const lighting = tecs.gfx.meshes.newLighting()
    lighting.ambient = 0
    lighting.probe = {
        0.1,
        0.11,
        0.14,
        0.1,
        0.11,
        0.14,
        0.1,
        0.11,
        0.14,
        0.1,
        0.11,
        0.14,
        0.1,
        0.11,
        0.14,
        0.1,
        0.11,
        0.14
    }
    lighting.ssao = true
    lighting.ssaoRadius = 0.9
    lighting.ssaoIntensity = 1.15
    lighting.shadows = true
    lighting.shadowDistance = 12
    lighting.directionX = -0.55
    lighting.directionY = -1
    lighting.directionZ = -0.35
    lighting.r = 1
    lighting.g = 0.86
    lighting.b = 0.7
    lighting.intensity = 2.2
    lighting.shadowStrength = 0.82
    lighting.shadowSoftness = 1.25
    app.world:spawn(tecs.gfx.View({camera3D = camera, lighting = lighting}))
    const controller = tecs.gfx.flycamera3d.new(app.input, app.window, camera, {moveSpeed = 5, sprintMultiplier = 4})
    const floor, bounds = tecs.gfx.models.newMesh({
        name = "example://animated-hero-floor",
        vertices = FLOOR_VERTICES,
        indices = {0, 2, 1, 0, 3, 2}
    })
    app.world:spawn(
        tecs.ecs.Transform3D(),
        floor,
        bounds,
        tecs.gfx.MeshMaterial(),
        tecs.gfx.Tint(0.26, 0.29, 0.34, 1),
        tecs.gfx.Renderable3D
    )
    const loaded, reason = tecs.gfx.models.load(tecs.files.assetPath("models/hero.glb"))
    const model = assert(loaded, reason)
    const hero = model:newInstance()
    hero.transform = tecs.ecs.Transform3D(-1.7, 0, 0, 0, 1, 0, 0).value
    spawn(app.world, hero, 1.5)
    hero:play(CLIPS[1])
    const loadedMorph, why = tecs.gfx.models.load(tecs.files.assetPath("models/morph-cube.gltf"))
    const morphModel = assert(loadedMorph, why)
    const morph = morphModel:newInstance()
    morph.transform = tecs.ecs.Transform3D(2.6, 1.45, 0, 0, 0, 0, 1, 0.72, 0.72, 0.72).value
    spawn(app.world, morph, 0)
    morph:play(1)
    local clip: integer = 1
    local clipTime = 0.0
    local capture: tecs.gfx.screenshot.Capture? = nil
    const input = app.input
    app.world:addSystem({
        name = "example.AnimateLitHero",
        phase = tecs.ecs.phases.Update,
        run = function(dt: number): nil
            controller:update(dt)
            clipTime = clipTime + dt
            if clipTime >= 4 then
                clipTime = clipTime - 4
                clip = clip % #CLIPS + 1
                hero:play(CLIPS[clip])
            end
            hero:update(dt)
            morph:update(dt)
            if input:keyPressed("KeyO") then
                lighting.ssaoIntensity = lighting.ssaoIntensity > 0 and 0 or 1.15
            end
            if input:keyPressed("F12") then
                capture = tecs.gfx.screenshot.request()
            end
            const pending = capture
            if pending ~= nil and pending.ready then
                tecs.gfx.screenshot.save(pending, "animated3d.png")
                capture = nil
            end
        end
    })
end

--- Creates the animated glTF showcase with the original hero and morph cube.
--- @param title The caller supplies an optional window title.
--- @param width The caller supplies the logical width.
--- @param height The caller supplies the logical height.
--- @param debug The caller enables guarded debugging.
--- @param maxFrames The caller supplies a finite smoke-run frame limit.
--- @return The session driven by the native host.
export function create(
    title: string?,
    width: integer?,
    height: integer?,
    debug: boolean?,
    maxFrames: integer?
): tecs.host.Session
    return tecs.host.createWithPlugin(
        install,
        title or "Tecs animated and lit glTF",
        width or 960,
        height or 640,
        debug,
        maxFrames
    )
end
