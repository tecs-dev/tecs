module ibl3d

local function sphere(
    name: string,
    slices: integer,
    stacks: integer
): tecs.gfx.models.MeshInput, tecs.gfx.models.BoundsInput
    local vertices: {number} = {}
    local indices: {integer} = {}
    for row = 0, stacks do
        const v = row / stacks
        const latitude = v * math.pi
        const ring = math.sin(latitude)
        const y = math.cos(latitude)
        for column = 0, slices do
            const u = column / slices
            const longitude = u * math.pi * 2.0
            const x = ring * math.cos(longitude)
            const z = ring * math.sin(longitude)
            const base = #vertices
            vertices[base + 1], vertices[base + 2], vertices[base + 3] = x, y, z
            vertices[base + 4], vertices[base + 5], vertices[base + 6] = x, y, z
            vertices[
                base + 7
            ], vertices[
                base + 8
            ], vertices[base + 9], vertices[base + 10] = -math.sin(longitude), 0.0, math.cos(longitude), 1.0
            vertices[base + 11], vertices[base + 12] = u, v
        end
    end
    const stride = slices + 1
    for row = 0, stacks - 1 do
        for column = 0, slices - 1 do
            const a = row * stride + column
            const b = a + stride
            const base = #indices
            indices[base + 1], indices[base + 2], indices[base + 3] = a, a + 1, b
            indices[base + 4], indices[base + 5], indices[base + 6] = a + 1, b + 1, b
        end
    end
    assert(#indices == slices * stacks * 6)

    return tecs.gfx.models.newMesh({name = name, vertices = vertices, indices = indices})
end

local function install(exclusive app: tecs.application.Application): nil
    const world = app.world
    const camera = tecs.gfx.newCamera3D()
    const lighting = tecs.gfx.meshes.newLighting()
    lighting.ambient = 0
    lighting.probe = {
        0.11,
        0.08,
        0.07,
        0.05,
        0.07,
        0.11,
        0.18,
        0.24,
        0.34,
        0.025,
        0.018,
        0.016,
        0.14,
        0.09,
        0.06,
        0.045,
        0.055,
        0.09
    }
    lighting.probeIntensity = 8
    lighting.environmentIntensity = 2.4
    lighting.skyboxIntensity = 0.35
    lighting.environmentRotation = math.rad(18)
    world:spawn(tecs.gfx.View({camera3D = camera, lighting = lighting}))
    tecs.gfx.lighting.setBloom({threshold = 0.72, knee = 0.18, intensity = 0.55})
    camera.y, camera.z = 1.2, 10.5
    camera.rotationX = math.sin(math.rad(-6) * 0.5)
    camera.rotationW = math.cos(math.rad(-6) * 0.5)
    camera.verticalFov = math.rad(52)
    camera.near, camera.far = 0.1, 100

    const controller = tecs.gfx.flycamera3d.new(app.input, app.window, camera, {moveSpeed = 4, sprintMultiplier = 4})
    world:addSystem({
        name = "example.IblFlyCamera",
        phase = tecs.ecs.phases.Update,
        run = function(dt: number): nil
            controller:update(dt)
        end,
    })

    world:spawn(tecs.ecs.Transform3D(-4.5, 5, 4), tecs.gfx.PointLight3D(16, 1.0, 0.72, 0.46, 8.0))
    world:spawn(tecs.ecs.Transform3D(5, 2.5, 3), tecs.gfx.PointLight3D(14, 0.34, 0.55, 1.0, 5.0))

    const mesh, bounds = sphere("example://ibl-sphere", 40, 24)
    const roughness: {number} = {0.05, 0.18, 0.32, 0.48, 0.65}
    for index, value in ipairs(roughness) do
        const material = tecs.gfx.models.newMaterial({
            name = ("example://ibl-metal-%d"):format(index),
            metallic = 1.0,
            roughness = value,
            baseR = 0.82,
            baseG = 0.62,
            baseB = 0.22,
        })
        world:spawn(
            tecs.ecs.Transform3D((index - 3) * 2.15, 1.15),
            mesh,
            bounds,
            material,
            tecs.gfx.Tint(1, 1, 1, 1),
            tecs.gfx.Renderable3D
        )
        const dielectric = tecs.gfx.models.newMaterial({
            name = ("example://ibl-dielectric-%d"):format(index),
            metallic = 0.0,
            roughness = value,
            baseR = 0.18,
            baseG = 0.48,
            baseB = 0.92,
        })
        world:spawn(
            tecs.ecs.Transform3D((index - 3) * 2.15, -1.15),
            mesh,
            bounds,
            dielectric,
            tecs.gfx.Tint(1, 1, 1, 1),
            tecs.gfx.Renderable3D
        )
    end

    const faceNames: {
        string
    } = {"positive-x.svg", "negative-x.svg", "positive-y.svg", "negative-y.svg", "positive-z.svg", "negative-z.svg",}
    local faces: {string} = {}
    for index, face in ipairs(faceNames) do
        faces[index] = tecs.files.assetPath("environment/ibl-demo/" .. face)
    end
    const environment, reason = tecs.gfx.models.loadEnvironment("ibl-demo", faces)
    lighting.environment = assert(environment, reason)
    print("ibl3d: loaded six CC0 environment faces and generated the roughness mip chain")

    print("ibl3d: upper row is gold metal, lower row is blue dielectric")
    print("ibl3d: roughness runs 0.05, 0.18, 0.32, 0.48, 0.65 from left to right")
    print("ibl3d: click to look; WASD moves, Q/E changes height, Shift sprints, Tab releases")
end

--- Creates the original Tecs specular IBL showcase.
--- @param title optional window title
--- @param width logical width
--- @param height logical height
--- @param debug enable guarded application failures
--- @param maxFrames optional bounded run
--- @return the native host session
export function create(
    title: string?,
    width: integer?,
    height: integer?,
    debug: boolean?,
    maxFrames: integer?
): tecs.host.Session
    return tecs.host.createWithPlugin(
        install,
        title or "Tecs specular IBL",
        width or 1100,
        height or 700,
        debug,
        maxFrames
    )
end
