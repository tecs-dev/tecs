        tecs.ecs.RelativeTransform2D(0, 0, 8),
        displayTint(0.08, 0.18, 0.25, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(viewportFrame)
