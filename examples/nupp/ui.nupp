        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = {left = 10, top = 38}
            }),
            tecs.ui.Intrinsic({
                source = "text"
            }),
            tecs.ecs.RelativeTransform2D(0, 0, 2),
            displayTint(0.9, 0.95, 1.0, 1.0),
            tecs.gfx.Text(growthLabels[index], font, 16),
            tecs.ecs.ChildOf(cell)
        )
    end
    world:spawn(
        tecs.ui.Style({
            maxWidth = "100%",
            order = 3
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 2),
        displayTint(0.72, 0.84, 0.94, 1.0),
        tecs.gfx.Text("flexWrap = wrap", font, 16),
        tecs.ecs.ChildOf(flexScene)
    )
    const wrapGrid = world:spawn(
        tecs.ui.Style({
            width = "100%",
            flexGrow = 1,
            flexDirection = "row",
            flexWrap = "wrap",
            alignContent = "start",
            gap = 8,
            order = 4,
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(flexScene)
    )
    for index = 1, 8 do
        const chip = world:spawn(
            tecs.ui.Style({
                width = index % 3 == 0 and 128 or 96,
                height = 54
            }),
            tecs.ecs.RelativeTransform2D(),
            tecs.ecs.ChildOf(wrapGrid)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = 0
            }),
            tecs.ui.Paint(true),
            tecs.ecs.RelativeTransform2D(0, 0, 1),
            displayTint(0.10, 0.18 + index * 0.018, 0.28 + index * 0.025, 1.0),
            tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.12),
            tecs.gfx.Renderable2D,
            tecs.ecs.ChildOf(chip)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = {left = 12, top = 16}
            }),
            tecs.ui.Intrinsic({
                source = "text"
            }),
            tecs.ecs.RelativeTransform2D(0, 0, 2),
            displayTint(0.86, 0.93, 1.0, 1.0),
            tecs.gfx.Text(("item %d"):format(index), font, 16),
            tecs.ecs.ChildOf(chip)
        )
    end

    const overlayScene = world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = "100%",
            height = "100%",
            inset = {left = 0, top = 0},
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(sceneHost)
    )
    scenes[3] = overlayScene
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = 0
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 0),
        displayTint(0.055, 0.10, 0.16, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.04),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(overlayScene)
    )
    const anchorNames = {"top-left", "top-right", "bottom-left", "bottom-right"}
    for index = 1, 4 do
        local anchorInset: tecs.ui.Edges = {}
        if index % 2 == 1 then
            anchorInset.left = 14
        else
            anchorInset.right = 14
        end
        if index <= 2 then
            anchorInset.top = 14
        else
            anchorInset.bottom = 14
        end
        const anchor = world:spawn(
            tecs.ui.Style({
                position = "absolute",
                width = 142,
                height = 54,
                inset = anchorInset
            }),
            tecs.ecs.RelativeTransform2D(0, 0, index),
            tecs.ecs.ChildOf(overlayScene)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = 0
            }),
            tecs.ui.Paint(true),
            tecs.ecs.RelativeTransform2D(0, 0, 1),
            displayTint(0.10, 0.26 + index * 0.035, 0.38 + index * 0.045, 1.0),
            tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.1),
            tecs.gfx.Renderable2D,
            tecs.ecs.ChildOf(anchor)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = {left = 10, top = 16}
            }),
            tecs.ui.Intrinsic({
                source = "text"
            }),
            tecs.ecs.RelativeTransform2D(0, 0, 2),
            displayTint(0.9, 0.95, 1.0, 1.0),
            tecs.gfx.Text(anchorNames[index], font, 16),
            tecs.ecs.ChildOf(anchor)
        )
    end
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = 116,
            height = 116,
            inset = {left = "34%", top = "34%"},
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 8),
        displayTint(0.32, 0.82, 1.0, 0.92),
        tecs.gfx.Material(tecs.gpu.materials.id("circle"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(overlayScene)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 94, top = "48%"}
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 10),
        displayTint(0.95, 0.98, 1.0, 1.0),
        tecs.gfx.Text("absolute + z", font, 16),
        tecs.ecs.ChildOf(overlayScene)
    )
    const labels = {
        "Viewport stays fixed",
        "Content is 920px tall",
        "Descendants are clipped",
        "Wheel moves content",
        "Unused wheel reaches parent",
        "Focus reveals descendants",
        "Scrollbar thumb is composed",
        "Nested clipping",
        "Nested wheel handoff",
        "Dirty offsets only",
        "Pointer capture",
        "Drag moves the thumb",
        "Negative extents clamp",
        "Absolute children count",
        "Snapshot keeps offset",
        "Clip indices stay GPU-side",
    }
    for index = 1, #labels do
        spawnButton(content, ("%02d  %s"):format(index, labels[index]), index + 4)
    end

    const image = tecs.gfx.images.load(tecs.files.assetPath("demo/ui-badge.png"), "ui-demo-badge")
    const sprite = tecs.gfx.Sprite(image)
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            height = 64,
            inset = {left = 14, top = 16},
        }),
        tecs.ui.Intrinsic({
            source = "image"
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 3),
        sprite,
        displayTint(1, 1, 1, 1),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(imageCard)
    )

    -- Plugin spawns remain staged until Startup begins, so select the
    -- initial scene here rather than reading its Style before it exists.
    world:addSystem({
        name = "demo.SelectInitialScene",
        phase = tecs.ecs.phases.Startup,
        run = function(): nil
            const requested = os.getenv("TECS_UI_SCENE") or "compose"
            const choices: {[string]: integer} = {compose = 1, flex = 2, overlay = 3, scroll = 4}
            selectScene(assert(choices[requested], "TECS_UI_SCENE must be compose, flex, overlay or scroll"))
        end,
    })

    world:addSystem({
        name = "demo.UiState",
        phase = tecs.ecs.phases.Update,
        run = function(): nil
            for index = 1, #controls do
                local pair = controls[index]
                local state = world:get(pair[1], tecs.ui.InteractionState)
                local tint = world:get(pair[2], tecs.gfx.Tint)
                if state ~= nil and tint ~= nil then
                    local r, g, b = 0.12, 0.20, 0.30
                    if sceneIndexByControl[pair[1]] == activeScene then
                        r, g, b = 0.12, 0.34, 0.48
                    end
                    if state.pressed then
                        r, g, b = 0.14, 0.47, 0.62
                    elseif state.hovered then
                        r, g, b = 0.17, 0.34, 0.48
                    elseif state.focused then
                        r, g, b = 0.18, 0.29, 0.46
                    end
                    r, g, b = linear(r), linear(g), linear(b)
                    if tint.r ~= r or tint.g ~= g or tint.b ~= b then
                        const changed = assert(world:getMut(pair[2], tecs.gfx.Tint))
                        changed.r, changed.g, changed.b = r, g, b
                    end
                end
            end
        end,
    })

    -- The host attaches its window after installation; rasterize again when its density
    -- arrives.
    const window = app.window
    local rasterDensity = window:scaleFactor()
    const textNodes = world:newQuery({include = {tecs.gfx.Text}})
    world:addSystem({
        name = "example.UiRasterDensity",
        phase = tecs.ecs.phases.Update,
        run = function(): nil
            const currentDensity = window:scaleFactor()
            if currentDensity == rasterDensity then
                return
            end
            rasterDensity = currentDensity
            for candidate, count in textNodes:iter() do
                const texts = assert(candidate:getMut(tecs.gfx.Text))
                for row = 1, count as integer do
                    texts[row].font = fontAt(texts[row].size, currentDensity)
                end
            end
        end
    })
    print("ui: retained Taffy layout and interaction ready")
end

--- Creates the UI demonstration session.
--- @param title Sets the window title.
--- @param width Sets the initial logical width.
--- @param height Sets the initial logical height.
--- @param debug Enables guarded failure recovery.
--- @param maxFrames Sets an optional frame limit.
--- @return Returns the host session.
export function create(
    title: string?,
    width: integer?,
    height: integer?,
    debug: boolean?,
    maxFrames: integer?
): tecs.host.Session
    return tecs.host.createWithPlugin(install, title or "Tecs UI", width or 1280, height or 720, debug, maxFrames)
end
