        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(viewportFrame)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = 16,
            height = 16,
            inset = {right = 0, bottom = 0}
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 11),
        displayTint(0.22, 0.56, 0.68, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(viewportFrame)
    )
    world:spawn(
        tecs.ui.Scrollbar({
            axis = "vertical",
            thickness = 12,
            inset = 2,
            minLength = 28
