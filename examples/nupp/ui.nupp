            cellStyle.width = 88
        else
            cellStyle.flexGrow = index - 1
        end
        const cell = world:spawn(tecs.ui.Style(cellStyle), tecs.ecs.RelativeTransform2D(), tecs.ecs.ChildOf(growthRow))
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = 0
            }),
            tecs.ui.Paint(true),
            tecs.ecs.RelativeTransform2D(0, 0, 1),
            displayTint(0.08 + index * 0.04, 0.24 + index * 0.06, 0.38 + index * 0.07, 1.0),
            tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.08),
            tecs.gfx.Renderable2D,
            tecs.ecs.ChildOf(cell)
