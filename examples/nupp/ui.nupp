module ui

--[[Four retained UI scenes over an animated, lit sunflower field. Run `nupp task ex-ui`.]]

local function fontAt(size: number, density: number): tecs.gfx.fonts.Font
    return assert(
        tecs.gfx.fonts.newTTF({
            source = tecs.files.assetPath("fonts/JetBrainsMono-ExtraBold.ttf"),
            name = "ui-demo-" .. size .. "-" .. density,
            size = size * density,
            raster = "alpha"
        })
    )
end

const COUNT = 4000
const Field = tecs.ecs.newTagComponent({name = "UiDemoField"})
local function backdrop(exclusive app: tecs.application.Application): nil
    const world = app.world
    const width, height = app.window:getPixelSize()
    tecs.gfx.lighting.setAmbient(0.05, 0.05, 0.08)
    const camera = world:spawn(tecs.gfx.Camera2D(width * 0.5, height * 0.5), tecs.gfx.ActiveCamera)
    const window = app.window
    -- A black far-plane quad preserves the showcase's black backdrop.
    world:spawn(
        tecs.ecs.Transform2D(width * 0.5, height * 0.5, 0, 1, 0, width * 4, height * 4),
        tecs.gfx.Tint(0, 0, 0, 1),
        tecs.gfx.Renderable2D
    )
    const extent = math.min(width, height) * 0.46
    for index = 0, COUNT - 1 do
        const angle = index * 2.39996
        const radius = math.sqrt(index / COUNT) * extent
        const size = 6 + 10 * (1 - radius / extent)
        const hue = index / COUNT
        world:spawn(
            tecs.ecs.Transform2D(
                width * 0.5 + math.cos(angle) * radius,
                height * 0.5 + math.sin(angle) * radius,
                0,
                2,
                angle,
                size,
                size
            ),
            tecs.gfx.Tint(
                0.55 + 0.45 * math.cos(6.28318 * hue),
                0.55 + 0.45 * math.cos(6.28318 * (hue + 0.33)),
                0.55 + 0.45 * math.cos(6.28318 * (hue + 0.67)),
                1
            ),
            tecs.gfx.Renderable2D,
            Field
        )
    end
    const palette = {{1.0, 0.42, 0.35}, {0.38, 1.0, 0.62}, {0.42, 0.58, 1.0}}
    for index = 1, 3 do
        const color = palette[index]
        world:spawn(
            tecs.ecs.Transform2D(width * 0.5, height * 0.5),
            tecs.gfx.PointLight2D(120, math.min(width, height) * 0.7, color[1], color[2], color[3], 3)
        )
    end
    local elapsed = 0.0
    const spinning = world:newQuery({include = {tecs.ecs.Transform2D, Field}})
    const orbiting = world:newQuery({include = {tecs.ecs.Transform2D, tecs.gfx.PointLight2D}})
    world:addSystem({
        name = "demo.Spin",
        phase = tecs.ecs.phases.Update,
        run = function(dt: number): nil
            elapsed = elapsed + dt
            const view = assert(world:get(camera, tecs.gfx.Camera2D))
            const density = window:scaleFactor()
            if view.zoom ~= density then
                assert(world:getMut(camera, tecs.gfx.Camera2D)).zoom = density
            end
            for candidate, count in spinning:iter() do
                const transforms = assert(candidate:getMut(tecs.ecs.Transform2D))
                for row = 1, count as integer do
                    transforms[row].rotation = transforms[row].rotation + dt * 1.5
                end
            end
            local index = 0
            for candidate, count in orbiting:iter() do
                const transforms = assert(candidate:getMut(tecs.ecs.Transform2D))
                for row = 1, count as integer do
                    const angle = elapsed * 0.6 + index * 2.094
                    transforms[row].x = width * (0.5 + 0.3 * math.cos(angle))
                    transforms[row].y = height * (0.5 + 0.3 * math.sin(angle))
                    index = index + 1
                end
            end
        end
    })
end

-- The original artwork specifies display RGB; the renderer consumes linear light.
local function linear(value: number): number
    return value <= 0.04045 and value / 12.92 or ((value + 0.055) / 1.055) ^ 2.4
end

local function displayTint(r: number, g: number, b: number, a: number): tecs.ecs.ComponentInput
    return tecs.gfx.Tint(linear(r), linear(g), linear(b), a)
end

local function install(exclusive app: tecs.application.Application): nil
    const world = app.world
    backdrop(app)
    tecs.ui.plugin(app, {wheelStep = 36})
    tecs.gfx.text.install(world)
    const displayFont, font = fontAt(32, app.window:scaleFactor()), fontAt(16, app.window:scaleFactor())
    const uiRoot = world:spawn(
        tecs.ui.Style({
            width = "100%",
            height = "100%",
            flexDirection = "row",
            justifyContent = "end",
            padding = 24,
        }),
        tecs.ui.Root(),
        tecs.ecs.Transform2D(0, 0, 900, 16)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 24, top = 24}
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 100),
        displayTint(0.92, 0.96, 1.0, 1.0),
        tecs.gfx.Text(("tecs %s\n%d entities"):format("0.1.0", COUNT), displayFont, 32),
        tecs.ecs.ChildOf(uiRoot)
    )
    const panel = world:spawn(
        tecs.ui.Style({
            width = 400,
            height = "100%",
            flexDirection = "column",
            padding = 20,
            gap = 12,
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(uiRoot)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = 0
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 0),
        displayTint(0.035, 0.055, 0.09, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.04),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(panel)
    )

    const header = world:spawn(
        tecs.ui.Style({
            height = 62,
            width = "100%",
            order = 1
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 100),
        tecs.ecs.ChildOf(panel)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = 42,
            height = 42,
            inset = {left = 0, top = 4}
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 2),
        displayTint(0.32, 0.82, 1.0, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("circle"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(header)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 58, top = 0}
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 3),
        displayTint(0.94, 0.97, 1.0, 1.0),
        tecs.gfx.Text("Tecs UI", displayFont, 32),
        tecs.ecs.ChildOf(header)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 58, top = 39}
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 3),
        displayTint(0.54, 0.64, 0.76, 1.0),
        tecs.gfx.Text("Retained ECS | GPU instanced", font, 16),
        tecs.ecs.ChildOf(header)
    )

    const status = world:spawn(
        tecs.ui.Style({
            minHeight = 42,
            width = "100%"
        }),
        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 100),
        displayTint(0.62, 0.75, 0.88, 1.0),
        tecs.gfx.Text("Click, Tab, Return, or scroll", font, 16),
        tecs.ecs.ChildOf(panel)
    )

    local controls: {{integer}} = {}
    local function setStatus(message: string): nil
        local text = world:getMut(status, tecs.gfx.Text)
        if text ~= nil then
            text.text = message
        end
    end

    local function spawnButton(parent: integer, label: string, tabIndex: integer): integer
        const control = world:spawn(
            tecs.ui.Style({
                width = "100%",
                height = 44
            }),
            tecs.ui.Interaction({
                tabIndex = tabIndex
            }),
            tecs.ecs.RelativeTransform2D(),
            tecs.ecs.ChildOf(parent)
        )
        const visual = world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = 0
            }),
            tecs.ui.Paint(true),
            tecs.ecs.RelativeTransform2D(0, 0, 1),
            displayTint(0.12, 0.20, 0.30, 1.0),
            tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.18),
            tecs.gfx.Renderable2D,
            tecs.ecs.ChildOf(control)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = {left = 14, top = 11}
            }),
            tecs.ui.Intrinsic({
                source = "text"
            }),
            tecs.ecs.RelativeTransform2D(0, 0, 2),
            displayTint(0.9, 0.95, 1.0, 1.0),
            tecs.gfx.Text(label, font, 16),
            tecs.ecs.ChildOf(control)
        )
        controls[#controls + 1] = {control, visual}
        world:observe(control, tecs.ui.Event, function(event: tecs.ui.Event): nil
            if event.kind == "activate" then
                setStatus(("%s via %s"):format(label, event.source))
            end
        end)

        return control
    end

    local activeScene = 1
    local scenes: {integer} = {}
    local sceneIndexByControl: {[integer]: integer} = {}
    const sceneStatus = {
        "Scene: composition + intrinsic",
        "Scene: flex growth + wrapping",
        "Scene: absolute anchors + depth",
        "Scene: clipping + scrollbars",
    }
    local function selectScene(index: integer): nil
        activeScene = index
        for sceneIndex = 1, #scenes do
            const visible = sceneIndex == activeScene
            const style = assert(world:getMut(scenes[sceneIndex], tecs.ui.Style))
            style.style.display = visible and "flex" or "none"
        end
        setStatus(sceneStatus[index])
    end

    const actions = world:spawn(
        tecs.ui.Style({
            width = "100%",
            height = 44,
            order = 2,
            flexDirection = "row",
            gap = 8,
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 100),
        tecs.ecs.ChildOf(panel)
    )
    local function spawnSceneButton(label: string, tabIndex: integer): nil
        const control = world:spawn(
            tecs.ui.Style({
                width = 84,
                height = 44
            }),
            tecs.ui.Interaction({
                tabIndex = tabIndex
            }),
            tecs.ecs.RelativeTransform2D(),
            tecs.ecs.ChildOf(actions)
        )
        const visual = world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = 0
            }),
            tecs.ui.Paint(true),
            tecs.ecs.RelativeTransform2D(0, 0, 1),
            displayTint(0.12, 0.20, 0.30, 1.0),
            tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.18),
            tecs.gfx.Renderable2D,
            tecs.ecs.ChildOf(control)
        )
        world:spawn(
            tecs.ui.Style({
                position = "absolute",
                inset = {left = 8, top = 11}
            }),
            tecs.ui.Intrinsic({
                source = "text"
            }),
            tecs.ecs.RelativeTransform2D(0, 0, 2),
            displayTint(0.9, 0.95, 1.0, 1.0),
            tecs.gfx.Text(label, font, 16),
            tecs.ecs.ChildOf(control)
        )
        controls[#controls + 1] = {control, visual}
        sceneIndexByControl[control] = tabIndex
        world:observe(control, tecs.ui.Event, function(event: tecs.ui.Event): nil
            if event.kind == "activate" then
                selectScene(tabIndex)
            end
        end)
    end

    spawnSceneButton("Compose", 1)
    spawnSceneButton("Flex", 2)
    spawnSceneButton("Overlay", 3)
    spawnSceneButton("Scroll", 4)

    const sceneHost = world:spawn(
        tecs.ui.Style({
            width = "100%",
            flexGrow = 1,
            minHeight = 120,
            order = 3
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 10),
        tecs.ecs.ChildOf(panel)
    )

    const composeScene = world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = "100%",
            height = "100%",
            inset = {left = 0, top = 0},
            flexDirection = "column",
            gap = 10,
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(sceneHost)
    )
    scenes[1] = composeScene

    const viewportFrame = world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = "100%",
            height = "100%",
            inset = {left = 0, top = 0},
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(sceneHost)
    )
    scenes[4] = viewportFrame
    const viewport = world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = 0
        }),
        tecs.ui.Scroll(),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(viewportFrame)
    )
    const content = world:spawn(
        tecs.ui.Style({
            width = "100%",
            height = 920,
            flexDirection = "column",
            padding = {right = 22},
            gap = 8,
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(viewport)
    )

    -- Taffy lays out the viewport and its content. The rail, end blocks,
    -- and thumb remain ordinary composed rectangle instances, so their
    -- appearance is entirely ours rather than a built-in widget skin.
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = 16,
            inset = {right = 0, top = 0, bottom = 0}
        }),
        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 7),
        displayTint(0.025, 0.045, 0.075, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(viewportFrame)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            width = 4,
            inset = {right = 6, top = 16, bottom = 16}
