        displayTint(0.48, 0.66, 0.78, 1.0),
        tecs.gfx.Text("Sprite + intrinsic ratio", font, 16),
        tecs.ecs.ChildOf(imageCard)
    )

    const shapeRow = world:spawn(
        tecs.ui.Style({
            width = "100%",
            height = 128,
            flexDirection = "row",
            gap = 10,
            order = 2
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(composeScene)
