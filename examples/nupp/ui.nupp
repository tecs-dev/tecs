        tecs.ui.Intrinsic({
            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 2),
        displayTint(0.72, 0.84, 0.94, 1.0),
        tecs.gfx.Text("Fixed width + flexGrow", font, 16),
        tecs.ecs.ChildOf(flexScene)
    )
    const growthRow = world:spawn(
        tecs.ui.Style({
            width = "100%",
            height = 104,
            flexDirection = "row",
            gap = 8,
            order = 2
        }),
        tecs.ecs.RelativeTransform2D(),
        tecs.ecs.ChildOf(flexScene)
