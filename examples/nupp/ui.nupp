        tecs.ui.Paint(true),
        tecs.ecs.RelativeTransform2D(0, 0, 1),
        displayTint(0.08, 0.15, 0.23, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0.08),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(imageCard)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 92, top = 20}
