            source = "text"
        }),
        tecs.ecs.RelativeTransform2D(0, 0, 3),
        displayTint(0.9, 0.95, 1.0, 1.0),
        tecs.gfx.Text("Image leaf", font, 16),
        tecs.ecs.ChildOf(imageCard)
    )
    world:spawn(
        tecs.ui.Style({
            position = "absolute",
            inset = {left = 92, top = 49}
