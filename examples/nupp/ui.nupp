        displayTint(0.32, 0.82, 1.0, 1.0),
        tecs.gfx.Material(tecs.gpu.materials.id("rounded"), 0),
        tecs.gfx.Renderable2D,
        tecs.ecs.ChildOf(viewport)
    )

    const imageCard = world:spawn(
