module postprocess

--[[
A complete game entry for animated flat-color rendering.

The exported `create` function matches the Rust host's managed entry contract.
It installs three animated entities and delegates all platform and rendering
ownership to `tecs.host`.
]]
const {type Application} = require("tecs.application")
const passes = require("tecs.gpu.passes")
const ecs = require("tecs.ecs")
const gfx = require("tecs.gfx")
const {type Transform2D} = require("tecs.ecs")
const {type Session} = require("tecs.host")
const host = require("tecs.host")

local function install(exclusive app: Application): nil
    local width, height = app.window:getSize()
    passes.setShader(
        "present",
        [=[
fn postprocess(uv: vec2<f32>) -> vec4<f32> {
    let color = textureSample(input0, passSampler, uv);
    let gray = dot(color.rgb, vec3<f32>(0.2126, 0.7152, 0.0722));
    let graded = mix(color.rgb, vec3<f32>(gray), params.values[0].x);
    let vignette = 1.0 - params.values[0].y * dot(uv - 0.5, uv - 0.5);
    return vec4<f32>(graded * vignette, color.a);
}
]=]
    )
    passes.setParameters("present", {0.3, 1.5})
    local moving = app.world:newQuery({include = {ecs.Transform2D, gfx.Renderable2D}})
    app.world:spawn(
        ecs.Transform2D(width * 0.3, height * 0.5, 0, 1, -0.2, 180, 110),
        gfx.Tint(0.15, 0.65, 1, 1),
        gfx.Renderable2D
    )
    app.world:spawn(
        ecs.Transform2D(width * 0.5, height * 0.5, 0, 2, 0.15, 150, 150),
        gfx.Tint(1, 0.35, 0.2, 0.9),
        gfx.Renderable2D
    )
    app.world:spawn(
        ecs.Transform2D(width * 0.7, height * 0.5, 0, 3, 0.35, 110, 180),
        gfx.Tint(0.55, 1, 0.3, 0.8),
        gfx.Renderable2D
    )
    app.world:addSystem({
        name = "example.postprocess.rotate",
        phase = ecs.phases.Update,
        run = function(dt: number): nil
            unsafe do
                for candidate, count in moving:iter() do
                    local transforms: Transform2D[?] = assert(candidate:getMut(ecs.Transform2D))
                    for index = 1, count as integer do
                        transforms[index].rotation = transforms[index].rotation + dt * (0.35 + index * 0.1)
                    end
                end
            end
        end,
    })
end

--- Creates the example's host session through its statically linked plugin.
--- @param title the desktop title
--- @param width the initial logical width
--- @param height the initial logical height
--- @param debug whether guarded application failures may be cleared
--- @param maxFrames an optional positive frame limit
--- @return the session retained by the Rust host
export function create(title: string?, width: integer?, height: integer?, debug: boolean?, maxFrames: integer?): Session
    return host.createWithPlugin(install, title or "Tecs postprocess", width, height, debug, maxFrames)
end
