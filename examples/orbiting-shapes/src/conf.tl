function love.conf(t: love.Configuration)
    t.identity = "orbiting_shapes"
    t.console = false
    t.window.title = "Tecs - Orbiting Shapes (Hierarchical Transforms)"
    t.window.width = 800
    t.window.height = 600
    t.window.borderless = false
    t.window.resizable = false
    t.window.vsync = false
    t.window.msaa = 0
end
