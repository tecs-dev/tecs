module tecs.host

--[[
Managed-call bridge between the Rust application host and Nupp game state.

This module keeps the embedding ABI scalar. Rust holds a managed `Session`
handle and asks for one frame at a time. Records remain inside Nupp and no Lua
stack layout or collector address becomes part of the host contract.

Translated platform input crosses on the `nupp.host` channel rather than
through exports. The host pushes each observation on a `tecs.input.*` kind,
and the session routes every kind to its `input` bus as the matching record
below, whose fields are the pushed values in order. A route delivers at the
start of the next frame, or while a frame is parked, and the session queues
the platform event for the frame after it. The kinds are a compatibility
surface between this module and the host.
]]
const screenshot = require("tecs.gfx.screenshot")
const models = require("tecs.gfx.models")
const events = require("nupp.events")
const nupphost = require("nupp.host")
const suspension = require("nupp.suspension")

local application = require("tecs.application")
local viewpacket = require("tecs.internal.viewpacket")
local framepacket = require("tecs.internal.framepacket")
local hostpump = require("nupp.host.pump")
local images = require("tecs.gfx.images")
local platformevents = require("tecs.platform.events")
local window = require("tecs.platform.window")

--- The address every input route delivers at. The host drives one window.
export const INPUT_ADDRESS: integer = 1

--- A close request the host pushed on `tecs.input.close`.
@derive(events.Event)
export record CloseInput
    timestamp: number
    sequence: integer
end

--- A size observation the host pushed on `tecs.input.resize`.
@derive(events.Event)
export record ResizeInput
    --- Read-only. Reports whether the scale factor changed rather than only the size.
    scaleChanged: boolean

    width: integer
    height: integer
    pixelWidth: integer
    pixelHeight: integer
    scaleFactor: number
    timestamp: number
    sequence: integer
end

--- A focus transition the host pushed on `tecs.input.focus`.
@derive(events.Event)
export record FocusInput
    focused: boolean
    timestamp: number
    sequence: integer
end

--- A keyboard transition the host pushed on `tecs.input.key`.
@derive(events.Event)
export record KeyInput
    down: boolean
    physicalKey: string
    logicalKey: string?
    text: string?
    modifiers: integer
    repeated: boolean
    timestamp: number
    sequence: integer
end

--- An absolute pointer position and relative delta the host pushed on
--- `tecs.input.pointer-move`.
@derive(events.Event)
export record PointerMoveInput
    x: number
    y: number
    dx: number
    dy: number
    timestamp: number
    sequence: integer
end

--- A pointer button transition the host pushed on `tecs.input.pointer-button`.
@derive(events.Event)
export record PointerButtonInput
    down: boolean
    button: integer
    x: number
    y: number
    timestamp: number
    sequence: integer
end

--- Normalized wheel movement the host pushed on `tecs.input.wheel`.
@derive(events.Event)
export record WheelInput
    wheelX: number
    wheelY: number
    ticksX: integer
    ticksY: integer
    x: number
    y: number
    timestamp: number
    sequence: integer
end

--- Committed input-method text the host pushed on `tecs.input.text`.
@derive(events.Event)
export record TextInput
    text: string
    timestamp: number
    sequence: integer
end

--- One finger's transition or movement the host pushed on `tecs.input.touch`.
---
--- `x` and `y` are in the window's logical coordinates and `normalX` and
--- `normalY` run from zero to one across the surface. `touchDevice` and
--- `finger` are strings rather than numbers because both are 64-bit platform
--- identities that a Lua number would round together.
@derive(events.Event)
export record TouchInput
    --- Read-only. Names one of `fingerDown`, `fingerMotion`, `fingerUp` or
    --- `fingerCanceled`.
    phase: string

    touchDevice: string
    finger: string
    x: number
    y: number
    normalX: number
    normalY: number
    pressure: number
    dx: number
    dy: number
    timestamp: number
    sequence: integer
end

--- Host-owned state rooted by one Nupp managed handle.
export record Session
    app: application.Application

    --- Engine-owned. Receives the host's pushed input as the records above at
    --- `INPUT_ADDRESS`. Public so a test can emit on it in place of a host;
    --- game code should ignore it.
    input: events.MessageBus<integer>

    @private hosted: boolean
    @private routes: {nupphost.Route}
    @private events: {platformevents.Event}
    @private commands: {window.Command}
    @private commandIndex: integer
    @private imageCommands: {images.Command}
    @private imageCommandIndex: integer
    @private pump: hostpump.Pump
    @private extractor: framepacket.Extractor
    @private views: viewpacket.Collector
end

local function append(exclusive session: Session, event: platformevents.Event): nil
    session.events[#session.events + 1] = event
end

local function grabMode(mode: string): window.CursorGrab
    if mode == "none" or mode == "confined" or mode == "locked" then
        return mode
    end
    error("host: unknown cursor grab mode", 3)
end

local function hostState(
    id: integer,
    title: string,
    width: integer,
    height: integer,
    pixelWidth: integer,
    pixelHeight: integer,
    scaleFactor: number,
    x: integer,
    y: integer,
    focused: boolean,
    visible: boolean,
    minimized: boolean,
    maximized: boolean,
    fullscreen: boolean,
    occluded: boolean,
    resizable: boolean,
    cursorVisible: boolean,
    cursorGrab: string
): window.HostState
    return new window.HostState(
        id = id,
        title = title,
        width = width,
        height = height,
        pixelWidth = pixelWidth,
        pixelHeight = pixelHeight,
        scaleFactor = scaleFactor,
        x = x,
        y = y,
        focused = focused,
        visible = visible,
        minimized = minimized,
        maximized = maximized,
        fullscreen = fullscreen,
        occluded = occluded,
        resizable = resizable,
        cursorVisible = cursorVisible,
        cursorGrab = grabMode(cursorGrab)
    )
end

local function touchPhase(phase: string): "fingerDown" | "fingerUp" | "fingerMotion" | "fingerCanceled"
    if phase == "fingerDown" or phase == "fingerUp" or phase == "fingerMotion" or phase == "fingerCanceled" then
        return phase
    end
    error("host: unknown touch phase", 3)
end

-- Turns each routed input record into the platform event the application
-- reads, queued for the next frame.
local function observeInput(session: Session): nil
    const bus = session.input
    const window = session.app.window
    bus:observe(
        INPUT_ADDRESS,
        CloseInput,
        function(borrows input: CloseInput): nil
            append(session, platformevents.closeRequested(window:id(), input.timestamp, input.sequence))
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        ResizeInput,
        function(borrows input: ResizeInput): nil
            if input.scaleChanged then
                append(
                    session,
                    platformevents.scaleChanged(
                        input.scaleFactor,
                        input.width,
                        input.height,
                        window:id(),
                        input.timestamp,
                        input.sequence,
                        input.pixelWidth,
                        input.pixelHeight
                    )
                )
            else
                append(
                    session,
                    platformevents.resized(
                        input.width,
                        input.height,
                        window:id(),
                        input.scaleFactor,
                        input.timestamp,
                        input.sequence,
                        input.pixelWidth,
                        input.pixelHeight
                    )
                )
            end
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        FocusInput,
        function(borrows input: FocusInput): nil
            append(session, platformevents.focused(input.focused, window:id(), input.timestamp, input.sequence))
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        KeyInput,
        function(borrows input: KeyInput): nil
            append(
                session,
                platformevents.key(
                    input.down,
                    input.physicalKey,
                    input.logicalKey,
                    input.text,
                    input.modifiers,
                    input.repeated,
                    window:id(),
                    input.timestamp,
                    input.sequence
                )
            )
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        PointerMoveInput,
        function(borrows input: PointerMoveInput): nil
            append(
                session,
                platformevents.pointerMoved(
                    input.x,
                    input.y,
                    input.dx,
                    input.dy,
                    window:id(),
                    input.timestamp,
                    input.sequence
                )
            )
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        PointerButtonInput,
        function(borrows input: PointerButtonInput): nil
            append(
                session,
                platformevents.pointerButton(
                    input.down,
                    input.button,
                    input.x,
                    input.y,
                    1,
                    window:id(),
                    input.timestamp,
                    input.sequence
                )
            )
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        WheelInput,
        function(borrows input: WheelInput): nil
            append(
                session,
                platformevents.wheel(
                    input.wheelX,
                    input.wheelY,
                    input.ticksX,
                    input.ticksY,
                    input.x,
                    input.y,
                    window:id(),
                    input.timestamp,
                    input.sequence
                )
            )
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        TextInput,
        function(borrows input: TextInput): nil
            append(session, platformevents.text(input.text, window:id(), input.timestamp, input.sequence))
        end,
        "tecs.host"
    )
    bus:observe(
        INPUT_ADDRESS,
        TouchInput,
        function(borrows input: TouchInput): nil
            append(
                session,
                platformevents.touch(
                    touchPhase(input.phase),
                    input.touchDevice,
                    input.finger,
                    input.x,
                    input.y,
                    input.normalX,
                    input.normalY,
                    input.pressure,
                    input.dx,
                    input.dy,
                    window:id(),
                    input.timestamp,
                    input.sequence
                )
            )
        end,
        "tecs.host"
    )
end

-- Every routed kind keeps each message, as the per-event exports it replaced
-- did, up to a bound no frame of real input approaches.
const INPUT_LIMIT = 1024

-- The pushed kinds are a compatibility surface with the Rust host.
local function routeInput(exclusive session: Session): nil
    const bus = session.input
    const routes = session.routes
    routes[#routes + 1] = nupphost.route("tecs.input.close", CloseInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[
        #routes + 1
    ] = nupphost.route("tecs.input.resize", ResizeInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[#routes + 1] = nupphost.route("tecs.input.focus", FocusInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[#routes + 1] = nupphost.route("tecs.input.key", KeyInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[
        #routes + 1
    ] = nupphost.route("tecs.input.pointer-move", PointerMoveInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[
        #routes + 1
    ] = nupphost.route("tecs.input.pointer-button", PointerButtonInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[#routes + 1] = nupphost.route("tecs.input.wheel", WheelInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[#routes + 1] = nupphost.route("tecs.input.text", TextInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
    routes[#routes + 1] = nupphost.route("tecs.input.touch", TouchInput, bus, INPUT_ADDRESS, "dropOldest", INPUT_LIMIT)
end

--- Creates a configurable session without starting the application.
---
--- Under an embedding host the session routes the host's `tecs.input.*` pushes
--- to its `input` bus. Without one, as in a test, nothing is routed and input
--- arrives only by emitting on that bus.
--- @param config the application settings, including world timing and optional MCP
---     port.
--- @return the session a component's constructor gives the Rust host.
--- @raises string when application configuration is invalid.
export function newSession(config: application.Config?): Session
    const app = application.newApplication(config)
    const session = new Session(
        app = app,
        input = events.newMessageBus(),
        hosted = nupphost.attached(),
        routes = {},
        events = {},
        commands = {},
        commandIndex = 1,
        imageCommands = {},
        imageCommandIndex = 1,
        pump = hostpump.newPump(),
        extractor = framepacket.new(app.world),
        views = viewpacket.new(app.world)
    )
    observeInput(session)
    if session.hosted then
        routeInput(session)
    end

    return session
end

--- Creates an application session around a game-owned installation callback.
---
--- A game component exports a function with the managed `create` signature and
--- delegates here with its statically imported plugin. Rust selects that export
--- with `--entry`, so the host never dynamically requires game code.
--- @param plugin the game installation callback
--- @param title the desktop title, defaulting to `tecs`
--- @param width the positive initial logical width, defaulting to 1280
--- @param height the positive initial logical height, defaulting to 720
--- @param debug whether guarded application failures may be cleared
--- @param maxFrames an optional positive frame limit for host smoke runs
--- @return the session the embedding host keeps as a managed handle
export function createWithPlugin(
    plugin: application.Plugin,
    title: string?,
    width: integer?,
    height: integer?,
    debug: boolean?,
    maxFrames: integer?
): Session
    return newSession({
        window = {title = title, width = width, height = height},
        plugin = plugin,
        debug = debug == true,
        debugMaxFrames = maxFrames,
    })
end

--- Creates one blank application session for the Rust host.
--- @param title the desktop title, defaulting to `tecs`
--- @param width the positive initial logical width, defaulting to 1280
--- @param height the positive initial logical height, defaulting to 720
--- @param debug whether guarded application failures may be cleared
--- @param maxFrames an optional positive frame limit for host smoke runs
--- @return the session the embedding host keeps as a managed handle
export function create(title: string?, width: integer?, height: integer?, debug: boolean?, maxFrames: integer?): Session
    return newSession({
        window = {title = title, width = width, height = height},
        debug = debug == true,
        debugMaxFrames = maxFrames,
    })
end

--- Starts initialization and parks asynchronous startup work between host turns.
--- @param session the application session to initialize.
--- @return true while the host may continue driving startup or diagnostics.
export function init(exclusive session: Session): boolean
    const app = session.app
    session.pump:start(function(): boolean
        return app:init()
    end)

    return true
end

--- Starts one frame or polls the frame already parked on asynchronous work.
--- @return `parked`, `continue`, or `stopped`
export function iterate(exclusive session: Session, dt: number): hostpump.State
    const pump = session.pump
    session.app:poll(pump:parked())
    if pump:parked() then
        return pump:poll()
    end
    if session.hosted then
        -- Delivers what the host pushed since the last turn.
        suspension.poll()
    end
    local batch = session.events
    session.events = {}
    local app = session.app

    return pump:start(function(): boolean
        return app:iterate(dt, batch)
    end)
end

--- Runs application shutdown once.
export function shutdown(exclusive session: Session): boolean
    screenshot.cancelPending()
    session.pump:cancel()
    for _, route in ipairs(session.routes) do
        route:close()
    end
    session.routes = {}

    return session.app:shutdown()
end

--- Returns the first guarded application failure, if one exists.
export function crashed(borrows session: Session): string?
    return session.app:crashed()
end

--- Extracts the current renderable world into one versioned byte packet.
---
--- The viewport is the window's physical drawable size rather than its logical
--- size, because the camera projects into target pixels and the swapchain the
--- packet is drawn into is that size on every display.
--- @return the packet consumed by the Rust renderer after a completed frame
--- @param residentRevision The host's resident instance generation, or nil for an
---     independent full snapshot.
export function renderPacket(exclusive session: Session, residentRevision: integer?): string
    local width, height = session.app.window:getPixelSize()
    const views = session.views:frame(width, height, residentRevision)
    if views ~= nil then
        return views
    end
    if residentRevision ~= nil then
        return session.extractor:frame(width, height, residentRevision)
    end

    return session.extractor:packet(width, height)
end

--- Returns and consumes the next pending image residency command.
---
--- The result is a scalar tagged tuple for the managed embedding ABI. `kind`
--- selects upload, release, or material-map association. A release leaves every field
--- after `image` nil. `pixels` carries eight-bit RGBA texels with unassociated
--- alpha, four bytes per texel, in rows running top to bottom.
--- @param session the host session draining the process-wide image registry
--- @return the command kind, the serial, the image id, the width, the height,
---     the sampler index, pixel format, texel bytes, normal, emission and ORM IDs
export function nextImageCommand(
    exclusive session: Session
): string?, integer?, integer?, integer?, integer?, integer?, string?, string?, integer?, integer?, integer?
    if session.imageCommandIndex > #session.imageCommands then
        session.imageCommands = images.drain()
        session.imageCommandIndex = 1
    end
    local command = session.imageCommands[session.imageCommandIndex]
    if command == nil then
        return nil, nil, nil, nil, nil, nil, nil, nil
    end
    session.imageCommandIndex = session.imageCommandIndex + 1

    if command is images.UploadImageCommand then
        return command.kind, command.serial, command.image, command.width, command.height, command.sampler, command.format, command.pixels, nil, nil, nil
    elseif command is images.MaterialMapsCommand then
        return command.kind, command.serial, command.image, nil, nil, nil, nil, nil, command.normalMap, command.emissionMap, command.ormMap
    elseif command is images.ReleaseImageCommand then
        return command.kind, command.serial, command.image, nil, nil, nil, nil, nil
    end
end

--- Records the backend's outcome for one drained image command.
--- @param session the host session that drained the command
--- @param image the image id the command named
--- @param serial the command serial the host applied
--- @param ok whether the backend accepted the command
--- @param reason the non-empty host failure, required when `ok` is false
export function imageCommandResult(
    exclusive session: Session,
    image: integer,
    serial: integer,
    ok: boolean,
    reason: string?
): nil
    local _ = session
    images.complete(image, serial, ok, reason)
end

--- Changes whether host turns advance simulation.
export function setSuspended(exclusive session: Session, suspended: boolean): nil
    session.app:setSuspended(suspended)
end

--- Attaches the Rust-created window with a complete initial state.
export function attachWindow(
    exclusive session: Session,
    id: integer,
    title: string,
    width: integer,
    height: integer,
    pixelWidth: integer,
    pixelHeight: integer,
    scaleFactor: number,
    x: integer,
    y: integer,
    focused: boolean,
    visible: boolean,
    minimized: boolean,
    maximized: boolean,
    fullscreen: boolean,
    occluded: boolean,
    resizable: boolean,
    cursorVisible: boolean,
    cursorGrab: string
): nil
    window.attach(
        session.app.window,
        hostState(
            id,
            title,
            width,
            height,
            pixelWidth,
            pixelHeight,
            scaleFactor,
            x,
            y,
            focused,
            visible,
            minimized,
            maximized,
            fullscreen,
            occluded,
            resizable,
            cursorVisible,
            cursorGrab
        )
    )
end

--- Applies a complete state acknowledgement after processing commands.
export function applyWindowState(
    exclusive session: Session,
    id: integer,
    title: string,
    width: integer,
    height: integer,
    pixelWidth: integer,
    pixelHeight: integer,
    scaleFactor: number,
    x: integer,
    y: integer,
    focused: boolean,
    visible: boolean,
    minimized: boolean,
    maximized: boolean,
    fullscreen: boolean,
    occluded: boolean,
    resizable: boolean,
    cursorVisible: boolean,
    cursorGrab: string
): nil
    window.applyState(
        session.app.window,
        hostState(
            id,
            title,
            width,
            height,
            pixelWidth,
            pixelHeight,
            scaleFactor,
            x,
            y,
            focused,
            visible,
            minimized,
            maximized,
            fullscreen,
            occluded,
            resizable,
            cursorVisible,
            cursorGrab
        )
    )
end

--- Detaches the OS window after the host destroys it.
export function detachWindow(exclusive session: Session): nil
    window.detach(session.app.window)
end

--- Returns and consumes the next pending window command.
---
--- The result is a scalar tagged tuple for the managed embedding ABI. `text`
--- carries a title or cursor mode, `x` and `y` carry size or position, and
--- `flag` carries a boolean setter. Fields unused by a kind are nil.
export function nextWindowCommand(exclusive session: Session): string?, integer?, string?, number?, number?, boolean?
    if session.commandIndex > #session.commands then
        session.commands = window.drainCommands(session.app.window)
        session.commandIndex = 1
    end
    local command = session.commands[session.commandIndex]
    if command == nil then
        return nil, nil, nil, nil, nil, nil
    end
    session.commandIndex = session.commandIndex + 1

    if command is window.SetTitleCommand then
        return command.kind, command.serial, command.title, nil, nil, nil
    elseif command is window.SetSizeCommand then
        return command.kind, command.serial, nil, command.width, command.height, nil
    elseif command is window.SetPositionCommand then
        return command.kind, command.serial, nil, command.x, command.y, nil
    elseif command is window.SetVisibleCommand then
        return command.kind, command.serial, nil, nil, nil, command.visible
    elseif command is window.SetResizableCommand then
        return command.kind, command.serial, nil, nil, nil, command.resizable
    elseif command is window.SetFullscreenCommand then
        return command.kind, command.serial, nil, nil, nil, command.fullscreen
    elseif command is window.SetCursorVisibleCommand then
        return command.kind, command.serial, nil, nil, nil, command.visible
    elseif command is window.SetCursorGrabCommand then
        return command.kind, command.serial, command.mode, nil, nil, nil
    elseif command is window.RequestRedrawCommand then
        return command.kind, command.serial, nil, nil, nil, nil
    end
end

--- Reports one rejected command to the game-facing window.
export function windowCommandFailed(exclusive session: Session, serial: integer, reason: string): nil
    window.reportFailure(session.app.window, serial, reason)
end

--- Consumes the next explicit frame capture request.
export function nextCapture(exclusive session: Session): integer
    return screenshot.nextRequest() or 0
end

--- Delivers one completed frame readback to its requester.
export function captureResult(
    exclusive session: Session,
    id: integer,
    width: integer,
    height: integer,
    rgba: string,
    png: string,
    reason: string?
): nil
    screenshot.complete(id, width, height, rgba, png, reason)
end

--- Drains one pending model upload for the native renderer.
--- @return The model ID and geometry packet, or zero and an empty string.
export function nextModelUpload(): integer, string
    return models.nextUpload()
end
