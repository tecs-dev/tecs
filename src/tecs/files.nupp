module tecs.files

--[[
Where a game reads its shipped content from.

`nupp.io.files` owns every filesystem operation and every writable root:
reading, writing, atomic commits, directory streams, temporaries, metadata, and
the platform's own configuration, data and cache directories for one named
application. This module keeps the one thing Nupp cannot supply, because it is a
property of the product rather than of the platform: where this build's content
was installed.

```nupp
const disk = require("nupp.io.files")

disk.setApplicationIdentity("Ex Nihilo", "Starfarer")
const saves = assert(disk.dataPath()):join("saves")
disk.writeAtomic(saves:join("slot1.json"), bytes)

const level = disk.read(tecs.files.assetPath("levels/one.json"))
```

## The asset root

`assetRoot` is where shipped content lives and is never a place a build may
write. `TECS_ASSETS` wins, which is how a development run reads straight out of
a build tree instead of a staged copy. Then the `__tecsContent` global, since a
host knows the layout it installed and this is not something to sniff for. Then
the directory the running executable was loaded from, which is where a
single-directory build puts everything. `assetPath` joins against it without
checking existence, because a path that is about to be read is as valid a
request as one that is already there.

## Writable roots

A game names itself through `nupp.io.files.setApplicationIdentity` and then asks
`nupp.io.files` for `configurationPath`, `dataPath` or `cachePath`, each of
which is a distinct directory that is created before it is answered. Saves and
settings belong under `dataPath`, and anything the game can rebuild belongs
under `cachePath`, which the operating system may empty between any two runs.
`tecs.application.newApplication` names the identity `"tecs", "tecs"` when a
game named none, so an engine test and an unnamed tool write somewhere stable.
]]

const files = require("nupp.io.files")
const paths = require("nupp.io.path")

--- The platform's own separator, which is what a resolved root ends with.
const SEPARATOR: string = paths.separator()

-- Compatibility surface. `TECS_ASSETS` is what a developer exports to run a
-- build straight out of a source tree, and `__tecsContent` is the global a host
-- sets to the root it installed content under. Both are typed outside this tree
-- and neither follows this module if the module moves.

--- Read-only. Names the environment variable that overrides the asset root.
export const ASSET_ROOT_VARIABLE = "TECS_ASSETS"

--- Read-only. Names the global a host sets to the content root it installed.
export const CONTENT_GLOBAL = "__tecsContent"

local assetsCache: string? = nil

--- Returns `text` with exactly one trailing separator.
---
--- The root is concatenated with a relative path rather than joined, so the
--- separator has to be there before the concatenation rather than after it.
--- @param text the directory text to terminate
--- @return the same directory with one trailing separator
local function terminated(text: string): string
    local last = text:sub(-1)
    if last == "/" or last == "\\" then
        return text
    end

    return text .. SEPARATOR
end

--- Raises when a caller passes something that is not a usable path fragment.
--- @param value the argument to check
--- @param label the function name to name in the message
--- @return the same string
--- @raises when value is not a non-empty string
local function required(value: string, label: string): string
    if value == "" then
        error("tecs.files." .. label .. ": a path is required", 3)
    end

    return value
end

--- Returns an environment variable's value, or nil when it is unset or empty.
--- @param name the variable to read
--- @return the value, or nil
local function environment(name: string): string?
    local value = os.getenv(name)
    if value == nil or value == "" then
        return nil
    end

    return value
end

--- Reads a string global a host may have set, or nil when it did not.
--- @param name the global to read
--- @return the value, or nil
local function hostGlobal(name: string): string?
    local value = rawget(_G as {[string]: any}, name)
    if type(value) ~= "string" or value == "" then
        return nil
    end

    return value as string
end

--- Returns the root the engine reads shipped content from.
---
--- The root is resolved once and remembered, and `reset` forgets it. An empty
--- answer is not a failure: it means no override named a root and the platform
--- declined to say where the executable is, and a caller falls back to a path
--- relative to the working directory.
--- @return the root with a trailing separator, or an empty string
export function assetRoot(): string
    local held = assetsCache
    if held ~= nil then
        return held
    end
    local override = environment(ASSET_ROOT_VARIABLE) or hostGlobal(CONTENT_GLOBAL)
    if override == nil then
        override = files.executableDirectory()
    end
    local answer = override == nil and "" or terminated(override as string)
    assetsCache = answer

    return answer
end

--- Resolves `relative` against the asset root.
--- @param relative a path under the content root, with `/` separators
--- @return the joined path, without checking that anything is there
--- @raises when relative is empty
export function assetPath(relative: string): string
    local suffix = required(relative, "assetPath")

    return assetRoot() .. suffix
end

--- Overrides the asset root, for a test or a tool.
--- @param root the content directory to read from, with or without a trailing
---     separator
--- @raises when root is empty
export function setAssetRoot(root: string): nil
    assetsCache = terminated(required(root, "setAssetRoot"))
end

--- Forgets the cached asset root so the next call resolves again.
---
--- A test that moves `TECS_ASSETS` between cases needs this. A game does not:
--- nothing under a running process changes where content was installed. The
--- writable roots are `nupp.io.files`', and `resetApplicationPaths` forgets
--- those.
export function reset(): nil
    assetsCache = nil
end
