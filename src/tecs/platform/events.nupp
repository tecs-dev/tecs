module tecs.platform.events

--[[
Typed platform events produced by the Rust host.

Every kind is its own `nupp.events` declaration, so a world delivers a key
press to the observers of `KeyDown` and nothing else, and the twelve shapes
the kinds share are unions of the declarations that carry them. Kind strings
are a stable external data surface used by recordings and tools. Rust
translates `winit` events into these records and passes one ordered batch to
`tecs.application.Application:iterate`.
]]

local ecs = require("tecs.ecs")
local events = require("nupp.events")

--- A platform event kind supported by the Rust host.
export type Kind = "quit"
    | "windowCloseRequested"
    | "windowResized"
    | "windowScaleChanged"
    | "windowFocusGained"
    | "windowFocusLost"
    | "keyDown"
    | "keyUp"
    | "mouseMotion"
    | "mouseDown"
    | "mouseUp"
    | "mouseWheel"
    | "textInput"
    | "fingerDown"
    | "fingerUp"
    | "fingerMotion"
    | "fingerCanceled"
    | "gamepadAdded"
    | "gamepadRemoved"
    | "gamepadButtonDown"
    | "gamepadButtonUp"
    | "gamepadAxis"

--- Returns every platform event kind, in the union's declared order.
---
--- Compatibility surface: each string is the externally typed kind an agent
--- names over the debug protocol, so the spellings here are the same ones
--- `Kind` declares and must not change with a module move. The union is a
--- type and cannot be read at run time, so a caller that needs the kinds as
--- data reads them here rather than keeping a second copy that drifts.
--- @return a fresh caller-owned list of the twenty-two kind strings
export function kinds(): {string}
    return {
        "quit",
        "windowCloseRequested",
        "windowResized",
        "windowScaleChanged",
        "windowFocusGained",
        "windowFocusLost",
        "keyDown",
        "keyUp",
        "mouseMotion",
        "mouseDown",
        "mouseUp",
        "mouseWheel",
        "textInput",
        "fingerDown",
        "fingerUp",
        "fingerMotion",
        "fingerCanceled",
        "gamepadAdded",
        "gamepadRemoved",
        "gamepadButtonDown",
        "gamepadButtonUp",
        "gamepadAxis",
    }
end

--- A process quit request.
@derive(events.Event)
@event(name = "tecs.platform.events.quit")
export record Quit
    kind: "quit"
    timestamp: number
    sequence: integer
    window: integer
end

--- A close request for one window.
@derive(events.Event)
@event(name = "tecs.platform.events.windowCloseRequested")
export record WindowCloseRequested
    kind: "windowCloseRequested"
    timestamp: number
    sequence: integer
    window: integer
end

--- A process or window close request.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type QuitEvent = Quit | WindowCloseRequested

--- A logical window resize.
@derive(events.Event)
@event(name = "tecs.platform.events.windowResized")
export record WindowResized
    kind: "windowResized"
    timestamp: number
    sequence: integer
    window: integer
    width: integer
    height: integer
    pixelWidth: integer
    pixelHeight: integer
    scaleFactor: number
end

--- A scale-factor change with the resulting logical size.
@derive(events.Event)
@event(name = "tecs.platform.events.windowScaleChanged")
export record WindowScaleChanged
    kind: "windowScaleChanged"
    timestamp: number
    sequence: integer
    window: integer
    width: integer
    height: integer
    pixelWidth: integer
    pixelHeight: integer
    scaleFactor: number
end

--- A logical window size change.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type ResizeEvent = WindowResized | WindowScaleChanged

--- A window gaining focus.
@derive(events.Event)
@event(name = "tecs.platform.events.windowFocusGained")
export record WindowFocusGained
    kind: "windowFocusGained"
    timestamp: number
    sequence: integer
    window: integer
    focused: boolean
end

--- A window losing focus.
@derive(events.Event)
@event(name = "tecs.platform.events.windowFocusLost")
export record WindowFocusLost
    kind: "windowFocusLost"
    timestamp: number
    sequence: integer
    window: integer
    focused: boolean
end

--- A window focus transition.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type FocusEvent = WindowFocusGained | WindowFocusLost

--- A key going down.
@derive(events.Event)
@event(name = "tecs.platform.events.keyDown")
export record KeyDown
    kind: "keyDown"
    timestamp: number
    sequence: integer
    window: integer
    physicalKey: string
    logicalKey: string?
    text: string?
    modifiers: integer
    repeated: boolean
    down: boolean
end

--- A key coming up.
@derive(events.Event)
@event(name = "tecs.platform.events.keyUp")
export record KeyUp
    kind: "keyUp"
    timestamp: number
    sequence: integer
    window: integer
    physicalKey: string
    logicalKey: string?
    text: string?
    modifiers: integer
    repeated: boolean
    down: boolean
end

--- A physical and logical keyboard transition.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type KeyEvent = KeyDown | KeyUp

--- An absolute pointer position and optional relative movement.
@derive(events.Event)
@event(name = "tecs.platform.events.mouseMotion")
export record MouseMotion
    kind: "mouseMotion"
    timestamp: number
    sequence: integer
    window: integer
    x: number
    y: number
    dx: number
    dy: number
end

--- An absolute pointer position and optional relative movement.
export type PointerMoveEvent = MouseMotion

--- A pointer button going down.
@derive(events.Event)
@event(name = "tecs.platform.events.mouseDown")
export record MouseDown
    kind: "mouseDown"
    timestamp: number
    sequence: integer
    window: integer
    x: number
    y: number
    button: integer
    clicks: integer
    down: boolean
end

--- A pointer button coming up.
@derive(events.Event)
@event(name = "tecs.platform.events.mouseUp")
export record MouseUp
    kind: "mouseUp"
    timestamp: number
    sequence: integer
    window: integer
    x: number
    y: number
    button: integer
    clicks: integer
    down: boolean
end

--- A pointer button transition.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type PointerButtonEvent = MouseDown | MouseUp

--- A normalized pointer wheel movement.
@derive(events.Event)
@event(name = "tecs.platform.events.mouseWheel")
export record MouseWheel
    kind: "mouseWheel"
    timestamp: number
    sequence: integer
    window: integer
    x: number
    y: number
    wheelX: number
    wheelY: number
    wheelTicksX: integer
    wheelTicksY: integer
end

--- A normalized pointer wheel movement.
export type WheelEvent = MouseWheel

--- Text committed by the platform input method.
@derive(events.Event)
@event(name = "tecs.platform.events.textInput")
export record TextInput
    kind: "textInput"
    timestamp: number
    sequence: integer
    window: integer
    text: string
end

--- Text committed by the platform input method.
export type TextEvent = TextInput

--- A finger touching the surface.
@derive(events.Event)
@event(name = "tecs.platform.events.fingerDown")
export record FingerDown
    kind: "fingerDown"
    timestamp: number
    sequence: integer
    window: integer
    touchDevice: string
    finger: string
    x: number
    y: number
    dx: number
    dy: number
    normalX: number
    normalY: number
    pressure: number
    down: boolean
end

--- A finger leaving the surface.
@derive(events.Event)
@event(name = "tecs.platform.events.fingerUp")
export record FingerUp
    kind: "fingerUp"
    timestamp: number
    sequence: integer
    window: integer
    touchDevice: string
    finger: string
    x: number
    y: number
    dx: number
    dy: number
    normalX: number
    normalY: number
    pressure: number
    down: boolean
end

--- A finger moving on the surface.
@derive(events.Event)
@event(name = "tecs.platform.events.fingerMotion")
export record FingerMotion
    kind: "fingerMotion"
    timestamp: number
    sequence: integer
    window: integer
    touchDevice: string
    finger: string
    x: number
    y: number
    dx: number
    dy: number
    normalX: number
    normalY: number
    pressure: number
    down: boolean
end

--- A touch the platform cancelled.
@derive(events.Event)
@event(name = "tecs.platform.events.fingerCanceled")
export record FingerCanceled
    kind: "fingerCanceled"
    timestamp: number
    sequence: integer
    window: integer
    touchDevice: string
    finger: string
    x: number
    y: number
    dx: number
    dy: number
    normalX: number
    normalY: number
    pressure: number
    down: boolean
end

--- One finger on a touch surface.
---
--- Compatibility surface: `touchDevice` and `finger` are stable field names,
--- and both stay strings because a device and a finger are 64-bit identities
--- that a Lua number would round together.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type TouchEvent = FingerDown | FingerUp | FingerMotion | FingerCanceled

--- A gamepad appearing.
@derive(events.Event)
@event(name = "tecs.platform.events.gamepadAdded")
export record GamepadAdded
    kind: "gamepadAdded"
    timestamp: number
    sequence: integer
    window: integer
    which: integer
end

--- A gamepad going away.
@derive(events.Event)
@event(name = "tecs.platform.events.gamepadRemoved")
export record GamepadRemoved
    kind: "gamepadRemoved"
    timestamp: number
    sequence: integer
    window: integer
    which: integer
end

--- A gamepad appearing or going away.
---
--- Compatibility surface: `which` names the device rather than the window.
--- `window` is zero because a gamepad belongs to no window.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type GamepadDeviceEvent = GamepadAdded | GamepadRemoved

--- A gamepad button going down.
@derive(events.Event)
@event(name = "tecs.platform.events.gamepadButtonDown")
export record GamepadButtonDown
    kind: "gamepadButtonDown"
    timestamp: number
    sequence: integer
    window: integer
    which: integer
    button: integer
    down: boolean
end

--- A gamepad button coming up.
@derive(events.Event)
@event(name = "tecs.platform.events.gamepadButtonUp")
export record GamepadButtonUp
    kind: "gamepadButtonUp"
    timestamp: number
    sequence: integer
    window: integer
    which: integer
    button: integer
    down: boolean
end

--- A gamepad button transition.
---
--- Whichever kind carries this shape; an observer written against it fits any of them.
export type GamepadButtonEvent = GamepadButtonDown | GamepadButtonUp

--- A gamepad axis reading.
@derive(events.Event)
@event(name = "tecs.platform.events.gamepadAxis")
export record GamepadAxis
    kind: "gamepadAxis"
    timestamp: number
    sequence: integer
    window: integer
    which: integer
    axis: integer
    value: number
end

--- A gamepad axis reading.
export type GamepadAxisEvent = GamepadAxis

--- An event in one sealed host batch.
export type Event = Quit
    | WindowCloseRequested
    | WindowResized
    | WindowScaleChanged
    | WindowFocusGained
    | WindowFocusLost
    | KeyDown
    | KeyUp
    | MouseMotion
    | MouseDown
    | MouseUp
    | MouseWheel
    | TextInput
    | FingerDown
    | FingerUp
    | FingerMotion
    | FingerCanceled
    | GamepadAdded
    | GamepadRemoved
    | GamepadButtonDown
    | GamepadButtonUp
    | GamepadAxis

--- Constructs a process or window close request.
export function quit(window: integer?, timestamp: number?, sequence: integer?): QuitEvent
    return new Quit(kind = "quit", timestamp = timestamp or 0, sequence = sequence or 0, window = window or 0)
end

--- Constructs a close request for one window.
export function closeRequested(window: integer?, timestamp: number?, sequence: integer?): QuitEvent
    return new WindowCloseRequested(
        kind = "windowCloseRequested",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0
    )
end

--- Constructs a logical window resize.
export function resized(
    width: integer,
    height: integer,
    window: integer?,
    scaleFactor: number?,
    timestamp: number?,
    sequence: integer?,
    pixelWidth: integer?,
    pixelHeight: integer?
): ResizeEvent
    if width < 0 or height < 0 then
        error("platform.events.resized: dimensions must be non-negative", 2)
    end
    local scale = scaleFactor or 1
    if scale <= 0 or scale ~= scale then
        error("platform.events.resized: scaleFactor must be greater than zero", 2)
    end
    local physicalWidth = pixelWidth or math.floor(width * scale + 0.5)
    local physicalHeight = pixelHeight or math.floor(height * scale + 0.5)
    if physicalWidth < 0 or physicalHeight < 0 then
        error("platform.events.resized: pixel dimensions must be non-negative", 2)
    end

    return new WindowResized(
        kind = "windowResized",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        width = width,
        height = height,
        pixelWidth = physicalWidth,
        pixelHeight = physicalHeight,
        scaleFactor = scale
    )
end

--- Constructs a scale-factor change with the resulting logical size.
export function scaleChanged(
    scaleFactor: number,
    width: integer,
    height: integer,
    window: integer?,
    timestamp: number?,
    sequence: integer?,
    pixelWidth: integer?,
    pixelHeight: integer?
): ResizeEvent
    local sized = resized(width, height, window, scaleFactor, timestamp, sequence, pixelWidth, pixelHeight)

    return new WindowScaleChanged(
        kind = "windowScaleChanged",
        timestamp = sized.timestamp,
        sequence = sized.sequence,
        window = sized.window,
        width = sized.width,
        height = sized.height,
        pixelWidth = sized.pixelWidth,
        pixelHeight = sized.pixelHeight,
        scaleFactor = sized.scaleFactor
    )
end

--- Constructs a window focus transition.
export function focused(focused: boolean, window: integer?, timestamp: number?, sequence: integer?): FocusEvent
    if focused then
        return new WindowFocusGained(
            kind = "windowFocusGained",
            timestamp = timestamp or 0,
            sequence = sequence or 0,
            window = window or 0,
            focused = true
        )
    end

    return new WindowFocusLost(
        kind = "windowFocusLost",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        focused = false
    )
end

--- Constructs a keyboard transition.
export function key(
    down: boolean,
    physicalKey: string,
    logicalKey: string?,
    text: string?,
    modifiers: integer?,
    repeated: boolean?,
    window: integer?,
    timestamp: number?,
    sequence: integer?
): KeyEvent
    if physicalKey == "" then
        error("platform.events.key: physicalKey must not be empty", 2)
    end
    if down then
        return new KeyDown(
            kind = "keyDown",
            timestamp = timestamp or 0,
            sequence = sequence or 0,
            window = window or 0,
            physicalKey = physicalKey,
            logicalKey = logicalKey,
            text = text,
            modifiers = modifiers or 0,
            repeated = repeated == true,
            down = true
        )
    end

    return new KeyUp(
        kind = "keyUp",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        physicalKey = physicalKey,
        logicalKey = logicalKey,
        text = text,
        modifiers = modifiers or 0,
        repeated = repeated == true,
        down = false
    )
end

--- Constructs an absolute pointer movement.
export function pointerMoved(
    x: number,
    y: number,
    dx: number?,
    dy: number?,
    window: integer?,
    timestamp: number?,
    sequence: integer?
): PointerMoveEvent
    return new MouseMotion(
        kind = "mouseMotion",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        x = x,
        y = y,
        dx = dx or 0,
        dy = dy or 0
    )
end

--- Constructs a pointer button transition.
export function pointerButton(
    down: boolean,
    button: integer,
    x: number,
    y: number,
    clicks: integer?,
    window: integer?,
    timestamp: number?,
    sequence: integer?
): PointerButtonEvent
    if button < 1 then
        error("platform.events.pointerButton: button must be positive", 2)
    end
    if down then
        return new MouseDown(
            kind = "mouseDown",
            timestamp = timestamp or 0,
            sequence = sequence or 0,
            window = window or 0,
            x = x,
            y = y,
            button = button,
            clicks = clicks or 1,
            down = true
        )
    end

    return new MouseUp(
        kind = "mouseUp",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        x = x,
        y = y,
        button = button,
        clicks = clicks or 1,
        down = false
    )
end

--- Constructs normalized pointer wheel movement.
export function wheel(
    wheelX: number,
    wheelY: number,
    ticksX: integer?,
    ticksY: integer?,
    x: number?,
    y: number?,
    window: integer?,
    timestamp: number?,
    sequence: integer?
): WheelEvent
    return new MouseWheel(
        kind = "mouseWheel",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        x = x or 0,
        y = y or 0,
        wheelX = wheelX,
        wheelY = wheelY,
        wheelTicksX = ticksX or 0,
        wheelTicksY = ticksY or 0
    )
end

--- Constructs committed text input.
export function text(text: string, window: integer?, timestamp: number?, sequence: integer?): TextEvent
    return new TextInput(
        kind = "textInput",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = window or 0,
        text = text
    )
end

--- Constructs one finger's transition or movement.
---
--- `x` and `y` are in the window's logical coordinates, `normalX` and `normalY`
--- run from zero to one across the touch surface, and `pressure` runs from zero
--- to one where the surface reports it and is one where it does not.
--- @param phase the finger's transition, spelled as the event kind
--- @param touchDevice the touch surface's opaque identity
--- @param finger the finger's opaque identity on that surface
--- @param x the position in logical window coordinates
--- @param y the position in logical window coordinates
--- @param normalX the position across the surface, from zero to one
--- @param normalY the position down the surface, from zero to one
--- @param pressure the reported pressure from zero to one
--- @param dx the movement since the previous event, in logical coordinates
--- @param dy the movement since the previous event, in logical coordinates
--- @param window the window the touch is over
--- @param timestamp the host time the platform reported
--- @param sequence the host's ordering number for the batch
--- @return the constructed touch event
--- @raises when the finger identity is empty
export function touch(
    phase: "fingerDown" | "fingerUp" | "fingerMotion" | "fingerCanceled",
    touchDevice: string,
    finger: string,
    x: number,
    y: number,
    normalX: number?,
    normalY: number?,
    pressure: number?,
    dx: number?,
    dy: number?,
    window: integer?,
    timestamp: number?,
    sequence: integer?
): TouchEvent
    if finger == "" then
        error("platform.events.touch: finger must not be empty", 2)
    end

    local at, order, over = timestamp or 0, sequence or 0, window or 0
    local moveX, moveY, nx, ny, force = dx or 0, dy or 0, normalX or 0, normalY or 0, pressure or 0
    if phase == "fingerDown" then
        return new FingerDown(
            kind = "fingerDown",
            timestamp = at,
            sequence = order,
            window = over,
            touchDevice = touchDevice,
            finger = finger,
            x = x,
            y = y,
            dx = moveX,
            dy = moveY,
            normalX = nx,
            normalY = ny,
            pressure = force,
            down = true
        )
    elseif phase == "fingerMotion" then
        return new FingerMotion(
            kind = "fingerMotion",
            timestamp = at,
            sequence = order,
            window = over,
            touchDevice = touchDevice,
            finger = finger,
            x = x,
            y = y,
            dx = moveX,
            dy = moveY,
            normalX = nx,
            normalY = ny,
            pressure = force,
            down = true
        )
    elseif phase == "fingerUp" then
        return new FingerUp(
            kind = "fingerUp",
            timestamp = at,
            sequence = order,
            window = over,
            touchDevice = touchDevice,
            finger = finger,
            x = x,
            y = y,
            dx = moveX,
            dy = moveY,
            normalX = nx,
            normalY = ny,
            pressure = force,
            down = false
        )
    else
        return new FingerCanceled(
            kind = "fingerCanceled",
            timestamp = at,
            sequence = order,
            window = over,
            touchDevice = touchDevice,
            finger = finger,
            x = x,
            y = y,
            dx = moveX,
            dy = moveY,
            normalX = nx,
            normalY = ny,
            pressure = force,
            down = false
        )
    end
end

--- Constructs a gamepad appearing or going away.
--- @param added whether the device appeared rather than went away
--- @param which the device identifier the backend issued
--- @param timestamp the host time the platform reported
--- @param sequence the host's ordering number for the batch
--- @return the constructed device event
export function gamepadDevice(
    added: boolean,
    which: integer,
    timestamp: number?,
    sequence: integer?
): GamepadDeviceEvent
    if added then
        return new GamepadAdded(
            kind = "gamepadAdded",
            timestamp = timestamp or 0,
            sequence = sequence or 0,
            window = 0,
            which = which
        )
    end

    return new GamepadRemoved(
        kind = "gamepadRemoved",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = 0,
        which = which
    )
end

--- Constructs a gamepad button transition.
--- @param down whether the button went down rather than came up
--- @param which the device identifier the backend issued
--- @param button the positional button code `tecs.input` resolves a name to
--- @param timestamp the host time the platform reported
--- @param sequence the host's ordering number for the batch
--- @return the constructed button event
--- @raises when the button code is not positive
export function gamepadButton(
    down: boolean,
    which: integer,
    button: integer,
    timestamp: number?,
    sequence: integer?
): GamepadButtonEvent
    if button < 1 then
        error("platform.events.gamepadButton: button must be positive", 2)
    end

    if down then
        return new GamepadButtonDown(
            kind = "gamepadButtonDown",
            timestamp = timestamp or 0,
            sequence = sequence or 0,
            window = 0,
            which = which,
            button = button,
            down = true
        )
    end

    return new GamepadButtonUp(
        kind = "gamepadButtonUp",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = 0,
        which = which,
        button = button,
        down = false
    )
end

--- Constructs a gamepad axis reading.
--- @param which the device identifier the backend issued
--- @param axis the axis code `tecs.input` resolves a name to
--- @param value the reading from -1 to 1, with a trigger running zero to one
--- @param timestamp the host time the platform reported
--- @param sequence the host's ordering number for the batch
--- @return the constructed axis event
--- @raises when the axis code is not positive
export function gamepadAxis(
    which: integer,
    axis: integer,
    value: number,
    timestamp: number?,
    sequence: integer?
): GamepadAxisEvent
    if axis < 1 then
        error("platform.events.gamepadAxis: axis must be positive", 2)
    end

    return new GamepadAxis(
        kind = "gamepadAxis",
        timestamp = timestamp or 0,
        sequence = sequence or 0,
        window = 0,
        which = which,
        axis = axis,
        value = value
    )
end

--- Delivers one translated event to the world's observers of its kind.
---
--- The host's instance is delivered as it is: nothing is copied or constructed,
--- and observers receive it as a borrow for the call.
--- @param world the receiving world
--- @param event the translated platform event
export function dispatch(exclusive world: ecs.World, event: Event): nil
    if event is Quit then
        world:deliver(0, Quit, event)
    elseif event is WindowCloseRequested then
        world:deliver(0, WindowCloseRequested, event)
    elseif event is WindowResized then
        world:deliver(0, WindowResized, event)
    elseif event is WindowScaleChanged then
        world:deliver(0, WindowScaleChanged, event)
    elseif event is WindowFocusGained then
        world:deliver(0, WindowFocusGained, event)
    elseif event is WindowFocusLost then
        world:deliver(0, WindowFocusLost, event)
    elseif event is KeyDown then
        world:deliver(0, KeyDown, event)
    elseif event is KeyUp then
        world:deliver(0, KeyUp, event)
    elseif event is MouseMotion then
        world:deliver(0, MouseMotion, event)
    elseif event is MouseDown then
        world:deliver(0, MouseDown, event)
    elseif event is MouseUp then
        world:deliver(0, MouseUp, event)
    elseif event is MouseWheel then
        world:deliver(0, MouseWheel, event)
    elseif event is TextInput then
        world:deliver(0, TextInput, event)
    elseif event is FingerDown then
        world:deliver(0, FingerDown, event)
    elseif event is FingerUp then
        world:deliver(0, FingerUp, event)
    elseif event is FingerMotion then
        world:deliver(0, FingerMotion, event)
    elseif event is FingerCanceled then
        world:deliver(0, FingerCanceled, event)
    elseif event is GamepadAdded then
        world:deliver(0, GamepadAdded, event)
    elseif event is GamepadRemoved then
        world:deliver(0, GamepadRemoved, event)
    elseif event is GamepadButtonDown then
        world:deliver(0, GamepadButtonDown, event)
    elseif event is GamepadButtonUp then
        world:deliver(0, GamepadButtonUp, event)
    elseif event is GamepadAxis then
        world:deliver(0, GamepadAxis, event)
    end
end
