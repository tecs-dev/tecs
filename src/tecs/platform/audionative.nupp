module tecs.platform.audionative

--[[
The `tecsaudio` binding behind the audio backend contract.

Loading this module loads `libtecsaudio` through
`tecs.internal.nativelibrary`, so a build that cannot find the library raises
here rather than anywhere later. `tecs.audio` requires it through `pcall` for
exactly that reason and falls back to `tecs.platform.audiobackend.silent` when
it is absent.

Commands cross as one contiguous C array per flush and finished voices come back
as a second one. Nothing in the library ever calls a Nupp function: a `cpal`
output callback runs on a thread the Lua virtual machine never created, and
entering Nupp from there is undefined. Every observation is therefore pulled by
`drain` from the frame thread instead, which is why this binding declares no
function pointer anywhere.

```nupp
local audionative <const> = require("tecs.platform.audionative")

local backend <const> = assert(audionative.open(48000, 2, 32))
```
]]

local audiobackend = require("tecs.platform.audiobackend")
local nativelibrary = require("tecs.internal.nativelibrary")
local ffilib = require("ffi")

nativelibrary.open("tecsaudio", "TECS_AUDIO_LIBRARY")

--- Reads a NUL-terminated C string the library owns.
---
--- `ffi.string` carries no Nupp declaration, so the binding states the one it
--- uses rather than reaching for `any` at each call site.
local readCString: function(value: cstring?): string = ffilib.string as any

--- Reads `length` bytes from memory the library filled.
---
--- The captured samples are the one raw block on this seam, and they carry
--- zeroes, so the length has to come from the call rather than from a
--- terminator.
local readBytes: function(value: any, length: integer): string = ffilib.string as any

--- Bytes one interleaved sample occupies, which the C ABI fixes at four.
local BYTES_PER_SAMPLE: integer = 4

cdef struct tecsAudioCommand
    kind: uint32
    handle: uint32
    clip: uint32
    flags: uint32
    gain: float
    pitch: float
    start: float
    fade: float
    loopStart: float
    x: float
    y: float
    z: float
end

cdef struct tecsAudioEvent
    kind: uint32
    handle: uint32
end

cdef struct tecsAudioClipInfo
    duration: float
    resident: int32
end

--- One captured sample, so a block of them can be a `carray`.
---
--- `carray` takes a struct type, and the captured samples are bare floats, so
--- the block is declared as an array of one-field structs instead. A struct
--- holding one float has that float's size and alignment under every ABI this
--- tree targets, so `tecsAudioSample*` and `float*` describe the same memory
--- and the library's own declaration stays `float*`. Nothing about the layout
--- is negotiable, which is why this is not in `tecs_audio_layout`: the C ABI
--- fixes a float at four bytes and there is no second description to drift
--- from.
cdef struct tecsAudioSample
    value: float
end

-- Every entry point takes the device as a borrow, including `tecs_audio_close`.
-- The library frees the device inside that call and the binding must not touch
-- the pointer afterwards, which is a fact the checker cannot hold here: the
-- pointer lives in the closure set below rather than in a lexical scope, so
-- there is no owner for an affine obligation to sit on.

cdef function tecs_audio_open(frequency: uint32, channels: uint32, maxVoices: uint32): voidptr?

cdef function tecs_audio_open_offline(frequency: uint32, channels: uint32, maxVoices: uint32): voidptr?

cdef function tecs_audio_close(borrows device: voidptr?)

cdef function tecs_audio_available(borrows device: voidptr?): int32

cdef function tecs_audio_frequency(borrows device: voidptr?): uint32

cdef function tecs_audio_channels(borrows device: voidptr?): uint32

cdef function tecs_audio_submit(borrows device: voidptr?, borrows commands: tecsAudioCommand*, count: uint32)

cdef function tecs_audio_drain(borrows device: voidptr?, borrows events: tecsAudioEvent*, capacity: uint32): uint32

cdef function tecs_audio_load_clip(
    borrows device: voidptr?,
    path: cstring,
    clip: uint32,
    mode: uint32,
    streamSeconds: float,
    borrows info: tecsAudioClipInfo*
): int32

cdef function tecs_audio_release_clip(borrows device: voidptr?, clip: uint32)

cdef function tecs_audio_position(borrows device: voidptr?, handle: uint32): float

cdef function tecs_audio_seek(borrows device: voidptr?, handle: uint32, seconds: float): int32

cdef function tecs_audio_decoders(borrows device: voidptr?): cstring?

cdef function tecs_audio_last_error(borrows device: voidptr?): cstring?

cdef function tecs_audio_layout(kind: uint32): uint32

-- Device listing and recording. Neither a listing nor a capture crosses as a
-- struct: a device name has no fixed width worth choosing, and a capture is a
-- handle. So these add nothing for `layoutMismatch` to compare, and the
-- interleaved float samples a read produces are the one raw block, which the C
-- ABI already fixes at four bytes each.

cdef function tecs_audio_open_error(): cstring?

cdef function tecs_audio_devices(recording: uint32): voidptr?

cdef function tecs_audio_devices_count(borrows list: voidptr?): uint32

cdef function tecs_audio_devices_id(borrows list: voidptr?, index: uint32): uint32

cdef function tecs_audio_devices_name(borrows list: voidptr?, index: uint32): cstring?

cdef function tecs_audio_devices_frequency(borrows list: voidptr?, index: uint32): uint32

cdef function tecs_audio_devices_channels(borrows list: voidptr?, index: uint32): uint32

cdef function tecs_audio_devices_free(borrows list: voidptr?)

cdef function tecs_audio_open_microphone(
    device: uint32,
    name: cstring?,
    frequency: uint32,
    channels: uint32,
    bufferFrames: uint32
): voidptr?

cdef function tecs_audio_open_microphone_offline(frequency: uint32, channels: uint32, bufferFrames: uint32): voidptr?

cdef function tecs_audio_microphone_close(borrows microphone: voidptr?)

cdef function tecs_audio_microphone_frequency(borrows microphone: voidptr?): uint32

cdef function tecs_audio_microphone_channels(borrows microphone: voidptr?): uint32

cdef function tecs_audio_microphone_available(borrows microphone: voidptr?): uint32

cdef function tecs_audio_microphone_overruns(borrows microphone: voidptr?): uint32

-- The library declares these two as `float *`. They are declared here as
-- `tecsAudioSample *`, which is the same memory: `carray` needs a struct type,
-- and LuaJIT refuses to convert an array of one-field structs to a pointer to
-- its field even though the two describe identical bytes. Naming the struct on
-- both sides of the call is what makes the conversion legal without a cast that
-- would hide a real mismatch.

cdef function tecs_audio_microphone_read(
    borrows microphone: voidptr?,
    borrows out: tecsAudioSample*,
    maxFrames: uint32
): int32

cdef function tecs_audio_microphone_write(
    borrows microphone: voidptr?,
    borrows samples: tecsAudioSample*,
    frames: uint32
): uint32

cdef function tecs_audio_microphone_pause(borrows microphone: voidptr?): int32

cdef function tecs_audio_microphone_resume(borrows microphone: voidptr?): int32

cdef function tecs_audio_microphone_last_error(borrows microphone: voidptr?): cstring?

--- Commands buffered before one crossing, and events pulled back in one.
---
--- Both arrays are allocated once and reused, because the seam is crossed every
--- frame and a per-frame allocation on a path that exists to avoid per-voice
--- calls would give the saving straight back.
local CAPACITY: integer = 512

--- Selects a load that measures the clip against the streaming threshold.
local MODE_AUTO: integer = 0

--- Selects a load that holds decoded samples in memory.
local MODE_RESIDENT: integer = 1

--- Selects a load each voice reads from the file for itself.
local MODE_STREAM: integer = 2

--- The event kind reporting that a voice has finished.
local EVENT_FINISHED: integer = 1

--- Selects the command struct in `tecs_audio_layout`.
local LAYOUT_COMMAND: integer = 0

--- Selects the event struct in `tecs_audio_layout`.
local LAYOUT_EVENT: integer = 1

--- Selects the clip-info struct in `tecs_audio_layout`.
local LAYOUT_CLIP_INFO: integer = 2

--- Reports where LuaJIT and the library disagree about a struct size.
---
--- Two descriptions of one memory layout can drift, and the failure a drift
--- produces is a voice at the wrong pitch rather than a call that will not
--- link. Comparing sizes once at open is what turns that into a refusal.
---
--- @return the reason, or nil when every struct agrees
local function layoutMismatch(): string?
    local names: {string} = {"tecsAudioCommand", "tecsAudioEvent", "tecsAudioClipInfo"}
    local kinds: {integer} = {LAYOUT_COMMAND, LAYOUT_EVENT, LAYOUT_CLIP_INFO}
    local sizes: {
        integer
    } = {ffi.sizeof<tecsAudioCommand>(), ffi.sizeof<tecsAudioEvent>(), ffi.sizeof<tecsAudioClipInfo>(),}
    for index = 1, #kinds do
        local reported = tecs_audio_layout(kinds[index] as uint32) as integer
        if reported ~= sizes[index] then
            return "libtecsaudio reports " .. names[
                index
            ] .. " as " .. tostring(reported) .. " bytes and this binding declares " .. tostring(sizes[index])
        end
    end

    return nil
end

local function modeCode(mode: audiobackend.LoadMode): integer
    if mode == "resident" then
        return MODE_RESIDENT
    elseif mode == "stream" then
        return MODE_STREAM
    else
        return MODE_AUTO
    end
end

--- Wraps an open library device in the backend contract.
local function wrap(device: voidptr?): audiobackend.Backend
    local commands = carray(tecsAudioCommand, CAPACITY)
    local events = carray(tecsAudioEvent, CAPACITY)
    local info = ffi.new<tecsAudioClipInfo>()

    local function reason(fallback: string): string
        local message = tecs_audio_last_error(device)
        if message == nil then
            return fallback
        end
        local text = readCString(message)
        if text == "" then
            return fallback
        end

        return text
    end

    local function submit(pending: {audiobackend.Command}, count: integer): nil
        local written: integer = 0
        for index = 1, count do
            local source = pending[index]
            -- The index stays below `CAPACITY` because the flush below resets
            -- it there, which is the bound the checker has no way to read off
            -- a `carray` handle.
            unsafe do
                local target = commands[written]
                target.kind = source.kind as uint32
                target.handle = source.handle as uint32
                target.clip = source.clip as uint32
                target.flags = source.flags as uint32
                target.gain = nupp.math.f32.narrow(source.gain)
                target.pitch = nupp.math.f32.narrow(source.pitch)
                target.start = nupp.math.f32.narrow(source.start)
                target.fade = nupp.math.f32.narrow(source.fade)
                target.loopStart = nupp.math.f32.narrow(source.loopStart)
                target.x = nupp.math.f32.narrow(source.x)
                target.y = nupp.math.f32.narrow(source.y)
                target.z = nupp.math.f32.narrow(source.z)
            end
            written = written + 1
            if written == CAPACITY then
                tecs_audio_submit(device, commands, written as uint32)
                written = 0
            end
        end
        if written > 0 then
            tecs_audio_submit(device, commands, written as uint32)
        end
    end

    local function drain(out: {integer}): integer
        local capacity = #out
        if capacity > CAPACITY then
            capacity = CAPACITY
        end
        local count = tecs_audio_drain(device, events, capacity as uint32) as integer
        local written: integer = 0
        for index = 0, count - 1 do
            -- The library answers with at most the capacity it was given, so
            -- the read stays inside the array this call allocated.
            unsafe do
                if events[index].kind as integer == EVENT_FINISHED then
                    written = written + 1
                    out[written] = events[index].handle as integer
                end
            end
        end

        return written
    end

    local function loadClip(
        path: string,
        clip: integer,
        mode: audiobackend.LoadMode,
        streamSeconds: number
    ): (audiobackend.ClipInfo?, string?)
        local status = tecs_audio_load_clip(
            device,
            path,
            clip as uint32,
            modeCode(mode) as uint32,
            nupp.math.f32.narrow(streamSeconds),
            info
        )
        if status ~= 0 then
            return nil, reason("tecsaudio could not read '" .. path .. "'")
        end

        return new audiobackend.ClipInfo(duration = info.duration as number, resident = info.resident ~= 0)
    end

    return new audiobackend.Backend(
        available = tecs_audio_available(device) ~= 0,
        frequency = tecs_audio_frequency(device) as integer,
        channels = tecs_audio_channels(device) as integer,
        submit = submit,
        drain = drain,
        loadClip = loadClip,
        releaseClip = function(clip: integer): nil
            tecs_audio_release_clip(device, clip as uint32)
        end,
        position = function(handle: integer): number?
            local seconds = tecs_audio_position(device, handle as uint32) as number
            if seconds < 0 then
                return nil
            end

            return seconds
        end,
        seek = function(handle: integer, seconds: number): boolean
            return tecs_audio_seek(device, handle as uint32, nupp.math.f32.narrow(seconds)) ~= 0
        end,
        decoders = function(): {string}
            local joined = tecs_audio_decoders(device)
            if joined == nil then
                return {}
            end
            local names: {string} = {}
            for name in readCString(joined):gmatch("[^,]+") do
                names[#names + 1] = name
            end

            return names
        end,
        close = function(): nil
            tecs_audio_close(device)
        end
    )
end

--- Opens the platform's default output and returns it as a backend.
---
--- @param frequency the requested output frequency in frames per second
--- @param channels the requested number of output channels
--- @param maxVoices the greatest number of voices the mixer holds at once
--- @return the backend, or nil when the library opened nothing
--- @return the reason, when the first return is nil
export function open(frequency: integer, channels: integer, maxVoices: integer): (audiobackend.Backend?, string?)
    local mismatch = layoutMismatch()
    if mismatch ~= nil then
        return nil, mismatch
    end
    local device = tecs_audio_open(frequency as uint32, channels as uint32, maxVoices as uint32)
    if device == nil then
        return nil, "tecsaudio opened no output"
    end

    return wrap(device)
end

--- Opens a backend that touches no output device.
---
--- Every command still crosses and every query still answers; the mix goes
--- nowhere unless the caller renders it, which nothing on this side does. This
--- is what a test that has to prove the seam without needing a sound card
--- reaches for, and it is deliberately not what `tecs.audio` opens: opening a
--- real output can block inside the platform's audio daemon, and a headless
--- suite must not be able to.
---
--- @param frequency the output frequency in frames per second
--- @param channels the number of output channels
--- @param maxVoices the greatest number of voices the mixer holds at once
--- @return the backend, or nil when the library refused
--- @return the reason, when the first return is nil
export function openOffline(frequency: integer, channels: integer, maxVoices: integer): (audiobackend.Backend?, string?)
    local mismatch = layoutMismatch()
    if mismatch ~= nil then
        return nil, mismatch
    end
    local device = tecs_audio_open_offline(frequency as uint32, channels as uint32, maxVoices as uint32)
    if device == nil then
        return nil, "tecsaudio opened no offline mixer"
    end

    return wrap(device)
end

--- Returns the reason the library left after a failing enumeration or open.
---
--- Those two calls answer with a handle rather than with a device, so the
--- library has nothing to hang a reason off and keeps one process-wide slot
--- instead. It is read immediately, before anything else can replace it.
---
--- @param fallback the reason to use when the library left none
--- @return the library's reason, or `fallback`
local function openReason(fallback: string): string
    local message = tecs_audio_open_error()
    if message == nil then
        return fallback
    end
    local text = readCString(message)
    if text == "" then
        return fallback
    end

    return text
end

--- Names every device of one direction and frees the library's listing.
---
--- @param recording whether to name recording devices rather than playback ones
--- @return the devices, empty rather than nil when the host produced none
--- @return the reason, when the listing is empty because something failed
local function listDevices(recording: boolean): ({audiobackend.Device}, string?)
    local list = tecs_audio_devices((recording and 1 or 0) as uint32)
    if list == nil then
        return {}, openReason("tecsaudio listed no devices")
    end
    local count = tecs_audio_devices_count(list) as integer
    local out: {audiobackend.Device} = {}
    for index = 0, count - 1 do
        local slot = index as uint32
        local named = tecs_audio_devices_name(list, slot)
        local name = ""
        if named ~= nil then
            name = readCString(named)
        end
        out[
            index + 1
        ] = new audiobackend.Device(
            id = tecs_audio_devices_id(list, slot) as integer,
            name = name,
            frequency = tecs_audio_devices_frequency(list, slot) as integer,
            channels = tecs_audio_devices_channels(list, slot) as integer
        )
    end
    tecs_audio_devices_free(list)

    return out
end

--- Wraps an open library capture in the backend contract.
---
--- The sample block is allocated once, sized to the whole ring, because no read
--- can produce more frames than the ring holds and a capture drained every
--- frame must not allocate to do it.
local function wrapCapture(
    microphone: voidptr?,
    frequency: integer,
    channels: integer,
    bufferFrames: integer
): audiobackend.Capture
    local width = channels
    if width < 1 then
        width = 1
    end
    local capacityFrames = bufferFrames
    if capacityFrames < 1 then
        capacityFrames = 1
    end
    local samples = carray(tecsAudioSample, capacityFrames * width)
    -- A boxed flag rather than a captured boolean, because every call below has
    -- to refuse after `close` frees the handle and a freed pointer reached
    -- again is not a diagnosable failure.
    local closed = {false}

    local function reason(fallback: string): string
        local message = tecs_audio_microphone_last_error(microphone)
        if message == nil then
            return fallback
        end
        local text = readCString(message)
        if text == "" then
            return fallback
        end

        return text
    end

    --- Moves at most `maxFrames` frames into the sample block.
    --- @param maxFrames the greatest number of frames to take
    --- @return the frames written, or a negative number when the read failed
    local function take(maxFrames: integer): integer
        local wanted = maxFrames
        if wanted > capacityFrames then
            wanted = capacityFrames
        end
        if wanted < 1 then
            return 0
        end

        return tecs_audio_microphone_read(microphone, samples, wanted as uint32) as integer
    end

    local function read(maxFrames: integer): (string?, string?)
        if closed[1] then
            return nil, "the capture is closed"
        end
        local frames = take(maxFrames)
        if frames < 0 then
            return nil, reason("tecsaudio could not read the capture")
        end
        if frames == 0 then
            return ""
        end

        return readBytes(samples, frames * width * BYTES_PER_SAMPLE)
    end

    local function readInto(out: {number}, maxFrames: integer): integer
        if closed[1] then
            return 0
        end
        local fits = #out // width
        local wanted = maxFrames
        if wanted > fits then
            wanted = fits
        end
        local frames = take(wanted)
        if frames < 1 then
            return 0
        end
        -- The block holds `capacityFrames * width` samples and the read above
        -- was bounded by both, which is the fact the checker cannot read off an
        -- `ffi.new` handle.
        unsafe do
            for index = 0, frames * width - 1 do
                out[index + 1] = samples[index].value as number
            end
        end

        return frames
    end

    local function write(source: {number}, frames: integer): integer
        if closed[1] then
            return 0
        end
        local remaining = frames
        local offset: integer = 0
        local total: integer = 0
        while remaining > 0 do
            local chunk = remaining
            if chunk > capacityFrames then
                chunk = capacityFrames
            end
            unsafe do
                for index = 0, chunk * width - 1 do
                    samples[index].value = nupp.math.f32.narrow(source[offset + index + 1])
                end
            end
            local accepted = tecs_audio_microphone_write(microphone, samples, chunk as uint32) as integer
            total = total + accepted
            if accepted < chunk then
                return total
            end
            offset = offset + chunk * width
            remaining = remaining - chunk
        end

        return total
    end

    return new audiobackend.Capture(
        frequency = frequency,
        channels = width,
        availableFrames = function(): integer
            if closed[1] then
                return 0
            end

            return tecs_audio_microphone_available(microphone) as integer
        end,
        overruns = function(): integer
            if closed[1] then
                return 0
            end

            return tecs_audio_microphone_overruns(microphone) as integer
        end,
        read = read,
        readInto = readInto,
        write = write,
        pause = function(): (boolean, string?)
            if closed[1] then
                return false, "the capture is closed"
            end
            if tecs_audio_microphone_pause(microphone) == 0 then
                return false, reason("tecsaudio could not pause the capture")
            end

            return true
        end,
        resume = function(): (boolean, string?)
            if closed[1] then
                return false, "the capture is closed"
            end
            if tecs_audio_microphone_resume(microphone) == 0 then
                return false, reason("tecsaudio could not resume the capture")
            end

            return true
        end,
        close = function(): nil
            if closed[1] then
                return
            end
            closed[1] = true
            tecs_audio_microphone_close(microphone)
        end
    )
end

--- Returns the device provider backed by the library.
---
--- Building it opens nothing and lists nothing: every call on the returned
--- record reaches the platform, and none of them runs here. That matters
--- because listing devices goes through the same platform machinery an open
--- goes through, so resolving a provider has to stay clear of it.
---
--- @return a provider naming the platform's devices and opening its microphones
export function devices(): audiobackend.Devices
    return new audiobackend.Devices(
        playback = function(): ({audiobackend.Device}, string?)
            return listDevices(false)
        end,
        recording = function(): ({audiobackend.Device}, string?)
            return listDevices(true)
        end,
        open = function(
            device: integer,
            deviceName: string?,
            frequency: integer,
            channels: integer,
            bufferFrames: integer
        ): (audiobackend.Capture?, string?)
            local microphone = tecs_audio_open_microphone(
                device as uint32,
                deviceName,
                frequency as uint32,
                channels as uint32,
                bufferFrames as uint32
            )
            if microphone == nil then
                return nil, openReason("tecsaudio opened no microphone")
            end

            return wrapCapture(
                microphone,
                tecs_audio_microphone_frequency(microphone) as integer,
                tecs_audio_microphone_channels(microphone) as integer,
                bufferFrames
            )
        end
    )
end

--- Returns a provider whose captures touch no recording device.
---
--- Its listings are empty, and `open` answers with a capture whose frames the
--- caller supplies through `write`. This is what a test that has to prove the
--- capture seam reaches for, and it is deliberately not what `tecs.audio`
--- resolves: opening a real recording device can block inside the platform's
--- audio daemon, and a headless suite must not be able to.
---
--- @return a provider naming no devices and opening device-free captures
export function offlineDevices(): audiobackend.Devices
    return new audiobackend.Devices(
        playback = function(): ({audiobackend.Device}, string?)
            return {}, "an offline provider names no devices"
        end,
        recording = function(): ({audiobackend.Device}, string?)
            return {}, "an offline provider names no devices"
        end,
        open = function(
            _device: integer,
            _deviceName: string?,
            frequency: integer,
            channels: integer,
            bufferFrames: integer
        ): (audiobackend.Capture?, string?)
            local microphone = tecs_audio_open_microphone_offline(
                frequency as uint32,
                channels as uint32,
                bufferFrames as uint32
            )
            if microphone == nil then
                return nil, openReason("tecsaudio opened no offline capture")
            end

            return wrapCapture(
                microphone,
                tecs_audio_microphone_frequency(microphone) as integer,
                tecs_audio_microphone_channels(microphone) as integer,
                bufferFrames
            )
        end
    )
end
