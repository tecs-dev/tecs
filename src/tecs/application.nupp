module tecs.application

--[[
The host-neutral application lifecycle.

The Rust host owns polling and passes one sealed event batch and elapsed delta
to `iterate`. This module owns only game lifecycle: plugin installation,
startup, world updates, crash containment, suspension, quit requests, and
shutdown. Windowing, rendering, audio, and platform event conversion are Rust
service boundaries rather than application fields.

Each application owns an asset loader. `Config.mcpPort` opts into one loopback
MCP listener, opened before plugin installation so startup failures remain
inspectable. Only one application per runtime may own that listener, because
the tool registry names one world. Nil opens no listener; zero chooses a port.

A host calls `poll` outside `iterate`, once per host turn, even while gameplay
is suspended or a lifecycle operation is parked. `tecs.host` does this and
parks asynchronous startup as well as updates. A custom host must follow the
same ordering. Diagnostics remain available during a parked operation; tools
that could touch its in-progress world report a retryable refusal.

## Driving frames from outside

A test harness or debugger drives an application deterministically with three
calls, which the MCP `send_event` and `clock_*` tools reach. `queueEvent`
queues a platform event for the next frame that runs, delivered after the
host's batch for that turn exactly as a platform event is, so per-frame edges
such as `keyPressed` survive the frame's `beginFrame`. `pause` holds the
simulation: an iteration that has no granted frame runs no system, folds no
input, leaves `frame` and `elapsed` unchanged, and keeps the host's events for
the frame that eventually runs, honoring only a quit. A held turn has nothing
new to draw, so the offscreen host stops rendering and waits between turns
instead, but it still renders the held world for a screenshot requested while
paused, which therefore shows it. `step` grants
frames that run while paused, each with the fixed delta it names rather than
the host's measured one, so a paused application advances by exactly the
granted frames and simulated time.

```nupp
app:pause()
app:queueEvent(tecs.platform.events.key(true, "Space", " ", " ", 0, false, 0))
app:step(1, 1 / 60)
app:iterate(0.5, nil) -- runs one frame with dt 1/60 and sees Space pressed
app:iterate(0.5, nil) -- holds: no frame, no time
```

Shutdown first unwinds a parked host operation, then attempts world shutdown,
stops the loader, and closes the debug listener. Later application cleanup
still runs if world shutdown raises. Resident asset handles retain their
existing release contract: game shutdown systems release the holds they own.
Repeated application shutdown does nothing.
]]

local assets = require("tecs.assets")
local ecs = require("tecs.ecs")
local files = require("nupp.io.files")
local mcp = require("tecs.mcp")
local mcpbindings = require("tecs.internal.mcpbindings")
local hostcancellation = require("tecs.internal.hostcancellation")
local input = require("tecs.input")
local platformevents = require("tecs.platform.events")
local platformwindow = require("tecs.platform.window")

--- A platform event already translated by the Rust host.
export type HostEvent = platformevents.Event

-- Compatibility surface. The identity names the directories `nupp.io.files`
-- resolves this application's configuration, data and cache under, so a build
-- that never names itself keeps finding the state it wrote last time.

--- Read-only. Names the organization and the application `newApplication`
--- selects when a game named neither.
export const DEFAULT_IDENTITY = "tecs"

--- The lifecycle state visible to host diagnostics.
export type State = "created" | "running" | "stopped"

--- Installs a game's entities, resources, observers, and systems before startup.
export type Plugin = function(exclusive app: Application): nil

--- A host-driven application and its world.
export record Application is mcpbindings.Application
    world: ecs.World

    --- Read-only. Holds this application's loader, which shuts down with the
    --- application.
    assets: assets.Assets

    --- Read-only. Holds the optional loopback debug listener after initialization.
    debugServer: mcp.Server?

    input: input.Input
    window: platformwindow.Window
    quitRequested: boolean
    suspended: boolean
    elapsed: number
    frame: integer

    --- Read-only. Reports whether `pause` holds the simulation. Change it through
    --- `pause` and `resume`.
    paused: boolean

    @private state: State
    @private plugin: Plugin?
    @private onEvent: (function(event: platformevents.Event, exclusive app: Application): nil)?
    @private bindDebug: function(): nil
    @private mcpPort: integer?
    @private debug: boolean
    @private debugMaxFrames: integer?
    @private failure: string?
    @private shutdownDone: boolean
    @private steps: integer
    @private stepDt: number
    @private held: {platformevents.Event}
    @private injected: {platformevents.Event}

    --- Polls optional debugging once per host turn, outside the world update scope.
    --- @param self the application to serve.
    --- @param parked whether its lifecycle coroutine remains suspended.
    --- @return whether one debug request was answered.
    poll: function(exclusive self: Application, parked: boolean?): boolean

    init: function(exclusive self: Application): boolean
    iterate: function(exclusive self: Application, dt: number, events: {platformevents.Event}?): boolean
    requestQuit: function(exclusive self: Application): nil
    setSuspended: function(exclusive self: Application, suspended: boolean): nil
    crashed: function(borrows self: Application): string?
    clearCrash: function(exclusive self: Application): (boolean, string?)
    shutdown: function(exclusive self: Application): boolean
    getState: function(borrows self: Application): State

    --- Queues a platform event for the next frame that runs.
    ---
    --- The event reaches window state, input state, the world's observers and
    --- `Config.onEvent` after that frame's `beginFrame`, behind the host's own
    --- batch for the same turn, so per-frame edges such as `keyPressed` read
    --- true for exactly that frame. While paused the event waits for the next
    --- frame `step` or `resume` lets run.
    --- @param self the application to deliver to
    --- @param event the event, delivered as if the platform had sent it
    queueEvent: function(exclusive self: Application, event: platformevents.Event): nil

    --- Holds the simulation from the next iteration on.
    ---
    --- A held iteration runs no system and folds no input, and leaves `frame`
    --- and `elapsed` unchanged. Host events wait for the next frame that runs,
    --- up to the latest 1024, except that a quit or close request still stops
    --- the application. `tecs.host` reports a held iteration as `held`, and the
    --- offscreen host then renders the held world only for a pending
    --- screenshot. Pausing again does nothing, and frames already granted by
    --- `step` are kept.
    --- @param self the application to hold
    pause: function(exclusive self: Application): nil

    --- Lets the simulation run on the host's measured delta again.
    ---
    --- Discards any frames `step` granted and has not run yet. Resuming a
    --- running application does nothing.
    --- @param self the application to release
    resume: function(exclusive self: Application): nil

    --- Grants frames that run while paused, one per host iteration.
    ---
    --- Each granted frame passes `dt` to the world in place of the host's
    --- delta, so a script of steps reproduces the same simulated time on every
    --- run and every host. The delta applies to every granted frame not yet
    --- run, including ones an earlier call granted.
    --- @param self the paused application
    --- @param frames how many more frames to run, at least one
    --- @param dt the fixed delta of each granted frame, in seconds
    --- @raises string when the application is not paused
    --- @raises string when `frames` is not a positive integer or `dt` is not a
    ---     positive finite number
    step: function(exclusive self: Application, frames: integer, dt: number): nil

    --- Returns the frames `step` granted that have not started.
    --- @param self the application to inspect
    --- @return the count, zero while running or once every granted frame ran
    pendingSteps: function(borrows self: Application): integer

    --- Returns the fixed delta granted frames run with.
    --- @param self the application to inspect
    --- @return the delta in seconds the last `step` named, or 1/60 before one
    stepDelta: function(borrows self: Application): number

    --- Returns how many events wait for the next frame that runs.
    --- @param self the application to inspect
    --- @return the count of queued and held events
    pendingEvents: function(borrows self: Application): integer
end

--- Settings copied by `newApplication`.
export type Config = {
    world: ecs.WorldConfig?,
    window: platformwindow.Options?,
    plugin: Plugin?,
    onEvent: (function(event: platformevents.Event, exclusive app: Application): nil)?,

    --- Caller-writable. Enables loopback debugging on this port; nil disables it and
    --- zero chooses a free port.
    mcpPort: integer?,
    debug: boolean?,
    debugMaxFrames: integer?
}

-- The most events a paused application holds for its next frame. Past it the
-- oldest are dropped, as the host's own input routes drop theirs.
local HELD_LIMIT: integer = 1024

-- The tool registry names one application per runtime. A second listener must
-- not silently redirect the first application's tools into another world.
local debugOwner: Application? = nil

--- Names the engine's default application identity when a game named none.
---
--- `nupp.io.files` owns the writable roots and resolves them from one
--- process-wide identity, which has to be named before the first root is asked
--- for. A game names itself with `nupp.io.files.setApplicationIdentity` before
--- it creates an application, and this leaves that name alone.
--- @return nil after naming an identity, or without changing one
local function nameIdentity(): nil
    const organization = files.applicationIdentity()
    if organization == nil then
        files.setApplicationIdentity(DEFAULT_IDENTITY, DEFAULT_IDENTITY)
    end
end

local function captureFailure(exclusive app: Application, failure: any): nil
    if hostcancellation.is(failure) then
        error(failure, 0)
    end
    if app.failure == nil then
        app.failure = tostring(failure)
        if debugOwner == app then
            mcp.setCrashed(app.failure)
        end
    end
end

--- Builds an inert application without opening platform services.
--- @param config the copied world and lifecycle settings
--- @return an application waiting for `init`
--- @raises string when the debug frame limit or MCP port is invalid
export function newApplication(config: Config?): Application
    local maxFrames = config and config.debugMaxFrames or nil
    if maxFrames ~= nil and (maxFrames < 1 or maxFrames % 1 ~= 0) then
        error("application.newApplication: debugMaxFrames must be a positive integer", 2)
    end
    const port = config and config.mcpPort
    if port ~= nil and (port < 0 or port > 65535 or port % 1 ~= 0) then
        error("application.newApplication: mcpPort must be an integer from zero to 65535", 2)
    end
    nameIdentity()
    local world = ecs.newWorld(config and config.world)
    local inputState = input.install(world)
    local windowState = platformwindow.newWindow(config and config.window)

    const app = new Application(
        world = world,
        assets = assets.newAssets(),
        debugServer = nil,
        bindDebug = function(): nil
        end,
        mcpPort = port,
        input = inputState,
        window = windowState,
        quitRequested = false,
        suspended = false,
        elapsed = 0,
        frame = 0,
        state = "created",
        plugin = config and config.plugin or nil,
        onEvent = config and config.onEvent or nil,
        debug = config ~= nil and config.debug == true,
        debugMaxFrames = maxFrames,
        failure = nil,
        shutdownDone = false,
        paused = false,
        steps = 0,
        stepDt = 1 / 60,
        held = {},
        injected = {}
    )
    app.bindDebug = function(): nil
        debugOwner = app
        mcp.bind(app.world, app)
        mcp.setCrashed(nil)
        mcp.resetSandbox()
    end

    return app
end

--- Installs the game plugin and runs startup phases once.
--- @param self the application the host is starting
--- @return true so a host may continue serving a guarded startup failure
--- @raises string when the host initializes an application more than once
function Application.init(exclusive self: Application): boolean
    if self.state == "created" then
        self.state = "running"
    else
        error("application.init: application is already " .. self.state, 2)
    end
    if self.mcpPort ~= nil then
        if debugOwner ~= nil then
            captureFailure(self, "application.init: another application owns the debug listener")
            return true
        end
        const server, reason = mcp.listen(self.mcpPort)
        if server == nil then
            captureFailure(self, reason or "the debug listener could not bind")
            return true
        end
        self.debugServer = server
        self.bindDebug()
    end
    local plugin = self.plugin
    if plugin ~= nil then
        local succeeded, failure = pcall(function(): nil
            plugin(self)
        end)
        if not succeeded then
            captureFailure(self, failure)
        end
    end
    if self.failure == nil then
        local succeeded, failure = pcall(function(): nil
            self.world:startup()
        end)
        if not succeeded then
            captureFailure(self, failure)
        end
    end

    return true
end

function Application.poll(exclusive self: Application, parked: boolean?): boolean
    const server = self.debugServer
    if server == nil or self.shutdownDone then
        return false
    end

    return mcp.poll(server, parked)
end

--- Runs one host iteration and returns whether another is wanted.
--- @param self the running application
--- @param dt elapsed simulation time in seconds
--- @param batch the caller-owned sealed event batch for this iteration
--- @return false after a quit request or configured frame limit
--- @raises string for an invalid delta or when called outside the running lifecycle
function Application.iterate(exclusive self: Application, dt: number, batch: {platformevents.Event}?): boolean
    if self.state == "running" then
        -- The host is inside the only state that accepts iterations.
    else
        error("application.iterate: application is " .. self.state, 2)
    end
    if dt < 0 or dt ~= dt then
        error("application.iterate: dt must be a non-negative number", 2)
    end
    if self.quitRequested then
        return false
    end

    -- Arrival order: events held while paused, then this turn's host batch,
    -- then what `queueEvent` added since the last iteration.
    local incoming = self.held
    for _, event in ipairs(batch or {}) do
        incoming[#incoming + 1] = event
    end
    for _, event in ipairs(self.injected) do
        incoming[#incoming + 1] = event
    end
    self.held = {}
    self.injected = {}
    if self.paused then
        if self.steps <= 0 then
            -- A held turn: nothing runs and the events wait for a frame that
            -- does, but a quit is a request to the process rather than to a
            -- frame, so it is still honored.
            for index = 1, #incoming do
                if incoming[index] is platformevents.QuitEvent then
                    self.quitRequested = true
                    return false
                end
            end
            if #incoming > HELD_LIMIT then
                -- A long pause under a live window must not grow without bound.
                local kept: {platformevents.Event} = {}
                for index = #incoming - HELD_LIMIT + 1, #incoming do
                    kept[#kept + 1] = incoming[index]
                end
                incoming = kept
            end
            self.held = incoming

            return true
        end
        self.steps = self.steps - 1
        dt = self.stepDt
    end

    self.input:beginFrame()
    local handler = self.onEvent
    for index = 1, #incoming do
        local event = incoming[index]
        local succeeded, failure = pcall(function(): nil
            platformwindow.handleEvent(self.window, event)
            self.input:handleEvent(event)
            platformevents.dispatch(self.world, event)
            if handler ~= nil then
                handler(event, self)
            end
        end)
        if not succeeded then
            captureFailure(self, failure)
            break
        end
        if event is platformevents.QuitEvent then
            self.quitRequested = true
        end
        if self.quitRequested then
            return false
        end
    end

    if not self.suspended and self.failure == nil then
        self.elapsed = self.elapsed + dt
        local succeeded, failure = pcall(function(): nil
            self.world:update(dt)
        end)
        if not succeeded then
            captureFailure(self, failure)
        end
    end

    self.frame = self.frame + 1
    local limit = self.debugMaxFrames
    if limit ~= nil and self.frame >= limit then
        return false
    end

    return not self.quitRequested
end

function Application.queueEvent(exclusive self: Application, event: platformevents.Event): nil
    self.injected[#self.injected + 1] = event
end

function Application.pause(exclusive self: Application): nil
    self.paused = true
end

function Application.resume(exclusive self: Application): nil
    self.paused = false
    self.steps = 0
end

function Application.step(exclusive self: Application, frames: integer, dt: number): nil
    if not self.paused then
        error("application.step: the application is not paused", 2)
    end
    if frames < 1 or frames % 1 ~= 0 then
        error("application.step: frames must be a positive integer", 2)
    end
    if not (dt > 0) or dt == math.huge then
        error("application.step: dt must be a positive finite number", 2)
    end
    self.steps = self.steps + frames
    self.stepDt = dt
end

function Application.pendingSteps(borrows self: Application): integer
    return self.steps
end

function Application.stepDelta(borrows self: Application): number
    return self.stepDt
end

function Application.pendingEvents(borrows self: Application): integer
    return #self.held + #self.injected
end

--- Requests that the host stop after the current callback returns.
--- @param self the application to stop
function Application.requestQuit(exclusive self: Application): nil
    self.quitRequested = true
end

--- Changes whether iterations advance simulation.
--- @param self the application receiving a platform lifecycle change
--- @param suspended whether frame updates should pause
function Application.setSuspended(exclusive self: Application, suspended: boolean): nil
    self.suspended = suspended
end

--- Returns the first guarded game failure.
--- @param self the application to inspect
--- @return the failure text, or nil while healthy
function Application.crashed(borrows self: Application): string?
    return self.failure
end

--- Clears a guarded game failure in a debug application.
--- @param self the application to resume
--- @return whether simulation may resume, plus a refusal reason
function Application.clearCrash(exclusive self: Application): boolean, string?
    if self.failure == nil then
        return true
    end
    if not self.debug then
        return false, "application debug mode is disabled"
    end
    self.failure = nil
    if debugOwner == self then
        mcp.setCrashed(nil)
    end

    return true
end

--- Runs world shutdown once, including after a guarded startup failure.
--- @param self the application the host is stopping
--- @return true after shutdown has been attempted
function Application.shutdown(exclusive self: Application): boolean
    if self.shutdownDone then
        return true
    end
    self.shutdownDone = true
    local succeeded, failure = pcall(function(): nil
        self.world:shutdown()
    end)
    if not succeeded then
        captureFailure(self, failure)
    end
    local assetsStopped, assetsFailure = pcall(function(): nil
        self.assets:shutdown()
    end)
    if not assetsStopped then
        captureFailure(self, assetsFailure)
    end
    const server = self.debugServer
    self.debugServer = nil
    if server ~= nil then
        const stopped, reason = pcall(function(): nil
            mcp.destroy(server)
        end)
        if not stopped then
            captureFailure(self, reason)
        end
    end
    if debugOwner == self then
        debugOwner = nil
        mcp.bind(nil, nil)
        mcp.setCrashed(nil)
        mcp.resetSandbox()
    end
    self.state = "stopped"

    return true
end

--- Returns the current host lifecycle state.
--- @param self the application to inspect
--- @return `created`, `running`, or `stopped`
function Application.getState(borrows self: Application): State
    return self.state
end
