module tecs.internal.dirtyranges

--[[Coalesced byte ranges ported from the original tecs.gpu.dirtyranges.
Adjacent writes merge. After 64 distinct ranges, one covering span bounds
bookkeeping and trades only upload bandwidth. Storage is retained across frames.]]

export const MAX: integer = 64

--- Reusable, bounded ranges of modified buffer bytes.
export record Ranges
    private entries: {integer}
    count: integer
    private collapsed: boolean
    bytes: integer
    mark: function(self: Ranges, offset: integer, size: integer): nil
    at: function(self: Ranges, index: integer): (integer, integer)
    clear: function(self: Ranges): nil
    sort: function(self: Ranges): nil
end

-- Ordered wire ranges let the receiver validate and apply each byte once.
-- The old mark algorithm accepts out-of-order writes; sorting its bounded
-- list before the same coalescing pass preserves that producer contract.
function Ranges.sort(self: Ranges): nil
    if self.count < 2 then
        return
    end
    local ranges: {{integer}} = {}
    for index = 0, self.count - 1 do
        const offset, size = self:at(index)
        ranges[#ranges + 1] = {offset, size}
    end
    table.sort(ranges, function(left: {integer}, right: {integer}): boolean
        return left[1] < right[1]
    end)
    const bytes = self.bytes
    self:clear()
    for _, range in ipairs(ranges) do
        self:mark(range[1], range[2])
    end
    self.bytes = bytes
end

--- Creates an empty range list.
--- @return The list, whose storage is retained when cleared.
export function new(): Ranges
    return new Ranges(entries = {}, count = 0, collapsed = false, bytes = 0)
end

function Ranges.mark(self: Ranges, offset: integer, size: integer): nil
    if size <= 0 then
        return
    end
    self.bytes = self.bytes + size
    const entries = self.entries
    if self.collapsed then
        const start = (math.min(entries[1], offset) as integer)
        const finish = (math.max(entries[1] + entries[2], offset + size) as integer)
        entries[1], entries[2] = start, finish - start
        return
    end
    const count = self.count
    if count > 0 then
        const lastOffset, lastSize = entries[(count - 1) * 2 + 1], entries[(count - 1) * 2 + 2]
        if offset <= lastOffset + lastSize and offset + size >= lastOffset then
            const start = (math.min(lastOffset, offset) as integer)
            const finish = (math.max(lastOffset + lastSize, offset + size) as integer)
            entries[(count - 1) * 2 + 1], entries[(count - 1) * 2 + 2] = start, finish - start
            return
        end
    end
    if count >= MAX then
        local start = entries[1]
        local finish = start
        for entry = 0, count - 1 do
            const rangeEnd = entries[entry * 2 + 1] + entries[entry * 2 + 2]
            start = (math.min(start, entries[entry * 2 + 1]) as integer)
            finish = (math.max(finish, rangeEnd) as integer)
        end
        start = (math.min(start, offset) as integer)
        finish = (math.max(finish, offset + size) as integer)
        entries[1], entries[2] = start, finish - start
        self.count, self.collapsed = 1, true
        return
    end
    entries[count * 2 + 1], entries[count * 2 + 2] = offset, size
    self.count = count + 1
end

function Ranges.at(self: Ranges, index: integer): integer, integer
    return self.entries[index * 2 + 1], self.entries[index * 2 + 2]
end

function Ranges.clear(self: Ranges): nil
    self.count, self.bytes, self.collapsed = 0, 0, false
end
