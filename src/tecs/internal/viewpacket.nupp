module tecs.internal.viewpacket

const {type Archetype} = require("tecs.internal.archetype")
const io2 = require("nupp.io")

local world = require("tecs.internal.world")
local query = require("tecs.internal.query")
local views = require("tecs.internal.views")
local meshpacket = require("tecs.internal.meshpacket")
local framepacket = require("tecs.internal.framepacket")

export record Collector
    private world: world.World
    private query: query.Query
    private extractors: {[integer]: framepacket.Extractor}
    private meshRevisions: {[integer]: integer} = {}
    private meshes: meshpacket.Collector
    private empty: world.World
    private lastSeen: {[integer]: integer} = {}
    private spritesEnabled: {[integer]: boolean} = {}
    private sent: integer = 0
    frame: function(exclusive self: Collector, width: integer, height: integer, resident: integer?): string?
end

-- The world is plain rather than `exclusive`, because the collector holds it
-- for its own lifetime rather than for this call.
export function new(value: world.World): Collector
    return new Collector(
        world = value,
        query = value:newQuery({
            include = {views.Component}
        }),
        extractors = {},
        meshes = meshpacket.new(value),
        empty = world.new(1)
    )
end

local record Selected
    entity: integer
    value: views.View
end

function Collector.frame(exclusive self: Collector, width: integer, height: integer, resident: integer?): string?
    local selected: {Selected} = {}
    local explicit = false
    for candidate, count in self.query:iter() do
        local active = candidate as Archetype
        local values = assert(active:get(views.Component))
        for index = 1, count as integer do
            explicit = true
            if values[index].enabled then
                views.validate(values[index])
                selected[#selected + 1] = new Selected(entity = active.entities[index], value = values[index])
            end
        end
    end
    if not explicit then
        for id, extractor in pairs(self.extractors) do
            framepacket.close(extractor)
            self.extractors[id], self.lastSeen[id], self.meshRevisions[id], self.spritesEnabled[id] = nil, nil, nil, nil
        end
        self.sent = 0
        return nil
    end
    table.sort(selected, function(a: Selected, b: Selected): boolean
        return a.value.order < b.value.order or (a.value.order == b.value.order and a.entity < b.entity)
    end)
    const matched = resident ~= nil and resident ~= 0 and resident == self.sent
    self.sent = self.sent + 1
    assert(self.sent < 4294967295, "view packet revision exhausted")
    local buffer = io2.newBuffer()
    local writer = io2.newScalarWriter(buffer)
    writer:writeUint32(nupp.math.u32.wrap(1414944595))
    writer:writeUint32(nupp.math.u32.wrap(2))
    writer:writeUint32(nupp.math.u32.wrap(self.sent))
    writer:writeUint32(nupp.math.u32.wrap(width))
    writer:writeUint32(nupp.math.u32.wrap(height))
    writer:writeUint32(nupp.math.u32.wrap(#selected))
    for _, entry in ipairs(selected) do
        local extractor = self.extractors[entry.entity]
        if extractor == nil or self.spritesEnabled[entry.entity] ~= (entry.value.camera2D ~= nil) then
            if extractor ~= nil then
                framepacket.close(extractor)
            end
            extractor = framepacket.new(entry.value.camera2D ~= nil and self.world or self.empty)
            self.extractors[entry.entity] = extractor
            self.spritesEnabled[entry.entity] = entry.value.camera2D ~= nil
        end
        const viewMatched = matched and self.lastSeen[entry.entity] == self.sent - 1
        self.lastSeen[entry.entity] = self.sent
        const value = entry.value
        if value.camera2D ~= nil then
            extractor:setCamera(value.camera2D)
        end
        const targetWidth = math.max(1, math.floor(width * value.width + 0.5)) as integer
        const targetHeight = math.max(1, math.floor(height * value.height + 0.5)) as integer
        const packet = extractor:frame(targetWidth, targetHeight, viewMatched and extractor:revision() or 0)
        writer:writeUint32(nupp.math.u32.wrap(entry.entity))
        writer:writeFloat32(nupp.math.f32.narrow(value.x))
        writer:writeFloat32(nupp.math.f32.narrow(value.y))
        writer:writeFloat32(nupp.math.f32.narrow(value.width))
        writer:writeFloat32(nupp.math.f32.narrow(value.height))
        writer:writeUint32(nupp.math.u32.wrap(#packet))
        writer:writeBytes(packet)
        local meshes = ""
        const camera3D = value.camera3D
        if camera3D ~= nil then
            meshes = self.meshes:frame(
                targetWidth,
                targetHeight,
                camera3D,
                value.lighting,
                viewMatched and (self.meshRevisions[entry.entity] or 0) or 0
            )
        end
        self.meshRevisions[entry.entity] = camera3D ~= nil and self.meshes:currentRevision() or 0
        writer:writeUint32(nupp.math.u32.wrap(#meshes)):writeBytes(meshes)
    end
    for id, extractor in pairs(self.extractors) do
        if self.lastSeen[id] ~= self.sent then
            framepacket.close(extractor)
            self.extractors[id], self.lastSeen[id], self.meshRevisions[id], self.spritesEnabled[id] = nil, nil, nil, nil
        end
    end
    writer:drop()
    const bytes = buffer:getString()
    buffer:drop()

    return bytes
end
