module tecs.internal.world

--[[
The entity-lifetime core of a Tecs world.

Structural changes are staged. `spawn` reserves an identity immediately but
does not make it alive until `commit`; `despawn` leaves a committed entity alive
until the same barrier. This is the transaction boundary the archetype and
query layers will build on.

This module orders ECS systems, but owns no private task or completion runtime.
Systems suspend through `nupp.tasks`; parallel work belongs to `nupp.workers`.
]]

local tasks = require("nupp.tasks")
local ffi = require("ffi")
local random = require("nupp.data.random")
local archetype = require("tecs.internal.archetype")
local components = require("tecs.internal.components")
local events = require("tecs.internal.events")
local nuppevents = require("nupp.events")
local ffistorage = require("tecs.internal.ffistorage")
local idallocator = require("tecs.internal.idallocator")
local inverseindex = require("tecs.internal.inverseindex")
local phases = require("tecs.internal.phases")
local query = require("tecs.internal.query")
local randomstreams = require("tecs.internal.randomstreams")
local snapshotvalue = require("tecs.internal.snapshotvalue")
local snapshotcodec = require("tecs.internal.snapshotcodec")
local buffer = require("string.buffer")
local files = require("nupp.io.files")

--- A frame system body.
---
--- The borrowed task scope is optional to accept for source compatibility with
--- ordinary two-argument systems. A system that starts child work accepts it as
--- its third argument; all children settle before the logical update returns.
export type System = function(dt: number, exclusive world: World, borrows scope: tasks.Scope)

--- Replaces scheduling while preserving world mutation, event and task-scope ownership.
export interface Pipeline
    --- Read-only. Reports the registered system count.
    count: integer

    --- Read-only. Reports the fixed-step duration in seconds.
    fixedTimestep: number

    --- Read-only. Limits catch-up iterations in one frame.
    fixedMaxSteps: integer

    --- Read-only. Selects drop or accumulate for excess fixed time.
    fixedOverload: FixedOverload

    --- Engine-owned. Stores the fixed remainder; snapshot restore writes it.
    fixedAccumulator: number

    --- Read-only. Reports completed fixed iterations.
    fixedStepCount: integer

    --- Read-only. Reports abandoned fixed time in seconds.
    fixedTimeDropped: number

    --- Read-only. Reports abandoned whole fixed steps.
    fixedStepsDropped: integer

    --- Engine-owned. Stores enabled flags by registered phase position; snapshots
    --- restore it.
    phaseStates: {boolean}

    --- Dispatches a frame inside the world's existing task scope.
    --- @param self The custom scheduler.
    --- @param dt The frame duration in seconds.
    --- @param world The world whose systems run.
    --- @param scope The call-scoped owner of child tasks.
    update: function(self: Pipeline, dt: number, exclusive world: World, borrows scope: tasks.Scope): nil

    --- Dispatches one phase or phase tree inside the world's task scope.
    --- @param self The custom scheduler.
    --- @param phase The selected phase name.
    --- @param dt The elapsed seconds supplied to systems.
    --- @param world The world whose systems run.
    --- @param scope The call-scoped owner of child tasks.
    run: function(
        self: Pipeline,
        phase: phases.Selection,
        dt: number,
        exclusive world: World,
        borrows scope: tasks.Scope
    ): nil

    --- Registers a system and returns its unique name.
    --- @param self The custom scheduler.
    --- @param config The system and its ordering constraints.
    --- @return Returns the registered name.
    addSystem: function(self: Pipeline, config: SystemConfig): string

    --- Removes a named system.
    --- @param self The custom scheduler.
    --- @param name The registered name.
    --- @return Returns whether the system existed.
    removeSystem: function(self: Pipeline, name: string): boolean

    --- Returns detached system inspection data.
    --- @param self The custom scheduler.
    --- @return Returns systems in dispatch order.
    listSystems: function(self: Pipeline): {SystemInfo}

    --- Changes a registered system's enabled state.
    --- @param self The custom scheduler.
    --- @param name The registered name.
    --- @param enabled The desired state.
    --- @return Returns success and an optional failure reason.
    setSystemEnabled: function(self: Pipeline, name: string, enabled: boolean): (boolean, string?)

    --- Enables a phase tree.
    --- @param self The custom scheduler.
    --- @param phase The selected name.
    enablePhase: function(self: Pipeline, phase: phases.Selection): nil

    --- Disables a phase tree.
    --- @param self The custom scheduler.
    --- @param phase The selected name.
    disablePhase: function(self: Pipeline, phase: phases.Selection): nil

    --- Reports whether a leaf is enabled.
    --- @param self The custom scheduler.
    --- @param phase The selected name.
    --- @return Returns whether dispatch is enabled.
    isPhaseEnabled: function(self: Pipeline, phase: phases.Phase): boolean

    --- Registers a custom phase tree and assigns any omitted position.
    --- @param self The custom scheduler.
    --- @param phase The phase declaration.
    registerPhase: function(self: Pipeline, phase: phases.Definition): nil
end

--- A predicate evaluated immediately before one system dispatch.
export type RunIf = function(dt: number, exclusive world: World, systemName: string): boolean

--- Supplies cold debugger hooks without enabling public event fan-out.
export type TransitionObserver = {
    entity: (function(id: integer, before: archetype.Archetype?, after: archetype.Archetype?))?,
    state: (function(kind: "push" | "pop", before: string?, after: string?, changed: string))?
}

--- The policy applied when one frame owes more than its fixed-step limit.
export type FixedOverload = "drop" | "accumulate"

--- The fixed-step statistics accumulated by a world.
export record WorldStats
    entities: integer
    archetypes: integer
    components: integer
    systems: integer
    fixedTimeDropped: number
    fixedStepsDropped: integer
end

--- A built-in state-policy action.
export type StateAction = "pause" | "resume" | "despawn" | "disable"

--- A custom state lifecycle callback.
export type StateCallback = function(exclusive world: World)

--- A state action followed by a custom callback.
export type StatePolicyAction = {
    apply: StateAction?,
    call: StateCallback?
}

--- One state lifecycle policy operation.
export type StatePolicyOperation = StateAction | StatePolicyAction | StateCallback

--- Policy hooks for one registered state.
export type StatePolicy = {
    onBlur: StatePolicyOperation?,
    onFocus: StatePolicyOperation?,
    onEnter: StatePolicyOperation?,
    onExit: StatePolicyOperation?
}

--- Registration options for a frame system.
export type SystemConfig = {
    --- Caller-writable. Names the system uniquely; nil requests an engine-owned name.
    name: string?,

    --- Caller-writable. Selects the leaf phase that dispatches the system.
    phase: phases.Phase,

    --- Caller-writable. Receives the phase delta, world and borrowed task scope.
    run: System,

    --- Caller-writable. Gates each dispatch; a disabled system does not evaluate it.
    runIf: RunIf?,

    --- Caller-writable. Names systems that must run later in this phase; missing and
    --- cross-phase names contribute no edge. The world copies the list.
    before: {string}?,

    --- Caller-writable. Names systems that must run earlier in this phase; missing and
    --- cross-phase names contribute no edge. The world copies the list.
    after: {string}?,

    --- Caller-writable. Publishes staged changes before evaluating runIf.
    commitBefore: boolean?,

    --- Caller-writable. Publishes staged changes after dispatch, even when runIf is
    --- false.
    commitAfter: boolean?
}

--- One registered system as reported in execution order.
export type SystemInfo = {
    --- Read-only. Names the registered system.
    name: string,

    --- Read-only. Names its dispatch phase.
    phase: phases.Phase,

    --- Read-only. Reports its position in the inspected schedule.
    position: integer,

    --- Read-only. Reports whether the scheduler permits dispatch.
    enabled: boolean,

    --- Read-only. Reports whether dispatch has an additional predicate.
    hasRunIf: boolean
}

--- One component named by a snapshot.
export type SnapshotComponentEntry = events.SnapshotComponentEntry

--- One entity and its non-tag component payloads.
export record SnapshotEntity
    id: integer
    values: {[string]: any}
end

--- Entities sharing one saved component signature.
export record SnapshotArchetype
    components: {string}
    entities: {SnapshotEntity}

end

--- One named custom snapshot value.
export type SnapshotDataEntry = snapshotcodec.Data

--- A detached, format-neutral world snapshot.
export record Snapshot
    version: integer
    nextEntityId: integer
    entityCount: integer
    archetypeCount: integer
    componentTable: {SnapshotComponentEntry}
    archetypes: {SnapshotArchetype}
    data: {SnapshotDataEntry}
    states: {string}

    --- Read-only. Identifies binary output when a native buffer was requested.
    format: ("binary" | "table")?

    --- Read-only. Holds binary output; later saves into the same buffer overwrite it.
    buffer: buffer.Buffer?

    --- Read-only. Preserves fixed-step remainder and disabled phase names in table
    --- output.
    pipeline: {
        fixedAccumulator: number,
        phaseStates: {boolean},
        disabledPhases: {[string]: boolean}
    }?

end

--- Metadata returned after a snapshot load.
export type SnapshotPrelude = events.SnapshotPrelude

--- Options for a format-neutral snapshot save.
export type SnapshotOptions = {
    --- Caller-writable. Attaches unique named custom data.
    customData: {[string]: any}?,

    --- Caller-writable. Selects entities without automatic Disabled or Paused
    --- exclusions.
    filterQuery: query.Descriptor?,

    --- Caller-writable. Selects draw layers from zero through 31; entities without
    --- Transform2D always pass.
    layers: {integer}?,

    --- Caller-writable. Chooses binary framing or a detached table; nil retains table
    --- output.
    format: ("binary" | "table")?,

    --- Caller-writable. Supplies reusable binary output storage, reset at save time.
    buffer: buffer.Buffer?,

    --- Caller-writable. Writes binary output to this file and also returns its buffer.
    path: string?
}

--- A named participant in non-component snapshot data.
export type SnapshotHandler = {
    name: string,
    save: (function(exclusive world: World): any)?,
    load: (function(exclusive world: World, value: any): nil)?,
    finish: (function(exclusive world: World, prelude: SnapshotPrelude): nil)?
}

--- A factory for one component value inserted by a bundle.
export type BundleFactory = function(): components.Input

--- A declarative reusable spawn shape.
export type BundleDefinition = {
    required: {components.Component}?,
    with: {[components.Component]: true | BundleFactory}?
}

--- A world-bound reusable spawn shape.
export record Bundle
    name: string
    required: {string}
    defaulted: {string}
    private world: any
    private requiredComponents: {components.Component}
    private defaultComponents: {components.Component}
    private defaultFactories: {BundleFactory?}
    private cachedTarget: archetype.Archetype?
    private cachedState: components.Component?
    private requiredDefaults: {[integer]: any}
    private plain: boolean
    private scratchInputs: {components.Input}
    private busy: boolean

    spawn: function(self: Bundle, ...: components.Input): integer
end

local record RegisteredSystem
    name: string
    phase: phases.Phase
    run: System
    runIf: RunIf?
    before: {string}
    after: {string}
    commitBefore: boolean
    commitAfter: boolean
    enabled: boolean
    removed: boolean
end

--- The parameters an event is constructed with, so `emit` binds them by name.
local comptime function Construction(E: type): typepack
    return nupp.types.construction(E)
end

local record PendingSpawn
    id: integer
    target: archetype.Archetype
    values: {[integer]: any}
    isSealed: boolean
end

local record SpawnShape
    children: {[components.Component]: SpawnShape}
    target: archetype.Archetype?
    state: components.Component?
    defaults: {[integer]: any}
end

local record PendingMove
    id: integer
    target: archetype.Archetype
    values: {[integer]: any}
    isSealed: boolean
end

--- Initializes or updates one contiguous, one-based range of committed rows.
export type BatchCallback = function(
    candidate: archetype.Archetype,
    firstRow: integer,
    lastRow: integer,
    count: integer
)

local record SpawnBatch
    index: integer
    target: archetype.Archetype
    values: {[integer]: any}
    shared: {[integer]: boolean}
    count: integer
    firstId: integer
    ids: {integer}?
    rawIds: number[?]?
    callback: BatchCallback?
    rawRestore: boolean?
end

local record MutationBatch
    index: integer
    source: archetype.Archetype
    target: archetype.Archetype
    ids: number[?]
    count: integer
    values: {[integer]: any}
    shared: {[integer]: boolean}
    callback: BatchCallback?
    despawn: boolean
    resetComponent: components.Component?
    writeComponent: components.Component?
end

local record BatchWrite
    ids: {integer}
    component: components.Component
    callback: BatchCallback
end

local record PendingSegment
    spawns: {PendingSpawn}
    moves: {PendingMove}
    despawns: {integer}
    writer: BatchWrite?
    spawnBatch: SpawnBatch?
    mutationBatch: MutationBatch?
    flatFirst: integer?
    flatLast: integer?
    moveFirst: integer?
    moveLast: integer?
end

local record PendingNotice
    target: archetype.Archetype
    source: archetype.Archetype
    entity: integer
    observerLimit: integer
end

--- A world containing entity identities and staged structural work.
---
--- A world is an event source: observers register against it by address and
--- receive the world itself as their second argument.
export record World is nupp.events.Source<integer>
    private allocator: idallocator.IdAllocator
    private archetypes: {archetype.Archetype}
    private archetypeById: {[integer]: archetype.Archetype}
    private maxArchetypeId: integer
    private freeArchetypeIds: {integer}
    private archetypeBySignature: {[string]: archetype.Archetype}
    private componentArchetypes: {[integer]: {archetype.Archetype}}
    private dirtyQueue: archetype.DirtyQueue
    private pendingSpawns: {PendingSpawn}
    -- Each fixed-signature row is [archetype, id, optional promoted record,
    -- component values...]. Native slot offsets replace per-entity records.
    private flatSpawns: {any}
    private flatSpawnCount: integer
    private flatSealedCount: integer
    private spawnShapes: SpawnShape
    private spawnScratch: {[integer]: any}
    private flatMoves: {any}
    private flatMoveCount: integer
    private flatMovesSealed: integer
    private moveScratch: PendingMove
    private mutationValues: {[integer]: any}
    private emptyValues: {[integer]: any}
    private pendingSegments: {PendingSegment}
    private pendingSpawnBySlot: {[integer]: PendingSpawn}
    private spawnBatches: {SpawnBatch}
    private mutationBatches: {MutationBatch}
    private pendingMoves: {PendingMove}
    private pendingMoveBySlot: {[integer]: PendingMove}
    private publishingMove: PendingMove?
    private pendingDespawns: {integer}
    private pendingDespawnBySlot: {[integer]: boolean}
    private queries: {query.Query}
    private queryOwner: query.Owner
    private queryObservers: {query.Query}
    private relationshipIndexes: {[integer]: inverseindex.InverseIndex}
    private keyIndex: {[string]: integer}
    private systems: {RegisteredSystem}
    private schedule: {[phases.Phase]: {RegisteredSystem}}
    private scheduleDirty: boolean
    private pipeline: Pipeline?
    private customPhases: {[string]: phases.Definition}
    private phaseOrder: {string}
    private systemNames: {[string]: RegisteredSystem}
    private anonymousSystemCount: integer
    private disabledPhases: {[string]: boolean}
    private bundles: {[string]: Bundle}
    private snapshotHandlers: {SnapshotHandler}
    private snapshotHandlerNames: {[string]: boolean}
    private randomRegistry: randomstreams.Registry?
    private stateComponents: {[string]: components.Component}
    private statePolicies: {[string]: StatePolicy}
    private stateStack: {string}
    private autoStateComponent: components.Component?
    private updating: boolean

    --- The entity addresses something has observed, so clearing every entity
    --- can clear their registrations without touching the world's own.
    private observedEntities: {[integer]: boolean}

    private transitionObserver: TransitionObserver?

    private committing: boolean
    private runningSystem: boolean
    private systemThread: thread?
    private commitRequested: boolean
    private nominalFrameTime: number
    private fixedTimestep: number
    private fixedAccumulator: number
    private fixedStepTotal: integer
    private fixedMaxSteps: integer
    private fixedOverload: FixedOverload
    private fixedTimeDropped: number
    private fixedStepsDropped: integer
    private beforeFixedCallbacks: {function(exclusive world: World)}?
    private afterFixedCallbacks: {function(exclusive world: World)}?
    liveCount: integer
    archetypeCount: integer
    systemCount: integer

    --- Observer registrations by address and event; `observers.count` is how
    --- many are live.
    observers: nupp.events.Observers<integer>

    resources: nupp.data.Store

    spawn: function(exclusive self: World, ...: components.Input): integer
    spawnAt: function(exclusive self: World, id: integer, ...: components.Input): nil

    --- Reserves a batch sharing one signature and initializes its rows at the next
    --- barrier.
    --- @param self The world to modify.
    --- @param count The positive number of entities to reserve.
    --- @param inputs The component definitions or values, including required defaults.
    --- @param callback The optional initializer, called before membership and spawn
    ---     events.
    --- @return Returns a first packed id and nil for a contiguous range, or nil and an
    ---     explicit id list when slots or generations are non-contiguous.
    --- @raises Raises for invalid count, exhausted capacity, bare relationships or
    ---     EntityKey.
    batchSpawn: function(
        exclusive self: World,
        count: integer,
        inputs: {components.Input},
        callback: BatchCallback?
    ): (integer?, {integer}?)

    --- Reserves supplied packed identities in order for a deferred batch spawn.
    --- @param self The world to modify.
    --- @param ids The identities to restore; an empty list does nothing.
    --- @param inputs The shared component signature and initial values.
    --- @param callback The optional row initializer at publication.
    --- @raises Raises before reserving any id if one is invalid, duplicated or
    ---     occupied,
    ---     or the signature contains EntityKey or a bare relationship.
    batchSpawnAt: function(
        exclusive self: World,
        ids: {integer},
        inputs: {components.Input},
        callback: BatchCallback?
    ): nil

    --- Reserves packed identities directly from a zero-based native double array.
    --- @param self The world to modify.
    --- @param ids The borrowed array, retained until publication. Do not change its
    ---     selected prefix before the barrier.
    --- @param count The number of identities in the prefix; zero does nothing.
    --- @param inputs The shared signature. Unlike ordinary batch spawns, this
    ---     restoration path permits EntityKey, initialized before key registration.
    --- @param callback The optional initializer, called before indexes and observers.
    --- @raises Raises before reservation for an invalid count, identity, duplicate,
    ---     occupied slot, or bare relationship.
    batchSpawnAtRaw: function(
        exclusive self: World,
        ids: number[?],
        count: integer,
        inputs: {components.Input},
        callback: BatchCallback?
    ): nil

    --- Stages a value or deferred column writer for currently matching entities.
    --- @param self The world owning the query.
    --- @param selection The reusable query; membership is captured at this call.
    --- @param input The component value, or definition when supplying a callback.
    --- @param callback The optional writer, called for each contiguous affected range.
    --- @raises Raises for a foreign query, EntityKey, or callback mode with an instance
    ---     or relationship. Relationship values support constant mode.
    batchSet: function(
        exclusive self: World,
        selection: query.Query,
        input: components.Input,
        callback: BatchCallback?
    ): nil

    --- Stages component removal for the query's current committed members.
    --- @param self The world owning the query.
    --- @param selection The reusable query to capture now.
    --- @param input The component definition or a relationship value selecting one
    ---     target.
    --- @raises Raises when the query belongs to another world.
    batchRemove: function(exclusive self: World, selection: query.Query, input: components.Input): nil

    --- Stages normal teardown, events and cascading for currently matching entities.
    --- @param self The world owning the query.
    --- @param selection The reusable query to capture now.
    --- @raises Raises when the query belongs to another world.
    batchDespawn: function(exclusive self: World, selection: query.Query): nil

    --- Visits every archetype, including empty and disabled ones, in registry order.
    --- @param self The world to inspect.
    --- @param callback The callback; it must not commit or compact during this
    ---     traversal.
    forEachArchetype: function(borrows self: World, callback: function(candidate: archetype.Archetype)): nil

    --- Iterates registered archetypes containing a component, including empty ones.
    --- @param self The world to inspect.
    --- @param component The component used to select the index.
    --- @return Returns an iterator over the live component index.
    findArchetypes: function(
        borrows self: World,
        component: components.Component
    ): function(): (archetype.Archetype?, integer?, tecs.internal.entitycolumn.DoubleArray?)

    --- Captures archetypes with dirty components in registry order.
    --- @param self The world to inspect.
    --- @return Returns an independent iterator, including empty dirty archetypes.
    dirtyArchetypes: function(borrows self: World): function(): archetype.Archetype?

    --- Prunes empty dead-target archetypes and rebuilds storage that has lost rows.
    --- @param self A quiet world with no pending mutations or active dispatch.
    --- @return Returns the number of archetypes pruned and surviving stores rebuilt.
    --- @raises Raises during dispatch, publication, or with uncommitted work.
    compact: function(exclusive self: World): (integer, integer)

    isAlive: function(borrows self: World, id: integer): boolean
    has: function(borrows self: World, id: integer, component: components.Component): boolean
    byKey: function(borrows self: World, key: string): integer?
    requireKey: function(borrows self: World, key: string): integer
    get: function<C is components.Component>(borrows self: World, id: integer, component: C): C.Value?
    getMut: function<C is components.Component>(exclusive self: World, id: integer, component: C): C.Value?
    markComponentDirty: function(exclusive self: World, id: integer, component: components.Component): nil
    relationshipSources: function(borrows self: World, relationship: components.Component, target: integer): {integer}

    --- Iterates a source entity's edges in target order.
    --- @param self The world to inspect.
    --- @param id The committed source identifier.
    --- @param relationship The relationship definition or target-specific component.
    --- @param callback The callback receiving each live edge value.
    forEachRelationship: function<C is components.Component>(
        borrows self: World,
        id: integer,
        relationship: C,
        callback: function(value: C.Value)
    ): nil

    --- Returns the first edge in target order.
    --- @param self The world to inspect.
    --- @param id The committed source identifier.
    --- @param relationship The relationship to inspect.
    --- @return Returns nil when the source or edge is absent.
    getFirstRelationship: function<C is components.Component>(
        borrows self: World,
        id: integer,
        relationship: C
    ): C.Value?

    --- Visits sources targeting an entity in ascending identifier order.
    --- @param self The world to inspect.
    --- @param target The target entity identifier.
    --- @param relationship The reverse-indexed relationship.
    --- @param callback The callback receiving each source and the caller's context.
    --- @param context The caller-owned callback context.
    --- @raises Raises when the relationship has no reverse index.
    targets: function<T>(
        borrows self: World,
        target: integer,
        relationship: components.Component,
        callback: function(source: integer, context: T),
        context: T
    ): nil

    --- Traverses descendants depth first, visiting each identifier at most once.
    --- @param self The world to inspect.
    --- @param root The excluded root identifier.
    --- @param relationship The reverse-indexed relationship.
    --- @return Returns an iterator yielding depth and entity; direct children have
    ---     depth zero.
    --- @raises Raises when the relationship has no reverse index.
    traverse: function(
        borrows self: World,
        root: integer,
        relationship: components.Component
    ): function(): (integer?, integer?)

    --- Walks the first outgoing edge at each level, in target order.
    --- @param self The world to inspect.
    --- @param id The excluded starting entity.
    --- @param relationship The relationship to follow.
    --- @param callback The callback receiving ancestor, depth starting at one, and
    ---     context; false stops traversal.
    --- @param context The caller-owned callback context.
    --- @param maxDepth The positive depth limit, defaulting to 100.
    --- @raises Raises on a cycle or when the depth limit is exceeded.
    walkUp: function<T>(
        borrows self: World,
        id: integer,
        relationship: components.Component,
        callback: function(ancestor: integer, depth: integer, context: T): boolean?,
        context: T,
        maxDepth: integer?
    ): nil

    --- Creates a query over committed entities, excluding Disabled by default.
    --- @param self The world that owns the query.
    --- @param descriptor The constraints and callbacks; nil matches enabled entities.
    --- @return Returns a persistent query unless temp is true.
    --- @raises Raises for an invalid query type or temporary membership callbacks.
    newQuery: function(exclusive self: World, descriptor: query.Descriptor?): query.Query

    set: function(exclusive self: World, id: integer, input: components.Input, value: any?): nil
    remove: function(exclusive self: World, id: integer, input: components.Input): nil
    despawn: function(exclusive self: World, id: integer): nil

    --- Publishes staged mutations synchronously, including work staged by observers.
    --- Reentrant calls during publication join the active drain.
    --- @param self The world to publish; callers must leave query iteration first.
    --- @raises Raises when a publication callback raises.
    commit: function(exclusive self: World): nil

    --- Requests publication after the current system and its predicate return.
    --- Repeated requests coalesce, including across suspension. Outside a system
    --- this publishes synchronously; publication callbacks join the active drain.
    --- A failed system cancels the request without publishing its staged work.
    --- @param self The world whose pending mutations need a publication barrier.
    --- @raises Raises when a synchronous publication callback raises.
    enqueueCommit: function(exclusive self: World): nil

    --- Returns this world's stable named Nupp random generator.
    --- Stream names and the world seed determine independent sequences. The world
    --- snapshots generators automatically and restores captured objects in place.
    --- @param self The world that owns the generator and its snapshot state.
    --- @param name The non-empty stream name, preferably namespaced for its consumer.
    --- @return Returns the same mutable generator for each call with this name.
    --- @raises Raises when the name is empty.
    randomStream: function(exclusive self: World, name: string): random.Random

    --- Restarts every named random stream without replacing captured generators.
    --- Streams created later derive their seeds from this seed too.
    --- @param self The world whose random sequences restart.
    --- @param seed The finite integer seed, interpreted as a 32-bit word.
    --- @raises Raises when the seed is not a finite integer.
    seedRandom: function(exclusive self: World, seed: integer): nil

    --- Clears entity data and pending batches while preserving systems, queries and
    --- resources.
    --- @param self The world to reset; reserved identities are invalidated too.
    --- @raises Raises during publication. Use staged despawn from callbacks instead.
    clearEntities: function(exclusive self: World): nil

    --- Registers a system for the next external dispatch, copying its constraints.
    --- @param self The world to modify.
    --- @param config The phase, body, optional ordering, gate and barriers.
    --- @return Returns the unique explicit or generated system name.
    --- @raises Raises when another registered system carries that name.
    addSystem: function(exclusive self: World, config: SystemConfig): string

    --- Registers a custom leaf or tree without adding it to the default frame loop.
    --- @param self The world whose phase registry changes.
    --- @param phase The stable name, optional position and registered child names.
    --- @raises Raises for duplicate names, invalid positions, unknown children or
    ---     registration during dispatch.
    registerPhase: function(exclusive self: World, phase: phases.Definition): nil

    removeSystem: function(exclusive self: World, name: string): boolean

    --- Reports the next schedule in phase and dependency order.
    --- @param self The world to inspect without changing any active dispatch.
    --- @return Returns caller-owned metadata, including disabled systems.
    --- @raises Raises when any phase contains an ordering cycle.
    listSystems: function(borrows self: World): {SystemInfo}

    setSystemEnabled: function(exclusive self: World, name: string, enabled: boolean): (boolean, string?)
    update: function(exclusive self: World, dt: number): nil
    startup: function(exclusive self: World): nil
    shutdown: function(exclusive self: World): nil
    runPhase: function(exclusive self: World, phase: phases.Selection, dt: number?): nil
    enablePhase: function(exclusive self: World, phase: phases.Selection): nil
    disablePhase: function(exclusive self: World, phase: phases.Selection): nil
    isPhaseEnabled: function(borrows self: World, phase: phases.Phase): boolean

    --- Returns the configured seconds per presentation tick.
    getNominalFrameTime: function(borrows self: World): number

    --- Changes conversion for future sequence waits; existing deadlines stay fixed.
    setNominalFrameTime: function(exclusive self: World, seconds: number): nil

    getFixedTiming: function(borrows self: World): (number, number, number)
    fixedStepCount: function(borrows self: World): integer

    --- Reports current counts and accumulated fixed-step losses.
    --- @param self The world to inspect.
    --- @param fill The optional caller-owned result to overwrite without allocating.
    --- @return Returns fill itself, or a new record when fill is absent.
    getStats: function(borrows self: World, fill: WorldStats?): WorldStats

    createState: function(exclusive self: World, name: string, policy: StatePolicy?): components.Component
    pushState: function(exclusive self: World, name: string): nil
    popState: function(exclusive self: World): nil
    peekState: function(borrows self: World): string?
    listStates: function(borrows self: World): {string}
    newBundle: function(exclusive self: World, name: string, definition: BundleDefinition?): Bundle
    spawnBundle: function(exclusive self: World, name: string, ...: components.Input): integer
    getBundles: function(borrows self: World): {[string]: Bundle}
    getBundle: function(borrows self: World, name: string): Bundle?

    --- Saves committed entities and durable world metadata in table or native binary
    --- form.
    --- @param self The world to save; staged mutations publish first.
    --- @param options The optional format, reusable output, file, filters and custom
    ---     metadata.
    --- @return Returns a detached table snapshot or a tagged binary buffer, according
    ---     to format.
    --- @raises Raises during publication or another suspended dispatch, for invalid
    ---     options, duplicate or reserved metadata, unencodable values, or failed file
    ---     output.
    saveSnapshot: function(exclusive self: World, options: SnapshotOptions?): Snapshot

    --- Replaces entity state while retaining registered runtime setup.
    --- @param self The destination with component and state definitions already
    ---     registered.
    --- @param snapshot The current or version-one table, tagged output, byte string or
    ---     non-consuming buffer.
    --- @return Returns the validated snapshot prelude.
    --- @raises Raises during publication or another suspended dispatch, or for invalid
    ---     framing, identities, schemas, state or codecs.
    loadSnapshot: function(exclusive self: World, snapshot: any): SnapshotPrelude

    addSnapshotHandler: function(exclusive self: World, handler: SnapshotHandler): nil
    observe: function<E is nupp.events.Emittable>(
        exclusive self: World,
        address: integer,
        event: Type<E>,
        callback: nupp.events.Observer<E, World>,
        id: string?
    ): nil
    observeOnce: function<E is nupp.events.Emittable>(
        exclusive self: World,
        address: integer,
        event: Type<E>,
        callback: nupp.events.Observer<E, World>,
        id: string?
    ): nil
    stopObserving: function<E is nupp.events.Emittable>(
        exclusive self: World,
        address: integer,
        event: Type<E>,
        callbackOrId: nupp.events.Observer<E, World> | string
    ): boolean
    hasObservers: function<E is nupp.events.Emittable>(borrows self: World, address: integer, event: Type<E>): boolean
    emit: function<E is nupp.events.Emittable>(
        exclusive self: World,
        address: integer,
        event: Type<E>,
        ...: unpackof Construction(E)
    ): nil
    deliver: function<E is nupp.events.Emittable>(
        exclusive self: World,
        address: integer,
        event: Type<E>,
        instance: E
    ): nil
    clearObservers: function(exclusive self: World, address: integer): nil
end

export const DEFAULT_TIMESTEP: number = 1 / 60
export const DEFAULT_FIXED_MAX_STEPS: integer = 10
export const DEFAULT_FIXED_OVERLOAD: FixedOverload = "drop"

--- Creates an empty world.
--- @param maxEntities the fixed entity capacity
--- @param timestep the positive duration of one fixed step
--- @param fixedMaxSteps the fixed steps one frame may run
--- @param fixedOverload what happens to whole steps beyond the limit
--- @param nominalFrameTime the positive finite seconds per presentation tick,
---     defaulting to 1/60.
--- @param pipelineFactory The optional scheduler constructor, called before built-in
---     installation.
--- @return the empty world
--- @raises when a capacity or fixed-clock option is invalid
export function new(
    maxEntities: integer?,
    timestep: number?,
    fixedMaxSteps: integer?,
    fixedOverload: FixedOverload?,
    nominalFrameTime: number?,
    pipelineFactory: (function(): Pipeline)?
): World
    if timestep ~= nil and (timestep <= 0 or timestep ~= timestep) then
        error("world.new: timestep must be greater than zero", 2)
    end
    if fixedMaxSteps ~= nil and (fixedMaxSteps < 1 or fixedMaxSteps % 1 ~= 0) then
        error("world.new: fixedMaxSteps must be a positive integer", 2)
    end
    if fixedOverload ~= nil and fixedOverload ~= "drop" and fixedOverload ~= "accumulate" then
        error("world.new: fixedOverload must be 'drop' or 'accumulate'", 2)
    end
    if nominalFrameTime ~= nil and (not (nominalFrameTime > 0) or nominalFrameTime == math.huge) then
        error("world.new: nominalFrameTime must be positive and finite", 2)
    end
    const dirtyQueue = new archetype.DirtyQueue(list = {}, epoch = 1)
    local empty = archetype.new(1, {}, dirtyQueue)
    local bySignature: {[string]: archetype.Archetype} = {}
    bySignature[empty.signature] = empty
    const phaseOrder: {string} = {}
    local phaseIndex: integer = 1
    while true do
        const phase = phases.selectionAt(phases.AllGroups, phaseIndex)
        if phase == nil then
            break
        end
        phaseOrder[#phaseOrder + 1] = phase
        phaseIndex = phaseIndex + 1
    end

    return new World(
        allocator = idallocator.new(maxEntities),
        archetypes = {empty},
        archetypeById = {[1] = empty},
        maxArchetypeId = 1,
        freeArchetypeIds = {},
        archetypeBySignature = bySignature,
        componentArchetypes = {},
        dirtyQueue = dirtyQueue,
        pendingSpawns = {},
        flatSpawns = {},
        flatSpawnCount = 0,
        flatSealedCount = 0,
        spawnShapes = new SpawnShape(children = {}, defaults = {}),
        spawnScratch = {},
        flatMoves = {},
        flatMoveCount = 0,
        flatMovesSealed = 0,
        moveScratch = new PendingMove(id = 0, target = empty, values = {}, isSealed = true),
        mutationValues = {},
        emptyValues = {},
        pendingSegments = {},
        pendingSpawnBySlot = {},
        spawnBatches = {},
        mutationBatches = {},
        pendingMoves = {},
        pendingMoveBySlot = {},
        pendingDespawns = {},
        pendingDespawnBySlot = {},
        queries = {},
        queryOwner = new query.Owner(token = true),
        queryObservers = {},
        relationshipIndexes = {},
        keyIndex = {},
        systems = {},
        schedule = {},
        scheduleDirty = true,
        pipeline = pipelineFactory and pipelineFactory() or nil,
        customPhases = {},
        phaseOrder = phaseOrder,
        systemNames = {},
        anonymousSystemCount = 0,
        disabledPhases = {},
        bundles = {},
        snapshotHandlers = {},
        snapshotHandlerNames = {},
        stateComponents = {},
        statePolicies = {},
        stateStack = {},
        autoStateComponent = nil,
        updating = false,
        observedEntities = {},
        committing = false,
        runningSystem = false,
        commitRequested = false,
        nominalFrameTime = nominalFrameTime or 1 / 60,
        fixedTimestep = timestep or DEFAULT_TIMESTEP,
        fixedAccumulator = 0,
        fixedStepTotal = 0,
        fixedMaxSteps = fixedMaxSteps or DEFAULT_FIXED_MAX_STEPS,
        fixedOverload = fixedOverload or DEFAULT_FIXED_OVERLOAD,
        fixedTimeDropped = 0,
        fixedStepsDropped = 0,
        liveCount = 0,
        archetypeCount = 1,
        systemCount = 0,
        observers = nuppevents.newObservers(),
        resources = nupp.data.newStore()
    )
end

local function resolveArchetype(exclusive world: World, values: {components.Component}): archetype.Archetype
    local signature = archetype.signatureOf(values)
    local existing = world.archetypeBySignature[signature]
    if existing ~= nil then
        return existing
    end
    local id: integer
    if #world.freeArchetypeIds > 0 then
        id = world.freeArchetypeIds[#world.freeArchetypeIds]
        world.freeArchetypeIds[#world.freeArchetypeIds] = nil
    else
        world.maxArchetypeId = world.maxArchetypeId + 1
        id = world.maxArchetypeId
    end
    local created = archetype.new(id, values, world.dirtyQueue)
    world.archetypes[#world.archetypes + 1] = created
    world.archetypeById[id] = created
    world.archetypeBySignature[signature] = created
    world.archetypeCount = world.archetypeCount + 1
    for index = 1, #created.components do
        const componentId = created.components[index].componentId
        local entries = world.componentArchetypes[componentId]
        if entries == nil then
            entries = {}
            world.componentArchetypes[componentId] = entries
        end
        entries[#entries + 1] = created
    end
    for index = 1, #world.queries do
        query.addArchetype(world.queries[index], created)
    end
    world:emit(0, events.ArchetypeCreated, created)

    return created
end

local sealPending: function(exclusive world: World, writer: BatchWrite?): nil

local function reserveFlat(
    exclusive world: World,
    id: integer,
    target: archetype.Archetype,
    values: {[integer]: any}
): nil
    if #world.pendingSpawns > 0 then
        sealPending(world)
    end
    const offset = world.flatSpawnCount + 1
    const queue = world.flatSpawns
    queue[offset] = target
    queue[offset + 1] = id
    queue[offset + 2] = nil
    for index = 1, #target.components do
        queue[offset + 2 + index] = values[target.components[index].componentId]
    end
    world.flatSpawnCount = offset + 2 + #target.components
    const slot = idallocator.slotOf(id)
    idallocator.stampFlatSpawn(world.allocator, slot, offset)
    world.pendingDespawnBySlot[slot] = nil
end

local function reserve(exclusive world: World, id: integer, target: archetype.Archetype, values: {[integer]: any}): nil
    if archetype.bulkSafe(target) then
        reserveFlat(world, id, target, values)
        return
    end
    if world.flatSpawnCount > world.flatSealedCount then
        sealPending(world)
    end
    local slot = idallocator.slotOf(id)
    local pending = new PendingSpawn(id = id, target = target, values = values, isSealed = false)
    world.pendingDespawnBySlot[slot] = nil
    world.pendingSpawns[#world.pendingSpawns + 1] = pending
    world.pendingSpawnBySlot[slot] = pending

end

--- Adds everything the named components pull in with them.
---
--- A component may name others it cannot be meaningful without, and adding it
--- adds those too, so the entity lands in an archetype that carries all of
--- them and the systems reading the pair actually match it. A component
--- already named keeps its value; a missing one takes either the requirement's
--- shared instance or its own per-entity default. An explicit root limits set
--- expansion to the newly added component, not every component already present.
--- @param definitions the component list to extend in place
--- @param supplied the staged values to extend with shared requirements
--- @param root the newly added component, or nil for all spawn inputs
local function expandRequires(
    exclusive definitions: {components.Component},
    exclusive supplied: {[integer]: any},
    root: components.Component?
): nil
    local present: {[integer]: boolean} = {}
    for index = 1, #definitions do
        present[definitions[index].componentId] = true
    end
    local named = root ~= nil and 1 or #definitions
    for index = 1, named do
        local required = components.requiresClosure(root or definitions[index])
        for position = 1, #required do
            const entry = required[position]
            local component = entry.component
            if not present[component.componentId] then
                present[component.componentId] = true
                definitions[#definitions + 1] = component
                if entry.explicit then
                    supplied[component.componentId] = entry.value
                end
                const relationship = components.asRelationship(component)
                if relationship ~= nil and not relationship.sparse then
                    const edges = entry.value as {any}
                    for edgeIndex = 1, #edges do
                        definitions[#definitions + 1] = relationship:targeting(components.edgeTarget(edges[edgeIndex]))
                    end
                end
            end
        end
    end
end

local function mergeEdges(previous: {any}, additions: {any}, exclusiveRelationship: boolean): {any}
    const result: {any} = table.clone(previous)
    for index = 1, #additions do
        const edge = additions[index]
        const target = components.edgeTarget(edge)
        if exclusiveRelationship then
            result[1] = edge
        else
            local found = false
            for position = 1, #result do
                if components.edgeTarget(result[position]) == target then
                    result[position] = edge
                    found = true
                    break
                end
            end
            if not found then
                result[#result + 1] = edge
            end
        end
    end
    table.sort(result, function(left: any, right: any): boolean
        return components.edgeTarget(left) < components.edgeTarget(right)
    end)

    return result
end

local function appendRelationshipDefinitions(
    definitions: {components.Component},
    relationship: components.RelationshipComponent,
    edges: {any}
): nil
    if #edges == 0 then
        return
    end
    definitions[#definitions + 1] = assert(components.findById(relationship.componentId))
    if not relationship.sparse then
        for index = 1, #edges do
            definitions[#definitions + 1] = relationship:targeting(components.edgeTarget(edges[index]))
        end
    end
end

local function collectInputs(values: {components.Input}): {components.Component}, {[integer]: any}
    local definitions: {components.Component} = {}
    local supplied: {[integer]: any} = {}
    local relationships: {components.RelationshipComponent}? = nil
    for index = 1, #values do
        local input = values[index]
        local component = components.definitionOf(input)
        local raw, explicit = components.explicitValue(input)
        const relationship = components.asRelationship(component)
        if relationship ~= nil and not explicit then
            error("Relationship " .. component.componentName .. " requires a target", 3)
        end
        if relationship ~= nil then
            if supplied[relationship.componentId] == nil then
                if relationships == nil then
                    relationships = {}
                end
                relationships[#relationships + 1] = relationship
            end
            const additions: {any} = input is components.RelationshipBatch and input.values or {raw}
            supplied[
                relationship.componentId
            ] = mergeEdges(supplied[relationship.componentId] or {}, additions, relationship.exclusive)
        else
            definitions[#definitions + 1] = component
            if explicit then
                supplied[component.componentId] = raw
            end
        end
    end

    if relationships ~= nil then
        for index = 1, #relationships do
            const relationship = relationships[index]
            appendRelationshipDefinitions(definitions, relationship, supplied[relationship.componentId] as {any})
        end
    end

    expandRequires(definitions, supplied)

    return definitions, supplied
end

--- Reserves a new entity and stages it for the next barrier.
--- @param self the world to modify
--- @return the reserved packed entity id
--- @raises when the world has exhausted its fixed entity capacity
function World.spawn(exclusive self: World, ...: components.Input): integer
    local shape = self.spawnShapes
    local plain = true
    for index = 1, select("#", ...) do
        const component = components.definitionOf(select(index, ...))
        if components.asRelationship(component) ~= nil or component == components.Key then
            plain = false;
            break
        end
        local child = shape.children[component]
        if child == nil then
            child = new SpawnShape(children = {}, defaults = {})
            shape.children[component] = child
        end
        shape = child
    end
    if plain then
        local target = shape.target
        if target == nil or shape.state ~= self.autoStateComponent or self.archetypeById[target.id] ~= target then
            const resolvingState = self.autoStateComponent
            const inputs: {components.Input} = {...}
            if self.autoStateComponent ~= nil then
                local present = false
                for index = 1, #inputs do
                    if components.definitionOf(inputs[index]) == self.autoStateComponent then
                        present = true
                    end
                end
                if not present then
                    inputs[#inputs + 1] = self.autoStateComponent
                end
            end
            const definitions, supplied = collectInputs(inputs)
            target = resolveArchetype(self, definitions)
            table.clear(shape.defaults)
            for index = 1, #inputs do
                supplied[components.definitionOf(inputs[index]).componentId] = nil
            end
            for id, raw in pairs(supplied) do
                shape.defaults[id] = raw
            end
            shape.target = target
            shape.state = resolvingState
        end
        if archetype.bulkSafe(target) then
            const supplied = self.spawnScratch
            table.clear(supplied)
            for id, raw in pairs(shape.defaults) do
                supplied[id] = raw
            end
            for index = 1, select("#", ...) do
                const input = select(index, ...)
                const raw, explicit = components.explicitValue(input)
                if explicit then
                    supplied[components.definitionOf(input).componentId] = raw
                end
            end
            const slot = idallocator.allocSlot(self.allocator)
            const id = idallocator.encodeId(slot, idallocator.generationAt(self.allocator, slot))
            reserveFlat(self, id, target, supplied)
            table.clear(supplied)
            return id
        end
    end
    local inputs: {components.Input} = {...}
    local stateComponent = self.autoStateComponent
    if stateComponent ~= nil then
        local present = false
        for index = 1, #inputs do
            if components.definitionOf(inputs[index]) == stateComponent then
                present = true
                break
            end
        end
        if not present then
            inputs[#inputs + 1] = stateComponent
        end
    end
    local definitions, supplied = collectInputs(inputs)
    const target = resolveArchetype(self, definitions)
    local slot = idallocator.allocSlot(self.allocator)
    local generation = idallocator.generationAt(self.allocator, slot)
    local id = idallocator.encodeId(slot, generation)
    reserve(self, id, target, supplied)

    return id
end

--- Reserves an externally supplied packed id for the next barrier.
--- @param self the world to modify
--- @param id the packed entity id to restore
--- @raises when the id is out of range or its slot is already reserved or alive
function World.spawnAt(exclusive self: World, id: integer, ...: components.Input): nil
    local slot = idallocator.slotOf(id)
    local pending = self.pendingSpawnBySlot[slot]
    local archetypeId = idallocator.placement(self.allocator, slot)
    if pending ~= nil or idallocator.flatSpawnAt(
        self.allocator,
        slot
    ) ~= 0 or idallocator.spawnBatchAt(self.allocator, slot) ~= 0 or archetypeId ~= 0 then
        error("world.spawnAt: slot " .. tostring(slot) .. " is already reserved or alive", 2)
    end
    local definitions, supplied = collectInputs({...})
    const target = resolveArchetype(self, definitions)
    idallocator.stakeId(self.allocator, id)
    reserve(self, id, target, supplied)
end

local function withComponent(
    source: archetype.Archetype,
    component: components.Component,
    include: boolean,
    supplied: {[integer]: any}?
): {components.Component}
    local values: {components.Component} = {}
    for index = 1, #source.components do
        local present = source.components[index]
        if present ~= component then
            values[#values + 1] = present
        end
    end
    if include then
        values[#values + 1] = component
        -- Adding a component adds what it pulls in, the same as a spawn that
        -- names it. Removing one does not take them away again: another
        -- component may want the same thing, and a caller that added the
        -- requirement itself did not ask for it to leave.
        expandRequires(values, supplied or {}, component)
    end

    return values
end

local function pendingDespawn(borrows world: World, slot: integer): boolean
    return world.pendingDespawnBySlot[slot] or idallocator.mutationBatchAt(world.allocator, slot) < 0
end

local function resolveTransition(
    exclusive world: World,
    source: archetype.Archetype,
    component: components.Component,
    adding: boolean,
    supplied: {[integer]: any}?
): archetype.Archetype
    const cacheable = not adding or #components.requiresClosure(component) == 0
    if cacheable then
        const cached = archetype.transition(source, component, adding)
        if cached ~= nil and world.archetypeById[cached.id] == cached then
            return cached
        end
    end
    const target = resolveArchetype(world, withComponent(source, component, adding, supplied))
    if cacheable then
        archetype.cacheTransition(source, target, component, adding)
        if #components.requiresClosure(component) == 0 then
            archetype.cacheTransition(target, source, component, not adding)
        end
    end

    return target
end

local function logicalArchetype(borrows world: World, id: integer): archetype.Archetype?
    local slot = idallocator.slotOf(id)
    const mutation = idallocator.mutationBatchAt(world.allocator, slot)
    if mutation > 0 and not idallocator.isStale(world.allocator, id) then
        return world.mutationBatches[mutation].target
    end
    const flatMove = idallocator.flatMoveAt(world.allocator, slot)
    if flatMove ~= 0 and world.flatMoves[flatMove + 1] == id then
        return world.flatMoves[flatMove] as archetype.Archetype
    end
    local pendingMove = world.pendingMoveBySlot[slot]
    if pendingMove ~= nil and pendingMove.id == id then
        return pendingMove.target
    end
    local pendingSpawn = world.pendingSpawnBySlot[slot]
    if pendingSpawn ~= nil and pendingSpawn.id == id then
        return pendingSpawn.target
    end
    const flat = idallocator.flatSpawnAt(world.allocator, slot)
    if flat ~= 0 and world.flatSpawns[flat + 1] == id then
        return world.flatSpawns[flat] as archetype.Archetype
    end
    const batch = idallocator.spawnBatchAt(world.allocator, slot)
    if batch ~= 0 and not idallocator.isStale(world.allocator, id) then
        return world.spawnBatches[batch].target
    end
    const publishing = world.publishingMove
    if publishing ~= nil and publishing.id == id then
        return publishing.target
    end
    if not world:isAlive(id) then
        return nil
    end
    local archetypeId = idallocator.placement(world.allocator, slot)

    return world.archetypeById[archetypeId]
end

local function mergeValues(target: {[integer]: any}, source: {[integer]: any}): nil
    for componentId, raw in pairs(source) do
        target[componentId] = raw
    end
end

local function stageMove(
    exclusive world: World,
    id: integer,
    target: archetype.Archetype,
    values: {[integer]: any}
): nil
    local slot = idallocator.slotOf(id)
    if idallocator.mutationBatchAt(world.allocator, slot) > 0 then
        idallocator.stampMutation(world.allocator, slot, 0)
    end
    local pendingSpawn = world.pendingSpawnBySlot[slot]
    const flat = idallocator.flatSpawnAt(world.allocator, slot)
    if pendingSpawn == nil and flat > world.flatSealedCount and world.flatSpawns[flat + 1] == id then
        const original = world.flatSpawns[flat] as archetype.Archetype
        const promoted: {[integer]: any} = {}
        for index = 1, #original.components do
            promoted[original.components[index].componentId] = world.flatSpawns[flat + 2 + index]
        end
        pendingSpawn = new PendingSpawn(id = id, target = target, values = promoted, isSealed = false)
        world.flatSpawns[flat + 2] = pendingSpawn
        world.pendingSpawnBySlot[slot] = pendingSpawn
    end
    if pendingSpawn ~= nil and pendingSpawn.id == id and not pendingSpawn.isSealed then
        pendingSpawn.target = target
        mergeValues(pendingSpawn.values, values)
        return
    end
    local pending = world.pendingMoveBySlot[slot]
    if pending ~= nil and not pending.isSealed then
        pending.target = target
        mergeValues(pending.values, values)
        return
    end
    const previous = idallocator.flatMoveAt(world.allocator, slot)
    const coalesce = previous > world.flatMovesSealed and world.flatMoves[previous + 1] == id
    if archetype.bulkSafe(target) then
        if #world.pendingMoves > 0 then
            sealPending(world)
        end
        const queue = world.flatMoves
        const offset = world.flatMoveCount + 1
        queue[offset] = target
        queue[offset + 1] = id
        local count: integer = 0
        if coalesce then
            count = queue[previous + 2] as integer
            for index = 1, count * 2 do
                queue[offset + 2 + index] = queue[previous + 2 + index]
            end
            queue[previous + 1] = 0
        end
        for componentId, raw in pairs(values) do
            local found = false
            for index = 1, count do
                if queue[offset + 1 + index * 2] == componentId then
                    queue[offset + 2 + index * 2] = raw
                    found = true
                    break
                end
            end
            if not found then
                count = count + 1
                queue[offset + 1 + count * 2] = componentId
                queue[offset + 2 + count * 2] = raw
            end
        end
        queue[offset + 2] = count
        world.flatMoveCount = offset + 2 + count * 2
        idallocator.stampFlatMove(world.allocator, slot, offset)
        return
    end
    if coalesce then
        const combined: {[integer]: any} = {}
        for index = 1, world.flatMoves[previous + 2] as integer do
            combined[world.flatMoves[previous + 1 + index * 2] as integer] = world.flatMoves[previous + 2 + index * 2]
        end
        mergeValues(combined, values)
        values = combined
        world.flatMoves[previous + 1] = 0
    end
    if world.flatMoveCount > world.flatMovesSealed then
        sealPending(world)
    end
    idallocator.stampFlatMove(world.allocator, slot, 0)
    if values == world.mutationValues or values == world.emptyValues then
        values = table.clone(values)
    end
    pending = new PendingMove(id = id, target = target, values = values, isSealed = false)
    world.pendingMoves[#world.pendingMoves + 1] = pending
    world.pendingMoveBySlot[slot] = pending
end

local function logicalEdges(
    borrows world: World,
    id: integer,
    source: archetype.Archetype,
    relationship: components.RelationshipComponent
): {any}
    if not archetype.has(source, relationship) then
        return {}
    end
    const slot = idallocator.slotOf(id)
    const move = world.pendingMoveBySlot[slot]
    if move ~= nil and move.values[relationship.componentId] ~= nil then
        return move.values[relationship.componentId] as {any}
    end
    for segmentIndex = #world.pendingSegments, 1, -1 do
        const moves = world.pendingSegments[segmentIndex].moves
        for index = #moves, 1, -1 do
            const previous = moves[index]
            if previous.id == id and previous.values[relationship.componentId] ~= nil then
                return previous.values[relationship.componentId] as {any}
            end
        end
    end
    const spawn = world.pendingSpawnBySlot[slot]
    if spawn ~= nil then
        return spawn.values[relationship.componentId] or {}
    end
    const batch = idallocator.spawnBatchAt(world.allocator, slot)
    if batch ~= 0 then
        return world.spawnBatches[batch].values[relationship.componentId] or {}
    end
    const publishing = world.publishingMove
    if publishing ~= nil and publishing.id == id and publishing.values[relationship.componentId] ~= nil then
        return publishing.values[relationship.componentId] as {any}
    end
    const archetypeId, row = idallocator.placement(world.allocator, slot)

    return archetype.edgeValues(assert(world.archetypeById[archetypeId]), row, relationship)
end

local function stageEdges(
    exclusive world: World,
    id: integer,
    source: archetype.Archetype,
    relationship: components.RelationshipComponent,
    edges: {any}
): nil
    const native = ffistorage.find(relationship.componentId)
    if native ~= nil then
        for index = 1, #edges do
            edges[index] = ffistorage.capture(native, edges[index])
        end
    end
    const definitions: {components.Component} = {}
    for index = 1, #source.components do
        const component = source.components[index]
        if components.asRelationship(component) ~= relationship then
            definitions[#definitions + 1] = component
        end
    end
    appendRelationshipDefinitions(definitions, relationship, edges)
    const supplied: {[integer]: any} = {[relationship.componentId] = edges}
    if #edges > 0 and not archetype.has(source, relationship) then
        expandRequires(definitions, supplied, relationship)
    end
    stageMove(world, id, resolveArchetype(world, definitions), supplied)
end

--- Stages a component value to be present at the next barrier.
--- @param self the world to modify
--- @param id the entity to change
--- @param input the component definition or scalar wrapper to add
--- @param value an optional raw scalar value for the three-argument form
--- @raises Raises when a relationship has no valid target-bearing value.
function World.set(exclusive self: World, id: integer, input: components.Input, value: any?): nil
    local component = components.definitionOf(input)
    local source = logicalArchetype(self, id)
    if source == nil then
        return
    end
    const relationship = components.asRelationship(component)
    if relationship ~= nil then
        local raw, explicit = components.explicitValue(input)
        if value ~= nil then
            raw = value
            explicit = true
        end
        if not explicit then
            error("relationship requires a target", 2)
        end
        const additions: {any} = input is components.RelationshipBatch and input.values or {raw}
        const edges = mergeEdges(logicalEdges(self, id, source, relationship), additions, relationship.exclusive)
        stageEdges(self, id, source, relationship, edges)
        return
    end
    local raw: any = nil
    if component.storageType ~= "tag" then
        local explicit: boolean
        raw, explicit = components.explicitValue(input)
        if value ~= nil then
            raw = value
            explicit = true
        end
        if not explicit then
            raw = components.defaultValue(component)
        end
        if component.storageType == "ffi" then
            raw = ffistorage.capture(assert(ffistorage.find(component.componentId)), raw)
        end
    end
    const reusable = archetype.has(
        source,
        component
    ) or (#components.requiresClosure(component) == 0 and archetype.transition(source, component, true) ~= nil)
    local supplied: {[integer]: any} = reusable and self.mutationValues or {}
    table.clear(supplied)
    if component.storageType ~= "tag" then
        supplied[component.componentId] = raw
    end
    local target = source
    if not archetype.has(source, component) then
        target = resolveTransition(self, source, component, true, supplied)
    elseif component.storageType == "tag" then
        return
    end
    stageMove(self, id, target, supplied)
    if reusable then
        table.clear(supplied)
    end
end

--- Stages a tag component to be absent at the next barrier.
--- @param self the world to modify
--- @param id the entity to change
--- @param input The component to remove, or a relationship instance selecting just its
---     target.
function World.remove(exclusive self: World, id: integer, input: components.Input): nil
    const component = components.definitionOf(input)
    local source = logicalArchetype(self, id)
    if source == nil or not archetype.has(source, component) then
        return
    end
    const relationship = components.asRelationship(component)
    if relationship ~= nil then
        local selected = components.targetOf(component)
        const raw, explicit = components.explicitValue(input)
        if explicit then
            selected = components.edgeTarget(raw)
        end
        const edges: {any} = {}
        if selected ~= nil then
            const previous = logicalEdges(self, id, source, relationship)
            for index = 1, #previous do
                if components.edgeTarget(previous[index]) ~= selected then
                    edges[#edges + 1] = previous[index]
                end
            end
        end
        stageEdges(self, id, source, relationship, edges)
        return
    end
    stageMove(self, id, resolveTransition(self, source, component, false), self.emptyValues)
end

sealPending = function(exclusive world: World, writer: BatchWrite?): nil
    if #world.pendingSpawns == 0
        and world.flatSpawnCount == world.flatSealedCount
        and world.flatMoveCount == world.flatMovesSealed
        and #world.pendingMoves == 0
        and #world.pendingDespawns == 0
        and writer == nil
    then
        return
    end
    for index = 1, #world.pendingSpawns do
        world.pendingSpawns[index].isSealed = true
    end
    for index = 1, #world.pendingMoves do
        world.pendingMoves[index].isSealed = true
    end
    world.pendingSegments[
        #world.pendingSegments + 1
    ] = new PendingSegment(
        spawns = world.pendingSpawns,
        moves = world.pendingMoves,
        despawns = world.pendingDespawns,
        writer = writer,
        flatFirst = world.flatSealedCount + 1,
        flatLast = world.flatSpawnCount,
        moveFirst = world.flatMovesSealed + 1,
        moveLast = world.flatMoveCount
    )
    local offset = world.flatSealedCount + 1
    while offset <= world.flatSpawnCount do
        const target = world.flatSpawns[offset] as archetype.Archetype
        const promoted = world.flatSpawns[offset + 2] as PendingSpawn?
        if promoted ~= nil then
            promoted.isSealed = true
        end
        offset = offset + 3 + #target.components
    end
    world.flatSealedCount = world.flatSpawnCount
    world.flatMovesSealed = world.flatMoveCount
    world.pendingSpawns = {}
    world.pendingMoves = {}
    world.pendingDespawns = {}
end

local function batchIds(borrows world: World, selection: query.Query): {integer}
    if not query.belongsTo(selection, world.queryOwner) then
        error("batch mutation requires a query from this world", 3)
    end
    const ids: {integer} = {}
    for _, count, entities in selection:iter() do
        const stored = assert(entities)
        for row = 1, assert(count) do
            ids[#ids + 1] = stored[row]
        end
    end

    return ids
end

-- Bulk constants copy their outer value, preserving record behavior. Nested
-- references remain shared, just as with an ordinary shallow record copy.
local function copyBatchValue(value: any): any
    if type(value) == "table" then
        return setmetatable(table.clone(value), getmetatable(value))
    end
    return value
end

local function copyBatchValues(supplied: {[integer]: any}, shared: {[integer]: boolean}): {[integer]: any}
    const result: {[integer]: any} = {}
    for id, value in pairs(supplied) do
        if shared[id] then
            result[id] = value
        elseif components.asRelationship(assert(components.findById(id))) ~= nil then
            const edges: {any} = {}
            for index = 1, #value do
                edges[index] = copyBatchValue(value[index])
            end
            result[id] = edges
        else
            result[id] = copyBatchValue(value)
        end
    end

    return result
end

local function batchSignature(
    exclusive world: World,
    inputs: {components.Input},
    autoState: boolean,
    allowKeys: boolean?
): archetype.Archetype, {[integer]: any}, {[integer]: boolean}
    const values = table.clone(inputs)
    if autoState and world.autoStateComponent ~= nil then
        local present = false
        for index = 1, #values do
            if components.definitionOf(values[index]) == world.autoStateComponent then
                present = true
            end
        end
        if not present then
            values[#values + 1] = assert(world.autoStateComponent)
        end
    end
    const definitions, supplied = collectInputs(values)
    const shared: {[integer]: boolean} = {}
    for id in pairs(supplied) do
        shared[id] = true
    end
    for index = 1, #values do
        shared[components.definitionOf(values[index]).componentId] = nil
    end
    for index = 1, #definitions do
        if definitions[index] == components.Key and not allowKeys then
            error("batch spawn does not support EntityKey; set keys per entity", 3)
        end
    end

    return resolveArchetype(world, definitions), supplied, shared
end

local function batchId(batch: SpawnBatch, index: integer): integer
    if batch.rawIds ~= nil then
        unsafe do
            return batch.rawIds[index - 1] as integer
        end
    end

    return batch.ids ~= nil and batch.ids[index] or batch.firstId + index - 1
end

local function queueSpawnBatch(exclusive world: World, batch: SpawnBatch): nil
    sealPending(world)
    world.spawnBatches[batch.index] = batch
    for index = 1, batch.count do
        const slot = idallocator.slotOf(batchId(batch, index))
        idallocator.stampSpawn(world.allocator, slot, batch.index)
        world.pendingDespawnBySlot[slot] = nil
    end
    world.pendingSegments[
        #world.pendingSegments + 1
    ] = new PendingSegment(spawns = {}, moves = {}, despawns = {}, spawnBatch = batch)
end

function World.batchSpawn(
    exclusive self: World,
    count: integer,
    inputs: {components.Input},
    callback: BatchCallback?
): (integer?, {integer}?)
    if count < 1 or count % 1 ~= 0 or count == math.huge then
        error("batchSpawn requires a positive integer count", 2)
    end
    const available = self.allocator.maxSlotCount - self.allocator.nextFreshSlot + 1 + self.allocator.freeCount
    if count > available then
        error("batchSpawn: entity ID exhaustion", 2)
    end
    const target, supplied, shared = batchSignature(self, inputs, true)
    local ids: {integer}? = nil
    local firstId: integer = 0
    if self.allocator.nextFreshSlot + count <= self.allocator.maxSlotCount + 1 then
        const firstSlot = idallocator.allocContiguousSlots(self.allocator, count)
        idallocator.reserveSlots(self.allocator, firstSlot + count - 1)
        const generation = idallocator.generationAt(self.allocator, firstSlot)
        firstId = idallocator.encodeId(firstSlot, generation)
        if self.allocator.maxGeneration ~= 0 then
            for slot = firstSlot + 1, firstSlot + count - 1 do
                if idallocator.generationAt(self.allocator, slot) ~= generation then
                    ids = {}
                    break
                end
            end
        end
        if ids ~= nil then
            for index = 1, count do
                const slot = firstSlot + index - 1
                ids[index] = idallocator.encodeId(slot, idallocator.generationAt(self.allocator, slot))
            end
        end
    else
        ids = {}
        for index = 1, count do
            const slot = idallocator.allocSlot(self.allocator)
            ids[index] = idallocator.encodeId(slot, idallocator.generationAt(self.allocator, slot))
        end
    end
    queueSpawnBatch(
        self,
        new SpawnBatch(
            index = #self.spawnBatches + 1,
            target = target,
            values = supplied,
            shared = shared,
            count = count,
            firstId = firstId,
            ids = ids ~= nil and table.clone(ids) or nil,
            callback = callback
        )
    )
    if ids == nil then
        return firstId, nil
    end

    return nil, ids
end

function World.batchSpawnAt(
    exclusive self: World,
    ids: {integer},
    inputs: {components.Input},
    callback: BatchCallback?
): nil
    const seen: {[integer]: boolean} = {}
    for index = 1, #ids do
        const id = ids[index]
        const slot = idallocator.slotOf(id)
        if id < 1 or id > 9007199254740991 or id % 1 ~= 0 or slot < 1 or slot > self.allocator.maxSlotCount then
            error("batchSpawnAt: invalid packed entity id", 2)
        end
        if seen[
            slot
        ] or self.pendingSpawnBySlot[
            slot
        ] ~= nil or idallocator.spawnBatchAt(
            self.allocator,
            slot
        ) ~= 0 or idallocator.flatSpawnAt(
            self.allocator,
            slot
        ) ~= 0 or idallocator.placement(self.allocator, slot) ~= 0 then
            error("batchSpawnAt: duplicate or occupied entity slot", 2)
        end
        seen[slot] = true
    end
    if #ids == 0 then
        return
    end
    const target, supplied, shared = batchSignature(self, inputs, false)
    for index = 1, #ids do
        idallocator.stakeId(self.allocator, ids[index])
    end
    queueSpawnBatch(
        self,
        new SpawnBatch(
            index = #self.spawnBatches + 1,
            target = target,
            values = supplied,
            shared = shared,
            count = #ids,
            firstId = 0,
            ids = table.clone(ids),
            callback = callback
        )
    )
    const reserved: {[integer]: boolean} = {}
    for slot in pairs(self.pendingSpawnBySlot) do
        reserved[slot] = true
    end
    idallocator.rebuildFreeStack(self.allocator, reserved)
end

function World.batchSpawnAtRaw(
    exclusive self: World,
    ids: number[?],
    count: integer,
    inputs: {components.Input},
    callback: BatchCallback?
): nil
    if count < 0 or count % 1 ~= 0 or count == math.huge or count * 8 > ffi.sizeof(ids) then
        error("batchSpawnAtRaw: count exceeds the native identity array", 2)
    end
    if count == 0 then
        return
    end
    const seen: {[integer]: boolean} = {}
    unsafe do
        for index = 0, count - 1 do
            const id = ids[index] as integer
            const slot = idallocator.slotOf(id)
            if id < 1 or id > 9007199254740991 or id % 1 ~= 0 or slot < 1 or slot > self.allocator.maxSlotCount then
                error("batchSpawnAtRaw: invalid packed entity id", 2)
            end
            if seen[
                slot
            ] or self.pendingSpawnBySlot[
                slot
            ] ~= nil or idallocator.spawnBatchAt(
                self.allocator,
                slot
            ) ~= 0 or idallocator.flatSpawnAt(
                self.allocator,
                slot
            ) ~= 0 or idallocator.placement(self.allocator, slot) ~= 0 then
                error("batchSpawnAtRaw: duplicate or occupied entity slot", 2)
            end
            seen[slot] = true
        end
    end
    const target, supplied, shared = batchSignature(self, inputs, false, true)
    unsafe do
        for index = 0, count - 1 do
            idallocator.stakeId(self.allocator, ids[index] as integer)
        end
    end
    queueSpawnBatch(
        self,
        new SpawnBatch(
            index = #self.spawnBatches + 1,
            target = target,
            values = supplied,
            shared = shared,
            count = count,
            firstId = 0,
            rawIds = ids,
            callback = callback
        )
    )
    const reserved: {[integer]: boolean} = {}
    for slot in pairs(self.pendingSpawnBySlot) do
        reserved[slot] = true
    end
    idallocator.rebuildFreeStack(self.allocator, reserved)
end

-- Capture row identities in native storage because an earlier queued operation
-- may move or append to this archetype before this descriptor publishes. The
-- ordinary whole-archetype case still swaps columns; exceptions use these ids.
local function tryStageBulk(
    exclusive world: World,
    selection: query.Query,
    component: components.Component?,
    raw: any,
    explicit: boolean,
    removing: boolean,
    callback: BatchCallback?,
    despawning: boolean
): boolean
    if not query.belongsTo(selection, world.queryOwner) then
        error("batch mutation requires a query from this world", 3)
    end
    if despawning and (#world.spawnBatches > 0 or #world.pendingSpawns > 0 or world.flatSpawnCount > 0) then
        return false
    end
    const batches: {MutationBatch} = {}
    for candidate, rows in selection:iter() do
        const count = assert(rows)
        if count > 0 then
            const selected = assert(candidate)
            const source = assert(logicalArchetype(world, selected.entities[1]))
            if not archetype.bulkSafe(source) then
                return false
            end
            for row = 1, count do
                const id = selected.entities[row]
                const slot = idallocator.slotOf(id)
                if world.pendingMoveBySlot[
                    slot
                ] ~= nil or pendingDespawn(world, slot) or logicalArchetype(world, id) ~= source then
                    return false
                end
            end
            const values: {[integer]: any} = {}
            const shared: {[integer]: boolean} = {}
            local target = source
            local resetComponent: components.Component? = nil
            if component ~= nil then
                if removing then
                    if archetype.has(source, component) then
                        target = resolveTransition(world, source, component, false)
                    end
                else
                    if not archetype.has(source, component) then
                        target = resolveTransition(world, source, component, true, values)
                    end
                    for id in pairs(values) do
                        shared[id] = true
                    end
                    if component.storageType ~= "tag" then
                        if explicit then
                            const native = ffistorage.find(component.componentId)
                            values[component.componentId] = native ~= nil and ffistorage.capture(native, raw) or raw
                            shared[component.componentId] = false
                        elseif callback == nil then
                            resetComponent = component
                        end
                    end
                end
            end
            if not archetype.bulkSafe(target) then
                return false
            end
            const ids = ffi.new("double[?]", count) as number[?]
            unsafe do
                for row = 1, count do
                    ids[row - 1] = selected.entities[row]
                end
            end
            batches[
                #batches + 1
            ] = new MutationBatch(
                index = #world.mutationBatches + #batches + 1,
                source = source,
                target = target,
                ids = ids,
                count = count,
                values = values,
                shared = shared,
                callback = callback,
                despawn = despawning,
                resetComponent = resetComponent,
                writeComponent = component
            )
        end
    end
    sealPending(world)
    for index = 1, #batches do
        const batch = batches[index]
        world.mutationBatches[batch.index] = batch
        unsafe do
            for row = 0, batch.count - 1 do
                const slot = idallocator.slotOf(batch.ids[row] as integer)
                if despawning then
                    idallocator.stampMutation(world.allocator, slot, -batch.index)
                else
                    idallocator.stampMutation(world.allocator, slot, batch.index)
                end
            end
        end
        world.pendingSegments[
            #world.pendingSegments + 1
        ] = new PendingSegment(spawns = {}, moves = {}, despawns = {}, mutationBatch = batch)
    end

    return true
end

function World.batchSet(
    exclusive self: World,
    selection: query.Query,
    input: components.Input,
    callback: BatchCallback?
): nil
    const component = components.definitionOf(input)
    const raw, explicit = components.explicitValue(input)
    const relationship = components.asRelationship(component)
    if component == components.Key then
        error("batchSet does not support EntityKey; set keys per entity", 2)
    end
    if callback ~= nil and (explicit or relationship ~= nil) then
        error("batchSet callback requires a plain component definition", 2)
    end
    if relationship ~= nil and not explicit then
        error("batchSet relationship requires a target", 2)
    end
    if relationship == nil and tryStageBulk(self, selection, component, raw, explicit, false, callback, false) then
        return
    end
    const ids = batchIds(self, selection)
    const targets: {[archetype.Archetype]: archetype.Archetype} = {}
    const requirements: {[archetype.Archetype]: {[integer]: any}} = {}
    for index = 1, #ids do
        const id = ids[index]
        const source = logicalArchetype(self, id)
        if source ~= nil then
            if relationship ~= nil then
                self:set(id, component, copyBatchValue(raw))
            elseif callback == nil or not archetype.has(source, component) then
                local target = targets[source]
                if target == nil then
                    const required: {[integer]: any} = {}
                    target = archetype.has(
                        source,
                        component
                    ) and source or resolveTransition(self, source, component, true, required)
                    targets[source] = target
                    requirements[source] = required
                end
                const supplied: {[integer]: any} = table.clone(assert(requirements[source]))
                if component.storageType ~= "tag" then
                    if explicit then
                        supplied[component.componentId] = copyBatchValue(raw)
                    else
                        supplied[component.componentId] = components.defaultValue(component)
                    end
                end
                stageMove(self, id, target, supplied)
            end
        end
    end
    if callback ~= nil and #ids > 0 then
        sealPending(self, new BatchWrite(ids = ids, component = component, callback = callback))
    end
end

function World.batchRemove(exclusive self: World, selection: query.Query, input: components.Input): nil
    const component = components.definitionOf(input)
    if components.asRelationship(
        component
    ) == nil and tryStageBulk(self, selection, component, nil, false, true, nil, false) then
        return
    end
    const ids = batchIds(self, selection)
    if components.asRelationship(component) ~= nil then
        for index = 1, #ids do
            self:remove(ids[index], input)
        end
        return
    end
    const targets: {[archetype.Archetype]: archetype.Archetype} = {}
    for index = 1, #ids do
        const id = ids[index]
        const source = logicalArchetype(self, id)
        if source ~= nil and archetype.has(source, component) then
            local target = targets[source]
            if target == nil then
                target = resolveTransition(self, source, component, false)
                targets[source] = target
            end
            stageMove(self, id, target, {})
        end
    end
end

function World.batchDespawn(exclusive self: World, selection: query.Query): nil
    if tryStageBulk(self, selection, nil, nil, false, false, nil, true) then
        return
    end
    const ids = batchIds(self, selection)
    for index = 1, #ids do
        self:despawn(ids[index])
    end
end

--- Reports whether an entity is committed and alive.
--- @param self the world to inspect
--- @param id the packed entity id
--- @return true only for the currently committed generation
function World.isAlive(borrows self: World, id: integer): boolean
    local slot = idallocator.slotOf(id)
    local archetypeId = idallocator.placement(self.allocator, slot)
    return archetypeId ~= 0 and not idallocator.isStale(self.allocator, id)
end

--- Reports whether a committed entity carries a component.
--- @param self the world to inspect
--- @param id the packed entity id
--- @param component the component to find
--- @return whether the live entity's archetype contains the component
function World.has(borrows self: World, id: integer, component: components.Component): boolean
    if not self:isAlive(id) then
        return false
    end
    local slot = idallocator.slotOf(id)
    local archetypeId = idallocator.placement(self.allocator, slot)

    return archetype.has(assert(self.archetypeById[archetypeId]), component)
end

--- Returns one committed component value.
--- @param self the world to inspect
--- @param id the packed entity id
--- @param component the component to read
--- @return the raw scalar, tag singleton, or nil when absent or dead
function World.get<C is components.Component>(borrows self: World, id: integer, component: C): C.Value?
    if not self:isAlive(id) then
        return nil
    end
    local slot = idallocator.slotOf(id)
    local archetypeId, row = idallocator.placement(self.allocator, slot)

    return archetype.valueAt(assert(self.archetypeById[archetypeId]), row, component)
end

--- Returns one committed component value and marks its archetype column dirty.
--- @param self the world to modify
--- @param id the packed entity id
--- @param component the component the caller intends to write
--- @return the live value, or nil when absent or dead
function World.getMut<C is components.Component>(exclusive self: World, id: integer, component: C): C.Value?
    if not self:isAlive(id) then
        return nil
    end
    local slot = idallocator.slotOf(id)
    local archetypeId, row = idallocator.placement(self.allocator, slot)
    local source = assert(self.archetypeById[archetypeId])
    source:markComponentDirty(component)

    return archetype.valueAt(source, row, component)
end

--- Marks a committed entity's component dirty after an out-of-band write.
--- @param self the world to modify
--- @param id the packed entity id
--- @param component the component whose storage changed
function World.markComponentDirty(exclusive self: World, id: integer, component: components.Component): nil
    if not self:isAlive(id) then
        return
    end
    local slot = idallocator.slotOf(id)
    local archetypeId = idallocator.placement(self.allocator, slot)
    assert(self.archetypeById[archetypeId]):markComponentDirty(component)
end

--- Reports whether any archetype holds a dirty column for one of these components.
---
--- A gate that recomputes derived state needs to know that something anywhere
--- changed, not that a particular query matched, because the entity that moved
--- may live in an archetype the derived query never sees. A parent carrying only
--- `Transform2D` is exactly that case. The walk covers every archetype because
--- dirty marks live on archetypes rather than in a world-level list.
--- @param world the world to inspect
--- @param values the components whose changed columns open the gate
--- @return whether at least one archetype reports one of them dirty
export function anyDirty(borrows world: World, values: {components.Component}): boolean
    for index = 1, world.archetypeCount do
        local source = world.archetypes[index]
        if source:anyComponentDirty() then
            for valueIndex = 1, #values do
                if source:isComponentDirty(values[valueIndex]) then
                    return true
                end
            end
        end
    end

    return false
end

local function collectRelationshipSource(source: integer, context: any): nil
    local result = context as {integer}
    result[#result + 1] = source
end

--- Returns the sources currently linked to one relationship target.
--- @param self the world to inspect
--- @param relationship the reverse-indexed relationship
--- @param target the target entity id
--- @return a sorted caller-owned source list
--- @raises Raises when the component is not a relationship with a reverse index.
function World.relationshipSources(borrows self: World, relationship: components.Component, target: integer): {integer}
    const metadata = assert(components.asRelationship(relationship), "expected a relationship")
    if not metadata.reverseIndex then
        error("relationshipSources requires reverseIndex = true", 2)
    end
    local result: {integer} = {}
    local inverse = self.relationshipIndexes[metadata.componentId]
    if inverse ~= nil then
        inverse:forEachSource(target, collectRelationshipSource, result)
        table.sort(result)
    end

    return result
end

function World.forEachRelationship<C is components.Component>(
    borrows self: World,
    id: integer,
    relationship: C,
    callback: function(value: C.Value)
): nil
    if not self:isAlive(id) then
        return
    end
    const archetypeId, row = idallocator.placement(self.allocator, idallocator.slotOf(id))
    assert(self.archetypeById[archetypeId]):forEachRelationship(relationship, row + 1, callback)
end

function World.getFirstRelationship<C is components.Component>(
    borrows self: World,
    id: integer,
    relationship: C
): C.Value?
    if components.asRelationship(relationship) == nil then
        error("expected a relationship", 2)
    end
    return self:get(id, relationship)
end

function World.targets<T>(
    borrows self: World,
    target: integer,
    relationship: components.Component,
    callback: function(source: integer, context: T),
    context: T
): nil
    const sources = self:relationshipSources(relationship, target)
    for index = 1, #sources do
        callback(sources[index], context)
    end
end

function World.traverse(
    borrows self: World,
    root: integer,
    relationship: components.Component
): function(): (integer?, integer?)
    const metadata = assert(components.asRelationship(relationship), "expected a relationship")
    if not metadata.reverseIndex then
        error("traverse requires reverseIndex = true", 2)
    end
    const inverse = self.relationshipIndexes[metadata.componentId]
    const stack: {{integer}} = {}
    const seen: {[integer]: boolean} = {[root] = true}
    local function pushChildren(target: integer, depth: integer): nil
        const children: {integer} = {}
        if inverse ~= nil then
            inverse:forEachSource(target, collectRelationshipSource, children)
        end
        table.sort(children)
        for index = #children, 1, -1 do
            stack[#stack + 1] = {children[index], depth}
        end
    end

    pushChildren(root, 0)

    return function(): (integer?, integer?)
        while #stack > 0 do
            const item = assert(table.remove(stack))
            const id: integer = item[1]
            const depth: integer = item[2]
            if not seen[id] then
                seen[id] = true
                pushChildren(id, (depth + 1) as integer)
                return depth, id
            end
        end

        return nil, nil
    end
end

function World.walkUp<T>(
    borrows self: World,
    id: integer,
    relationship: components.Component,
    callback: function(ancestor: integer, depth: integer, context: T): boolean?,
    context: T,
    maxDepth: integer?
): nil
    const metadata = assert(components.asRelationship(relationship), "expected a relationship")
    const limit = maxDepth or 100
    if limit < 1 then
        error("walkUp requires a positive depth limit", 2)
    end
    const seen: {[integer]: boolean} = {[id] = true}
    local current: integer = id
    local depth: integer = 0
    while self:isAlive(current) do
        const edge = self:get(current, metadata)
        if edge == nil then
            return
        end
        current = edge.target
        depth = depth + 1
        if seen[current] or depth > limit then
            error("walkUp encountered a cycle or exceeded its depth limit", 2)
        end
        seen[current] = true
        if callback(current, depth, context) == false then
            return
        end
    end
end

local function registerQuery(exclusive self: World, value: query.Query): query.Query
    query.bindOwner(value, self.queryOwner)
    if not value.descriptor.temp then
        self.queries[#self.queries + 1] = value
        if value.descriptor.onEntitiesAdded ~= nil or value.descriptor.onEntitiesRemoved ~= nil then
            self.queryObservers[#self.queryObservers + 1] = value
        end
    end
    local candidates = self.archetypes
    const included = value.descriptor.include
    if included ~= nil then
        for index = 1, #included do
            const entries = self.componentArchetypes[included[index].componentId]
            if entries == nil then
                return value
            end
            if #entries < #candidates then
                candidates = entries
            end
        end
    end
    for index = 1, #candidates do
        query.addArchetype(value, candidates[index])
    end

    return value
end

--- Creates a reusable query with automatic state filtering.
--- @param self The world owning the query.
--- @param descriptor The constraints and optional membership callbacks, copied during
---     construction.
--- @return Returns a query excluding Disabled unless explicitly included, and Paused
---     for logic queries.
--- @raises Raises when a temporary query declares callbacks or a callback raises.
function World.newQuery(exclusive self: World, descriptor: query.Descriptor?): query.Query
    return registerQuery(self, query.new(descriptor, true))
end

--- Creates a persistent engine query that can see disabled entities during cleanup.
--- @param world The world owning native resources or retained derived data.
--- @param descriptor The explicit constraints; no state exclusions are added.
--- @return Returns the registered query.
export function newUnfilteredQuery(exclusive world: World, descriptor: query.Descriptor?): query.Query
    return registerQuery(world, query.new(descriptor))
end

--- Registers an addressed typed-event observer.
---
--- Observers run in registration order and receive this world as their second
--- argument. A name lets `stopObserving` remove the registration by name; a
--- name already observing this event at this address is an error.
--- @param self the world that owns the observer
--- @param address zero for the world or an entity id
--- @param event the event declaration
--- @param callback what runs when one is delivered, with the event borrowed
--- @param id an optional name used for later removal
--- @raises when the same name already observes this event and address
function World.observe<E is nupp.events.Emittable>(
    exclusive self: World,
    address: integer,
    event: Type<E>,
    callback: nupp.events.Observer<E, World>,
    id: string?
): nil
    nuppevents.observe(self, address, event, callback, id)
    if address ~= 0 then
        self.observedEntities[address] = true
    end
end

--- Registers an observer consumed before its first delivery.
--- @param self the world that owns the observer
--- @param address zero for the world or an entity id
--- @param event the event declaration
--- @param callback what runs, once
--- @param id an optional name used for later removal
--- @raises when the same name already observes this event and address
function World.observeOnce<E is nupp.events.Emittable>(
    exclusive self: World,
    address: integer,
    event: Type<E>,
    callback: nupp.events.Observer<E, World>,
    id: string?
): nil
    nuppevents.observeOnce(self, address, event, callback, id)
    if address ~= 0 then
        self.observedEntities[address] = true
    end
end

--- Removes observers at one address and event.
---
--- Given a name, the first registration with that name goes; given the
--- callback, every registration of it. A removal during a delivery takes
--- effect at once for anything the delivery has not yet reached.
--- @param self the world to modify
--- @param address the observer address
--- @param event the observed event declaration
--- @param callbackOrId the callback registered, or the name supplied at registration
--- @return whether a matching observer existed
function World.stopObserving<E is nupp.events.Emittable>(
    exclusive self: World,
    address: integer,
    event: Type<E>,
    callbackOrId: nupp.events.Observer<E, World> | string
): boolean
    return nuppevents.stopObserving(self, address, event, callbackOrId)
end

--- Reports whether an address has an observer for an event.
--- @param self the world to inspect
--- @param address the world or entity address
--- @param event the event declaration
--- @return whether at least one observer is registered
function World.hasObservers<E is nupp.events.Emittable>(borrows self: World, address: integer, event: Type<E>): boolean
    return nuppevents.hasObservers(self, address, event)
end

--- Constructs an event into the world's storage and delivers it to one address.
---
--- Nothing is constructed when nothing observes the event there. Observers
--- run in registration order, see each other's writes, and cannot keep the
--- event; the storage returns to the world when the delivery leaves, whether
--- it returned, raised, or was cancelled while an observer was suspended.
--- @param self the world whose observers receive the event
--- @param address zero for the world or an entity id
--- @param event the event declaration
--- @param ... the event's fields, positional or named
--- @raises what an observer raised, after the storage is released
function World.emit<E is nupp.events.Emittable>(
    exclusive self: World,
    address: integer,
    event: Type<E>,
    ...: unpackof Construction(E)
): nil
    nuppevents.emit(self, address, event, ...)
end

--- Delivers an event instance the caller already holds.
---
--- The instance stays the caller's, and what observers wrote to it is there
--- when the delivery returns, which is what a bubbling delivery reads back.
--- @param self the world whose observers receive the event
--- @param address zero for the world or an entity id
--- @param event the event declaration
--- @param instance the instance to deliver
--- @raises what an observer raised
function World.deliver<E is nupp.events.Emittable>(
    exclusive self: World,
    address: integer,
    event: Type<E>,
    instance: E
): nil
    nuppevents.deliver(self, address, event, instance)
end

--- Clears every event observer at one address.
--- @param self the world to modify
--- @param address the world or entity address to clear
function World.clearObservers(exclusive self: World, address: integer): nil
    nuppevents.clearAddress(self, address)
    if address ~= 0 then
        self.observedEntities[address] = nil
    end
end

--- Stages a live or newly reserved entity for removal.
---
--- Dead, invalid, and stale ids are silent no-ops. Repeating the same despawn
--- is also a no-op.
--- @param self the world to modify
--- @param id the entity to remove
function World.despawn(exclusive self: World, id: integer): nil
    local slot = idallocator.slotOf(id)
    if pendingDespawn(self, slot) then
        return
    end
    local pending = self.pendingSpawnBySlot[slot]
    const batch = idallocator.spawnBatchAt(self.allocator, slot)
    if (
        pending == nil or pending.id ~= id
    ) and (
        batch == 0 or idallocator.isStale(self.allocator, id)
    ) and (
        idallocator.flatSpawnAt(self.allocator, slot) == 0 or idallocator.isStale(self.allocator, id)
    ) and not self:isAlive(id) then
        return
    end
    self.pendingDespawns[#self.pendingDespawns + 1] = id
    self.pendingDespawnBySlot[slot] = true
    for _, child in pairs(self.pendingSpawnBySlot) do
        local childSlot = idallocator.slotOf(child.id)
        if not pendingDespawn(self, childSlot) then
            const target = assert(logicalArchetype(self, child.id))
            for componentIndex = 1, #target.components do
                local relationship = components.asRelationship(target.components[componentIndex])
                if relationship ~= nil and relationship.cascadeDelete then
                    const raw = logicalEdges(self, child.id, target, relationship)
                    if #raw > 0 and components.edgeTarget(raw[1]) == id then
                        self:despawn(child.id)
                        break
                    end
                end
            end
        end
    end
    for batchIndex = 1, #self.spawnBatches do
        const children = self.spawnBatches[batchIndex]
        if not archetype.bulkSafe(children.target) then
            for childIndex = 1, children.count do
                const childId = batchId(children, childIndex)
                const childSlot = idallocator.slotOf(childId)
                if idallocator.spawnBatchAt(
                    self.allocator,
                    childSlot
                ) == children.index and not pendingDespawn(self, childSlot) then
                    const target = assert(logicalArchetype(self, childId))
                    for componentIndex = 1, #target.components do
                        const relationship = components.asRelationship(target.components[componentIndex])
                        if relationship ~= nil and relationship.cascadeDelete then
                            const edges = logicalEdges(self, childId, target, relationship)
                            if #edges > 0 and components.edgeTarget(edges[1]) == id then
                                self:despawn(childId)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end

local function relationshipIndex(
    exclusive world: World,
    relationship: components.RelationshipComponent
): inverseindex.InverseIndex
    local index = world.relationshipIndexes[relationship.componentId]
    if index == nil then
        index = inverseindex.new()
        world.relationshipIndexes[relationship.componentId] = index
    end

    return index
end

--- Claims a durable key for one entity.
---
--- A key names at most one live entity, so a claim on a key another entity
--- already holds is a programmer error rather than a silent reassignment: the
--- two entities disagree about which one `byKey` should answer with, and
--- nothing later can resolve that.
--- @param world the world holding the index
--- @param entity the entity claiming the key
--- @param key the durable key
--- @raises when the key is empty or another live entity holds it
local function claimKey(exclusive world: World, entity: integer, key: string): nil
    if key == "" then
        error("world: an entity key must not be empty", 3)
    end
    local current = world.keyIndex[key]
    if current ~= nil and current ~= entity then
        error("world: key '" .. key .. "' is already claimed by entity " .. tostring(current), 3)
    end
    world.keyIndex[key] = entity
end

--- Releases a key an entity holds, if it still holds it.
--- @param world the world holding the index
--- @param entity the entity releasing the key
--- @param key the durable key
local function releaseKey(exclusive world: World, entity: integer, key: string): nil
    if world.keyIndex[key] == entity then
        world.keyIndex[key] = nil
    end
end

local function linkOutgoing(exclusive world: World, source: archetype.Archetype, row: integer, entity: integer): nil
    for index = 1, #source.components do
        local relationship = components.asRelationship(source.components[index])
        if relationship ~= nil and relationship.componentId == source.components[
            index
        ].componentId and relationship.reverseIndex then
            const edges = archetype.edgeValues(source, row, relationship)
            const inverse = relationshipIndex(world, relationship)
            for edgeIndex = 1, #edges do
                inverse:link(entity, components.edgeTarget(edges[edgeIndex]))
            end
        end
    end
    local key = archetype.valueAt(source, row, components.Key)
    if key ~= nil then
        claimKey(world, entity, key as string)
    end
end

local function unlinkOutgoing(exclusive world: World, source: archetype.Archetype, row: integer, entity: integer): nil
    for index = 1, #source.components do
        local relationship = components.asRelationship(source.components[index])
        if relationship ~= nil and relationship.componentId == source.components[
            index
        ].componentId and relationship.reverseIndex then
            const edges = archetype.edgeValues(source, row, relationship)
            const inverse = relationshipIndex(world, relationship)
            for edgeIndex = 1, #edges do
                inverse:unlink(entity, components.edgeTarget(edges[edgeIndex]))
            end
        end
    end
    local key = archetype.valueAt(source, row, components.Key)
    if key ~= nil then
        releaseKey(world, entity, key as string)
    end
end

local function removeFromArchetype(exclusive world: World, source: archetype.Archetype, row: integer): nil
    const previousLast = #source.entities - 1
    local movedId = archetype.removeRow(source, row)
    if movedId ~= nil then
        local movedSlot = idallocator.slotOf(movedId)
        idallocator.place(world.allocator, movedSlot, source.id, row)
        archetype.notifyMove(source, movedId, previousLast, row)
    end
end

local function notifyQueries(
    exclusive world: World,
    source: archetype.Archetype,
    other: archetype.Archetype?,
    row: integer,
    count: integer,
    added: boolean,
    observerLimit: integer?
): nil
    const observers = world.queryObservers
    archetype.notifyRows(source, other, row + 1, count, added)
    local index: integer = 1
    local limit: integer = observerLimit or #observers
    while index <= limit do
        query.notify(observers[index], source, other, row + 1, count, added)
        index = index + 1
        if not added then
            limit = #observers
        end
    end
    const observer = world.transitionObserver
    if observer ~= nil and observer.entity ~= nil and (added or other == nil) then
        for position = row + 1, row + count do
            if added then
                observer.entity(source.entities[position], other, source)
            else
                observer.entity(source.entities[position], source, nil)
            end
        end
    end
end

local function publishMove(exclusive world: World, pending: PendingMove, notices: {PendingNotice}?): nil
    local id = pending.id
    if not world:isAlive(id) then
        return
    end
    local slot = idallocator.slotOf(id)
    local archetypeId, row = idallocator.placement(world.allocator, slot)
    local source = assert(world.archetypeById[archetypeId])
    local target = pending.target
    if source == target then
        for componentId, raw in pairs(pending.values) do
            if source.componentIds[componentId] then
                local stored = assert(source.columns[componentId])
                local relationship = components.asRelationship(assert(components.findById(componentId)))
                if relationship ~= nil then
                    const previous = archetype.edgeValues(source, row, relationship)
                    const replacement = raw as {any}
                    if relationship.reverseIndex then
                        const inverse = relationshipIndex(world, relationship)
                        for index = 1, #previous do
                            inverse:unlink(id, components.edgeTarget(previous[index]))
                        end
                        for index = 1, #replacement do
                            inverse:link(id, components.edgeTarget(replacement[index]))
                        end
                    end
                    archetype.setEdges(source, row, relationship, replacement)
                else
                    if componentId == components.Key.componentId then
                        local previous = stored[row + 1] as string
                        local replacement = raw as string
                        if previous ~= replacement then
                            claimKey(world, id, replacement)
                            releaseKey(world, id, previous)
                        end
                    end
                    stored[row + 1] = raw
                    source:markComponentDirty(assert(components.findById(componentId)))
                end
            end
        end
        return
    end
    local values = archetype.valuesForMove(source, row, target, pending.values)
    world.publishingMove = pending
    notifyQueries(world, source, target, row, 1, false)
    unlinkOutgoing(world, source, row, id)
    local targetRow = archetype.append(target, id, values)
    archetype.releaseMoveValues(source, target)
    -- Native values are row references: copy into the destination before swap
    -- removal overwrites their source. No per-component clone is necessary.
    removeFromArchetype(world, source, row)
    linkOutgoing(world, target, targetRow, id)
    idallocator.place(world.allocator, slot, target.id, targetRow)
    archetype.activate(target)
    world.publishingMove = nil
    if notices ~= nil then
        notices[
            #notices + 1
        ] = new PendingNotice(target = target, source = source, entity = id, observerLimit = #world.queryObservers)
    else
        notifyQueries(world, target, source, targetRow, 1, true)
    end
end

local function publishSpawnBatch(exclusive world: World, batch: SpawnBatch): nil
    const target = batch.target
    archetype.reserveCapacity(target, #target.entities + batch.count)
    const observerLimit = #world.queryObservers
    const firstRow = #target.entities + 1
    const plain = archetype.bulkSafe(target, true)
    local lastRow = firstRow - 1
    for index = 1, batch.count do
        const id = batchId(batch, index)
        const slot = idallocator.slotOf(id)
        if pendingDespawn(world, slot) then
            world:clearObservers(id)
            idallocator.freeSlot(world.allocator, slot)
        else
            if plain or batch.rawRestore then
                lastRow = lastRow + 1
                target.entities[lastRow] = id
            else
                lastRow = archetype.append(target, id, copyBatchValues(batch.values, batch.shared)) + 1
            end
            idallocator.place(world.allocator, slot, target.id, lastRow - 1)
            idallocator.stampSpawn(world.allocator, slot, 0)
            world.liveCount = world.liveCount + 1
        end
    end
    if lastRow < firstRow then
        return
    end
    if plain or batch.rawRestore then
        archetype.initializeRange(target, firstRow, lastRow, batch.values, batch.shared, batch.rawRestore)
    end
    if not batch.rawRestore then
        archetype.activate(target)
    end
    const callback = batch.callback
    local succeeded, failure = pcall(function(): nil
        if callback ~= nil then
            callback(target, firstRow, lastRow, lastRow - firstRow + 1)
        end
    end)
    if not plain or archetype.has(target, components.Key) then
        for row = firstRow, lastRow do
            linkOutgoing(world, target, row - 1, target.entities[row])
        end
    end
    if not succeeded then
        error(failure, 0)
    end
    notifyQueries(world, target, nil, firstRow - 1, lastRow - firstRow + 1, true, observerLimit)
    if world:hasObservers(0, events.OnSpawn) then
        for row = firstRow, lastRow do
            world:emit(0, events.OnSpawn, target.entities[row])
        end
    end
end

local function publishBatchWrite(exclusive world: World, writer: BatchWrite): nil
    const rows: {[archetype.Archetype]: {integer}} = {}
    const ordered: {archetype.Archetype} = {}
    for index = 1, #writer.ids do
        const id = writer.ids[index]
        const slot = idallocator.slotOf(id)
        if world:isAlive(id) and not pendingDespawn(world, slot) then
            const archetypeId, row = idallocator.placement(world.allocator, slot)
            const target = assert(world.archetypeById[archetypeId])
            if archetype.has(target, writer.component) then
                local selected = rows[target]
                if selected == nil then
                    selected = {}
                    rows[target] = selected
                    ordered[#ordered + 1] = target
                end
                selected[#selected + 1] = row + 1
            end
        end
    end
    for index = 1, #ordered do
        const target = ordered[index]
        const selected = assert(rows[target])
        table.sort(selected)
        local position: integer = 1
        while position <= #selected do
            const first = selected[position]
            local last = first
            position = position + 1
            while position <= #selected and selected[position] == last + 1 do
                last = selected[position]
                position = position + 1
            end
            writer.callback(target, first, last, last - first + 1)
        end
    end
end

local function publishSpawn(exclusive world: World, pending: PendingSpawn): nil
    local id = pending.id
    local slot = idallocator.slotOf(id)
    if pendingDespawn(world, slot) then
        world:clearObservers(id)
        idallocator.freeSlot(world.allocator, slot)
        return
    end
    local target = pending.target
    local row = archetype.append(target, id, pending.values)
    linkOutgoing(world, target, row, id)
    idallocator.place(world.allocator, slot, target.id, row)
    world.liveCount = world.liveCount + 1
    notifyQueries(world, target, nil, row, 1, true)
    world:emit(0, events.OnSpawn, id)
end

local publishDespawn: function(exclusive world: World, id: integer): nil
publishDespawn = function(exclusive world: World, id: integer): nil
    if not world:isAlive(id) then
        return
    end
    local slot = idallocator.slotOf(id)
    local archetypeId, row = idallocator.placement(world.allocator, slot)
    local source = assert(world.archetypeById[archetypeId])
    local relationships = components.relationships()
    for index = 1, #relationships do
        local relationship = relationships[index]
        if relationship.cascadeDelete then
            local inverse = world.relationshipIndexes[relationship.componentId]
            if inverse ~= nil then
                local children = inverse:removeTarget(id)
                for child in pairs(children) do
                    local childSlot = idallocator.slotOf(child)
                    if not pendingDespawn(world, childSlot) and world:isAlive(child) then
                        world.pendingDespawnBySlot[childSlot] = true
                        publishDespawn(world, child)
                    end
                end
            end
        elseif not relationship.sparse and relationship.reverseIndex then
            const inverse = world.relationshipIndexes[relationship.componentId]
            if inverse ~= nil then
                const sources = inverse:removeTarget(id)
                if next(sources) ~= nil then
                    const selected = relationship:targeting(id)
                    for sourceId in pairs(sources) do
                        if not pendingDespawn(world, idallocator.slotOf(sourceId)) then
                            world:remove(sourceId, selected)
                        end
                    end
                end
            end
        end
    end
    -- Descendant removal can swap this entity's row in the same sparse archetype.
    archetypeId, row = idallocator.placement(world.allocator, slot)
    source = assert(world.archetypeById[archetypeId])
    unlinkOutgoing(world, source, row, id)
    world:emit(id, events.OnDespawn, id)
    world:emit(0, events.OnDespawn, id)
    world:clearObservers(id)
    notifyQueries(world, source, nil, row, 1, false)
    removeFromArchetype(world, source, row)
    idallocator.freeSlot(world.allocator, slot)
    world.liveCount = world.liveCount - 1
end

local function publishMutationBatch(exclusive world: World, batch: MutationBatch): nil
    const source = batch.source
    const target = batch.target
    local whole = #source.entities == batch.count
    if whole then
        unsafe do
            for index = 0, batch.count - 1 do
                const id = batch.ids[index] as integer
                if source.entities[
                    index + 1
                ] ~= id or (not batch.despawn and pendingDespawn(world, idallocator.slotOf(id))) then
                    whole = false
                    break
                end
                if batch.despawn then
                    for _, inverse in pairs(world.relationshipIndexes) do
                        if inverse:hasTarget(id) then
                            whole = false
                            break
                        end
                    end
                    if not whole then
                        break
                    end
                end
            end
        end
    end
    if whole and batch.despawn then
        -- Ordinary sources with no incoming relationships need no per-row
        -- swap removal or edge dispatch. Observers still see committed rows.
        if world.observers.count > 0 then
            for row = 1, batch.count do
                const id = source.entities[row]
                world:emit(id, events.OnDespawn, id)
                world:emit(0, events.OnDespawn, id)
                world:clearObservers(id)
            end
        end
        notifyQueries(world, source, nil, 0, batch.count, false)
        for row = 1, batch.count do
            idallocator.freeSlot(world.allocator, idallocator.slotOf(source.entities[row]))
        end
        world.liveCount = world.liveCount - batch.count
        archetype.truncate(source)
        return
    end
    if whole then
        if source ~= target then
            notifyQueries(world, source, target, 0, batch.count, false)
        end
        const first = archetype.moveAll(source, target, batch.values, batch.shared, batch.resetComponent)
        for row = first, first + batch.count - 1 do
            const slot = idallocator.slotOf(target.entities[row])
            idallocator.place(world.allocator, slot, target.id, row - 1)
            if idallocator.mutationBatchAt(world.allocator, slot) == batch.index then
                idallocator.stampMutation(world.allocator, slot, 0)
            end
        end
        const observerLimit = #world.queryObservers
        archetype.activate(target)
        if batch.callback ~= nil then
            batch.callback(target, first, first + batch.count - 1, batch.count)
        end
        if source ~= target then
            notifyQueries(world, target, source, first - 1, batch.count, true, observerLimit)
        end
        return
    end
    -- Earlier publication changed the captured rows, or teardown has edges.
    -- Keep the exceptional path identical to scalar mutation, including
    -- callback ordering, reverse indexes, cancellation and cascading.
    local notices: {PendingNotice}? = nil
    local writerIds: {integer}? = nil
    if batch.callback ~= nil then
        notices = {}
        writerIds = {}
    end
    unsafe do
        for index = 0, batch.count - 1 do
            const id = batch.ids[index] as integer
            const slot = idallocator.slotOf(id)
            if idallocator.mutationBatchAt(world.allocator, slot) == batch.index then
                idallocator.stampMutation(world.allocator, slot, 0)
            end
            if batch.despawn then
                publishDespawn(world, id)
            elseif not pendingDespawn(world, slot) then
                const supplied = copyBatchValues(batch.values, batch.shared)
                if batch.resetComponent ~= nil then
                    supplied[batch.resetComponent.componentId] = components.defaultValue(batch.resetComponent)
                end
                publishMove(
                    world,
                    new PendingMove(id = id, target = target, values = supplied, isSealed = true),
                    notices
                )
                if writerIds ~= nil then
                    writerIds[#writerIds + 1] = id
                end
            end
        end
    end
    if batch.callback ~= nil then
        const writer = new BatchWrite(
            ids = assert(writerIds),
            component = assert(batch.writeComponent),
            callback = batch.callback
        )
        publishBatchWrite(world, writer)
    end
    if notices ~= nil then
        for index = 1, #notices do
            const notice = notices[index]
            const _, row = idallocator.placement(world.allocator, idallocator.slotOf(notice.entity))
            notifyQueries(world, notice.target, notice.source, row, 1, true, notice.observerLimit)
        end
    end
end

local function drainCommit(exclusive world: World): nil
    sealPending(world)
    local segmentIndex: integer = 1
    while segmentIndex <= #world.pendingSegments do
        const segment = world.pendingSegments[segmentIndex]
        segmentIndex = segmentIndex + 1
        if segment.spawnBatch ~= nil then
            publishSpawnBatch(world, segment.spawnBatch)
        end
        if segment.mutationBatch ~= nil then
            publishMutationBatch(world, segment.mutationBatch)
        end
        local offset = segment.flatFirst or 1
        while offset <= (segment.flatLast or 0) do
            const target = world.flatSpawns[offset] as archetype.Archetype
            const id = world.flatSpawns[offset + 1] as integer
            const slot = idallocator.slotOf(id)
            const promoted = world.flatSpawns[offset + 2] as PendingSpawn?
            if promoted ~= nil then
                if world.pendingSpawnBySlot[slot] == promoted then
                    world.pendingSpawnBySlot[slot] = nil
                end
                idallocator.stampFlatSpawn(world.allocator, slot, 0)
                publishSpawn(world, promoted)
            elseif pendingDespawn(world, slot) then
                world:clearObservers(id)
                idallocator.freeSlot(world.allocator, slot)
            else
                const row = archetype.appendFlat(target, id, world.flatSpawns, offset + 2)
                idallocator.place(world.allocator, slot, target.id, row)
                idallocator.stampFlatSpawn(world.allocator, slot, 0)
                world.liveCount = world.liveCount + 1
                notifyQueries(world, target, nil, row, 1, true)
                world:emit(0, events.OnSpawn, id)
            end
            idallocator.stampFlatSpawn(world.allocator, slot, 0)
            offset = offset + 3 + #target.components
        end
        local index: integer = 1
        while index <= #segment.spawns do
            const pending = segment.spawns[index]
            const slot = idallocator.slotOf(pending.id)
            if world.pendingSpawnBySlot[slot] == pending then
                world.pendingSpawnBySlot[slot] = nil
            end
            publishSpawn(world, pending)
            index = index + 1
        end
        local notices: {PendingNotice}? = nil
        if segment.writer ~= nil then
            notices = {}
        end
        local moveOffset = segment.moveFirst or 1
        while moveOffset <= (segment.moveLast or 0) do
            const queue = world.flatMoves
            const id = queue[moveOffset + 1] as integer
            const count = queue[moveOffset + 2] as integer
            if id ~= 0 then
                const slot = idallocator.slotOf(id)
                if idallocator.flatMoveAt(world.allocator, slot) == moveOffset then
                    idallocator.stampFlatMove(world.allocator, slot, 0)
                end
                if not pendingDespawn(world, slot) then
                    const pending = world.moveScratch
                    pending.id = id
                    pending.target = queue[moveOffset] as archetype.Archetype
                    table.clear(pending.values)
                    for index = 1, count do
                        pending.values[queue[moveOffset + 1 + index * 2] as integer] = queue[moveOffset + 2 + index * 2]
                    end
                    publishMove(world, pending, notices)
                    table.clear(pending.values)
                end
            end
            moveOffset = moveOffset + 3 + count * 2
        end
        for moveIndex = 1, #segment.moves do
            const pending = segment.moves[moveIndex]
            const slot = idallocator.slotOf(pending.id)
            if world.pendingMoveBySlot[slot] == pending then
                world.pendingMoveBySlot[slot] = nil
            end
            if not pendingDespawn(world, slot) then
                publishMove(world, pending, notices)
            end
        end
        if segment.writer ~= nil then
            publishBatchWrite(world, segment.writer)
        end
        if notices ~= nil then
            for noticeIndex = 1, #notices do
                const notice = notices[noticeIndex]
                const _, row = idallocator.placement(world.allocator, idallocator.slotOf(notice.entity))
                notifyQueries(world, notice.target, notice.source, row, 1, true, notice.observerLimit)
            end
        end
        for despawnIndex = 1, #segment.despawns do
            publishDespawn(world, segment.despawns[despawnIndex])
        end
        sealPending(world)
    end
end

local function ensureRandom(exclusive world: World): randomstreams.Registry
    local registry = world.randomRegistry
    if registry == nil then
        registry = randomstreams.newRegistry()
        world.randomRegistry = registry
    end

    return registry
end

function World.randomStream(exclusive self: World, name: string): random.Random
    if name == "" then
        error("world.randomStream: a stream needs a non-empty name", 2)
    end
    return randomstreams.stream(ensureRandom(self), name)
end

function World.seedRandom(exclusive self: World, seed: integer): nil
    if seed % 1 ~= 0 then
        error("world.seedRandom: seed must be a finite integer", 2)
    end
    randomstreams.reseed(ensureRandom(self), seed)
end

function World.enqueueCommit(exclusive self: World): nil
    if self.runningSystem or self.committing then
        self.commitRequested = true
        return
    end
    self:commit()
end

function World.commit(exclusive self: World): nil
    if self.committing then
        return
    end
    self.commitRequested = false
    if #self.pendingSegments == 0
        and #self.pendingSpawns == 0
        and self.flatSpawnCount == 0
        and self.flatMoveCount == 0
        and #self.pendingMoves == 0
        and #self.pendingDespawns == 0
    then
        return
    end
    self.committing = true
    local succeeded, failure = pcall(function(): nil
        drainCommit(self)
    end)
    self.committing = false
    -- The drain already includes every mutation staged by publication callbacks.
    self.commitRequested = false
    self.publishingMove = nil
    if not succeeded then
        local offset: integer = 1
        while offset <= self.flatSpawnCount do
            const target = self.flatSpawns[offset] as archetype.Archetype
            const id = self.flatSpawns[offset + 1] as integer
            const slot = idallocator.slotOf(id)
            if idallocator.placement(self.allocator, slot) == 0 and not idallocator.isStale(self.allocator, id) then
                self:clearObservers(id)
                idallocator.freeSlot(self.allocator, slot)
            end
            offset = offset + 3 + #target.components
        end
        -- Already published rows remain live; unplaced reservations must not leak
        -- capacity when a writer or observer interrupts the rest of the queue.
        for batchIndex = 1, #self.spawnBatches do
            const batch = self.spawnBatches[batchIndex]
            for index = 1, batch.count do
                const id = batchId(batch, index)
                const slot = idallocator.slotOf(id)
                if idallocator.spawnBatchAt(self.allocator, slot) == batch.index then
                    self:clearObservers(id)
                    idallocator.freeSlot(self.allocator, slot)
                end
            end
        end
        for _, pending in pairs(self.pendingSpawnBySlot) do
            const slot = idallocator.slotOf(pending.id)
            if idallocator.placement(
                self.allocator,
                slot
            ) == 0 and idallocator.generationAt(self.allocator, slot) == idallocator.generationPartOf(pending.id) then
                self:clearObservers(pending.id)
                idallocator.freeSlot(self.allocator, slot)
            end
        end
    end
    self.pendingSegments = {}
    table.clear(self.flatSpawns)
    self.flatSpawnCount = 0
    self.flatSealedCount = 0
    table.clear(self.flatMoves)
    table.clear(self.moveScratch.values)
    self.flatMoveCount = 0
    self.flatMovesSealed = 0
    if not succeeded then
        idallocator.clearStamps(self.allocator)
    end
    self.spawnBatches = {}
    self.mutationBatches = {}
    self.pendingSpawns = {}
    self.pendingSpawnBySlot = {}
    self.pendingMoves = {}
    self.pendingMoveBySlot = {}
    self.pendingDespawns = {}
    self.pendingDespawnBySlot = {}
    if not succeeded then
        error(failure, 0)
    end
end

function World.clearEntities(exclusive self: World): nil
    if self.committing then
        error("clearEntities cannot run during publication", 2)
    end
    for index = 1, self.archetypeCount do
        const candidate = self.archetypes[index]
        if #candidate.entities > 0 then
            notifyQueries(self, candidate, nil, 0, #candidate.entities, false)
        end
    end
    idallocator.reset(self.allocator)
    for index = 1, self.archetypeCount do
        archetype.clear(self.archetypes[index])
    end
    self.pendingSpawns = {}
    self.pendingSegments = {}
    table.clear(self.flatSpawns)
    self.flatSpawnCount = 0
    self.flatSealedCount = 0
    table.clear(self.flatMoves)
    table.clear(self.moveScratch.values)
    self.flatMoveCount = 0
    self.flatMovesSealed = 0
    self.spawnBatches = {}
    self.mutationBatches = {}
    self.pendingSpawnBySlot = {}
    self.pendingMoves = {}
    self.pendingMoveBySlot = {}
    self.pendingDespawns = {}
    self.pendingDespawnBySlot = {}
    self.relationshipIndexes = {}
    self.keyIndex = {}
    -- Every entity identity is gone, so every entity address is; the world's
    -- own observers at address zero stay, which is what keeps a subsystem's
    -- lifecycle observers and a game's global ones across a clear.
    for address in pairs(self.observedEntities) do
        nuppevents.clearAddress(self, address)
    end
    self.observedEntities = {}
    self.liveCount = 0
end

function World.forEachArchetype(borrows self: World, callback: function(candidate: archetype.Archetype)): nil
    const count = self.archetypeCount
    for index = 1, count do
        callback(self.archetypes[index])
    end
end

function World.dirtyArchetypes(borrows self: World): function(): archetype.Archetype?
    const selected = self.dirtyQueue.list
    const count = #selected
    local index: integer = 0

    return function(): archetype.Archetype?
        while index < count do
            index = index + 1
            if selected[index]:anyComponentDirty() then
                return selected[index]
            end
        end

        return nil
    end
end

function World.findArchetypes(
    borrows self: World,
    component: components.Component
): function(): (archetype.Archetype?, integer?, tecs.internal.entitycolumn.DoubleArray?)
    const entries = self.componentArchetypes[component.componentId]
    local index: integer = 0
    return function(): (archetype.Archetype?, integer?, tecs.internal.entitycolumn.DoubleArray?)
        index = index + 1
        const candidate = entries and entries[index] or nil
        if candidate == nil then
            return nil, nil, nil
        end

        return candidate, #candidate.entities, candidate.entities
    end
end

function World.compact(exclusive self: World): (integer, integer)
    if self.updating
        or self.committing
        or #self.pendingSpawns > 0
        or self.flatSpawnCount > 0
        or #self.pendingMoves > 0
        or self.flatMoveCount > 0
        or #self.pendingDespawns > 0
        or #self.pendingSegments > 0
    then
        error("compact requires a quiet, committed world", 2)
    end
    local pruned: integer = 0
    local compacted: integer = 0
    local write: integer = 1
    for index = 1, self.archetypeCount do
        const candidate = self.archetypes[index]
        local dead = false
        if candidate.id ~= 1 and #candidate.entities == 0 then
            for position = 1, #candidate.components do
                const target = components.targetOf(candidate.components[position])
                if target ~= nil and not self:isAlive(target) then
                    dead = true
                    break
                end
            end
        end
        if dead then
            archetype.destroy(candidate)
            for position = 1, #candidate.components do
                const componentId = candidate.components[position].componentId
                const entries = assert(self.componentArchetypes[componentId])
                for offset = #entries, 1, -1 do
                    if entries[offset] == candidate then
                        table.remove(entries, offset)
                    end
                end
                if #entries == 0 then
                    self.componentArchetypes[componentId] = nil
                end
            end
            self.archetypeBySignature[candidate.signature] = nil
            self.archetypeById[candidate.id] = nil
            self.freeArchetypeIds[#self.freeArchetypeIds + 1] = candidate.id
            for position = 1, #self.queries do
                query.removeArchetype(self.queries[position], candidate)
            end
            -- A temporary query may still retain this empty object, so release its
            -- unused backing stores too without adding it back to any query.
            archetype.compact(candidate)
            pruned = pruned + 1
        else
            self.archetypes[write] = candidate
            write = write + 1
            if archetype.compact(candidate) then
                compacted = compacted + 1
            end
        end
    end
    for index = self.archetypeCount, write, -1 do
        self.archetypes[index] = nil
    end
    self.archetypeCount = write - 1

    return pruned, compacted
end

--- Returns the live entity carrying one durable key.
--- @param self the world to search
--- @param key the durable key
--- @return the entity, or nil when no live entity carries the key
function World.byKey(borrows self: World, key: string): integer?
    return self.keyIndex[key]
end

--- Returns the live entity carrying one durable key, or raises.
---
--- Use this where a missing key means the caller built the world wrong, and
--- `byKey` where its absence is an ordinary answer.
--- @param self the world to search
--- @param key the durable key
--- @return the entity carrying the key
--- @raises when no live entity carries the key
function World.requireKey(borrows self: World, key: string): integer
    local id = self.keyIndex[key]
    if id == nil then
        error("world: no entity with key '" .. key .. "'", 2)
    end

    return id
end

local function stateEntities(borrows world: World, component: components.Component): {integer}
    local result: {integer} = {}
    for index = 1, world.archetypeCount do
        local source = world.archetypes[index]
        if archetype.has(source, component) then
            for row = 1, #source.entities do
                result[#result + 1] = source.entities[row]
            end
        end
    end

    return result
end

local function applyStateAction(exclusive world: World, action: StateAction, component: components.Component): nil
    local entities = stateEntities(world, component)
    for index = 1, #entities do
        local entity = entities[index]
        if action == "pause" then
            world:set(entity, components.Paused)
        elseif action == "resume" then
            world:remove(entity, components.Paused)
        elseif action == "disable" then
            world:set(entity, components.Disabled)
        else
            world:despawn(entity)
        end
    end
end

local function executeStatePolicy(exclusive world: World, operation: StatePolicyOperation?, stateName: string): nil
    if operation == nil then
        return
    end
    if operation is string then
        applyStateAction(world, operation as StateAction, assert(world.stateComponents[stateName]))
    elseif type(operation) == "function" then
        (operation as StateCallback)(world)
    else
        local compound = operation as StatePolicyAction
        if compound.apply ~= nil then
            applyStateAction(world, compound.apply, assert(world.stateComponents[stateName]))
        end
        if compound.call ~= nil then
            compound.call(world)
        end
    end
end

--- Registers a named state and returns its auto-tag component.
--- @param self the world to modify
--- @param name the world-unique state name
--- @param policy optional lifecycle actions and callbacks
--- @return the state tag applied to entities spawned while this state is active
--- @raises when the name is empty or already registered in this world
function World.createState(exclusive self: World, name: string, policy: StatePolicy?): components.Component
    if name == "" then
        error("world.createState: name must not be empty", 2)
    end
    if self.stateComponents[name] ~= nil then
        error("State '" .. name .. "' already exists", 2)
    end
    local componentName = name .. "State"
    local component = components.findByName(componentName)
    if component == nil then
        component = components.newTagComponent({name = componentName})
    end
    self.stateComponents[name] = component
    local configured = policy or {}
    if configured.onExit == nil then
        configured.onExit = "despawn"
    end
    self.statePolicies[name] = configured

    return component
end

--- Pushes a registered state and makes it the auto-tagging state.
--- @param self the world to modify
--- @param name the registered state name
--- @raises when the state is unknown
function World.pushState(exclusive self: World, name: string): nil
    local component = self.stateComponents[name]
    if component == nil then
        error("State '" .. name .. "' not found. Call createState first.", 2)
    end
    local previous = self.stateStack[#self.stateStack]
    if previous ~= nil then
        local previousPolicy = assert(self.statePolicies[previous])
        executeStatePolicy(self, previousPolicy.onBlur, previous)
        self:emit(0, events.StateBlur, previous, name)
    end
    self.stateStack[#self.stateStack + 1] = name
    self.autoStateComponent = component
    local policy = assert(self.statePolicies[name])
    executeStatePolicy(self, policy.onEnter, name)
    self:emit(0, events.StateEnter, name)
    const observer = self.transitionObserver
    if observer ~= nil and observer.state ~= nil then
        observer.state("push", previous, name, name)
    end
end

--- Pops the active state and focuses the state below it.
--- @param self the world to modify
--- @raises when the state stack is empty
function World.popState(exclusive self: World): nil
    local index = #self.stateStack
    if index == 0 then
        error("Cannot pop state: state stack is empty", 2)
    end
    local popped = self.stateStack[index]
    local poppedPolicy = assert(self.statePolicies[popped])
    executeStatePolicy(self, poppedPolicy.onExit, popped)
    self:emit(0, events.StateExit, popped)
    self.stateStack[index] = nil
    local focused = self.stateStack[index - 1]
    if focused == nil then
        self.autoStateComponent = nil
    else
        self.autoStateComponent = self.stateComponents[focused]
        local focusedPolicy = assert(self.statePolicies[focused])
        executeStatePolicy(self, focusedPolicy.onFocus, focused)
        self:emit(0, events.StateFocus, focused, popped)
    end
    const observer = self.transitionObserver
    if observer ~= nil and observer.state ~= nil then
        observer.state("pop", popped, focused, popped)
    end
end

--- Installs or removes the cold entity/state transition observer used by debugger
--- consumers.
export function setTransitionObserver(exclusive world: World, observer: TransitionObserver?): nil
    world.transitionObserver = observer
end

--- Returns the active state name.
--- @param self the world to inspect
--- @return the top state, or nil when the stack is empty
function World.peekState(borrows self: World): string?
    return self.stateStack[#self.stateStack]
end

--- Returns a bottom-first copy of the state stack.
--- @param self the world to inspect
--- @return the caller-owned state-name array
function World.listStates(borrows self: World): {string}
    local result: {string} = {}
    for index = 1, #self.stateStack do
        result[index] = self.stateStack[index]
    end

    return result
end

local function defaultBundleInput(component: components.Component): components.Input
    if component.storageType == "tag" then
        return component
    end
    if component is components.ScalarComponent<any> then
        return new components.ScalarInstance(componentType = component, value = component.scalarDefault)
    end
    if (component.storageType == "table" or component.storageType == "ffi") then
        local tableComponent = component as components.TableComponent<any>
        return new components.TableInstance(componentType = tableComponent, value = tableComponent.defaultFactory())
    end
    error("Bundle component " .. component.componentName .. " requires an explicit factory", 3)
end

--- Reserves an entity using this bundle's required and defaulted components.
--- @param self the bundle to instantiate
--- @param ... required component inputs in declaration order
--- @return the reserved entity id
--- @raises when a required input is missing, out of order, or extra
function Bundle.spawn(self: Bundle, ...: components.Input): integer
    if select("#", ...) > #self.requiredComponents then
        error("Bundle '" .. self.name .. "' received too many required components", 2)
    end
    -- Factory reentry gets independent scratch. Ordinary calls retain the
    -- fixed argument vector, and world.spawn's shape trie resolves it once.
    const wasBusy = self.busy
    local inputs: {components.Input} = wasBusy and {} or self.scratchInputs
    self.busy = true
    table.clear(inputs)
    for index = 1, #self.requiredComponents do
        local expected = self.requiredComponents[index]
        local input = select(index, ...)
        if input == nil then
            error("Required component missing: " .. expected.componentName, 2)
        end
        if components.definitionOf(input) ~= expected then
            error(
                "Bundle '" .. self.name .. "' expected " .. expected.componentName .. " at position " .. tostring(
                    index
                ),
                2
            )
        end
        inputs[#inputs + 1] = input
    end
    for index = 1, #self.defaultComponents do
        local expected = self.defaultComponents[index]
        local factory = self.defaultFactories[index]
        local input = factory ~= nil and factory() or defaultBundleInput(expected)
        if components.definitionOf(input) ~= expected then
            error("Bundle factory for " .. expected.componentName .. " returned another component", 2)
        end
        inputs[#inputs + 1] = input
    end
    local world = self.world as World
    local id: integer
    if self.plain then
        local target = self.cachedTarget
        if target == nil or self.cachedState ~= world.autoStateComponent or world.archetypeById[
            target.id
        ] ~= target then
            const state = world.autoStateComponent
            if state ~= nil then
                local present = false
                for index = 1, #inputs do
                    if components.definitionOf(inputs[index]) == state then
                        present = true
                    end
                end
                if not present then
                    inputs[#inputs + 1] = state
                end
            end
            const definitions, supplied = collectInputs(inputs)
            target = resolveArchetype(world, definitions)
            for index = 1, #inputs do
                supplied[components.definitionOf(inputs[index]).componentId] = nil
            end
            self.requiredDefaults = supplied
            self.cachedTarget = target
            self.cachedState = state
        end
        if archetype.bulkSafe(target) then
            const values = world.spawnScratch
            table.clear(values)
            for componentId, raw in pairs(self.requiredDefaults) do
                values[componentId] = raw
            end
            for index = 1, #inputs do
                const input = inputs[index]
                const raw, explicit = components.explicitValue(input)
                if explicit then
                    values[components.definitionOf(input).componentId] = raw
                end
            end
            const slot = idallocator.allocSlot(world.allocator)
            id = idallocator.encodeId(slot, idallocator.generationAt(world.allocator, slot))
            reserveFlat(world, id, target, values)
            table.clear(values)
        else
            id = world:spawn(unpack(inputs, 1, #inputs))
        end
    else
        id = world:spawn(unpack(inputs, 1, #inputs))
    end
    table.clear(inputs)
    self.busy = wasBusy

    return id
end

--- Creates and registers a reusable spawn bundle.
--- @param self the world that owns the bundle
--- @param name the world-unique bundle name
--- @param definition required and defaulted components
--- @return the registered bundle
--- @raises when the name or component declaration is invalid
function World.newBundle(exclusive self: World, name: string, definition: BundleDefinition?): Bundle
    if name == "" then
        error("Bundle requires a name", 2)
    end
    if self.bundles[name] ~= nil then
        error("Bundle with name '" .. name .. "' already exists", 2)
    end
    local required = definition and definition.required or {}
    local defaults = definition and definition.with or {}
    local requiredNames: {string} = {}
    local defaultedNames: {string} = {}
    local defaultComponents: {components.Component} = {}
    local defaultFactories: {BundleFactory?} = {}
    local seen: {[integer]: boolean} = {}
    local plain = true
    for index = 1, #required do
        local component = required[index]
        if components.asRelationship(component) ~= nil or component == components.Key then
            plain = false
        end
        if seen[component.componentId] then
            error("Component already in bundle: " .. component.componentName, 2)
        end
        seen[component.componentId] = true
        requiredNames[index] = component.componentName
    end
    for component, configured in pairs(defaults) do
        if components.asRelationship(component) ~= nil or component == components.Key then
            plain = false
        end
        if seen[component.componentId] then
            error("Component already in bundle: " .. component.componentName, 2)
        end
        seen[component.componentId] = true
        local index = #defaultComponents + 1
        defaultComponents[index] = component
        defaultedNames[index] = component.componentName
        if configured ~= true then
            defaultFactories[index] = configured as BundleFactory
        elseif component.storageType == "relationship" then
            error("Bundle component " .. component.componentName .. " requires an explicit factory", 2)
        end
    end
    local bundle = new Bundle(
        name = name,
        required = requiredNames,
        defaulted = defaultedNames,
        world = self,
        requiredComponents = required,
        defaultComponents = defaultComponents,
        defaultFactories = defaultFactories,
        requiredDefaults = {},
        plain = plain,
        scratchInputs = {},
        busy = false
    )
    self.bundles[name] = bundle

    return bundle
end

--- Spawns from a registered bundle by name.
--- @param self the world that owns the bundle
--- @param name the registered bundle name
--- @param ... required component inputs in declaration order
--- @return the reserved entity id
--- @raises when the bundle is unknown or its required inputs are invalid
function World.spawnBundle(exclusive self: World, name: string, ...: components.Input): integer
    local bundle = self.bundles[name]
    if bundle == nil then
        error("Unknown bundle: " .. name, 2)
    end

    return bundle:spawn(...)
end

--- Returns a caller-owned snapshot of registered bundles.
--- @param self the world to inspect
--- @return a name-to-bundle map
function World.getBundles(borrows self: World): {[string]: Bundle}
    local result: {[string]: Bundle} = {}
    for name, bundle in pairs(self.bundles) do
        result[name] = bundle
    end

    return result
end

--- Returns a registered bundle by name.
--- @param self the world to inspect
--- @param name the bundle name
--- @return the bundle, or nil when absent
function World.getBundle(borrows self: World, name: string): Bundle?
    return self.bundles[name]
end

local SNAPSHOT_VERSION: integer = 1

local function saveComponentValue(component: components.Component, value: any): any
    if component is components.ScalarComponent<any> then
        return value
    end
    if (component.storageType == "table" or component.storageType == "ffi") then
        local tableComponent = component as components.TableComponent<any>
        return snapshotvalue.clone(tableComponent.snapshotSave(value))
    end
    if component.storageType == "relationship" then
        return (value as components.RelationshipValue).target
    end

    return nil
end

local function saveEdges(component: components.Component, edges: {any}): any
    const relationship = assert(components.asRelationship(component))
    if relationship.exclusive and component.storageType == "relationship" then
        return components.edgeTarget(edges[1])
    end
    const saved: {any} = {}
    for index = 1, #edges do
        saved[index] = saveComponentValue(component, edges[index])
    end

    return {edges = saved}
end

local function sortedKeys(values: {[string]: any}): {string}
    local result: {string} = {}
    for key in pairs(values) do
        result[#result + 1] = key
    end
    table.sort(result)

    return result
end

local function addSnapshotData(target: {SnapshotDataEntry}, seen: {[string]: boolean}, key: string, value: any): nil
    if key == "" then
        error("snapshot data key must not be empty", 3)
    end
    if seen[key] then
        error("snapshot data key '" .. key .. "' was written twice", 3)
    end
    seen[key] = true
    target[#target + 1] = new SnapshotDataEntry(key = key, value = snapshotvalue.clone(value))
end

function World.saveSnapshot(exclusive self: World, options: SnapshotOptions?): Snapshot
    if self.committing or (self.updating and (not self.runningSystem or self.systemThread ~= coroutine.running())) then
        error("world.saveSnapshot: cannot save during publication or a suspended world update", 2)
    end
    self:commit()
    const binary = options ~= nil and options.format == "binary"
    if options ~= nil and not binary and (options.buffer ~= nil or options.path ~= nil) then
        error("snapshot buffer and path require format = binary", 2)
    end
    const eventData: {[string]: any} = {}
    const excluded: {components.Component} = {}
    self:emit(0, events.OnSnapshotSave, eventData, excluded)
    const descriptor = table.clone(options and options.filterQuery or {}) as query.Descriptor
    descriptor.exclude = table.clone(descriptor.exclude or {})
    for index = 1, #excluded do
        assert(descriptor.exclude)[#assert(descriptor.exclude) + 1] = excluded[index]
    end
    const selection = query.new(descriptor)
    local selectedLayers: {[integer]: boolean}? = nil
    if options ~= nil and options.layers ~= nil then
        selectedLayers = {}
        for index = 1, #options.layers do
            const layer = options.layers[index]
            if layer < 0 or layer > 31 or layer % 1 ~= 0 then
                error("snapshot layers must be integers from zero through 31", 2)
            end
            selectedLayers[layer] = true
        end
    end
    const transform = components.findByName("Transform2D")
    local componentTable: {SnapshotComponentEntry} = {}
    local componentSeen: {[string]: boolean} = {}
    local savedArchetypes: {SnapshotArchetype} = {}
    local entityCount: integer = 0
    for archetypeIndex = 1, self.archetypeCount do
        local source = self.archetypes[archetypeIndex]
        if not binary and #source.entities > 0 and query.matches(selection, source) then
            local names: {string} = {}
            local savedComponents: {components.Component} = {}
            for componentIndex = 1, #source.components do
                local component = source.components[componentIndex]
                if not component.transient and components.targetOf(component) == nil then
                    names[#names + 1] = component.componentName
                    savedComponents[#savedComponents + 1] = component
                    if not componentSeen[component.componentName] then
                        componentSeen[component.componentName] = true
                        componentTable[#componentTable + 1] = new SnapshotComponentEntry(name = component.componentName)
                    end
                end
            end
            local entities: {SnapshotEntity} = {}
            for row = 1, #source.entities do
                const pose: any = transform ~= nil and archetype.valueAt(source, row - 1, transform) or nil
                if selectedLayers ~= nil and pose ~= nil and not selectedLayers[pose.layer as integer] then
                    goto continueSnapshotRow
                end
                local values: {[string]: any} = {}
                for componentIndex = 1, #savedComponents do
                    local component = savedComponents[componentIndex]
                    if component.storageType ~= "tag" then
                        const relationship = components.asRelationship(component)
                        if relationship ~= nil then
                            values[
                                component.componentName
                            ] = saveEdges(component, archetype.edgeValues(source, row - 1, relationship))
                        else
                            local stored = archetype.valueAt(source, row - 1, component)
                            values[component.componentName] = saveComponentValue(component, stored)
                        end
                    end
                end
                entities[#entities + 1] = new SnapshotEntity(id = source.entities[row], values = values)
                ::continueSnapshotRow::
            end
            entityCount = entityCount + #entities
            savedArchetypes[#savedArchetypes + 1] = new SnapshotArchetype(components = names, entities = entities)
        end
    end
    local data: {SnapshotDataEntry} = {}
    local dataSeen: {[string]: boolean} = {}
    for key, value in pairs(eventData) do
        if key == randomstreams.snapshotKey or key == "__tecs.pipeline" or key == "__tecs.stateStack" then
            error("snapshot data uses a reserved key", 2)
        end
        addSnapshotData(data, dataSeen, key, value)
    end
    const phaseStates: {boolean} = {}
    for index = 1, phases.count do
        phaseStates[index] = not self.disabledPhases[assert(phases.at(index))]
    end
    const pipelineState = {
        fixedAccumulator = self.fixedAccumulator,
        phaseStates = phaseStates,
        disabledPhases = table.clone(self.disabledPhases)
    }
    if self.pipeline ~= nil then
        pipelineState.fixedAccumulator = self.pipeline.fixedAccumulator
        pipelineState.phaseStates = table.clone(self.pipeline.phaseStates)
    end
    local custom = options and options.customData or nil
    if custom ~= nil then
        local keys = sortedKeys(custom)
        for index = 1, #keys do
            local key = keys[index]
            if key == randomstreams.snapshotKey or key == "__tecs.pipeline" or key == "__tecs.stateStack" then
                error("world.saveSnapshot: " .. key .. " is reserved for world-managed state", 2)
            end
            addSnapshotData(data, dataSeen, key, custom[key])
        end
    end
    local handlers = table.clone(self.snapshotHandlers)
    if self.randomRegistry ~= nil then
        addSnapshotData(data, dataSeen, randomstreams.snapshotKey, randomstreams.save(self.randomRegistry))
    end
    table.sort(handlers, function(left: SnapshotHandler, right: SnapshotHandler): boolean
        return left.name < right.name
    end)
    for index = 1, #handlers do
        local handler = handlers[index]
        if handler.save ~= nil then
            local value = handler.save(self)
            if value ~= nil then
                addSnapshotData(data, dataSeen, handler.name, value)
            end
        end
    end

    if binary then
        addSnapshotData(data, dataSeen, "__tecs.pipeline", pipelineState)
        addSnapshotData(data, dataSeen, "__tecs.stateStack", self:listStates())
        const output = assert(options).buffer or buffer.new()
        const prelude = snapshotcodec.write(
            self.archetypes,
            selection,
            selectedLayers,
            self.allocator.nextFreshSlot,
            data,
            output
        )
        if assert(options).path ~= nil then
            const ok, reason = files.write(assert(assert(options).path), output:tostring())
            if not ok then
                error("snapshot write failed: " .. assert(reason), 2)
            end
        end
        return new Snapshot(
            version = prelude.version,
            nextEntityId = prelude.nextEntityId,
            entityCount = prelude.entityCount,
            archetypeCount = prelude.archetypeCount,
            componentTable = prelude.componentTable,
            archetypes = {},
            data = {},
            states = {},
            format = "binary",
            buffer = output
        )
    end

    return new Snapshot(
        version = SNAPSHOT_VERSION,
        nextEntityId = self.allocator.nextFreshSlot,
        entityCount = entityCount,
        archetypeCount = #savedArchetypes,
        componentTable = componentTable,
        archetypes = savedArchetypes,
        data = data,
        states = self:listStates(),
        pipeline = pipelineState
    )
end

local function loadComponentInput(component: components.Component, value: any, exclusive world: World): components.Input
    const relationship = components.asRelationship(component)
    if relationship ~= nil then
        const selected = components.targetOf(component)
        component = assert(components.findById(relationship.componentId))
        local saved: {any}
        if selected ~= nil then
            if component.storageType == "relationship" then
                saved = {selected}
            else
                saved = {value}
            end
        elseif type(value) == "table" and value.target ~= nil then
            saved = {value}
        elseif relationship.exclusive and component.storageType == "relationship" and type(value) == "number" then
            saved = {value}
        else
            if type(value) ~= "table" or type(value.edges) ~= "table" then
                error("snapshot relationship requires an edge list", 2)
            end
            saved = value.edges as {any}
        end
        if #saved == 0 or (relationship.exclusive and #saved ~= 1) then
            error("snapshot relationship has invalid edge count", 2)
        end
        const edges: {any} = {}
        const seen: {[integer]: boolean} = {}
        for index = 1, #saved do
            local edge: any
            if (component.storageType == "table" or component.storageType == "ffi") then
                edge = (
                    component as components.TableComponent<any>
                ).snapshotLoad(snapshotvalue.clone(saved[index]), world)
            else
                edge = {target = type(saved[index]) == "table" and saved[index].target or saved[index]}
            end
            const target = components.edgeTarget(edge)
            if selected ~= nil and target ~= selected then
                error("snapshot relationship payload changed its selected target", 2)
            end
            if seen[target] then
                error("snapshot relationship repeats a target", 2)
            end
            seen[target] = true
            edges[index] = edge
        end
        return new components.RelationshipBatch(componentType = component, values = edges)
    end
    if component.storageType == "tag" then
        return component
    end
    if component is components.ScalarComponent<any> then
        if type(value) ~= component.scalarKind then
            error("snapshot value for " .. component.componentName .. " has the wrong scalar type", 3)
        end
        return new components.ScalarInstance(componentType = component, value = value)
    end
    if (component.storageType == "table" or component.storageType == "ffi") then
        local tableComponent = component as components.TableComponent<any>
        return new components.TableInstance(
            componentType = tableComponent,
            value = tableComponent.snapshotLoad(snapshotvalue.clone(value), world)
        )
    end
    if type(value) ~= "number" or value ~= math.floor(value) then
        error("snapshot relationship " .. component.componentName .. " requires an entity id", 3)
    end

    return (component as components.RelationshipComponent)(value as integer)
end

local function copyComponentTable(source: {SnapshotComponentEntry}): {SnapshotComponentEntry}
    local result: {SnapshotComponentEntry} = {}
    for index = 1, #source do
        result[index] = new SnapshotComponentEntry(name = source[index].name)
    end

    return result
end

local record RestoreEntity
    id: integer
    inputs: {components.Input}
end

function World.loadSnapshot(exclusive self: World, source: any): SnapshotPrelude
    if self.committing or (self.updating and (not self.runningSystem or self.systemThread ~= coroutine.running())) then
        error("world.loadSnapshot: cannot load during publication or a suspended world update", 2)
    end
    local decoded: snapshotcodec.Decoded? = nil
    local snapshot: Snapshot
    if type(
        source
    ) == "string" or type(
        source
    ) == "cdata" or type(source) == "userdata" or (type(source) == "table" and source.format == "binary") then
        local bytes: string
        if type(source) == "string" then
            bytes = source as string
        elseif type(source) == "table" then
            bytes = (source.buffer as buffer.Buffer):tostring()
        else
            bytes = (source as buffer.Buffer):tostring()
        end
        decoded = snapshotcodec.read(bytes, self.allocator.maxSlotCount)
        const prelude = decoded.prelude
        const saved: {SnapshotArchetype} = {}
        for index = 1, #decoded.frames do
            const names: {string} = {}
            const frame = decoded.frames[index]
            for column = 1, #frame.columns do
                names[column] = frame.columns[column].component.componentName
            end
            saved[index] = new SnapshotArchetype(components = names, entities = {})
        end
        local states: {string} = {}
        for index = 1, #decoded.data do
            if decoded.data[index].key == "__tecs.stateStack" then
                states = decoded.data[index].value as {string}
            end
        end
        snapshot = new Snapshot(
            version = prelude.version,
            nextEntityId = prelude.nextEntityId,
            entityCount = prelude.entityCount,
            archetypeCount = prelude.archetypeCount,
            componentTable = prelude.componentTable,
            archetypes = saved,
            data = decoded.data,
            states = states
        )
    else
        if type(source) ~= "table" then
            error("snapshot source must be a table, string or buffer", 2)
        end
        if source.format == "table" and source.snapshot ~= nil then
            source = source.snapshot
        end
        if source.entityCount == nil then
            -- Column-indexed tables resolve columns through their component registry.
            const saved: {SnapshotArchetype} = {}
            local total: integer = 0
            for _, frame in ipairs(source.archetypes as {any}) do
                const names: {string} = {}
                for index, entry in ipairs(frame.columnIndices as {integer}) do
                    names[index] = source.componentTable[entry].name as string
                end
                const entities: {SnapshotEntity} = {}
                for _, row in ipairs(frame.entities as {any}) do
                    const values: {[string]: any} = {}
                    for index = 1, #names do
                        values[names[index]] = row[index + 1]
                    end
                    entities[#entities + 1] = new SnapshotEntity(id = row[1] as integer, values = values)
                end
                total = total + #entities
                saved[#saved + 1] = new SnapshotArchetype(components = names, entities = entities)
            end
            local states: {string} = {}
            for _, entry in ipairs((source.data or {}) as {SnapshotDataEntry}) do
                if entry.key == "__tecs.stateStack" then
                    states = entry.value as {string}
                end
            end
            snapshot = new Snapshot(
                version = source.version as integer,
                nextEntityId = source.nextEntityId as integer,
                entityCount = total,
                archetypeCount = #saved,
                componentTable = source.componentTable as {SnapshotComponentEntry},
                archetypes = saved,
                data = (source.data or {}) as {SnapshotDataEntry},
                states = states
            )
        else
            snapshot = source as Snapshot
        end
    end
    if snapshot.version ~= SNAPSHOT_VERSION then
        error("world.loadSnapshot: unsupported snapshot version " .. tostring(snapshot.version), 2)
    end
    if snapshot.nextEntityId < 1 or snapshot.nextEntityId > self.allocator.maxSlotCount + 1 then
        error("world.loadSnapshot: next entity id exceeds world capacity", 2)
    end
    local declaredComponents: {[string]: boolean} = {}
    for index = 1, #snapshot.componentTable do
        local name = snapshot.componentTable[index].name
        if declaredComponents[name] then
            error("world.loadSnapshot: repeated component-table entry " .. name, 2)
        end
        if components.resolveSnapshotName(name) == nil then
            error("world.loadSnapshot: unknown component " .. name, 2)
        end
        declaredComponents[name] = true
    end
    local prepared: {{RestoreEntity}} = {}
    local referencedComponents: {[string]: boolean} = {}
    local seenSlots: {[integer]: boolean} = {}
    local counted: integer = 0
    local greatestSlot: integer = 0
    const fastFrames: {[integer]: snapshotcodec.Frame} = {}
    for archetypeIndex = 1, #snapshot.archetypes do
        local saved = snapshot.archetypes[archetypeIndex]
        local definitions: {components.Component} = {}
        local names: {[string]: boolean} = {}
        for componentIndex = 1, #saved.components do
            local name = saved.components[componentIndex]
            if names[name] then
                error("world.loadSnapshot: repeated component " .. name, 2)
            end
            if not declaredComponents[name] then
                error("world.loadSnapshot: archetype component " .. name .. " is absent from the component table", 2)
            end
            names[name] = true
            referencedComponents[name] = true
            local component = components.resolveSnapshotName(name)
            if component == nil then
                error("world.loadSnapshot: unknown component " .. name, 2)
            end
            definitions[componentIndex] = component
        end
        local preparedEntities: {RestoreEntity} = {}
        prepared[archetypeIndex] = preparedEntities
        if decoded ~= nil then
            const frame = decoded.frames[archetypeIndex]
            local fast = true
            for column = 1, #frame.columns do
                const savedColumn = frame.columns[column]
                const component = savedColumn.component
                const native = ffistorage.find(component.componentId)
                const relationship = components.asRelationship(component)
                if savedColumn.present ~= nil or (
                    relationship ~= nil and (
                        relationship.sparse or components.targetOf(
                            component
                        ) == nil or #components.requiresClosure(relationship) > 0
                    )
                ) or (
                    component.storageType ~= "tag" and (
                        native == nil
                        or not native.rawCodec
                        or native ~= savedColumn.storage
                        or savedColumn.pointer == nil
                    )
                ) then
                    fast = false
                end
                if relationship ~= nil
                    and native ~= nil
                    and native == savedColumn.storage
                    and savedColumn.pointer ~= nil
                then
                    const selected = components.targetOf(component)
                    const pointerType = "$ *"
                    const rows: any = ffi.cast(ffi.typeof(pointerType, native.element), savedColumn.pointer)
                    for row = 0, frame.count - 1 do
                        if selected == nil or rows[row].target ~= selected then
                            error("snapshot relationship payload changed its selected target", 2)
                        end
                    end
                end
            end
            if fast then
                fastFrames[archetypeIndex] = frame
            end
            const ids: any = frame.ids
            for row = 1, frame.count do
                const id = ids[row - 1] as integer
                if id < 1 or id > 9007199254740991 or id % 1 ~= 0 then
                    error("snapshot has invalid entity id", 2)
                end
                const slot = idallocator.slotOf(id)
                if slot < 1 or slot > self.allocator.maxSlotCount or seenSlots[slot] then
                    error("snapshot has repeated or invalid entity slot", 2)
                end
                seenSlots[slot] = true
                greatestSlot = math.max(greatestSlot, slot)
                counted = counted + 1
                if not fast then
                    const inputs: {components.Input} = {}
                    for column = 1, #frame.columns do
                        const savedColumn = frame.columns[column]
                        local payload: any = nil
                        if savedColumn.present ~= nil and not savedColumn.present[row] then
                            goto nextSavedColumn
                        end
                        if savedColumn.component.storageType ~= "tag" then
                            payload = snapshotcodec.value(savedColumn, row)
                        end
                        if savedColumn.component.storageType == "tag" or payload ~= nil then
                            inputs[#inputs + 1] = loadComponentInput(savedColumn.component, payload, self)
                        end
                        ::nextSavedColumn::
                    end
                    preparedEntities[row] = new RestoreEntity(id = id, inputs = inputs)
                end
            end
        end
        for entityIndex = 1, #saved.entities do
            local entity = saved.entities[entityIndex]
            local id = entity.id
            local slot = idallocator.slotOf(id)
            if slot < 1 or slot > self.allocator.maxSlotCount then
                error("world.loadSnapshot: entity id is outside world capacity", 2)
            end
            if seenSlots[slot] then
                error("world.loadSnapshot: repeated entity slot " .. tostring(slot), 2)
            end
            seenSlots[slot] = true
            if slot > greatestSlot then
                greatestSlot = slot
            end
            local valueNames: {[string]: boolean} = {}
            for name in pairs(entity.values) do
                valueNames[name] = true
                local component = components.findByName(name)
                if component == nil or not names[name] or component.storageType == "tag" then
                    error("world.loadSnapshot: unexpected value for component " .. name, 2)
                end
            end
            local inputs: {components.Input} = {}
            for componentIndex = 1, #definitions do
                local component = definitions[componentIndex]
                if component.storageType == "tag" or valueNames[component.componentName] then
                    inputs[#inputs + 1] = loadComponentInput(component, entity.values[component.componentName], self)
                end
            end
            preparedEntities[entityIndex] = new RestoreEntity(id = id, inputs = inputs)
            counted = counted + 1
        end
    end
    for name in pairs(declaredComponents) do
        if not referencedComponents[name] then
            error("world.loadSnapshot: unreferenced component-table entry " .. name, 2)
        end
    end
    if snapshot.nextEntityId <= greatestSlot then
        error("world.loadSnapshot: next entity id does not follow restored slots", 2)
    end
    if counted ~= snapshot.entityCount or #snapshot.archetypes ~= snapshot.archetypeCount then
        error("world.loadSnapshot: snapshot counts do not match its contents", 2)
    end
    for index = 1, #snapshot.states do
        if self.stateComponents[snapshot.states[index]] == nil then
            error("world.loadSnapshot: saved state '" .. snapshot.states[index] .. "' is not registered", 2)
        end
    end
    local dataByKey: {[string]: any} = {}
    local dataSeen: {[string]: boolean} = {}
    for index = 1, #snapshot.data do
        local entry = snapshot.data[index]
        if entry.key == "" or dataSeen[entry.key] then
            error("world.loadSnapshot: invalid or repeated data key '" .. entry.key .. "'", 2)
        end
        dataSeen[entry.key] = true
        dataByKey[entry.key] = entry.value
    end

    local randomState: randomstreams.State? = nil
    if dataSeen[randomstreams.snapshotKey] then
        randomState = randomstreams.prepare(dataByKey[randomstreams.snapshotKey])
    end
    const pipeline: any = snapshot.pipeline or dataByKey["__tecs.pipeline"]
    if pipeline ~= nil and (
        type(
            pipeline
        ) ~= "table" or type(
            pipeline.fixedAccumulator
        ) ~= "number"
        or pipeline.fixedAccumulator < 0
        or pipeline.fixedAccumulator == math.huge
        or pipeline.fixedAccumulator ~= pipeline.fixedAccumulator
    ) then
        error("snapshot has invalid fixed accumulator", 2)
    end
    if pipeline ~= nil then
        if pipeline.phaseStates ~= nil then
            if type(pipeline.phaseStates) ~= "table" then
                error("snapshot has invalid phase states", 2)
            end
            for key, enabled in pairs(pipeline.phaseStates as table) do
                if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or type(enabled) ~= "boolean" then
                    error("snapshot has invalid phase states", 2)
                end
            end
        end
        if pipeline.disabledPhases ~= nil then
            if type(pipeline.disabledPhases) ~= "table" then
                error("snapshot has invalid disabled phases", 2)
            end
            for key, disabled in pairs(pipeline.disabledPhases as table) do
                if type(key) ~= "string" or type(disabled) ~= "boolean" then
                    error("snapshot has invalid disabled phases", 2)
                end
            end
        end
    end

    self:clearEntities()
    self.stateStack = {}
    self.autoStateComponent = nil
    for archetypeIndex = 1, #prepared do
        const frame = fastFrames[archetypeIndex]
        if frame ~= nil and frame.count > 0 then
            const inputs: {components.Input} = {}
            local relationships = false
            for column = 1, #frame.columns do
                inputs[column] = frame.columns[column].component
                if components.asRelationship(frame.columns[column].component) ~= nil then
                    relationships = true
                end
            end
            const restore = function(target: archetype.Archetype, first: integer, last: integer, count: integer): nil
                for column = 1, #frame.columns do
                    const savedColumn = frame.columns[column]
                    if savedColumn.component.storageType ~= "tag" then
                        snapshotcodec.copy(savedColumn, target, first, count)
                    end
                end
                if relationships then
                    archetype.restoreAliases(target, first, last)
                end
            end
            if relationships then
                const definitions: {components.Component} = {}
                const roots: {[integer]: boolean} = {}
                for column = 1, #frame.columns do
                    const component = frame.columns[column].component
                    definitions[#definitions + 1] = component
                    const relationship = components.asRelationship(component)
                    if relationship ~= nil and not roots[relationship.componentId] then
                        roots[relationship.componentId] = true
                        definitions[#definitions + 1] = assert(components.findById(relationship.componentId))
                    end
                end
                const target = resolveArchetype(self, definitions)
                unsafe do
                    for index = 0, frame.count - 1 do
                        idallocator.stakeId(self.allocator, frame.ids[index] as integer)
                    end
                end
                queueSpawnBatch(
                    self,
                    new SpawnBatch(
                        index = #self.spawnBatches + 1,
                        target = target,
                        values = {},
                        shared = {},
                        count = frame.count,
                        firstId = 0,
                        rawIds = frame.ids,
                        callback = restore,
                        rawRestore = true
                    )
                )
            else
                self:batchSpawnAtRaw(frame.ids, frame.count, inputs, restore)
            end
            const batch = self.spawnBatches[#self.spawnBatches]
            if batch ~= nil and batch.rawIds == frame.ids and archetype.bulkSafe(batch.target) then
                local complete = true
                for column = 1, #batch.target.components do
                    const component = batch.target.components[column]
                    if component.storageType ~= "tag" then
                        local found = false
                        for saved = 1, #frame.columns do
                            if frame.columns[saved].component == component then
                                found = true;
                                break
                            end
                        end
                        if not found then
                            complete = false;
                            break
                        end
                    end
                end
                -- Every value column is overwritten before any publication observer.
                -- Bypass per-row default constructors on this proven raw-copy path.
                batch.rawRestore = complete
            end
        end
        local entities = prepared[archetypeIndex]
        for entityIndex = 1, #entities do
            local entity = entities[entityIndex]
            self:spawnAt(entity.id, unpack(entity.inputs, 1, #entity.inputs))
        end
    end
    self:commit()
    if snapshot.nextEntityId > self.allocator.nextFreshSlot then
        self.allocator.nextFreshSlot = snapshot.nextEntityId
    end
    idallocator.rebuildFreeStack(self.allocator)
    for index = 1, #snapshot.states do
        self.stateStack[index] = snapshot.states[index]
    end
    local top = self.stateStack[#self.stateStack]
    if top ~= nil then
        self.autoStateComponent = self.stateComponents[top]
    end
    local prelude = new SnapshotPrelude(
        version = snapshot.version,
        nextEntityId = snapshot.nextEntityId,
        entityCount = snapshot.entityCount,
        archetypeCount = snapshot.archetypeCount,
        componentTable = copyComponentTable(snapshot.componentTable)
    )
    self.fixedAccumulator = pipeline ~= nil and pipeline.fixedAccumulator or 0
    if self.pipeline ~= nil then
        self.pipeline.fixedAccumulator = self.fixedAccumulator
        if pipeline ~= nil and type(pipeline.phaseStates) == "table" then
            self.pipeline.phaseStates = table.clone(pipeline.phaseStates as {boolean})
        end
    end
    table.clear(self.disabledPhases)
    if pipeline ~= nil then
        if type(pipeline.disabledPhases) == "table" then
            for name, disabled in pairs(pipeline.disabledPhases as {[string]: boolean}) do
                if disabled then
                    self.disabledPhases[name] = true
                end
            end
        elseif type(pipeline.phaseStates) == "table" then
            for index = 1, phases.count do
                if pipeline.phaseStates[index] == false then
                    self.disabledPhases[assert(phases.at(index))] = true
                end
            end
        end
    end
    const listeners: {[string]: {function(value: any)}} = {}
    self:emit(0, events.StartSnapshotLoad, prelude, listeners)
    if randomState ~= nil then
        randomstreams.restore(ensureRandom(self), randomState)
    end
    for index = 1, #self.snapshotHandlers do
        local handler = self.snapshotHandlers[index]
        local value = dataByKey[handler.name]
        if value ~= nil and handler.load ~= nil then
            handler.load(self, snapshotvalue.clone(value))
        end
    end
    for index = 1, #snapshot.data do
        const entry = snapshot.data[index]
        const callbacks = listeners[entry.key]
        if callbacks ~= nil then
            for position = 1, #callbacks do
                callbacks[position](snapshotvalue.clone(entry.value))
            end
        end
    end
    for index = 1, #self.snapshotHandlers do
        local finish = self.snapshotHandlers[index].finish
        if finish ~= nil then
            finish(self, prelude)
        end
    end
    self:emit(0, events.FinishSnapshotLoad, prelude)
    self:commit()

    return prelude
end

--- Registers a named custom snapshot participant.
--- @param self the world that owns the handler
--- @param handler the stable key and optional save, load, and finish callbacks
--- @raises when the key is empty, already registered, or reserved as tecs.random
function World.addSnapshotHandler(exclusive self: World, handler: SnapshotHandler): nil
    if handler.name == randomstreams.snapshotKey
        or handler.name == "__tecs.pipeline"
        or handler.name == "__tecs.stateStack"
    then
        error("world.addSnapshotHandler: " .. handler.name .. " is reserved for world-managed state", 2)
    end
    if handler.name == "" then
        error("snapshot handler requires a non-empty name", 2)
    end
    if self.snapshotHandlerNames[handler.name] then
        error("snapshot handler '" .. handler.name .. "' already registered", 2)
    end
    self.snapshotHandlerNames[handler.name] = true
    self.snapshotHandlers[#self.snapshotHandlers + 1] = handler
end

local function orderSystems(systems: {RegisteredSystem}, phase: phases.Phase): {RegisteredSystem}
    const names: {[string]: integer} = {}
    const indegrees: {integer} = {}
    const successors: {{integer}} = {}
    const seen: {{[integer]: boolean}} = {}
    for index = 1, #systems do
        names[systems[index].name] = index
        indegrees[index] = 0
        successors[index] = {}
        seen[index] = {}
    end
    local function edge(first: integer, second: integer): nil
        -- Self references impose no ordering constraint.
        if first == second or seen[first][second] then
            return
        end
        seen[first][second] = true
        const outgoing = successors[first]
        outgoing[#outgoing + 1] = second
        indegrees[second] = indegrees[second] + 1
    end

    for index = 1, #systems do
        const system = systems[index]
        for position = 1, #system.before do
            const target = names[system.before[position]]
            if target ~= nil then
                edge(index, target)
            end
        end
        for position = 1, #system.after do
            const target = names[system.after[position]]
            if target ~= nil then
                edge(target, index)
            end
        end
    end
    const ordered: {RegisteredSystem} = {}
    const emitted: {[integer]: boolean} = {}
    for position = 1, #systems do
        local ready: integer? = nil
        for index = 1, #systems do
            if not emitted[index] and indegrees[index] == 0 then
                ready = index
                break
            end
        end
        if ready == nil then
            const blocked: {string} = {}
            for index = 1, #systems do
                if not emitted[index] then
                    blocked[#blocked + 1] = systems[index].name
                end
            end
            error("Cycle detected in system dependencies in phase " .. phase .. ": " .. table.concat(blocked, ", "), 0)
        end
        emitted[ready] = true
        ordered[position] = systems[ready]
        const outgoing = successors[ready]
        for index = 1, #outgoing do
            const target = outgoing[index]
            indegrees[target] = indegrees[target] - 1
        end
    end

    return ordered
end

function World.registerPhase(exclusive self: World, phase: phases.Definition): nil
    if self.updating then
        error("registerPhase requires an idle scheduler", 2)
    end
    if self.pipeline ~= nil then
        self.pipeline:registerPhase(phase);
        return
    end
    if phase.name == "" or self.customPhases[phase.name] ~= nil then
        error("phase name is empty or already registered", 2)
    end
    const groups = {
        phases.StartupGroup,
        phases.FixedUpdateGroup,
        phases.RenderGroup,
        phases.MainGroup,
        phases.ShutdownGroup,
        phases.AllGroups
    }
    const known: {[string]: boolean} = {}
    for index = 1, #self.phaseOrder do
        known[self.phaseOrder[index]] = true
    end
    for index = 1, #groups do
        known[groups[index]] = true
    end
    if known[phase.name] then
        error("phase name is already registered", 2)
    end
    const position = phase.position or (#self.phaseOrder + 1)
    if position < 1 or position > #self.phaseOrder + 1 or position % 1 ~= 0 then
        error("phase position is outside the registry", 2)
    end
    local children: {string}? = nil
    if phase.children ~= nil then
        children = table.clone(phase.children)
        const seen: {[string]: boolean} = {}
        for index = 1, #children do
            const child = children[index]
            if not known[child] or seen[child] then
                error("phase tree contains an unknown or repeated child", 2)
            end
            seen[child] = true
        end
    end
    const definition: phases.Definition = {name = phase.name, position = position, children = children}
    self.customPhases[phase.name] = definition
    table.insert(self.phaseOrder, position, phase.name)
    for index = position, #self.phaseOrder do
        const custom = self.customPhases[self.phaseOrder[index]]
        if custom ~= nil then
            custom.position = index
        end
    end
    phase.position = position
    self.scheduleDirty = true
end

local function buildSchedule(borrows world: World): {[phases.Phase]: {RegisteredSystem}}
    const result: {[phases.Phase]: {RegisteredSystem}} = {}
    for index = 1, #world.systems do
        const system = world.systems[index]
        if not system.removed then
            local selected = result[system.phase]
            if selected == nil then
                selected = {}
                result[system.phase] = selected
            end
            selected[#selected + 1] = system
        end
    end
    local index: integer = 1
    while true do
        const phase = world.phaseOrder[index]
        if phase == nil then
            break
        end
        const selected = result[phase]
        if selected ~= nil then
            result[phase] = orderSystems(selected, phase)
        end
        index = index + 1
    end

    return result
end

local function prepareSchedule(exclusive world: World): nil
    if world.scheduleDirty then
        -- Publish the cache only after every phase passes cycle validation.
        world.schedule = buildSchedule(world)
        world.scheduleDirty = false
    end
end

function World.addSystem(exclusive self: World, config: SystemConfig): string
    if self.pipeline ~= nil then
        const name = self.pipeline:addSystem(config)
        self.systemCount = self.pipeline.count
        return name
    end
    local known = self.customPhases[config.phase] ~= nil
    for index = 1, #self.phaseOrder do
        if self.phaseOrder[index] == config.phase then
            known = true;
            break
        end
    end
    const custom = self.customPhases[config.phase]
    if not known or (custom ~= nil and custom.children ~= nil) then
        error("system phase must be a registered leaf", 2)
    end
    local name = config.name
    if name == nil then
        self.anonymousSystemCount = self.anonymousSystemCount + 1
        name = "_anonymousSystem" .. tostring(self.anonymousSystemCount)
    end
    if self.systemNames[name] ~= nil then
        error("System " .. name .. " already registered", 2)
    end
    local system = new RegisteredSystem(
        name = name,
        phase = config.phase,
        run = config.run,
        runIf = config.runIf,
        before = table.clone(config.before or {}),
        after = table.clone(config.after or {}),
        commitBefore = config.commitBefore == true,
        commitAfter = config.commitAfter == true,
        enabled = true,
        removed = false
    )
    self.systems[#self.systems + 1] = system
    self.systemNames[name] = system
    self.systemCount = self.systemCount + 1
    self.scheduleDirty = true

    return name
end

local function compactSystems(exclusive world: World): nil
    local write: integer = 1
    for read = 1, #world.systems do
        local system = world.systems[read]
        if not system.removed then
            world.systems[write] = system
            write = write + 1
        end
    end
    for index = #world.systems, write, -1 do
        world.systems[index] = nil
    end
end

--- Removes a system by name.
--- @param self the world to modify
--- @param name the registered explicit or generated name
--- @return whether a system carried the name
function World.removeSystem(exclusive self: World, name: string): boolean
    if self.pipeline ~= nil then
        const removed = self.pipeline:removeSystem(name)
        self.systemCount = self.pipeline.count
        return removed
    end
    local system = self.systemNames[name]
    if system == nil then
        return false
    end
    system.enabled = false
    system.removed = true
    self.systemNames[name] = nil
    self.systemCount = self.systemCount - 1
    self.scheduleDirty = true
    if not self.updating then
        compactSystems(self)
    end

    return true
end

function World.listSystems(borrows self: World): {SystemInfo}
    if self.pipeline ~= nil then
        return self.pipeline:listSystems()
    end
    const schedule = self.scheduleDirty and buildSchedule(self) or self.schedule
    local result: {SystemInfo} = {}
    local phaseIndex: integer = 1
    while true do
        local phase = self.phaseOrder[phaseIndex]
        if phase == nil then
            break
        end
        local position: integer = 0
        const selected = schedule[phase]
        if selected ~= nil then
            for systemIndex = 1, #selected do
                local system = selected[systemIndex]
                if not system.removed then
                    position = position + 1
                    result[
                        #result + 1
                    ] = {
                        name = system.name,
                        phase = phase,
                        position = position,
                        enabled = system.enabled,
                        hasRunIf = system.runIf ~= nil
                    }
                end
            end
        end
        phaseIndex = phaseIndex + 1
    end

    return result
end

--- Enables or disables a registered system without removing it.
--- @param self the world whose schedule changes
--- @param name the explicit or generated system name
--- @param enabled whether future dispatches should run the system
--- @return whether the system exists, plus a reason when it does not
function World.setSystemEnabled(exclusive self: World, name: string, enabled: boolean): boolean, string?
    if self.pipeline ~= nil then
        return self.pipeline:setSystemEnabled(name, enabled)
    end
    local system = self.systemNames[name]
    if system == nil or system.removed then
        return false, "no system named '" .. name .. "' is registered"
    end
    system.enabled = enabled

    return true
end

local setPhaseEnabled: function(exclusive world: World, selection: phases.Selection, enabled: boolean): nil
setPhaseEnabled = function(exclusive world: World, selection: phases.Selection, enabled: boolean): nil
    const custom = world.customPhases[selection]
    if custom ~= nil and custom.children ~= nil then
        for index = 1, #custom.children do
            setPhaseEnabled(world, custom.children[index], enabled)
        end
        return
    end
    local index: integer = 1
    while true do
        local phase = phases.selectionAt(selection, index)
        if phase == nil then
            break
        end
        if enabled then
            world.disabledPhases[phase] = nil
        else
            world.disabledPhases[phase] = true
        end
        index = index + 1
    end
end

--- Enables a leaf phase or every leaf in a predefined group.
--- @param self the world whose schedule changes
--- @param phase the leaf or group to enable
function World.enablePhase(exclusive self: World, phase: phases.Selection): nil
    if self.pipeline ~= nil then
        self.pipeline:enablePhase(phase);
        return
    end
    setPhaseEnabled(self, phase, true)
end

--- Disables a leaf phase or every leaf in a predefined group.
--- @param self the world whose schedule changes
--- @param phase the leaf or group to disable
function World.disablePhase(exclusive self: World, phase: phases.Selection): nil
    if self.pipeline ~= nil then
        self.pipeline:disablePhase(phase);
        return
    end
    setPhaseEnabled(self, phase, false)
end

--- Reports whether a leaf phase currently dispatches systems.
--- @param self the world to inspect
--- @param phase the leaf phase
--- @return whether the phase is enabled
function World.isPhaseEnabled(borrows self: World, phase: phases.Phase): boolean
    if self.pipeline ~= nil then
        return self.pipeline:isPhaseEnabled(phase)
    end
    return not self.disabledPhases[phase]
end

local function runPhase(exclusive world: World, phase: phases.Phase, dt: number, borrows scope: tasks.Scope): nil
    if world.disabledPhases[phase] then
        return
    end
    const selected = world.schedule[phase]
    if selected ~= nil then
        for index = 1, #selected do
            local system = selected[index]
            if system.enabled then
                if system.commitBefore then
                    world:commit()
                end
                -- Publication callbacks may stop a system before its dispatch.
                if system.enabled then
                    world.runningSystem = true
                    world.systemThread = coroutine.running()
                    local gate = system.runIf
                    if gate == nil or gate(dt, world, system.name) then
                        system.run(dt, world, scope)
                    end
                    world.runningSystem = false
                    world.systemThread = nil
                    if system.commitAfter or world.commitRequested then
                        world:commit()
                    end
                end
            end
        end
    end
    world:commit()
end

local runSelection: function(
    exclusive world: World,
    selection: phases.Selection,
    dt: number,
    borrows scope: tasks.Scope
): nil
runSelection = function(
    exclusive world: World,
    selection: phases.Selection,
    dt: number,
    borrows scope: tasks.Scope
): nil
    const custom = world.customPhases[selection]
    if custom ~= nil and custom.children ~= nil then
        for index = 1, #custom.children do
            runSelection(world, custom.children[index], dt, scope)
        end
        return
    end
    local index: integer = 1
    while true do
        local phase = phases.selectionAt(selection, index)
        if phase == nil then
            break
        end
        runPhase(world, phase, dt, scope)
        index = index + 1
    end
end

local function runPhaseRange(
    exclusive world: World,
    first: integer,
    last: integer,
    dt: number,
    borrows scope: tasks.Scope
): nil
    for phaseIndex = first, last do
        runPhase(world, assert(phases.at(phaseIndex)), dt, scope)
    end
end

local function dropFixedCatchUp(exclusive world: World): nil
    local timestep = world.fixedTimestep
    local owed = world.fixedAccumulator
    local dropped = owed - (owed % timestep)
    if dropped <= 0 then
        return
    end
    world.fixedAccumulator = owed - dropped
    world.fixedTimeDropped = world.fixedTimeDropped + dropped
    world.fixedStepsDropped = world.fixedStepsDropped + math.floor(dropped / timestep + 0.5)
end

local function runFixedSteps(exclusive world: World, dt: number, borrows scope: tasks.Scope): nil
    local timestep = world.fixedTimestep
    world.fixedAccumulator = world.fixedAccumulator + dt
    local steps: integer = 0
    while world.fixedAccumulator >= timestep and steps < world.fixedMaxSteps do
        steps = steps + 1
        world.fixedStepTotal = world.fixedStepTotal + 1
        beginFixedStep(world)
        runPhaseRange(world, phases.fixedFirstIndex, phases.fixedLastIndex, timestep, scope)
        finishFixedStep(world)
        world.fixedAccumulator = world.fixedAccumulator - timestep
    end
    if world.fixedAccumulator >= timestep and world.fixedOverload == "drop" then
        dropFixedCatchUp(world)
    end
end

local function runUpdate(exclusive world: World, dt: number, borrows scope: tasks.Scope): nil
    runPhaseRange(world, 1, phases.beforeFixedCount, dt, scope)
    runFixedSteps(world, dt, scope)
    runPhaseRange(world, phases.fixedLastIndex + 1, phases.count, dt, scope)
end

local function runLifecycle(
    exclusive world: World,
    phaseAt: function(integer): phases.Phase?,
    count: integer,
    borrows scope: tasks.Scope
): nil
    for index = 1, count do
        runPhase(world, assert(phaseAt(index)), 0, scope)
    end
end

local function runCustomPipeline(
    exclusive world: World,
    phase: phases.Selection?,
    dt: number,
    borrows scope: tasks.Scope
): nil
    const pipeline = assert(world.pipeline)
    world.runningSystem = true
    world.systemThread = coroutine.running()
    if phase ~= nil then
        pipeline:run(phase, dt, world, scope)
    else
        pipeline:update(dt, world, scope)
    end
    world.runningSystem = false
    world.systemThread = nil
    world:commit()
end

--- Runs the three startup phases in order.
--- @param self the world to start
--- @raises when another dispatch is active or a startup system raises
function World.startup(exclusive self: World): nil
    if self.updating then
        error("world.startup: another world dispatch is active", 2)
    end
    prepareSchedule(self)
    self:commit()
    self.updating = true
    local succeeded, failure = pcall(function(): nil
        with scope = tasks.open() do
            if self.pipeline ~= nil then
                runCustomPipeline(self, phases.StartupGroup, 0, scope)
            else
                runLifecycle(self, phases.startupAt, phases.startupCount, scope)
            end
        end
    end)
    self.updating = false
    self.runningSystem = false
    self.commitRequested = false
    compactSystems(self)
    if not succeeded then
        error(failure, 0)
    end
end

--- Runs the three shutdown phases in order.
--- @param self the world to stop
--- @raises when another dispatch is active or a shutdown system raises
function World.shutdown(exclusive self: World): nil
    if self.updating then
        error("world.shutdown: another world dispatch is active", 2)
    end
    prepareSchedule(self)
    self:commit()
    self.updating = true
    local succeeded, failure = pcall(function(): nil
        with scope = tasks.open() do
            if self.pipeline ~= nil then
                runCustomPipeline(self, phases.ShutdownGroup, 0, scope)
            else
                runLifecycle(self, phases.shutdownAt, phases.shutdownCount, scope)
            end
        end
    end)
    self.updating = false
    self.runningSystem = false
    self.commitRequested = false
    compactSystems(self)
    if not succeeded then
        error(failure, 0)
    end
end

--- Runs one leaf phase without advancing the fixed clock or clearing dirty bits.
--- @param self the world to dispatch
--- @param phase the startup, frame, fixed, rendering, or shutdown leaf
--- @param dt elapsed seconds passed to systems, or zero when omitted
--- @raises when another dispatch is active or a system raises
function World.runPhase(exclusive self: World, phase: phases.Selection, dt: number?): nil
    if self.updating then
        error("world.runPhase: another world dispatch is active", 2)
    end
    local elapsed = dt or 0
    if elapsed < 0 or elapsed ~= elapsed then
        error("world.runPhase: dt must be a non-negative number", 2)
    end
    prepareSchedule(self)
    self:commit()
    self.updating = true
    local succeeded, failure = pcall(function(): nil
        with scope = tasks.open() do
            if self.pipeline ~= nil then
                runCustomPipeline(self, phase, elapsed, scope)
            else
                runSelection(self, phase, elapsed, scope)
            end
        end
    end)
    self.updating = false
    self.runningSystem = false
    self.commitRequested = false
    compactSystems(self)
    if not succeeded then
        error(failure, 0)
    end
end

--- Runs one logical frame update and its structural barriers.
---
--- A barrier publishes work staged before the update, after every phase, and
--- wherever a system explicitly requests one. Every update owns a structured
--- `nupp.tasks` scope. A suspension-aware call may park the update through the
--- surrounding host handler, and child work started through the system's third
--- argument settles before the update returns.
--- @param self the world to update
--- @param dt elapsed frame time in seconds
--- @raises when dt is negative or NaN, or when a system raises
function World.update(exclusive self: World, dt: number): nil
    if self.updating then
        error("world.update: another world dispatch is active", 2)
    end
    if dt < 0 or dt ~= dt then
        error("world.update: dt must be a non-negative number", 2)
    end
    prepareSchedule(self)
    self:commit()
    self.updating = true
    local succeeded, failure = pcall(function(): nil
        with scope = tasks.open() do
            if self.pipeline ~= nil then
                runCustomPipeline(self, nil, dt, scope)
            else
                runUpdate(self, dt, scope)
            end
        end
    end)
    self.updating = false
    if self.dirtyQueue.fixed ~= nil then
        self.dirtyQueue.fixed.active = false
    end
    self.runningSystem = false
    self.commitRequested = false
    compactSystems(self)
    if not succeeded then
        error(failure, 0)
    end
    for index = 1, #self.dirtyQueue.list do
        self.dirtyQueue.list[index]:clearDirtyComponents()
    end
    table.clear(self.dirtyQueue.list)
    self.dirtyQueue.epoch = self.dirtyQueue.epoch + 1
end

--- Opens fixed tracking for either the built-in or a custom pipeline.
export function beginFixedStep(exclusive world: World): nil
    const state = world.dirtyQueue.fixed
    if state == nil then
        return
    end
    if state.active then
        error("fixed tracking step is already active", 2)
    end
    state.step = state.step + 1
    const before = world.beforeFixedCallbacks
    if before ~= nil then
        for index = 1, #before do
            before[index](world)
        end
    end
    state.active = true
end

--- Completes fixed tracking after all fixed systems have published their writes.
export function finishFixedStep(exclusive world: World): nil
    const state = world.dirtyQueue.fixed
    if state == nil then
        return
    end
    if not state.active then
        error("fixed tracking has no active step", 2)
    end
    const after = world.afterFixedCallbacks
    if after ~= nil then
        for index = 1, #after do
            after[index](world)
        end
    end
    state.active = false
end

--- Returns or lazily installs generic fixed-iteration tracking for engine consumers.
export function fixedTracking(exclusive world: World, create: boolean?): archetype.FixedState?
    if create and world.dirtyQueue.fixed == nil then
        world.dirtyQueue.fixed = new archetype.FixedState(
            tracked = {},
            trackedList = {},
            versions = setmetatable({}, {
                __mode = "k"
            }),
            writes = setmetatable({}, {
                __mode = "k"
            }),
            structures = setmetatable({}, {
                __mode = "k"
            }),
            step = 0,
            active = false
        )
    end

    return world.dirtyQueue.fixed
end

--- Registers a callback at one side of each completed fixed iteration.
export function onFixedStep(exclusive world: World, callback: function(exclusive world: World), before: boolean): nil
    fixedTracking(world, true)
    if before then
        if world.beforeFixedCallbacks == nil then
            world.beforeFixedCallbacks = {}
        end
        const entries = assert(world.beforeFixedCallbacks)
        entries[#entries + 1] = callback
    else
        if world.afterFixedCallbacks == nil then
            world.afterFixedCallbacks = {}
        end
        const entries = assert(world.afterFixedCallbacks)
        entries[#entries + 1] = callback
    end
end

--- Returns the configured seconds per presentation tick.
--- @param self the world to inspect.
--- @return the positive nominal duration, independent of measured frame deltas.
function World.getNominalFrameTime(borrows self: World): number
    return self.nominalFrameTime
end

--- Changes how future frame and presentation waits convert seconds to ticks.
--- Existing tick deadlines are unchanged. This setting is local to one world.
--- @param self the world to configure.
--- @param seconds the positive finite nominal duration in seconds.
--- @raises when seconds is not positive and finite.
function World.setNominalFrameTime(exclusive self: World, seconds: number): nil
    if not (seconds > 0) or seconds == math.huge then
        error("world.setNominalFrameTime: seconds must be positive and finite", 2)
    end
    self.nominalFrameTime = seconds
end

--- Returns fixed-step timing for interpolation consumers.
--- @param self the world to inspect
--- @return the fixed timestep, residual time, and clamped interpolation fraction
function World.getFixedTiming(borrows self: World): number, number, number
    const timestep = self.pipeline and self.pipeline.fixedTimestep or self.fixedTimestep
    const accumulator = self.pipeline and self.pipeline.fixedAccumulator or self.fixedAccumulator
    local alpha = accumulator / timestep
    if alpha < 0 then
        alpha = 0
    elseif alpha > 1 then
        alpha = 1
    end

    return timestep, accumulator, alpha
end

--- Returns the fixed steps run since the world was created.
--- @param self the world to inspect
--- @return the monotonically increasing simulation step count
function World.fixedStepCount(borrows self: World): integer
    if self.pipeline ~= nil then
        return self.pipeline.fixedStepCount
    end
    return self.fixedStepTotal
end

--- Returns the accumulated fixed-step overload counters.
--- @param self the world to inspect
--- @return a caller-owned statistics record
function World.getStats(borrows self: World, fill: WorldStats?): WorldStats
    local componentCount: integer = 0
    for _ in pairs(self.componentArchetypes) do
        componentCount = componentCount + 1
    end
    const systems = self.pipeline and self.pipeline.count or self.systemCount
    const timeDropped = self.pipeline and self.pipeline.fixedTimeDropped or self.fixedTimeDropped
    const stepsDropped = self.pipeline and self.pipeline.fixedStepsDropped or self.fixedStepsDropped
    if fill ~= nil then
        fill.entities = self.liveCount
        fill.archetypes = self.archetypeCount
        fill.components = componentCount
        fill.systems = systems
        fill.fixedTimeDropped = timeDropped
        fill.fixedStepsDropped = stepsDropped
        return fill
    end

    return new WorldStats(
        entities = self.liveCount,
        archetypes = self.archetypeCount,
        components = componentCount,
        systems = systems,
        fixedTimeDropped = timeDropped,
        fixedStepsDropped = stepsDropped
    )
end

--- Returns detached archetype metadata for internal diagnostics.
export function inspectArchetypes(borrows value: World): {any}
    local rows: {any} = {}
    local function byName(a: any, b: any): boolean
        return a.name < b.name
    end

    for index = 1, value.archetypeCount do
        local current = value.archetypes[index]
        local names: {string} = {}
        local columns: {any} = {}
        for _, kind in ipairs(current.components) do
            names[#names + 1] = kind.componentName
            columns[#columns + 1] = {name = kind.componentName, dirty = current:isComponentDirty(kind)}
        end
        table.sort(names)
        table.sort(columns, byName)
        rows[#rows + 1] = {id = current.id, entities = #current.entities, components = names, columns = columns}
    end

    return rows
end

--- Builds an internal diagnostic query over the current committed archetypes.
--- It is not retained by the world and must not be reused after structural changes.
export function querySnapshot(borrows value: World, descriptor: query.Descriptor): query.Query
    local found = query.new(descriptor)
    for index = 1, value.archetypeCount do
        query.addArchetype(found, value.archetypes[index])
    end

    return found
end

-- Releases a renderer-owned persistent query when its viewport is destroyed.
export function releaseQuery(exclusive value: World, owned: query.Query): nil
    for index = #value.queries, 1, -1 do
        if value.queries[index] == owned then
            table.remove(value.queries, index)
        end
    end
    for index = #value.queryObservers, 1, -1 do
        if value.queryObservers[index] == owned then
            table.remove(value.queryObservers, index)
        end
    end
end
