module tecs.internal.nativelibrary

--[[
Loading for the Rust service libraries Tecs binds through the FFI.

A `cdef function` declaration can name its library with a `from` clause, but
that clause has to spell one platform's file name in a source file shared by
three, and it binds at module load with no say in where the file is found. The
loader path a developer would otherwise set is stripped from a protected
process on macOS, so `DYLD_LIBRARY_PATH` is not an answer either.

`open` runs one search that covers both a packaged install and a development
checkout, and returns the loaded library. Each declaration then names that
handle in its `from` clause, so it binds its symbol from the library itself.
A declaration copies its function pointer out of the handle once, when its
module loads, and the copy does not keep the library loaded. LuaJIT unloads a
library when its handle is collected and when the state closes, so `open` keeps
every library it opens loaded for the life of the process.

```nupp
const physics = tecs.internal.nativelibrary.open("tecs_physics", "TECS_PHYSICS_LIBRARY")

cdef function tecsPhysicsStep(world: voidptr?, batch: voidptr?): uint32 from physics
```

Loading into the process namespace and declaring bare symbols does not work on
Windows, whose default namespace never includes a library loaded later.
]]

local ffi = require("ffi")

--- The directories searched under each ancestor, in order.
---
--- `lib` is where a packaged build puts the library and the Cargo directories
--- are where a development checkout has it, so a package never picks up a
--- stale build tree and a checkout needs no staging step.
local RELATIVE: {string} = {"/lib/", "/target/release/", "/target/debug/"}

--- Returns a library's file name on the running platform.
--- @param stem the library name without prefix or extension
--- @return the platform's file name for that library
local function libraryFile(stem: string): string
    if ffi.os == "Windows" then
        return stem .. ".dll"
    elseif ffi.os == "OSX" then
        return "lib" .. stem .. ".dylib"
    end

    return "lib" .. stem .. ".so"
end

--- Reports whether a path names a readable file.
--- @param path the path to test
--- @return whether the file could be opened for reading
local function readable(path: string): boolean
    local handle = io.open(path, "rb")
    if handle == nil then
        return false
    end
    handle:close()

    return true
end

--- Runs the search `open` describes and names the library it found.
--- @param stem the library name without prefix or extension
--- @param override the environment variable naming an exact file, if any
--- @return the file to load: a path, or the bare file name for the platform loader
local function locate(stem: string, override: string?): string
    if override ~= nil then
        local named = os.getenv(override)
        if named ~= nil then
            return named
        end
    end
    local file = libraryFile(stem)
    local source = debug.getinfo(1, "S").source
    local directory = source:match("^@(.+)[/\\][^/\\]+$") or "."
    for _ = 0, 8 do
        for _, relative in ipairs(RELATIVE) do
            local candidate = directory .. relative .. file
            if readable(candidate) then
                return candidate
            end
        end
        directory = directory .. "/.."
    end

    return file
end

--- Takes a reference to a loaded library that nothing releases.
---
--- LuaJIT releases its own when the handle is collected or the state closes, and a
--- service unloaded while a thread of its own still runs, or with destructors the
--- C runtime still holds, takes the process down at exit. This one keeps the
--- library mapped until the process ends.
--- @param file the file the library was loaded from
local function retain(file: string): nil
    local system: any = ffi.C
    if ffi.os == "Windows" then
        pcall(ffi.cdef, "void* LoadLibraryA(const char* name);")
        system.LoadLibraryA(file)
    else
        pcall(ffi.cdef, "void* dlopen(const char* path, int mode);")
        -- RTLD_NOW, the same on Linux and macOS.
        system.dlopen(file, 2)
    end
end

--- Every handle `open` returned, by stem. Once the declarations bound from a
--- handle have copied their function pointers out, nothing else references it.
local opened: {[string]: any} = {}

--- Loads a Tecs native library and returns its handle.
---
--- The environment variable named by `override` is tried first and names an
--- exact file. Otherwise the search walks up from this module through eight
--- ancestors, looking under each for `lib` and then for a Cargo target
--- directory. A plain load by file name runs last, so an installed library
--- still resolves and so its own diagnostic is what a failure reports.
---
--- The handle is what a `cdef function ... from` clause names. A stem loads
--- once per process: a later call returns the same handle, and the library
--- stays loaded until the process exits, so the functions bound from it stay
--- callable and a service's own threads outlive the state that started them.
--- @param stem the library name without prefix or extension
--- @param override the environment variable naming an exact file, if any
--- @return the loaded library, for `from` clauses to bind from
--- @raises string when no candidate can be loaded
export function open(stem: string, override: string?): any
    local handle = opened[stem]
    if handle == nil then
        local file = locate(stem, override)
        handle = ffi.load(file)
        retain(file)
        opened[stem] = handle
    end

    return handle
end
