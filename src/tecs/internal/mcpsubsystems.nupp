module tecs.internal.mcpsubsystems

const {type Store} = require("nupp.util")

-- Subsystem tools. Input schemas and tool names are compatibility surfaces.
local registry = require("tecs.internal.mcpregistry")
local bindings = require("tecs.internal.mcpbindings")
local schemas = require("tecs.internal.mcpschemas")
local entityworld = require("tecs.internal.world")
local cameraselection = require("tecs.internal.cameraselection")
local rendercomponents = require("tecs.internal.rendercomponents")
local ecs = require("tecs.ecs")
local materials = require("tecs.gpu.materials")
local layers = require("tecs.gfx.layers")
local physics = require("tecs.physics")
local audio = require("tecs.audio")
local screenshot = require("tecs.gfx.screenshot")
local files = require("nupp.io.files")
local path = require("nupp.io.path")
local json = require("nupp.codec.json")
local profile = require("nupp.profile")
local buffer = require("string.buffer")

local function register(
    name: string,
    description: string,
    handler: registry.ToolHandler,
    mutates: boolean?,
    independent: boolean?
): nil
    local schema = schemas.inputs[name] ?? schemas.added[name]
    registry.register({
        name = name,
        description = description,
        inputSchema = schema,
        readOnly = not mutates,
        destructive = mutates == true,
        whenCrashed = independent,
        whenParked = independent,
        handler = function(arguments: {[string]: any}): {[string]: any}?
            for _, key in ipairs(schema.required or {}) do
                assert(arguments[key] ~= nil, "missing argument: " .. key)
            end
            for key, value in pairs(arguments) do
                local rule = schema.properties[key]
                assert(rule ~= nil, "unknown argument: " .. key)
                local kind = type(value)
                assert(kind == rule.type, "invalid argument type: " .. key)
                if kind == "number" then
                    assert(
                        value == value and value ~= math.huge and value ~= -math.huge,
                        "non-finite argument: " .. key
                    )
                    assert(rule.minimum == nil or value >= rule.minimum, "argument below minimum: " .. key)
                    assert(rule.maximum == nil or value <= rule.maximum, "argument above maximum: " .. key)
                end
            end
            local values: {[string]: any} = {}
            for key, rule in pairs(schema.properties) do
                values[key] = arguments[key] ?? rule.default
            end

            return handler(values)
        end
    })
end

local function integer(value: number): integer
    assert(value == math.floor(value), "argument must be an integer")
    return value as integer
end

register("archetypes_list", "List committed archetypes, including empty ones when requested.", function(
    args: {[string]: any}
): {[string]: any}
    local rows: {any} = {}
    local total = 0
    local limit = args.limit or 50
    for _, row in ipairs(entityworld.inspectArchetypes(bindings.requireWorld())) do
        if args.empty == true or row.entities > 0 then
            total = total + 1
            if #rows < limit then
                rows[#rows + 1] = {id = row.id, entities = row.entities, components = json.asArray(row.components)}
            end
        end
    end

    return {archetypes = json.asArray(rows), total = total, returned = #rows}
end)
register("archetypes_info", "Report one archetype's components and dirty columns.", function(
    args: {[string]: any}
): {[string]: any}
    for _, row in ipairs(entityworld.inspectArchetypes(bindings.requireWorld())) do
        if row.id == args.id then
            return {id = row.id, entities = row.entities, components = json.asArray(row.columns)}
        end
    end
    error("unknown archetype: " .. tostring(args.id))
end)

--- Detached resource rows, labelling an anonymous key `#<id>` as the tool
--- output always has.
local function resourceRows(borrows resources: Store): {any}
    local rows: {any} = {}
    for id, name, valueType in resources:entries() do
        rows[#rows + 1] = {id = id, name = name or ("#" .. tostring(id)), valueType = valueType}
    end

    return rows
end

register("resources_list", "List occupied world resource keys without serializing live values.", function(
    _args: {[string]: any}
): {[string]: any}
    local rows = resourceRows(bindings.requireWorld().resources)
    return {resources = json.asArray(rows), total = #rows}
end)
register("resources_info", "Report whether a named world resource is present.", function(
    args: {[string]: any}
): {[string]: any}
    for _, row in ipairs(resourceRows(bindings.requireWorld().resources)) do
        if row.name == args.name then
            return {name = row.name, present = true, valueType = row.valueType}
        end
    end

    return {name = args.name, present = false}
end)
register("materials_list", "List the registered material dispatch names and IDs.", function(
    _args: {[string]: any}
): {[string]: any}
    local rows: {any} = {}
    for _, name in ipairs(materials.names()) do
        rows[#rows + 1] = {name = name, id = materials.id(name)}
    end

    return {materials = json.asArray(rows), total = #rows}
end)
register("materials_info", "Resolve one material name to its dispatch ID.", function(
    args: {[string]: any}
): {[string]: any}
    local id = materials.find(args.name)
    assert(id ~= nil, "unknown material: " .. args.name)
    return {name = args.name, id = id}
end)

local function camera(exclusive world: ecs.World): rendercomponents.Camera2D?, integer?
    local active, entity = cameraselection.pick(
        entityworld.querySnapshot(world, {
            include = {rendercomponents.Camera2DComponent, rendercomponents.ActiveCamera}
        })
    )
    if active ~= nil then
        return active, entity
    end

    return cameraselection.pick(entityworld.querySnapshot(world, {include = {rendercomponents.Camera2DComponent}}))
end

local function cameraInfo(): {[string]: any}
    local current, entity = camera(bindings.requireWorld())
    local app = bindings.app()
    local width, height = 0, 0
    if app ~= nil then
        width, height = app.window:getPixelSize()
    end
    local result: {[string]: any} = current ~= nil
        and {x = current.x, y = current.y, zoom = current.zoom, rotation = current.rotation, entity = entity}
        or {x = width * 0.5, y = height * 0.5, zoom = 1, rotation = 0, implicit = true}
    if app ~= nil then
        result.viewport = {width = width, height = height}
    end

    return result
end

register("camera_info", "Report the camera selected by frame extraction.", function(
    _args: {[string]: any}
): {[string]: any}
    return cameraInfo()
end)
register(
    "camera_move",
    "Change the selected camera's center, zoom or rotation.",
    function(args: {[string]: any}): {[string]: any}
        local world = bindings.requireWorld()
        local current, entity = camera(world)
        assert(current ~= nil and entity ~= nil, "no camera entity; create Camera2D before moving the view")
        local changed = assert(world:getMut(entity, rendercomponents.Camera2DComponent))
        if args.x ~= nil then
            changed.x = args.x
        end
        if args.y ~= nil then
            changed.y = args.y
        end
        if args.zoom ~= nil then
            changed.zoom = args.zoom
        end
        if args.rotation ~= nil then
            changed.rotation = args.rotation
        end

        return cameraInfo()
    end,
    true
)

local function layerInfo(index: integer): {[string]: any}
    local mode, parallax, ignoreZoom, lit = layers.entryOf(index)
    local sort = layers.sortOf(index)
    return {
        layer = index,
        sort = ({"topdown", "z", "isometric"})[sort + 1],
        space = ({"world", "screen", "virtual"})[integer(mode) + 1],
        parallax = parallax,
        ignoreZoom = ignoreZoom ~= 0,
        unlit = lit == 0,
        overlay = layers.isOverlay(index),
        viewCulled = layers.viewCulled(index)
    }
end

register("layers_list", "Report all configured layer bands.", function(_args: {[string]: any}): {[string]: any}
    local rows: {any} = {}
    for index = 1, layers.MAX do
        rows[#rows + 1] = layerInfo(index)
    end

    return {layers = json.asArray(rows), total = #rows}
end)
register("layers_info", "Report one layer's placement and sorting.", function(args: {[string]: any}): {[string]: any}
    return layerInfo(integer(args.layer))
end)
register(
    "render_info",
    "Report CPU render configuration; GPU frame counters are unavailable through this bridge.",
    function(_args: {[string]: any}): {[string]: any}
        local app = bindings.app()
        return {
            backend = "wgpu",
            materials = materials.count(),
            layers = layers.MAX,
            camera = cameraInfo(),
            frame = app ~= nil and app.frame or 0,
            observations = {gpuCounters = false, readback = true},
            unavailable = json.asArray({"presented frame ID", "GPU timings", "visible instance count"})
        }
    end
)
register("physics_info", "Report the installed solver and committed body population.", function(
    _args: {[string]: any}
): {[string]: any}
    local world = bindings.requireWorld()
    local simulation = physics.of(world)
    if simulation == nil then
        return {installed = false}
    end
    local count = 0
    for _, length in entityworld.querySnapshot(world, {include = {physics.Body}}):iter() do
        count = count + (length as integer)
    end

    return {
        installed = true,
        bodies = count,
        subStepCount = simulation.subStepCount,
        workerCount = simulation.workerCount
    }
end)
register("physics_raycast", "Find the nearest collider along a world-pixel segment.", function(
    args: {[string]: any}
): {[string]: any}
    local world = bindings.requireWorld()
    assert(physics.of(world) ~= nil, "no physics simulation installed")
    local category = integer(args.categoryBits or 4294967295)
    local mask = integer(args.maskBits or 4294967295)
    assert(
        category >= 0 and category <= 4294967295 and mask >= 0 and mask <= 4294967295,
        "collision mask is outside uint32"
    )
    local hit = physics.raycast(world, args.x1, args.y1, args.x2, args.y2, {categoryBits = category, maskBits = mask})
    if hit == nil then
        return {hit = false}
    end

    return {
        hit = true,
        entity = hit.entity,
        x = hit.x,
        y = hit.y,
        normalX = hit.normalX,
        normalY = hit.normalY,
        fraction = hit.fraction
    }
end)
register("audio", "Report the world's audio output, mixer and decoder state.", function(
    _args: {[string]: any}
): {[string]: any}
    local mixer = audio.of(bindings.requireWorld())
    if mixer == nil then
        return {installed = false, available = false}
    end

    return {
        installed = true,
        available = mixer.available,
        failure = mixer.failureReason,
        voices = mixer:sounding(),
        maxVoices = mixer:maxVoices(),
        gain = mixer:masterGain(),
        muted = mixer:muted(),
        decoders = json.asArray(mixer:decoders())
    }
end)
register(
    "reload_sound",
    "Reload an already cached sound through the world's audio owner.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = audio.of(bindings.requireWorld())
        assert(mixer ~= nil, "no audio mixer installed")
        local ok, reason = mixer:reload(args.path)
        assert(ok, reason)

        return {path = args.path, reloaded = true}
    end,
    true
)

local function artifact(name: string): string
    assert(name ~= "" and not path.newPath(name):isAbsolute(), "artifact name must be relative to the writable root")
    const root, reason = files.dataPath()
    assert(root ~= nil, reason?.message)
    local located = root as files.ApplicationPath
    -- The root refuses a component that would leave it, so a name carrying `..`
    -- raises here rather than resolving somewhere else.
    for segment in name:gmatch("[^/\\\\]+") do
        located = located:join(segment)
    end

    return located:toString()
end

register(
    "snapshot_save",
    "Write the committed world as a native binary snapshot.",
    function(args: {[string]: any}): {[string]: any}
        local destination = artifact(args.name or "snapshot.bin")
        local world = bindings.requireWorld()
        local output = buffer.new()
        world:saveSnapshot({format = "binary", buffer = output})
        local bytes = output:tostring()
        local ok, reason = files.writeAtomic(destination, bytes)
        assert(ok, reason?.message)

        return {path = destination, format = "binary", bytes = #bytes}
    end,
    true
)
register(
    "snapshot_load",
    "Replace the world from a native binary snapshot.",
    function(args: {[string]: any}): {[string]: any}
        assert(path.newPath(args.path):isAbsolute(), "snapshot path must be absolute")
        local bytes: string
        do
            local input, reason = files.open(args.path, "r")
            assert(input ~= nil, reason?.message)
            local size, sizeReason = input:size()
            assert(size ~= nil, sizeReason?.message)
            local chunk, failure = input:read(size + 1)
            assert(chunk ~= nil, failure)
            assert(#chunk == size, "snapshot changed during the read")
            bytes = chunk
        end
        local world = bindings.requireWorld()
        local prelude = world:loadSnapshot(bytes)

        return {
            path = args.path,
            bytes = #bytes,
            version = prelude.version,
            entities = prelude.entityCount,
            archetypes = prelude.archetypeCount
        }
    end,
    true
)

-- The sampler outlives the tool call that starts it, so it lives in a managed
-- cell this slot holds the alias to. `profile_stop` takes the session back out.
local session: alias(profile.SampleSession)? = nil
register(
    "profile_start",
    "Start the Nupp process sampler with an optional zone filter.",
    function(args: {[string]: any}): {[string]: any}
        assert(session == nil, "a tool sampling session is already running")
        local interval = math.floor(args.intervalMs or 10) as integer
        const owner = nupp.manage(profile.sample({intervalMs = interval, zone = args.zone}))
        session = owner:alias()
        -- Custody passes to the module slot until `profile_stop` takes it.
        @unsafe nupp.release(owner)

        return {running = true, intervalMs = interval, zone = args.zone}
    end,
    true,
    true
)
register(
    "profile_stop",
    "Stop the tool sampler and write collapsed stacks.",
    function(args: {[string]: any}): {[string]: any}
        local running = session
        assert(running ~= nil, "no tool sampling session is running")
        local destination = artifact(args.name or "profile.collapsed")
        session = nil
        const taken, problem = running:take()
        if taken == nil then
            error(tostring(problem), 0)
        end
        local report = taken:stop()
        nupp.drop(taken)
        local ok, reason = files.writeAtomic(destination, report.text)
        assert(ok, reason?.message)

        return {path = destination, samples = report.samples, stacks = report.stacks, bytes = #report.text}
    end,
    true,
    true
)

-------------------------------------------------------------------------------
-- Audio for agents
--
-- An agent cannot hear, so the console is reported as data: a snapshot, the
-- event log, and recordings summarized as numbers. A memory output, or a void
-- one held by `clock_pause`, makes all of it deterministic.
-------------------------------------------------------------------------------

local function requireMixer(): audio.Audio
    return assert(audio.of(bindings.requireWorld()), "no audio mixer installed")
end

--- Returns a table of numbers or nested tables JSON can carry as an array.
local function arrayOf(values: {any}): any
    return #values == 0 and json.EMPTY_ARRAY or values
end

register(
    "audio_snapshot",
    "Report the audio console as data: the output clock and status, master, groups, sounding voices and counters.",
    function(_args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local status = mixer:output()
        local groups: {any} = {}
        for _, name in ipairs(mixer:groups()) do
            groups[
                #groups + 1
            ] = {
                name = name,
                gain = mixer:groupGain(name),
                muted = mixer:groupMuted(name),
                paused = mixer:groupPaused(name)
            }
        end
        local voices: {any} = {}
        for _, info in ipairs(mixer:voiceList()) do
            voices[
                #voices + 1
            ] = {
                handle = info.handle,
                sound = info.clip,
                gain = info.gain,
                pitch = info.pitch,
                group = info.group,
                paused = info.paused,
                stopping = info.stopping,
                loop = info.loop
            }
        end
        local stats = mixer:stats()
        local meters = mixer:meters()

        local function meter(reading: audio.Meter?): any
            if reading == nil then
                return nil
            end

            return {peak = reading.peak, rms = reading.rms, clipped = reading.clipped}
        end

        local function chain(effects: {audio.Effect}): any
            local names: {any} = {}
            for _, effect in ipairs(effects) do
                names[#names + 1] = {id = effect.id, name = effect.name}
            end

            return arrayOf(names)
        end

        local buses: {any} = {}
        for _, bus in ipairs(mixer:buses()) do
            buses[
                #buses + 1
            ] = {
                name = bus.name,
                id = bus.id,
                parent = bus:parent(),
                gain = bus:gain(),
                muted = bus:muted(),
                paused = bus:paused(),
                effects = chain(bus:effects()),
                meter = bus.id == 0 and meter(meters.master) or meter(meters.buses[bus.name])
            }
        end
        local tracks: {any} = {}
        for _, track in ipairs(mixer:tracks()) do
            local x, y, z = track:position()
            tracks[
                #tracks + 1
            ] = {
                id = track.id,
                bus = track:bus(),
                gain = track:gain(),
                muted = track:muted(),
                solo = track:solo(),
                sounding = track:sounding(),
                polyphony = track:polyphony(),
                position = x ~= nil and {x, y, z} or nil,
                sends = track:sends(),
                effects = chain(track:effects()),
                meter = meter(meters.tracks[track.id])
            }
        end
        local lines: {any} = {}
        for index, line in ipairs(mixer:timelines()) do
            lines[
                #lines + 1
            ] = {
                index = index,
                now = line:now(),
                tempo = line:tempo(),
                paused = line:paused(),
                pending = line:pending(),
                upcoming = arrayOf(line:upcoming(8))
            }
        end

        return {
            buses = arrayOf(buses),
            tracks = arrayOf(tracks),
            timelines = arrayOf(lines),
            now = mixer:now(),
            frequency = mixer:frequency(),
            output = {state = status.state, drops = status.drops, reopens = status.reopens, reason = status.reason},
            available = mixer.available,
            master = {gain = mixer:masterGain(), muted = mixer:muted()},
            groups = arrayOf(groups),
            voices = arrayOf(voices),
            stats = stats
        }
    end
)
register(
    "audio_events",
    "Return the audio event log: starts, refusals, stops and finishes with their output-clock time. Pass the last "
    .. "sequence seen as `after` to get only newer entries.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local entries: {any} = {}
        for _, entry in ipairs(mixer:events(args.after and integer(args.after) or nil)) do
            entries[
                #entries + 1
            ] = {
                sequence = entry.sequence,
                time = entry.time,
                event = entry.event,
                handle = entry.handle,
                sound = entry.sound,
                group = entry.group,
                reason = entry.reason
            }
        end

        return {events = arrayOf(entries)}
    end
)
register(
    "audio_listen",
    "Start recording the next `seconds` of the mix. On a memory output, or a void one held by clock_pause, the "
    .. "recording fills as clock_step grants frames; on a device, as it plays.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local started = mixer:listen(args.seconds)
        assert(started, "this audio backend cannot record")

        return {listening = true, seconds = args.seconds, now = mixer:now()}
    end,
    true
)
register(
    "audio_listening",
    "Summarize the recording audio_listen started: peak, RMS, LUFS, clipped samples, silent spans and onset times. "
    .. "`save` names a WAV file under the writable root to write it to.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local summary = mixer:listening()
        assert(summary ~= nil, "nothing is being recorded; call audio_listen first")
        local saved: string? = nil
        if args.save ~= nil then
            local target = artifact(args.save)
            local ok, reason = mixer:saveListening(target)
            assert(ok, reason)
            saved = target
        end
        local silent: {any} = {}
        for _, span in ipairs(summary.silent) do
            silent[#silent + 1] = span
        end

        return {
            frames = summary.frames,
            seconds = summary.seconds,
            started = summary.started,
            peak = summary.peak,
            peakDbfs = summary.peakDbfs,
            rms = summary.rms,
            rmsDbfs = summary.rmsDbfs,
            lufs = summary.lufs,
            clipped = summary.clipped,
            silent = arrayOf(silent),
            onsets = arrayOf(summary.onsets),
            saved = saved
        }
    end,
    true
)
register(
    "audio_step",
    "Render `seconds` of the mix on a memory output, or a void one held by clock_pause, without running a frame.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local rendered = mixer:step(args.seconds)

        return {rendered = rendered, now = mixer:now()}
    end,
    true
)

register(
    "audio_control",
    "Set a Bus or a Track's controls: `bus` names a Bus (\"master\" is Master), `track` gives a Track id; then any of "
    .. "`gain`, `muted`, `solo` (Track), `paused` (Bus).",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        if args.bus ~= nil then
            local bus = mixer:bus(args.bus)
            if args.gain ~= nil then
                bus:setGain(args.gain)
            end
            if args.muted ~= nil then
                bus:setMuted(args.muted)
            end
            if args.paused == true then
                bus:pause()
            elseif args.paused == false then
                bus:resume()
            end
            mixer:flush()

            return {bus = bus.name, gain = bus:gain(), muted = bus:muted(), paused = bus:paused()}
        end
        assert(args.track ~= nil, "give a bus name or a track id")
        local found: audio.Track? = nil
        for _, track in ipairs(mixer:tracks()) do
            if track.id == integer(args.track) then
                found = track
            end
        end
        local track = assert(found, "no track has that id")
        if args.gain ~= nil then
            track:setGain(args.gain)
        end
        if args.muted ~= nil then
            track:setMuted(args.muted)
        end
        if args.solo ~= nil then
            track:setSolo(args.solo)
        end
        mixer:flush()

        return {track = track.id, gain = track:gain(), muted = track:muted(), solo = track:solo()}
    end,
    true
)
register(
    "audio_play",
    "Play a loaded clip, by the path it was loaded from, on a Bus's default Track or a Track id, optionally at a "
    .. "time on the audio clock.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local found: audio.Clip? = nil
        for _, clip in ipairs(mixer:clips()) do
            if clip.path == args.path then
                found = clip
            end
        end
        local clip = assert(found, "no clip was loaded from that path")
        local options: audio.PlayOptions = {gain = args.gain, at = args.at}
        if args.track ~= nil then
            for _, track in ipairs(mixer:tracks()) do
                if track.id == integer(args.track) then
                    options.track = track
                end
            end
            assert(options.track ~= nil, "no track has that id")
        elseif args.bus ~= nil and args.bus ~= "master" then
            options.group = args.bus
        end
        local handle = mixer:play(clip, options)
        mixer:flush()

        return {handle = handle, started = handle ~= 0, now = mixer:now()}
    end,
    true
)
register(
    "audio_timeline",
    "Pause, resume, seek (to `beat`) or retempo (`tempo` in bpm) one of the mixer's Timelines, by its index in "
    .. "audio_snapshot.",
    function(args: {[string]: any}): {[string]: any}
        local mixer = requireMixer()
        local line = assert(mixer:timelines()[integer(args.index)], "no timeline has that index")
        local action = args.action
        if action == "pause" then
            line:pause()
        elseif action == "resume" then
            line:resume()
        elseif action == "seek" then
            line:seek(assert(args.beat, "seek needs a beat"))
        elseif action == "tempo" then
            line:setTempo(assert(args.tempo, "tempo needs a tempo"))
        else
            error("action must be pause, resume, seek or tempo", 0)
        end

        return {now = line:now(), tempo = line:tempo(), paused = line:paused(), pending = line:pending()}
    end,
    true
)

-------------------------------------------------------------------------------
-- The simulation clock
--
-- `clock_pause`, `clock_step`, `clock_resume` and `clock_info` reach the
-- application's pause, step and queue state only, never the world, so they run
-- while a frame is parked and after a crash. A harness polls `clock_info` until
-- `settled` rather than retrying a refused world tool.
-------------------------------------------------------------------------------

--- Holds or releases the bound world's audio clock, when there is one: a void
--- or memory output then moves only with the frames the clock grants.
local function holdAudio(held: boolean): nil
    local world = bindings.world()
    local mixer = world and audio.of(world)
    if mixer ~= nil then
        mixer:hold(held)
    end
end

local function clockInfo(): {[string]: any}
    local app = bindings.requireApplication()
    local parked = registry.parkedCall()
    local steps = app:pendingSteps()

    return {
        paused = app.paused,
        frame = app.frame,
        elapsed = app.elapsed,
        pendingSteps = steps,
        pendingEvents = app:pendingEvents(),
        stepDt = app:stepDelta(),
        parked = parked,
        settled = app.paused and steps == 0 and not parked
    }
end

register(
    "clock_info",
    "Report whether the simulation is paused, the frame count, granted frames still to run, and whether a frame is "
    .. "parked mid-flight. `settled` is true once a paused clock has run every granted frame.",
    function(_args: {[string]: any}): {[string]: any}
        return clockInfo()
    end,
    false,
    true
)
register(
    "clock_pause",
    "Hold the simulation: host turns run no system and fold no input until clock_step grants frames or clock_resume "
    .. "releases it. Rendering continues.",
    function(_args: {[string]: any}): {[string]: any}
        local app = bindings.requireApplication()
        app:pause()
        -- A void or memory output's clock follows the granted frames too.
        holdAudio(true)

        return clockInfo()
    end,
    true,
    true
)
register(
    "clock_step",
    "Grant frames to a paused simulation, one per host turn, each with a fixed delta instead of the wall clock.",
    function(args: {[string]: any}): {[string]: any}
        local app = bindings.requireApplication()
        if not app.paused then
            error("not_paused: the clock is running; call clock_pause before clock_step", 0)
        end
        app:step(integer(args.frames or 1), args.dt or 1 / 60)

        return clockInfo()
    end,
    true,
    true
)
register(
    "clock_resume",
    "Let the simulation run on the host's measured delta again, discarding granted frames not yet run.",
    function(_args: {[string]: any}): {[string]: any}
        local app = bindings.requireApplication()
        app:resume()
        holdAudio(false)
        return clockInfo()
    end,
    true,
    true
)

-------------------------------------------------------------------------------
-- Screenshots
--
-- The host reads back a frame only after it renders one, so a tool call can
-- only request a capture. The server writes each finished capture from its
-- next poll, and `screenshot_info` reports it.
-------------------------------------------------------------------------------

local type Shot = {
    id: integer,
    path: string,
    capture: screenshot.Capture?,
    ready: boolean,
    saved: boolean,
    reason: string?,
    width: integer,
    height: integer,
    bytes: integer
}

local shots: {[integer]: Shot} = {}
local waiting: {Shot} = {}
local shotSerial: integer = 0

--- Writes every requested screenshot whose frame the host has read back.
---
--- `tecs.mcp.poll` calls this once per poll, so a capture lands on disk on the
--- turn after the host renders it whether or not anyone asks.
export function settleCaptures(): nil
    if #waiting == 0 then
        return
    end
    local still: {Shot} = {}
    for _, shot in ipairs(waiting) do
        local capture = shot.capture
        if capture ~= nil and capture.ready then
            shot.capture = nil
            local _, width, height = screenshot.pixels(capture)
            local png, failure = screenshot.encode(capture)
            if png == nil then
                shot.reason = failure
            else
                local saved, reason = screenshot.save(capture, shot.path)
                shot.saved = saved
                shot.reason = reason
                shot.width, shot.height, shot.bytes = width, height, #png
            end
            shot.ready = true
        else
            still[#still + 1] = shot
        end
    end
    waiting = still
end

local function shotInfo(borrows shot: Shot): {[string]: any}
    return {
        id = shot.id,
        path = shot.path,
        ready = shot.ready,
        saved = shot.saved,
        reason = shot.reason ?? json.NULL,
        width = shot.width,
        height = shot.height,
        bytes = shot.bytes
    }
end

register(
    "screenshot",
    "Capture the next rendered frame to a PNG under the writable root or at an absolute path. Returns at once with "
    .. "the capture's id and path; screenshot_info reports when the file is written.",
    function(args: {[string]: any}): {[string]: any}
        local destination: string
        if args.path ~= nil then
            assert(path.newPath(args.path):isAbsolute(), "screenshot path must be absolute")
            destination = args.path
        else
            destination = artifact(args.name or "screenshot.png")
        end
        shotSerial = shotSerial + 1
        const shot: Shot = {
            id = shotSerial,
            path = destination,
            capture = screenshot.request(),
            ready = false,
            saved = false,
            reason = nil,
            width = 0,
            height = 0,
            bytes = 0
        }
        shots[shot.id] = shot
        waiting[#waiting + 1] = shot

        return shotInfo(shot)
    end,
    true,
    true
)
register(
    "screenshot_info",
    "Report whether a requested screenshot has been written, with its size or why it failed.",
    function(args: {[string]: any}): {[string]: any}
        settleCaptures()
        local shot = shots[integer(args.id)]
        assert(shot ~= nil, "unknown screenshot: " .. tostring(args.id))

        return shotInfo(shot)
    end,
    false,
    true
)

local families: {
    [string]: boolean
} = {
    archetypes = true,
    resources = true,
    materials = true,
    camera = true,
    render = true,
    layers = true,
    physics = true,
    snapshot = true,
    profile = true,
    systems = true,
    states = true,
    clock = true,
    screenshot = true
}

local function groupOf(name: string): string
    local prefix = name:match("^([^_]+)_")
    return prefix ~= nil and families[prefix] and prefix or name
end

local function contract(tool: registry.Tool): {[string]: any}
    return {
        tool = tool.name,
        name = tool.name,
        description = tool.description,
        inputSchema = tool.inputSchema,
        outputSchema = tool.outputSchema,
        readOnly = tool.readOnly == true,
        destructive = tool.destructive == true
    }
end

local function describe(name: string): {[string]: any}
    local result: {[string]: any} = {name = name, section = "Tools", verbs = json.asArray({})}
    local verbs: {any} = {}
    for _, tool in ipairs(registry.listTools()) do
        if tool.name == name then
            result.action = contract(tool)
        elseif groupOf(tool.name) == name then
            verbs[#verbs + 1] = contract(tool)
        end
    end
    assert(result.action ~= nil or #verbs > 0, "unknown command: " .. name)
    result.verbs = json.asArray(verbs)

    return result
end

register(
    "describe",
    "Describe a command family or tool using the live registry.",
    function(args: {[string]: any}): {[string]: any}
        return describe(args.command)
    end,
    false,
    true
)
register(
    "help",
    "List available commands or describe one command family.",
    function(args: {[string]: any}): {[string]: any}
        if args.command ~= nil then
            return {command = describe(args.command)}
        end
        local seen: {[string]: boolean} = {}
        local commands: {any} = {}
        for _, tool in ipairs(registry.listTools()) do
            local name = groupOf(tool.name)
            if not seen[name] then
                commands[#commands + 1] = {name = name, signature = name, shortHelp = tool.description}
                seen[name] = true
            end
        end

        return {sections = json.asArray({{name = "Tools", commands = json.asArray(commands)}})}
    end,
    false,
    true
)
register(
    "capabilities",
    "Count available commands and tools from the live registry.",
    function(_args: {[string]: any}): {[string]: any}
        local groups: {[string]: boolean} = {}
        local count = 0
        local tools = registry.listTools()
        for _, tool in ipairs(tools) do
            local name = groupOf(tool.name)
            if not groups[name] then
                groups[name] = true
                count = count + 1
            end
        end

        return {commands = count, tools = #tools, sections = json.asArray({{name = "Tools", commands = count}})}
    end,
    false,
    true
)

--- Reports that the retained subsystem tools registered.
export function installed(): boolean
    return true
end
