module tecs.internal.query

--[[
A reusable archetype query over tag component signatures.

Queries retain signature matches, with separate active-only row and group lists.
Lifecycle notifications update those lists without scanning empty archetypes.
Temporary queries retain only their initial matches and scan their live row counts.
Generic-for cursors carry no allocated closure or query-owned iteration position.
]]

local archetype = require("tecs.internal.archetype")
local components = require("tecs.internal.components")
local entitycolumn = require("tecs.internal.entitycolumn")

--- Holds a query-owned group list reused by independent generic-for cursors.
export record GroupState
    items: {archetype.Archetype}
    positions: {[archetype.Archetype]: integer}
end

--- Advances an independent cursor without allocating iterator closures.
export type IterFn = function(
    state: Query,
    previous: archetype.Archetype?
): (archetype.Archetype?, integer?, entitycolumn.DoubleArray?)

--- Advances an independent cursor over one query-owned group.
export type GroupIterFn = function(
    state: GroupState,
    previous: archetype.Archetype?
): (archetype.Archetype?, integer?, entitycolumn.DoubleArray?)

--- Advances an independent cursor over sorted nonempty groups.
export type GroupsIterFn = function(state: Query, previous: integer?): integer?

--- Identifies the world that owns a query without retaining that world.
export record Owner
    token: boolean
end

--- Membership constraints, grouping and notifications for an archetype query.
export type Descriptor = {
    --- Caller-writable. Names this query for inspection.
    name: string?,

    --- Caller-writable. Excludes Paused for logic queries; nil behaves like render.
    type: ("logic" | "render")?,

    --- Caller-writable. Requires all listed components and overrides their automatic
    --- exclusions.
    include: const{components.Selector}?,

    --- Caller-writable. Requires at least one listed component; an empty list adds no
    --- constraint.
    includeAny: const{components.Selector}?,

    --- Caller-writable. Rejects every listed component.
    exclude: const{components.Selector}?,

    --- Caller-writable. Receives entering rows after publication, including initial
    --- members.
    onEntitiesAdded: MembershipCallback?,

    --- Caller-writable. Receives departing rows while their old values remain readable.
    onEntitiesRemoved: MembershipCallback?,

    --- Caller-writable. Retains only initially matching archetypes, with live rows, and
    --- forbids callbacks.
    temp: boolean?,

    --- Caller-writable. Assigns each matching archetype an integer group once.
    groupBy: (function(candidate: archetype.Archetype): integer)?
}

--- Receives a contiguous one-based row range entering or leaving a query.
export type MembershipCallback = function(
    candidate: archetype.Archetype,
    firstRow: integer,
    lastRow: integer,
    count: integer
)

--- A reusable query whose matching archetypes are updated by its world.
export record Query
    private owner: Owner?

    --- Read-only. Describes the normalized query; mutation after construction is
    --- unsupported.
    descriptor: Descriptor

    private include: {components.Component}
    private exclude: {components.Component}
    private includeAny: {components.Component}
    private active: {archetype.Archetype}
    private positions: {[archetype.Archetype]: integer}
    private lifecycle: archetype.EntityObserver?
    private matched: {[archetype.Archetype]: boolean}
    private groupIds: {integer}
    private groupPositions: {[integer]: integer}
    private grouped: {[integer]: GroupState}
    private archetypeGroups: {[archetype.Archetype]: integer}

    --- Iterates nonempty archetypes, in ascending group order when grouped.
    --- @param self The query to read.
    --- @return Returns an independent iterator yielding an archetype, count and live
    ---     entity column.
    iter: function(self: Query): (IterFn, Query, archetype.Archetype?)

    --- Iterates nonempty group identifiers in ascending order.
    --- @param self The query to read.
    --- @return Returns an independent iterator, empty for ungrouped queries.
    groups: function(self: Query): (GroupsIterFn, Query, integer?)

    --- Iterates nonempty archetypes in one group.
    --- @param self The query to read.
    --- @param groupId The integer group identifier.
    --- @return Returns an independent iterator yielding an archetype, count and live
    ---     entity column.
    group: function(self: Query, groupId: integer): (GroupIterFn, GroupState, archetype.Archetype?)

    --- Returns an archetype's assigned group.
    --- @param self The query to read.
    --- @param candidate The archetype to inspect.
    --- @return Returns nil when unmatched or ungrouped.
    getGroup: function(self: Query, candidate: archetype.Archetype): integer?

    --- Counts entities in one group.
    --- @param self The query to read.
    --- @param groupId The integer group identifier.
    --- @return Returns zero when the group is absent.
    getGroupCount: function(self: Query, groupId: integer): integer

    --- Counts all currently matching entities.
    --- @param self The query to read.
    --- @return Returns the committed entity count.
    count: function(self: Query): integer
end

--- Binds a query to its owning world's token.
--- @param value The query being registered.
--- @param owner The owning world's identity token.
export function bindOwner(value: Query, owner: Owner): nil
    value.owner = owner
end

--- Reports whether a query belongs to the selected world.
--- @param value The query to validate.
--- @param owner The world's identity token.
--- @return Returns true only for that world.
export function belongsTo(value: Query, owner: Owner): boolean
    return value.owner == owner
end

local function removeItem(
    items: {archetype.Archetype},
    positions: {[archetype.Archetype]: integer},
    candidate: archetype.Archetype
): nil
    const index = positions[candidate]
    if index == nil then
        return
    end
    const last = items[#items]
    items[index] = last
    positions[last] = index
    items[#items] = nil
    positions[candidate] = nil
end

local function deactivate(value: Query, candidate: archetype.Archetype): nil
    removeItem(value.active, value.positions, candidate)
    const group = value.archetypeGroups[candidate]
    if group ~= nil then
        const state = value.grouped[group]
        if state ~= nil then
            removeItem(state.items, state.positions, candidate)
            if #state.items == 0 and value.groupPositions[group] ~= nil then
                const position = assert(value.groupPositions[group])
                table.remove(value.groupIds, position)
                value.groupPositions[group] = nil
                for index = position, #value.groupIds do
                    value.groupPositions[value.groupIds[index]] = index
                end
            end
        end
    end
end

local function activate(value: Query, candidate: archetype.Archetype): nil
    if value.positions[candidate] ~= nil or not value.matched[candidate] then
        return
    end
    value.active[#value.active + 1] = candidate
    value.positions[candidate] = #value.active
    const group = value.archetypeGroups[candidate]
    if group ~= nil then
        const state = assert(value.grouped[group])
        if #state.items == 0 then
            local position: integer = 1
            while position <= #value.groupIds and value.groupIds[position] < group do
                position = position + 1
            end
            table.insert(value.groupIds, position, group)
            for index = position, #value.groupIds do
                value.groupPositions[value.groupIds[index]] = index
            end
        end
        state.items[#state.items + 1] = candidate
        state.positions[candidate] = #state.items
    end
end

--- Releases an empty archetype permanently removed by world maintenance.
--- @param value The query to update.
--- @param candidate The empty archetype to forget.
export function removeArchetype(value: Query, candidate: archetype.Archetype): nil
    if not value.matched[candidate] then
        return
    end
    deactivate(value, candidate)
    value.matched[candidate] = nil
    value.archetypeGroups[candidate] = nil
end

--- Creates a query with no active archetypes yet.
--- @param descriptor the include and exclude constraints
--- @param filterStates Whether to apply Disabled and logic Paused exclusions.
--- @return the reusable query
export function new(descriptor: Descriptor?, filterStates: boolean?): Query
    const source = descriptor or {}
    if source.type ~= nil and source.type ~= "logic" and source.type ~= "render" then
        error("query type must be logic or render", 2)
    end
    if source.temp and (source.onEntitiesAdded ~= nil or source.onEntitiesRemoved ~= nil) then
        error("temporary queries cannot have membership callbacks", 2)
    end
    const include = components.selectAll(source.include)
    const exclude = components.selectAll(source.exclude)
    const includeAny = components.selectAll(source.includeAny)
    if filterStates then
        const automatic = source.type == "logic" and {components.Disabled, components.Paused} or {components.Disabled}
        for index = 1, #automatic do
            const component = automatic[index]
            local explicit = false
            for position = 1, #include do
                if include[position] == component then
                    explicit = true
                end
            end
            if not explicit then
                exclude[#exclude + 1] = component
            end
        end
    end

    const result = new Query(
        descriptor = {
            name = source.name,
            type = source.type,
            include = include,
            includeAny = includeAny,
            exclude = exclude,
            onEntitiesAdded = source.onEntitiesAdded,
            onEntitiesRemoved = source.onEntitiesRemoved,
            temp = source.temp,
            groupBy = source.groupBy
        },
        include = include,
        exclude = exclude,
        includeAny = includeAny,
        active = {},
        positions = {},
        matched = {},
        groupIds = {},
        groupPositions = {},
        grouped = {},
        archetypeGroups = {}
    )
    if not source.temp then
        result.lifecycle = {
            onActivated = function(_observer: archetype.EntityObserver, candidate: archetype.Archetype): nil
                activate(result, candidate)
            end,
            onDeactivated = function(_observer: archetype.EntityObserver, candidate: archetype.Archetype): nil
                deactivate(result, candidate)
            end,
            onArchetypeDestroyed = function(_observer: archetype.EntityObserver, candidate: archetype.Archetype): nil
                removeArchetype(result, candidate)
            end
        }
    end

    return result
end

--- Reports whether an archetype satisfies a query.
--- @param value the query to inspect
--- @param candidate the archetype to test
--- @return whether every constraint is satisfied
export function matches(value: Query, candidate: archetype.Archetype): boolean
    for index = 1, #value.include do
        if not archetype.has(candidate, value.include[index]) then
            return false
        end
    end
    for index = 1, #value.exclude do
        if archetype.has(candidate, value.exclude[index]) then
            return false
        end
    end

    if #value.includeAny > 0 then
        for index = 1, #value.includeAny do
            if archetype.has(candidate, value.includeAny[index]) then
                return true
            end
        end
        return false
    end

    return true
end

--- Adds an archetype when it satisfies the query.
--- @param value the query to update
--- @param candidate the newly registered archetype
export function addArchetype(value: Query, candidate: archetype.Archetype): nil
    if value.matched[candidate] or not matches(value, candidate) then
        return
    end
    value.matched[candidate] = true
    const groupBy = value.descriptor.groupBy
    if groupBy ~= nil then
        const id = groupBy(candidate)
        value.archetypeGroups[candidate] = id
        local state = value.grouped[id]
        if state == nil then
            state = new GroupState(items = {}, positions = {})
            value.grouped[id] = state
        end
    end
    if value.lifecycle ~= nil then
        candidate:addEntityObserver(value.lifecycle)
    end
    if #candidate.entities > 0 or value.descriptor.temp then
        activate(value, candidate)
    end
    const added = value.descriptor.onEntitiesAdded
    if added ~= nil and #candidate.entities > 0 then
        added(candidate, 1, #candidate.entities, #candidate.entities)
    end
end

local function groupStep(
    state: GroupState,
    previous: archetype.Archetype?
): (archetype.Archetype?, integer?, entitycolumn.DoubleArray?)
    local index = previous ~= nil and (state.positions[previous] or #state.items) + 1 or 1
    while index <= #state.items do
        const candidate = state.items[index]
        if #candidate.entities > 0 then
            return candidate, #candidate.entities, candidate.entities
        end
        index = index + 1
    end

    return nil, nil, nil
end

local function iterStep(
    state: Query,
    previous: archetype.Archetype?
): (archetype.Archetype?, integer?, entitycolumn.DoubleArray?)
    if state.descriptor.groupBy ~= nil then
        const priorGroup = previous ~= nil and state.archetypeGroups[previous] or nil
        for index = priorGroup ~= nil and (state.groupPositions[priorGroup] or 1) or 1, #state.groupIds do
            const id = state.groupIds[index]
            if priorGroup == nil or id >= priorGroup then
                const candidate, count, entities = groupStep(
                    assert(state.grouped[id]),
                    id == priorGroup and previous or nil
                )
                if candidate ~= nil then
                    return candidate, count, entities
                end
            end
        end
        return nil, nil, nil
    end
    local index = previous ~= nil and (state.positions[previous] or #state.active) + 1 or 1
    while index <= #state.active do
        const candidate = state.active[index]
        if #candidate.entities > 0 then
            return candidate, #candidate.entities, candidate.entities
        end
        index = index + 1
    end

    return nil, nil, nil
end

function Query.iter(self: Query): (IterFn, Query, archetype.Archetype?)
    return iterStep, self, nil
end

const emptyGroup = new GroupState(items = {}, positions = {})

function Query.group(self: Query, groupId: integer): (GroupIterFn, GroupState, archetype.Archetype?)
    return groupStep, self.grouped[groupId] or emptyGroup, nil
end

function Query.getGroup(self: Query, candidate: archetype.Archetype): integer?
    return self.archetypeGroups[candidate]
end

function Query.getGroupCount(self: Query, groupId: integer): integer
    const state = self.grouped[groupId]
    local total: integer = 0
    if state ~= nil then
        const items = state.items
        for index = 1, #items do
            total = total + #items[index].entities
        end
    end

    return total
end

function Query.count(self: Query): integer
    local total: integer = 0
    for index = 1, #self.active do
        total = total + #self.active[index].entities
    end

    return total
end

local function groupsStep(state: Query, previous: integer?): integer?
    for index = previous ~= nil and (state.groupPositions[previous] or #state.groupIds) + 1 or 1, #state.groupIds do
        const id = state.groupIds[index]
        if (previous == nil or id > previous) and state:getGroupCount(id) > 0 then
            return id
        end
    end

    return nil
end

function Query.groups(self: Query): (GroupsIterFn, Query, integer?)
    return groupsStep, self, nil
end

--- Delivers a membership change, suppressing moves wholly inside the query.
--- @param value The subscribed query.
--- @param candidate The readable archetype that gains or loses the rows.
--- @param other The opposite archetype of a move, or nil for a lifetime change.
--- @param firstRow The one-based first affected row.
--- @param count The number of affected rows.
--- @param added Whether the rows enter rather than leave.
export function notify(
    value: Query,
    candidate: archetype.Archetype,
    other: archetype.Archetype?,
    firstRow: integer,
    count: integer,
    added: boolean
): nil
    if not value.matched[candidate] or (other ~= nil and value.matched[other]) then
        return
    end
    local callback = value.descriptor.onEntitiesRemoved
    if added then
        callback = value.descriptor.onEntitiesAdded
    end
    if callback ~= nil then
        callback(candidate, firstRow, firstRow + count - 1, count)
    end
end
