module tecs.internal.hostcancellation

--[[
Recognizes the cancellation that unwinds a frame parked during host shutdown.

`nupp.host.pump` raises it inside the parked operation when the host cancels
the pump. Application guards rethrow it rather than recording a crash, so the
operation unwinds through its cleanup instead of presenting a failure.
]]

local cancellation = require("nupp.suspension.cancellation")

--- Reports whether a caught value is a cancellation, such as the host pump's.
export function is(value: any): boolean
    return cancellation.is(value)
end
