module tecs.internal.meshpacket

local world = require("tecs.internal.world")
local query = require("tecs.internal.query")
local archetype = require("tecs.internal.archetype")
local components = require("tecs.internal.components")
local mesh = require("tecs.internal.meshcomponents")
local rendercomponents = require("tecs.internal.rendercomponents")
local camera3d = require("tecs.gfx.camera3d")

const observed: {
    components.Component
} = {
    mesh.Transform3DComponent,
    mesh.Bounds3DComponent,
    mesh.MeshComponent,
    mesh.MeshMaterialComponent,
    mesh.MeshSkinComponent,
    mesh.MeshMorphComponent,
    rendercomponents.TintComponent
}
local record Run
    values: {integer}
    structure: integer
    seen: integer
end
export record Collector
    private lights: tecs.internal.meshlights.Collector
    private query: query.Query
    private versions: {[integer]: Run} = {}
    private revision: integer = 0
    private visit: integer = 0
    private payload: string = ""
    currentRevision: function(borrows self: Collector): integer
    frame: function(
        exclusive self: Collector,
        width: integer,
        height: integer,
        camera: camera3d.Camera3D,
        lighting: tecs.gfx.meshes.Lighting,
        resident: integer
    ): string
end
export function new(exclusive value: world.World): Collector
    return new Collector(
        lights = tecs.internal.meshlights.new(value),
        query = value:newQuery({
            include = {mesh.Transform3DComponent, mesh.MeshComponent, mesh.Renderable3D},
            exclude = {components.Disabled}
        })
    )
end

local function changed(exclusive self: Collector): boolean
    self.visit = self.visit + 1
    local dirty = self.revision == 0
    for candidate, count in self.query:iter() do
        const active = candidate as archetype.Archetype
        local previous = self.versions[active.id]
        if previous == nil then
            previous = new Run(values = {}, structure = -1, seen = 0)
            self.versions[active.id] = previous
        end
        previous.seen = self.visit
        const structure = active:structuralCount()
        if previous.structure ~= structure then
            dirty = true
            previous.structure = structure
        end
        for index, component in ipairs(observed) do
            const version = active:writeCount(component)
            if previous.values[index] ~= version then
                dirty = true
                previous.values[index] = version
            end
        end
    end
    for id, previous in pairs(self.versions) do
        if previous.seen ~= self.visit then
            dirty = true
            self.versions[id] = nil
        end
    end

    return dirty
end

local function collect(exclusive self: Collector): string
    local buffer, palette = nupp.io.newBuffer(), nupp.io.newBuffer()
    local writer, paletteWriter = nupp.io.newScalarWriter(buffer), nupp.io.newScalarWriter(palette)
    local count: integer = 0
    local paletteCount: integer = 0
    unsafe do
        for candidate, size in self.query:iter() do
            const active = candidate as archetype.Archetype
            const transforms = assert(active:get(mesh.Transform3DComponent))
            const geometries = assert(active:get(mesh.MeshComponent))
            const bounds = assert(active:get(mesh.Bounds3DComponent))
            const tints = assert(active:get(rendercomponents.TintComponent))
            const materials = active:get(mesh.MeshMaterialComponent)
            const skins = active:get(mesh.MeshSkinComponent)
            const morphs = active:get(mesh.MeshMorphComponent)
            for index = 1, size as integer do
                const geometry = geometries[index]
                const transform, bound, tint = transforms[index], bounds[index], tints[index]
                local material = new mesh.MeshMaterial()
                if materials ~= nil then
                    material.model = materials[index].model
                    material.index = materials[index].index
                end
                const skin = skins ~= nil and skins[index].matrices or {}
                const morph = morphs ~= nil and morphs[index].weights or {}
                assert(#skin % 16 == 0, "mesh skin palette must contain complete matrices")
                for _, id in ipairs({
                    active.entities[index],
                    geometry.model,
                    geometry.index,
                    material.model,
                    material.index,
                    0,
                    0,
                    0
                }) do
                    writer:writeUint32(nupp.math.u32.wrap(id))
                end
                for _, value in ipairs({
                    transform.x,
                    transform.y,
                    transform.z,
                    0,
                    transform.rotationX,
                    transform.rotationY,
                    transform.rotationZ,
                    transform.rotationW,
                    transform.scaleX,
                    transform.scaleY,
                    transform.scaleZ,
                    0,
                    tint.r,
                    tint.g,
                    tint.b,
                    tint.a,
                    bound.centerX,
                    bound.centerY,
                    bound.centerZ,
                    bound.radius
                }) do
                    assert(value == value and math.abs(value) < math.huge, "mesh instance values must be finite")
                    writer:writeFloat32(nupp.math.f32.narrow(value))
                end
                writer:writeUint32(nupp.math.u32.wrap(paletteCount))
                writer:writeUint32(nupp.math.u32.wrap(#skin // 16))
                writer:writeUint32(nupp.math.u32.wrap(paletteCount + #skin))
                writer:writeUint32(nupp.math.u32.wrap(#morph))
                for _, value in ipairs(skin) do
                    paletteWriter:writeFloat32(nupp.math.f32.narrow(value))
                end
                for _, value in ipairs(morph) do
                    paletteWriter:writeFloat32(nupp.math.f32.narrow(value))
                end
                paletteCount = paletteCount + #skin + #morph
                count = count + 1
            end
        end
    end
    writer:drop()
    paletteWriter:drop()
    local output = nupp.io.newBuffer()
    local prefix = nupp.io.newScalarWriter(output)
    prefix:writeUint32(nupp.math.u32.wrap(count)):writeUint32(nupp.math.u32.wrap(paletteCount))
    prefix:writeBytes(buffer:getString()):writeBytes(palette:getString())
    prefix:drop()
    const result = output:getString()
    output:drop()
    buffer:drop()
    palette:drop()

    return result
end

local record Settings
    values: {[string]: any} = {}
    probe: {number} = {}
    bytes: string = ""
end
local settingsCache: {[tecs.gfx.meshes.Lighting]: Settings} = setmetatable({}, {
    __mode = "k"
}) as {[tecs.gfx.meshes.Lighting]: Settings}
local function settingsOf(lighting: tecs.gfx.meshes.Lighting): string
    local saved = settingsCache[lighting]
    if saved == nil then
        saved = new Settings()
        settingsCache[lighting] = saved
    end
    local changed = saved.bytes == "" or #saved.probe ~= #lighting.probe
    for key, value in pairs(lighting as {[string]: any}) do
        if key ~= "probe" and saved.values[key] ~= value then
            saved.values[key] = value
            changed = true
        end
    end
    for key in pairs(saved.values) do
        if (lighting as {[string]: any})[key] == nil then
            saved.values[key] = nil
            changed = true
        end
    end
    for index, value in ipairs(lighting.probe) do
        if saved.probe[index] ~= value then
            changed = true
        end
    end
    if changed then
        saved.bytes = nupp.data.json.encode(lighting)
        saved.probe = {}
        for index, value in ipairs(lighting.probe) do
            saved.probe[index] = value
        end
    end

    return saved.bytes
end

function Collector.frame(
    exclusive self: Collector,
    width: integer,
    height: integer,
    camera: camera3d.Camera3D,
    lighting: tecs.gfx.meshes.Lighting,
    resident: integer
): string
    const dirty = changed(self)
    if dirty then
        self.revision = self.revision + 1
        self.payload = collect(self)
    end
    local buffer = nupp.io.newBuffer()
    local writer = nupp.io.newScalarWriter(buffer)
    const retained = resident == self.revision
    writer:writeUint32(nupp.math.u32.wrap(0x544D5348)):writeUint32(nupp.math.u32.wrap(2))
    writer:writeUint32(nupp.math.u32.wrap(self.revision)):writeUint32(nupp.math.u32.wrap(retained and 1 or 0))
    const matrix = camera:matrix(width, height)
    for lane = 0, 15 do
        writer:writeFloat32(nupp.math.f32.narrow(assert(matrix[lane])))
    end
    for _, value in ipairs({camera.x, camera.y, camera.z, 0}) do
        writer:writeFloat32(nupp.math.f32.narrow(value))
    end
    const settings = settingsOf(lighting)
    writer:writeUint32(nupp.math.u32.wrap(#settings)):writeBytes(settings)
    writer:writeBytes(string.rep("\0", (4 - #settings % 4) % 4))
    const lights = self.lights:frame()
    writer:writeUint32(nupp.math.u32.wrap(#lights)):writeBytes(lights)
    if not retained then
        writer:writeBytes(self.payload)
    end
    writer:drop()
    const result = buffer:getString()
    buffer:drop()

    return result
end

function Collector.currentRevision(borrows self: Collector): integer
    return self.revision
end
