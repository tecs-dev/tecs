module tecs.internal.components

--[[
Process-wide component definitions and registration.

Component identity is permanent and shared by every world. A component's
associated `Value` type describes what its archetype column contains. Tags use
their own singleton as the value, while scalar components store raw Lua
primitives and use a small wrapper only at spawn and set boundaries.
]]

local componentids = require("tecs.internal.componentids")
local snapshotvalue = require("tecs.internal.snapshotvalue")

--- A registered component definition.
export interface Component
    associated type Value = self

    componentId: integer
    componentName: string
    storageType: string
    transient: boolean
end

--- A marker component with no per-entity column.
export record TagComponent is Component
    componentId: integer
    componentName: string
    storageType: string
    transient: boolean
end

--- A scalar component whose committed column stores raw primitive values.
export record ScalarComponent<T> is Component
    associated type Value = T

    componentId: integer
    componentName: string
    storageType: string
    transient: boolean
    scalarKind: "number" | "boolean" | "string"
    scalarDefault: T
    metamethod __call: function(self, value: T): ScalarInstance<T>
end

--- A scalar value carried only across a spawn or set boundary.
export record ScalarInstance<T>
    componentType: ScalarComponent<T>
    value: T
end

--- A table component whose committed column stores record values.
export interface TableComponent<T> is Component
    associated type Value == T

    componentId: integer
    componentName: string
    storageType: string
    transient: boolean
    construct: function(...: any): T
    defaultFactory: function(): T
    snapshotSave: function(value: T): any
    snapshotLoad: function(value: any): T
    metamethod __call: function(self, ...: any): TableInstance<T>
end

--- A table value carried only across a spawn or set boundary.
export record TableInstance<T>
    componentType: TableComponent<T>
    value: T
end

--- The committed value of an exclusive entity relationship.
export record RelationshipValue
    target: integer
end

--- A one-target-per-source relationship component.
export record RelationshipComponent is Component
    associated type Value = RelationshipValue

    componentId: integer
    componentName: string
    storageType: string
    transient: boolean
    exclusive: boolean
    reverseIndex: boolean
    cascadeDelete: boolean
    metamethod __call: function(self, target: integer): RelationshipInstance
end

--- A relationship value carried across a spawn or set boundary.
export record RelationshipInstance
    componentType: RelationshipComponent
    value: RelationshipValue
end

--- A component definition or value supplied at a mutation boundary.
export type Input = Component | ScalarInstance<any> | TableInstance<any> | RelationshipInstance

--- Options for a marker component with no per-entity value.
export type TagComponentOptions = {
    name: string,
    transient: boolean?,
    requires: {Component}?
}

--- Options for a number-valued scalar component.
export type NumberComponentOptions = {
    name: string,
    kind: "number",
    default: number?,
    transient: boolean?
}

--- Options for a boolean-valued scalar component.
export type BooleanComponentOptions = {
    name: string,
    kind: "boolean",
    default: boolean?,
    transient: boolean?
}

--- Options for a string-valued scalar component.
export type StringComponentOptions = {
    name: string,
    kind: "string",
    default: string?,
    transient: boolean?
}

export type ScalarComponentOptions = NumberComponentOptions | BooleanComponentOptions | StringComponentOptions

--- The kind-correlated scalar component factory.
export type NewScalarComponent = function(NumberComponentOptions): ScalarComponent<number>
    & function(BooleanComponentOptions): ScalarComponent<boolean>
    & function(StringComponentOptions): ScalarComponent<string>

--- Options for a record-valued component.
export type TableComponentOptions<T> = {
    name: string,
    construct: function(...: any): T,
    default: function(): T,
    save: (function(value: T): any)?,
    load: (function(value: any): T)?,
    transient: boolean?,
    requires: {Component}?
}

--- Options for an exclusive target relationship.
export type RelationshipOptions = {
    name: string,
    exclusive: boolean,
    reverseIndex: boolean?,
    cascadeDelete: boolean?,
    transient: boolean?
}

local registeredByName: {[string]: Component} = {}
local registeredById: {[integer]: Component} = {}
local registeredRelationships: {RelationshipComponent} = {}

local function validateName(name: string, caller: string): nil
    if name == "" then
        error(caller .. ": name must not be empty", 3)
    end
    if registeredByName[name] ~= nil then
        error("Component " .. name .. " already registered", 3)
    end
end

local function register<C is Component>(component: C): C
    registeredByName[component.componentName] = component
    registeredById[component.componentId] = component
    return component
end

ScalarComponent.__call = function<T>(self: ScalarComponent, value: T): ScalarInstance<T>
    return new ScalarInstance(componentType = self as ScalarComponent<T>, value = value)
end

RelationshipComponent.__call = function(self: RelationshipComponent, target: integer): RelationshipInstance
    return new RelationshipInstance(componentType = self, value = new RelationshipValue(target = target))
end

--- What each component pulls in with it, by component id.
---
--- A component may name others it cannot be meaningful without, and a mutation
--- that adds it adds those too. `RelativeTransform2D` names `Transform2D`
--- because a relative transform composes onto a local one, and an entity
--- carrying only the first would be silently skipped by the system that reads
--- both.
local requiredBy: {[integer]: {Component}} = {}

--- The flattened transitive closure of each component's requirements, built on
--- first use because most components have none and a spawn should not pay for
--- the walk twice.
local closureBy: {[integer]: {Component}} = {}

--- Records what a component requires, replacing any earlier list.
--- @param component the component that pulls the others in
--- @param required what it pulls in, which may itself require more
export function setRequires(component: Component, required: {Component}): nil
    requiredBy[component.componentId] = required
    closureBy = {}
end

--- Returns everything a component pulls in, transitively and deduplicated.
---
--- The list excludes the component itself and is the caller's to read, not to
--- keep: it is cached and shared. A cycle terminates, since a component
--- already visited is not walked again.
--- @param component the component to resolve
--- @return the components a mutation adding this one must also add
export function requiresClosure(component: Component): {Component}
    local cached = closureBy[component.componentId]
    if cached ~= nil then
        return cached
    end
    local entries: {Component} = {}
    local seen: {[integer]: boolean} = {[component.componentId] = true}
    local pending: {Component} = {component}
    local index: integer = 1
    while index <= #pending do
        local current = pending[index]
        index = index + 1
        local direct = requiredBy[current.componentId]
        if direct ~= nil then
            for position = 1, #direct do
                local required = direct[position]
                if not seen[required.componentId] then
                    seen[required.componentId] = true
                    entries[#entries + 1] = required
                    pending[#pending + 1] = required
                end
            end
        end
    end
    closureBy[component.componentId] = entries

    return entries
end

--- Creates and permanently registers a tag component.
--- @param options the process-unique component name and snapshot policy
--- @return the registered component
--- @raises when the name is empty or already registered
export function newTagComponent(options: TagComponentOptions): TagComponent
    local name = options.name
    validateName(name, "newTagComponent")
    local component = register(
        new TagComponent(
            componentId = componentids.allocate(),
            componentName = name,
            storageType = "tag",
            transient = options.transient == true
        )
    )
    local required = options.requires
    if required ~= nil then
        setRequires(component, required)
    end

    return component
end

local function createScalar<T>(
    name: string,
    kind: "number" | "boolean" | "string",
    defaultValue: T,
    transient: boolean
): ScalarComponent<T>
    validateName(name, "newScalarComponent")
    return register(
        new ScalarComponent(
            componentId = componentids.allocate(),
            componentName = name,
            storageType = "scalar",
            transient = transient,
            scalarKind = kind,
            scalarDefault = defaultValue
        )
    )
end

local function createScalarComponent(options: ScalarComponentOptions): ScalarComponent<any>
    local defaultValue: any = options.default
    if defaultValue == nil then
        if options.kind == "number" then
            defaultValue = 0
        elseif options.kind == "boolean" then
            defaultValue = false
        else
            defaultValue = ""
        end
    end

    return createScalar(options.name, options.kind, defaultValue, options.transient == true)
end

--- Creates and permanently registers a primitive-valued scalar component.
--- @param options the name, primitive kind, default, and snapshot policy
--- @return the registered scalar component
--- @raises when the name is empty or already registered
export const newScalarComponent: NewScalarComponent = createScalarComponent as NewScalarComponent

--- Creates and permanently registers a record-valued component.
--- @param options the name, positional constructor, default factory, and snapshot
---     policy
--- @return the registered table component
--- @raises when the name is empty or already registered
export function newComponent<T>(options: TableComponentOptions<T>): TableComponent<T>
    validateName(options.name, "newComponent")
    if (options.save == nil) ~= (options.load == nil) then
        error("newComponent: snapshot save and load must be provided together", 2)
    end
    local save = options.save
    local load = options.load
    if save == nil then
        save = function(value: T): any
            return snapshotvalue.clone(value)
        end
        load = function(value: any): T
            local restored = snapshotvalue.clone(value)
            if type(restored) == "table" then
                local prototype = options.default()
                setmetatable(restored as table, getmetatable(prototype as any))
            end

            return restored as T
        end
    end
    local component: TableComponent<T>
    component = setmetatable(
        {
            componentId = componentids.allocate(),
            componentName = options.name,
            storageType = "table",
            transient = options.transient == true,
            construct = options.construct,
            defaultFactory = options.default,
            snapshotSave = save,
            snapshotLoad = assert(load)
        },
        {
            __call = function(self: TableComponent<T>, ...: any): TableInstance<T>
                return new TableInstance(componentType = self, value = self.construct(...))
            end,
        }
    ) as TableComponent<T>
    -- An interface may extend another interface without itself being a
    -- concrete implementor, so the registry erases only at this storage seam.
    registeredByName[component.componentName] = component as Component
    registeredById[component.componentId] = component as Component
    local required = options.requires
    if required ~= nil then
        setRequires(component as Component, required)
    end

    return component
end

--- Creates an exclusive entity relationship.
--- @param options the relationship identity and reverse-index behavior
--- @return the callable relationship component
--- @raises when cascade deletion lacks a reverse index
export function newRelationship(options: RelationshipOptions): RelationshipComponent
    validateName(options.name, "newRelationship")
    if not options.exclusive then
        error("newRelationship: only exclusive relationships are implemented", 2)
    end
    if options.cascadeDelete == true and options.reverseIndex ~= true then
        error("newRelationship: cascadeDelete requires reverseIndex = true", 2)
    end
    local relationship = new RelationshipComponent(
        componentId = componentids.allocate(),
        componentName = options.name,
        storageType = "relationship",
        transient = options.transient == true,
        exclusive = true,
        reverseIndex = options.reverseIndex == true,
        cascadeDelete = options.cascadeDelete == true
    )
    registeredRelationships[#registeredRelationships + 1] = relationship

    return register(relationship)
end

--- Returns the definition carried by a mutation input.
--- @param input the component definition or scalar wrapper
--- @return the registered component definition
export function definitionOf(input: Input): Component
    if input is ScalarInstance<any> then
        return input.componentType
    end
    if input is TableInstance<any> then
        return input.componentType
    end
    if input is RelationshipInstance then
        return input.componentType
    end

    return input
end

--- Returns an input's scalar payload and whether it supplied one.
--- @param input the component definition or scalar wrapper
--- @return the raw payload and whether the input was a wrapper
export function explicitValue(input: Input): any, boolean
    if input is ScalarInstance<any> then
        return input.value, true
    end
    if input is TableInstance<any> then
        return input.value, true
    end
    if input is RelationshipInstance then
        return input.value, true
    end

    return nil, false
end

--- Returns a component's default committed value.
--- @param component the component definition
--- @return the scalar default or the tag singleton
export function defaultValue<C is Component>(component: C): C.Value
    if component is ScalarComponent<any> then
        return component.scalarDefault as C.Value
    end
    if component.storageType == "table" then
        local tableComponent = component as TableComponent<any>
        return tableComponent.defaultFactory() as C.Value
    end
    if component.storageType == "relationship" then
        error("Relationship " .. component.componentName .. " requires a target", 2)
    end

    return component as C.Value
end

--- Returns a component as a relationship when it carries that storage kind.
--- @param component the component to inspect
--- @return the relationship component, or nil for another storage kind
export function asRelationship(component: Component): RelationshipComponent?
    if component.storageType == "relationship" then
        return component as RelationshipComponent
    end
    return nil
end

--- Returns the process-wide relationship definitions.
--- @return the internal registry view
export function relationships(): {RelationshipComponent}
    return registeredRelationships
end

--- Stores a durable unique name for one entity.
---
--- Compatibility surface: the component is named `Key` rather than
--- `EntityKey`, which is the name the public module publishes it under. A
--- snapshot records the component name, so the stored spelling is `Key` and
--- must stay that way however the public name reads.
---
--- At most one live entity may carry a given key. The world maintains a
--- key-to-entity index and rejects a second claim, which is what makes
--- `World.byKey` a lookup rather than a search.
export const Key: ScalarComponent<string> = newScalarComponent({name = "Key", kind = "string"})

--- Names an entity for a human reader.
---
--- Compatibility surface: a snapshot records a component by name, so the stored
--- spelling is `Name` and must stay that way.
---
--- A name is neither indexed nor unique, and two entities may share one. Use
--- `Key` when a lookup has to resolve exactly one entity.
export const Name: ScalarComponent<string> = newScalarComponent({name = "Name", kind = "string"})

--- Relates one child entity to its parent.
---
--- Compatibility surface: a snapshot records a relationship by name, so the
--- stored spelling is `ChildOf` and must stay that way.
---
--- The relationship is exclusive, so a child has one parent and setting a new
--- target reparents it at the next barrier rather than adding a second edge. It
--- is reverse indexed, which is what makes `World.relationshipSources` a lookup
--- of a parent's children rather than a scan. It cascades, so despawning a
--- parent despawns every descendant beneath it in the same barrier.
export const ChildOf: RelationshipComponent = newRelationship({
    name = "ChildOf",
    exclusive = true,
    reverseIndex = true,
    cascadeDelete = true,
})

--- Marks an entity whose state is paused.
export const Paused: TagComponent = newTagComponent({name = "Paused"})

--- Marks an entity disabled by a state policy.
export const Disabled: TagComponent = newTagComponent({name = "Disabled"})

--- Returns the component registered under an id.
--- @param id the process-wide component id
--- @return the component, or nil when the id is unknown
export function findById(id: integer): Component?
    return registeredById[id]
end

--- Returns the component registered under a name.
--- @param name the process-wide component name
--- @return the component, or nil when the name is unknown
export function findByName(name: string): Component?
    return registeredByName[name]
end

--- Returns a fresh name-to-component snapshot of the registry.
--- @return the caller-owned registry snapshot
export function declared(): {[string]: Component}
    local result: {[string]: Component} = {}
    for name, component in pairs(registeredByName) do
        result[name] = component
    end

    return result
end
