module tecs.gfx.layers

--[[
Depth bands, sorting, coordinate spaces, parallax, and lighting.

A layer occupies one of sixteen depth bands. Entities sort inside their own
band and never against another band, so a heads-up display on layer 8 covers a
world on layer 1. Extraction turns a layer, a height, and a world position into
one depth from zero to one, with zero nearest.

```nupp
tecs.gfx.layers.configure(1, {sort = "topdown", parallax = 0.4})
tecs.gfx.layers.configure(8, {sort = "z", screenSpace = true, unlit = true, overlay = true})

world:spawn(
    tecs.ecs.Transform2D(16, 16, 0, 8, 0, 96, 24),
    tecs.gfx.Tint(1, 1, 1, 1),
    tecs.gfx.Renderable2D
)
```

The fourth `Transform2D` argument selects the layer.

The table is process-wide, in the same way component identity is, because one
process drives one renderer and a scene's authored depth order cannot differ
between two worlds in it.

`setExtents` names the authored ranges each sort normalizes against. A scene
reaching past an extent still draws, resting on the edge, and stops sorting
against its neighbors there.

# Coordinate spaces

World coordinates are the default. `screenSpace` measures a position in target
pixels and ignores the camera, which is what a heads-up display wants.
`virtualCoords` measures it in the one authored resolution `setVirtualSize`
names and stretches that resolution to fill the target. `ignoreZoom` follows
the camera's position while keeping the drawn size, and `parallax` scales how
far the camera carries the contents. `place` resolves all four into one target
pixel, and one layer cannot combine `screenSpace` with `virtualCoords`.

`unlit` marks contents that bypass scene lighting, and `overlay` marks contents
that always take the sorted forward lane. Both reach a renderer through
`entryOf` and `isOverlay` rather than changing anything this module computes.
]]

--- The number of bands that divide the depth range.
---
--- Load-bearing at sixteen. The band formula divides the range by it and a
--- consumer recovers a layer by multiplying a depth by it, so raising it
--- changes every depth a scene has ever recorded.
export const MAX: integer = 16

--- Selects how a layer orders its own contents.
---
--- These identifiers reach configuration a developer writes and are a
--- compatibility surface.
export type Sort = "topdown" | "z" | "isometric"

--- Defines everything a layer decides about its contents.
---
--- A field left out takes its default, so this says what a layer is rather
--- than amending what it was. `sort` is the one field a caller must set;
--- `screenSpace`, `ignoreZoom`, `virtualCoords`, `unlit`, and `overlay`
--- default to false, and `parallax` defaults to one.
export type Config = {
    sort: Sort,
    screenSpace: boolean?,
    ignoreZoom: boolean?,
    virtualCoords: boolean?,
    unlit: boolean?,
    overlay: boolean?,
    parallax: number?
}

--- Sorts lower screen positions in front and breaks ties with height.
export const SORT_TOPDOWN: integer = 0

--- Sorts only by height and ignores world position.
export const SORT_Z: integer = 1

--- Sorts by x plus y plus height for a diamond grid.
export const SORT_ISOMETRIC: integer = 2

--- Positions contents in world units, through the camera.
---
--- This value is the first component of what `entryOf` reports, which a
--- renderer packs into a uniform the vertex stage compares against, so it is a
--- compatibility surface rather than an identifier this tree renumbers.
export const MODE_CAMERA: number = 0.0

--- Positions contents in target pixels, ignoring the camera.
export const MODE_SCREEN: number = 1.0

--- Positions contents in the authored virtual resolution, stretched to the
--- target.
export const MODE_VIRTUAL: number = 2.0

--- How much of its band a sort spreads across, leaving a sliver so the far
--- end of one band never reaches the near end of the next.
const BAND_FILL = 0.99

--- How the topdown sort divides that span between its two inputs. Height
--- carries most of it and position breaks the ties, which is what makes a
--- character standing on a crate read as on top of it.
const TOPDOWN_Z_SHARE = 0.7

const TOPDOWN_Y_SHARE = 0.3

--- The range the isometric sum covers: a normalized x, a normalized y, and a
--- normalized height, each zero to one.
const ISOMETRIC_RANGE = 3.0

const sin, cos = math.sin, math.cos

local sortIds: {[string]: integer} = {topdown = SORT_TOPDOWN, z = SORT_Z, isometric = SORT_ISOMETRIC,}

--- Per-layer state, one array a column, because the four float columns are
--- what a renderer packs into a uniform.
---
--- Defaults are what a scene wants before anyone has said otherwise: sorted
--- top-down, positioned by the camera, moving with the world, lit, and culled
--- against the camera's view.
local sorts: {integer} = {}

local modes: {number} = {}

--- What the camera's position is multiplied by before it is added to a world
--- position: one minus parallax, which is zero when contents move with the
--- world and so costs an unconditional add nothing.
local parallaxOffsets: {number} = {}

local parallaxFactors: {number} = {}
local zoomFlags: {number} = {}
local litFlags: {number} = {}
local overlayFlags: {boolean} = {}
local culledByView: {boolean} = {}

for index = 1, MAX do
    sorts[index] = SORT_TOPDOWN
    modes[index] = MODE_CAMERA
    parallaxOffsets[index] = 0.0
    parallaxFactors[index] = 1.0
    zoomFlags[index] = 0.0
    litFlags[index] = 1.0
    overlayFlags[index] = false
    culledByView[index] = true
end

local maxZ = 1000.0
local maxY = 10000.0
local virtualWidth = 1920.0
local virtualHeight = 1080.0
local generation: integer = 0

--- A normalized sort term, with anything past either end resting on it.
---
--- Every sort divides a position by the extent this module was told to expect,
--- and a scene reaching past that extent has to stop sorting rather than carry
--- a depth out of its band: a consumer recovers a layer by multiplying a depth
--- by `MAX`, so a term outside zero and one would hand the geometry another
--- layer's band. Losing the order between two entities off the edge of the
--- expected extent is the smaller of those two failures by a wide margin.
local function saturate(value: number): number
    if value < 0.0 then
        return 0.0
    end
    if value > 1.0 then
        return 1.0
    end

    return value
end

--- Sets what one layer does with its contents.
---
--- Replaces the layer's configuration rather than amending it, so every
--- omitted field takes its default instead of keeping its previous value.
--- @param layer the band to configure, from one to `MAX`
--- @param config the complete replacement configuration
--- @raises when the layer is outside the band range, when the sort is unknown,
---     or when one layer asks for screen pixels and virtual coordinates at once
export function configure(layer: integer, config: Config): nil
    if layer < 1 or layer > MAX then
        error("gfx.layers.configure: layer " .. tostring(layer) .. " is outside 1.." .. tostring(MAX), 2)
    end
    local sort = sortIds[config.sort as string]
    if sort == nil then
        error("gfx.layers.configure: '" .. tostring(config.sort) .. "' is not a sort mode", 2)
    end
    if config.screenSpace == true and config.virtualCoords == true then
        error("gfx.layers.configure: a layer is positioned in screen pixels or in virtual coordinates, not both", 2)
    end

    const parallax = config.parallax ?? 1.0
    local mode = MODE_CAMERA
    if config.screenSpace == true then
        mode = MODE_SCREEN
    elseif config.virtualCoords == true then
        mode = MODE_VIRTUAL
    end

    sorts[layer] = sort
    modes[layer] = mode
    parallaxOffsets[layer] = 1.0 - parallax
    parallaxFactors[layer] = parallax
    zoomFlags[layer] = config.ignoreZoom == true and 1.0 or 0.0
    litFlags[layer] = config.unlit == true and 0.0 or 1.0
    overlayFlags[layer] = config.overlay == true
    -- The cull tests a world rectangle against a world bound, which only means
    -- something where the camera places the contents where the bound says.
    culledByView[layer] = mode == MODE_CAMERA and parallax == 1.0 and config.ignoreZoom ~= true
    generation = generation + 1
end

--- Returns a layer's sort as the identifier `depthIn` accepts.
--- @param layer the band to read, from one to `MAX`
--- @return the sort identifier, which is an internal number rather than a `Sort` string
export function sortOf(layer: integer): integer
    return sorts[layer] or SORT_TOPDOWN
end

--- Returns the configuration revision.
--- @return a count starting at zero that only rises, so a consumer holding a
---     packed copy can tell whether its copy is still the answer
export function revision(): integer
    return generation
end

--- Returns the authored extents every sort normalizes against.
--- @return the highest height a scene expects to use, then half the expected world
---     extent
export function extents(): number, number
    return maxZ, maxY
end

--- Replaces the authored extents every sort normalizes against.
---
--- Raising an extent lowers the depth difference one world unit is worth,
--- which is what `resolution` reports.
--- @param highestZ the highest height a scene expects to use
--- @param halfExtent half the expected world extent, used by the position terms
--- @raises when either extent is not greater than zero
export function setExtents(highestZ: number, halfExtent: number): nil
    if not (highestZ > 0.0) then
        error("gfx.layers.setExtents: the height extent must be greater than zero", 2)
    end
    if not (halfExtent > 0.0) then
        error("gfx.layers.setExtents: the world extent must be greater than zero", 2)
    end
    maxZ = highestZ
    maxY = halfExtent
    generation = generation + 1
end

--- Returns the authored resolution every virtual-coordinate layer is measured
--- in.
--- @return the authored width, then the authored height, both in virtual units
export function virtualSize(): number, number
    return virtualWidth, virtualHeight
end

--- Replaces the authored resolution every virtual-coordinate layer is measured
--- in.
---
--- One resolution serves every such layer, because a game has one authored
--- layout size. `place` scales it to fill the target, so the layout keeps its
--- internal proportions at any window size and stretches with the window's
--- aspect. It neither letterboxes nor preserves square pixels.
--- @param width the authored width in virtual units
--- @param height the authored height in virtual units
--- @raises when either dimension is not greater than zero
export function setVirtualSize(width: number, height: number): nil
    if not (width > 0.0) or not (height > 0.0) then
        error("gfx.layers.setVirtualSize: both dimensions must be greater than zero", 2)
    end
    virtualWidth = width
    virtualHeight = height
    generation = generation + 1
end

--- Returns the four numbers that position and light one layer.
---
--- A consumer packs these together when `revision` changes rather than reading
--- them per frame, which is why they come back together.
--- @param layer the band to read; outside one to `MAX` this answers the
---     defaults an unconfigured layer carries rather than raising
--- @return the positioning mode, then the camera position's multiplier, then
---     one when the layer ignores zoom, then one when the layer is lit
export function entryOf(layer: integer): number, number, number, number
    if layer < 1 or layer > MAX then
        return MODE_CAMERA, 0.0, 0.0, 1.0
    end

    return modes[layer], parallaxOffsets[layer], zoomFlags[layer], litFlags[layer]
end

--- Returns whether the camera's view rectangle decides if a layer draws.
---
--- False on a layer the camera does not place where its world bound says.
--- Screen-space and virtual-coordinate contents have no world position for the
--- view to test, and parallax and zoom independence draw them somewhere the
--- bound does not describe. Extraction gives those contents a bound every view
--- contains, so they draw whatever the camera is looking at, and a layer using
--- none of these modes keeps exact culling.
--- @param layer the band to read; outside one to `MAX` this answers true, as an
---     unconfigured layer does
--- @return whether extraction should write this layer's real world bound
export function viewCulled(layer: integer): boolean
    if layer < 1 or layer > MAX then
        return true
    end

    return culledByView[layer]
end

--- Returns whether a layer measures positions in target pixels.
--- @param layer the band to read; outside one to `MAX` this answers false, as an
---     unconfigured layer does
--- @return whether `configure` selected `screenSpace` for the layer
export function isScreenSpace(layer: integer): boolean
    if layer < 1 or layer > MAX then
        return false
    end

    return modes[layer] == MODE_SCREEN
end

--- Returns whether a layer always takes the sorted forward lane.
--- @param layer the band to read; outside one to `MAX` this answers false, as an
---     unconfigured layer does
--- @return whether `configure` selected `overlay` for the layer
export function isOverlay(layer: integer): boolean
    if layer < 1 or layer > MAX then
        return false
    end

    return overlayFlags[layer]
end

--- Returns how much of the camera's movement a layer's contents take.
--- @param layer the band to read; outside one to `MAX` this answers one, as an
---     unconfigured layer does
--- @return the parallax factor, one moving contents with the world and a half
---     drifting them at half speed
export function parallaxOf(layer: integer): number
    if layer < 1 or layer > MAX then
        return 1.0
    end

    return parallaxFactors[layer]
end

--- Returns where one authored position lands on the render target.
---
--- The one place the four positioning modes are resolved, so a caller placing
--- geometry and a caller hit-testing it cannot disagree. A camera layer turns
--- and scales the position about the view center, taking parallax before the
--- turn and dropping the zoom afterwards when the layer ignores it. A
--- screen-space layer answers the position unchanged, and a virtual layer
--- scales the authored resolution onto the target.
--- @param layer the band whose mode decides what the position means; outside one
---     to `MAX` this places through the camera, as an unconfigured layer does
--- @param x the authored horizontal position, in world units, target pixels, or
---     virtual units according to the layer's mode
--- @param y the authored vertical position, running down in every mode
--- @param cameraX the view center's world x, read only by a camera layer
--- @param cameraY the view center's world y, read only by a camera layer
--- @param zoom the camera's zoom, read only by a camera layer that does not
---     ignore it
--- @param rotation the camera's rotation in radians, read only by a camera layer
--- @param width the render target width in pixels
--- @param height the render target height in pixels
--- @return the pixels from the target's left edge, then the pixels from its top
---     edge; neither is clamped to the target
export function place(
    layer: integer,
    x: number,
    y: number,
    cameraX: number,
    cameraY: number,
    zoom: number,
    rotation: number,
    width: number,
    height: number
): number, number
    local index = layer
    if index < 1 then
        index = 1
    elseif index > MAX then
        index = MAX
    end

    const mode = modes[index]
    if mode == MODE_SCREEN then
        return x, y
    end
    if mode == MODE_VIRTUAL then
        return x * width / virtualWidth, y * height / virtualHeight
    end

    -- Parallax shifts the position instead of building a second camera. The
    -- projection is affine, so moving a point by (1 - parallax) times the view
    -- center scales how far the camera carried it and changes nothing else.
    const offset = parallaxOffsets[index]
    const dx = x + offset * cameraX - cameraX
    const dy = y + offset * cameraY - cameraY
    const c = cos(rotation)
    const s = sin(rotation)
    -- A layer that ignores zoom keeps the camera's position and rotation and
    -- drops its scale, which is the drawn size staying put while the contents
    -- move with the world.
    const scale = zoomFlags[index] ~= 0.0 and 1.0 or zoom

    return width * 0.5 + (dx * c + dy * s) * scale, height * 0.5 + (-dx * s + dy * c) * scale
end

--- Returns the two terms `depthIn` takes, resolved once for one layer.
---
--- A caller writing many depths on one layer resolves the band once here
--- rather than once a row.
--- @param layer the band to resolve; outside one to `MAX` this resolves the
---     nearest layer whole, so the sort answered is the clamped layer's
--- @return the band's near edge, then the sort identifier
export function bandOf(layer: integer): number, integer
    local index = layer
    if index < 1 then
        index = 1
    elseif index > MAX then
        index = MAX
    end

    return (MAX - index) * (1.0 / MAX), sorts[index] or SORT_TOPDOWN
end

--- Returns one entity's depth on a band `bandOf` already resolved.
--- @param base the band's near edge, from `bandOf`
--- @param sort the sort identifier, from `bandOf`
--- @param z the height in the sort, normalized against the height extent
--- @param x the world x, read only by the isometric sort
--- @param y the world y, read by the topdown and isometric sorts, larger being nearer
--- @return a depth inside the band, held between 0.001 and 0.999
export function depthIn(base: number, sort: integer, z: number, x: number, y: number): number
    const band = 1.0 / MAX
    const nz = saturate(z / maxZ)

    local within: number
    if sort == SORT_Z then
        within = (1.0 - nz) * band * BAND_FILL
    elseif sort == SORT_ISOMETRIC then
        const extent = 2.0 * maxY
        const nx = saturate((x + maxY) / extent)
        const ny = saturate((y + maxY) / extent)
        within = (1.0 - (nx + ny + nz) / ISOMETRIC_RANGE) * band * BAND_FILL
    else
        const ny = saturate((y + maxY) / (2.0 * maxY))
        within = (1.0 - (nz * TOPDOWN_Z_SHARE + ny * TOPDOWN_Y_SHARE)) * band * BAND_FILL
    end

    local depth = base + within
    if depth < 0.001 then
        return 0.001
    end
    if depth > 0.999 then
        return 0.999
    end

    return depth
end

--- Returns one entity's depth from zero to one, with zero nearest.
---
--- Exact ties carry no tie-breaker of their own. Extraction writes instances in
--- sorted order and the backend draws them in that order, so two entities at
--- one depth resolve the same way every frame: the later one wins.
--- @param layer the band, from one to `MAX`; outside that range this takes the
---     nearest layer whole, because a band is the only thing a depth can name
--- @param z the height in the sort, normalized against the height extent
--- @param x the world x, read only by the isometric sort
--- @param y the world y, read by the topdown and isometric sorts, larger being nearer
--- @return the depth inside the layer's own band
export function depthOf(layer: integer, z: number, x: number, y: number): number
    const base, sort = bandOf(layer)

    return depthIn(base, sort, z, x, y)
end

--- Returns the smallest depth difference `depthOf` produces between two
--- entities one world unit apart, taken over every sort mode.
---
--- A depth target must preserve this difference. A format with a larger step
--- keeps the bands, so layer order stays safe, and loses the sort inside them.
--- @return the depth difference, in the input that moves depth least
export function resolution(): number
    const span = (1.0 / MAX) * BAND_FILL
    const steps: {
        number
    } = {
        span * TOPDOWN_Z_SHARE / maxZ,
        span * TOPDOWN_Y_SHARE / (2.0 * maxY),
        span / maxZ,
        span / ISOMETRIC_RANGE / maxZ,
        span / ISOMETRIC_RANGE / (2.0 * maxY),
    }

    local finest = steps[1]
    for index = 2, #steps do
        if steps[index] < finest then
            finest = steps[index]
        end
    end

    return finest
end
