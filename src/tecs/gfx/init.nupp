module tecs.gfx

--[[
The public scene-rendering values a game spawns.

`Renderable3D` selects indexed meshes with `Transform3D`, `Mesh`, `Bounds3D`
and `MeshMaterial`. [Models](tecs.gfx.models) load shared glTF geometry and
independent animation poses. [Particles](tecs.gfx.particles) keep individual
particle state on the GPU; entities author their emitters. `View` selects
ordered 2D and 3D cameras.

`Tint`, `Sprite`, and `Renderable2D` accompany `tecs.ecs.Transform2D` on a
drawable entity, and `Camera2D` with `ActiveCamera` selects the view every
frame is projected through.

[`PreviousTransform2D`](tecs.ecs.PreviousTransform2D) opts an entity into
fixed-step presentation interpolation. The extractor blends position and the
shortest rotation arc using the world's residual fixed time. Lights and shadow
geometry use the same presented pose. Scale, depth and layer use current values,
and entities without history render directly from their current transform.
Physics seeds history automatically; an authored history should initially match
the entity's creation pose.

```nupp
const image = tecs.gfx.images.upload({name = "tiles/grass", width = 2, height = 2, pixels = grassRgba8})

world:spawn(tecs.gfx.Camera2D(320, 180, 1, 0), tecs.gfx.ActiveCamera)
world:spawn(
    tecs.ecs.Transform2D(320, 180, 0, 1, 0, 64, 64),
    tecs.gfx.Tint(1, 1, 1, 1),
    tecs.gfx.Sprite(image),
    tecs.gfx.Renderable2D
)
```

`tecs.gfx.lighting` owns the deferred lighting resolve, the two shadow
mechanisms, and optional bloom, and it is where `PointLight2D`, `Occluder2D`,
and `DropShadow2D` are documented. `tecs.gfx.layers` decides the order and
placement of those entities,
`tecs.gfx.images` owns image identity and residency, `tecs.gfx.clips` owns the
target-pixel regions `Clip` selects, `tecs.gfx.sheet` and `tecs.gfx.animation`
cut an image into frames and play them, `tecs.gfx.fonts` owns font identity and
the glyph atlas, `tecs.gfx.text` lays a string out into glyph entities that draw
through the same textured path a sprite does, `tecs.gpu.materials` numbers the
materials a `Material` selects, and `tecs.gpu.passes` declares the render passes
and render targets a frame is drawn through.
]]

local animation = require("tecs.gfx.animation")
local clips = require("tecs.gfx.clips")
local lighting = require("tecs.gfx.lighting")
local materials = require("tecs.gpu.materials")
local rendercomponents = require("tecs.internal.rendercomponents")
local fonts = require("tecs.gfx.fonts")
local text = require("tecs.gfx.text")

--- A four-channel color stored on a renderable entity.
export type Tint = rendercomponents.Tint

--- An image region stored on a renderable entity.
export type Sprite = rendercomponents.Sprite

--- A view onto the world, in world units and target pixels.
export type Camera2D = rendercomponents.Camera2D

--- Constructs a tint whose omitted channels default to one.
export const Tint = rendercomponents.TintComponent

--- Constructs a sprite whose omitted UV rectangle covers the whole image.
export const Sprite = rendercomponents.SpriteComponent

--- Constructs a camera centered on the world origin at zoom one.
export const Camera2D = rendercomponents.Camera2DComponent

--- Selects the camera entity extraction projects the scene through.
---
--- Extraction reads the lowest live entity carrying both `Camera2D` and this
--- tag. A world with no such entity draws through a camera centered on the
--- render target at zoom one, which places world unit and target pixel on top
--- of each other with the origin at the top left corner.
export const ActiveCamera = rendercomponents.ActiveCamera

--- Marks an entity as contributing geometry to the two-dimensional scene.
export const Renderable2D = rendercomponents.Renderable2D

--- A clip region selected by a renderable entity.
export type Clip = clips.Clip

--- Constructs a clip selecting a region set with `tecs.gfx.clips.setRegion`.
export const Clip = clips.ClipComponent

--- Sprite-sheet playback state stored on an entity.
export type Animation = animation.Animation

--- Constructs playback state directly. Prefer `tecs.gfx.animation.of`, which
--- resolves a sheet and a tag name for you.
export const Animation = animation.AnimationComponent

--- Requests `tecs.gfx.animation.Completed` and `tecs.gfx.animation.Looped` for
--- one entity.
export const AnimationEvents = animation.AnimationEvents

--- A loaded font and the atlas its glyphs live in.
export type Font = fonts.Font

--- A string laid out into glyph entities.
export type Text = text.Text

--- Loads a TrueType font and reads its metrics.
export const newTTF = fonts.newTTF

--- Constructs a text whose omitted fields default to an empty left-aligned
--- string at em size sixteen with no wrapping.
export const Text = text.TextComponent

--- Builds a text value that belongs to no entity, for measurement.
export const newText = text.newText

--- Marks an entity as one glyph `tecs.gfx.text` placed for a `Text`.
export const TextGlyph = text.TextGlyph

--- A light the deferred resolve accumulates.
export type PointLight2D = lighting.PointLight2D

--- Constructs a light at height sixty-four, reaching two hundred and fifty-six
--- world units, in white at full strength.
export const PointLight2D = lighting.PointLight2DComponent

--- A silhouette that blocks light, stored on a renderable entity.
export type Occluder2D = lighting.Occluder2D

--- Constructs an occluder at full height.
export const Occluder2D = lighting.Occluder2DComponent

--- A stretched ground shadow, stored on a renderable entity.
export type DropShadow2D = lighting.DropShadow2D

--- Constructs a drop-shadow caster at full height.
export const DropShadow2D = lighting.DropShadow2DComponent

--- A material selection stored on a renderable entity.
export type Material = materials.Material

--- Constructs a material selection, defaulting to `textured` at parameter
--- one quarter.
export const Material = materials.MaterialComponent

--- A native 16 by 16 grid of static atlas tiles.
export type TileChunk = tecs.internal.tilechunk.TileChunk

--- Constructs a tile chunk positioned by its top-left Transform2D.
export const TileChunk = tecs.internal.tilechunk.TileChunkComponent

--- Requests synchronization after a nested tile-array edit.
export const DirtyTileChunk = tecs.internal.tilechunk.DirtyTileChunk

--- The number of cells along a tile chunk edge.
export const TILE_CHUNK_SIZE = tecs.internal.tilechunk.SIZE

--- Describes an ordered viewport with its own camera. Explicit views replace
--- the synthesized full-frame camera; coordinates are fractions of the frame.
export type View = tecs.internal.views.View

--- Constructs a viewport from a camera and optional rectangle, order and enabled
--- fields.
export const View = tecs.internal.views.Component

--- Creates a camera value for a View or coordinate conversion outside an entity.
--- @param options The caller supplies world position, positive zoom and radians of
---     rotation.
--- @return The camera value, centered at zero with zoom one by default.
--- @raises When zoom is not positive or a value is not finite.
export function newCamera2D(options: {
    x: number?,
    y: number?,
    zoom: number?,
    rotation: number?
}?): Camera2D
    const value = options or {}
    const camera = new rendercomponents.Camera2D(value.x ?? 0, value.y ?? 0, value.zoom ?? 1, value.rotation ?? 0)
    assert(camera.zoom > 0, "camera zoom must be positive")
    for _, number in ipairs({camera.x, camera.y, camera.zoom, camera.rotation}) do
        assert(number == number and math.abs(number) < math.huge, "camera values must be finite")
    end

    return camera
end

--- Stores the Bounds3D data for one 3D primitive.
export type Bounds3D = tecs.internal.meshcomponents.Bounds3D

--- Constructs the Bounds3D component for a 3D primitive.
export const Bounds3D = tecs.internal.meshcomponents.Bounds3DComponent

--- Stores the Mesh data for one 3D primitive.
export type Mesh = tecs.internal.meshcomponents.Mesh

--- Constructs the Mesh component for a 3D primitive.
export const Mesh = tecs.internal.meshcomponents.MeshComponent

--- Stores the MeshMaterial data for one 3D primitive.
export type MeshMaterial = tecs.internal.meshcomponents.MeshMaterial

--- Constructs the MeshMaterial component for a 3D primitive.
export const MeshMaterial = tecs.internal.meshcomponents.MeshMaterialComponent

--- Stores the MeshSkin data for one 3D primitive.
export type MeshSkin = tecs.internal.meshcomponents.MeshSkin

--- Constructs the MeshSkin component for a 3D primitive.
export const MeshSkin = tecs.internal.meshcomponents.MeshSkinComponent

--- Stores the MeshMorph data for one 3D primitive.
export type MeshMorph = tecs.internal.meshcomponents.MeshMorph

--- Constructs the MeshMorph component for a 3D primitive.
export const MeshMorph = tecs.internal.meshcomponents.MeshMorphComponent

--- Marks geometry for the 3D renderer.
export const Renderable3D = tecs.internal.meshcomponents.Renderable3D

--- A perspective camera with quaternion orientation.
export type Camera3D = tecs.gfx.camera3d.Camera3D

--- Creates a right-handed perspective camera looking along negative Z.
export const newCamera3D = tecs.gfx.camera3d.newCamera3D

--- Omnidirectional mesh light positioned by Transform3D.
export type PointLight3D = tecs.internal.meshcomponents.PointLight3D

--- Constructs a point light with radius, linear RGB, intensity and LIGHT_* flags.
export const PointLight3D = tecs.internal.meshcomponents.PointLight3DComponent

--- Conical mesh light aimed along Transform3D local negative Z.
export type SpotLight3D = tecs.internal.meshcomponents.SpotLight3D

--- Constructs a spot light with radius, inner and outer half-angles in radians,
--- linear RGB, intensity and LIGHT_* flags.
export const SpotLight3D = tecs.internal.meshcomponents.SpotLight3DComponent

--- Requests a slot in the local-light shadow atlas.
export const LIGHT_CASTS_SHADOWS: integer = 1

--- Anchors a sprite at normalized X/Y coordinates or an authored sheet slice.
--- Use Sheet:pivot to keep animated slice anchors synchronized with the GPU frames.
export const Pivot = tecs.gfx.sheet.Pivot
