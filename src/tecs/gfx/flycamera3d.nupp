module tecs.gfx.flycamera3d

--[=[
A free-fly controller turns mouse and keyboard input into a 3D camera pose.

The controller is deliberately a camera tool rather than a character
controller. It has no gravity or collision, so render showcases and editor
views can move through large scenes without creating physics geometry. Click
the left mouse button to enter relative mouse mode, press Tab to release it,
and call `update` from a frame-phase system:

```nupp
const controller = tecs.gfx.flycamera3d.new(
    app.input, app.window, camera,
    {moveSpeed = 5, sprintMultiplier = 4}
)

world:addSystem({
    name = "game.FlyCamera",
    phase = tecs.ecs.phases.Update,
    run = function(dt: number)
        controller:update(dt)
    end,
})
```

WASD moves along the view, Q and E move down and up in world space, and Shift
multiplies the speed. The constructor caches physical scancodes, and `update`
allocates nothing.
]=]

local input = require("tecs.input")
local window = require("tecs.platform.window")
const {type Camera3D} = require("tecs.gfx.camera3d")

const sqrt, asin, atan2 = math.sqrt, math.asin, math.atan2
const sin, cos = math.sin, math.cos
const PI, TAU = math.pi, math.pi * 2.0

--- Defines optional free-fly camera behavior.
export type Options = {
    --- Caller-writable. Sets ordinary movement speed in world units per second
    --- and defaults to 5.
    moveSpeed: number?,

    --- Caller-writable. Multiplies movement speed while Shift is held and
    --- defaults to 4.
    sprintMultiplier: number?,

    --- Caller-writable. Sets radians of rotation per mouse-motion unit and
    --- defaults to 0.0025.
    lookSensitivity: number?,

    --- Caller-writable. Limits absolute pitch in radians and defaults to 89
    --- degrees.
    maxPitch: number?
}

--- Controls one perspective camera with relative mouse and keyboard input.
export record Controller
    --- Names the options accepted by `new`.

    --- Read-only. Refers to the camera whose pose `update` changes.
    camera: Camera3D

    --- Caller-writable. Sets ordinary movement speed in world units per second.
    moveSpeed: number

    --- Caller-writable. Multiplies movement speed while Shift is held.
    sprintMultiplier: number

    --- Caller-writable. Sets radians of rotation per mouse-motion unit.
    lookSensitivity: number

    --- Caller-writable. Limits absolute pitch in radians below pi divided by two.
    maxPitch: number

    --- Read-only. Reports the current left-right heading in radians.
    yaw: number

    --- Read-only. Reports the current up-down angle in radians.
    pitch: number

    --- Read-only. Reports whether this controller currently owns relative
    --- mouse input.
    captured: boolean

    --- Engine-owned. Retains the input state that `update` reads. Ordinary
    --- game code should ignore this field.
    _window: window.Window

    _input: input.Input

    --- Engine-owned. Caches the physical forward key. Ordinary game code
    --- should ignore this field.
    _forward: string

    --- Engine-owned. Caches the physical backward key. Ordinary game code
    --- should ignore this field.
    _backward: string

    --- Engine-owned. Caches the physical left key. Ordinary game code should
    --- ignore this field.
    _left: string

    --- Engine-owned. Caches the physical right key. Ordinary game code should
    --- ignore this field.
    _right: string

    --- Engine-owned. Caches the physical down key. Ordinary game code should
    --- ignore this field.
    _down: string

    --- Engine-owned. Caches the physical up key. Ordinary game code should
    --- ignore this field.
    _up: string

    --- Engine-owned. Caches the key that releases relative mouse mode.
    --- Ordinary game code should ignore this field.
    _release: string

    --- Creates a free-fly controller for one camera.
    --- @param source The application [`Input`](tecs.input.Input) remains owned by the
    ---     application and must
    ---     outlive the controller.
    --- @param camera The perspective [`Camera3D`](tecs.gfx.camera3d.Camera3D) remains
    ---     owned by the caller and receives
    ---     pose changes in place.
    --- @param options The caller omits this value to use the documented movement
    ---     defaults.
    --- @return A controller initialized from the camera's current forward direction.

    --- Requests or releases relative mouse mode.
    --- @param captured The caller passes true to hide and capture the pointer or false
    ---     to release it.
    --- @return Returns whether the platform reached the requested state.
    setCaptured: function(exclusive self: Controller, captured: boolean): boolean

    --- Applies this frame's input to the camera.
    ---
    --- A left click captures the pointer and returns without consuming the
    --- absolute motion that produced that click. Tab releases it. While
    --- captured, WASD moves along the view, Q and E move vertically, Shift
    --- sprints, and relative mouse motion changes yaw and pitch.
    --- @param dt The caller supplies a non-negative frame duration in seconds.
    update: function(exclusive self: Controller, dt: number): nil
end

local function checkedOptions(options: Options): number, number, number, number
    const moveSpeed = options.moveSpeed or 5.0
    const sprintMultiplier = options.sprintMultiplier or 4.0
    const lookSensitivity = options.lookSensitivity or 0.0025
    const maxPitch = options.maxPitch or math.rad(89.0)
    if moveSpeed <= 0.0 then
        error("Controller moveSpeed must be greater than zero", 3)
    end
    if sprintMultiplier < 1.0 then
        error("Controller sprintMultiplier must be at least one", 3)
    end
    if lookSensitivity <= 0.0 then
        error("Controller lookSensitivity must be greater than zero", 3)
    end
    if maxPitch <= 0.0 or maxPitch >= PI * 0.5 then
        error("Controller maxPitch must be greater than zero and less than pi divided by two", 3)
    end

    return moveSpeed, sprintMultiplier, lookSensitivity, maxPitch
end

export function new(source: input.Input, target: window.Window, camera: Camera3D, options: Options?): Controller
    if source == nil then
        error("Controller input is required", 2)
    end
    if camera == nil then
        error("Controller camera is required", 2)
    end
    options = options or {}
    local moveSpeed, sprintMultiplier, lookSensitivity, maxPitch = checkedOptions(options)

    local qx, qy, qz, qw = camera.rotationX, camera.rotationY, camera.rotationZ, camera.rotationW
    const magnitude = sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
    if magnitude == 0.0 then
        error("Controller camera rotation quaternion must not be zero", 2)
    end
    const inverseMagnitude = 1.0 / magnitude
    qx, qy, qz, qw = qx * inverseMagnitude, qy * inverseMagnitude, qz * inverseMagnitude, qw * inverseMagnitude

    const forwardX = -2.0 * (qx * qz + qy * qw)
    const rawForwardY = 2.0 * (qx * qw - qy * qz)
    const forwardY = math.max(-1.0, math.min(1.0, rawForwardY))
    const forwardZ = -(1.0 - 2.0 * (qx * qx + qy * qy))

    local self = new Controller(
        camera = camera,
        _input = source,
        _window = target,
        moveSpeed = moveSpeed,
        sprintMultiplier = sprintMultiplier,
        lookSensitivity = lookSensitivity,
        maxPitch = maxPitch,
        yaw = 0,
        pitch = 0,
        captured = false,
        _forward = "KeyW",
        _backward = "KeyS",
        _left = "KeyA",
        _right = "KeyD",
        _down = "KeyQ",
        _up = "KeyE",
        _release = "Tab"
    )
    self.camera = camera
    self.moveSpeed = moveSpeed
    self.sprintMultiplier = sprintMultiplier
    self.lookSensitivity = lookSensitivity
    self.maxPitch = maxPitch
    self.yaw = atan2(-forwardX, -forwardZ)
    self.pitch = asin(forwardY)
    self.captured = self._window:cursorGrab() == "locked"
    self._input = source

    return self
end

function Controller.setCaptured(exclusive self: Controller, captured: boolean): boolean
    self._window:setCursorVisible(not captured)
    self._window:setCursorGrab(captured and "locked" or "none")
    self.captured = captured
    return true
end

local function writeOrientation(exclusive self: Controller)
    const halfYaw, halfPitch = self.yaw * 0.5, self.pitch * 0.5
    const sinYaw, cosYaw = sin(halfYaw), cos(halfYaw)
    const sinPitch, cosPitch = sin(halfPitch), cos(halfPitch)
    self.camera.rotationX = cosYaw * sinPitch
    self.camera.rotationY = sinYaw * cosPitch
    self.camera.rotationZ = -sinYaw * sinPitch
    self.camera.rotationW = cosYaw * cosPitch
end

function Controller.update(exclusive self: Controller, dt: number): nil
    if dt < 0.0 then
        error("Controller update dt must not be negative", 2)
    end

    const source = self._input
    if not self.captured and source:mousePressed("left") then
        self:setCaptured(true)
        return
    end
    if self.captured and source:keyPressed(self._release) then
        self:setCaptured(false)
        return
    end

    self.captured = self._window:cursorGrab() == "locked"
    if not self.captured then
        return
    end

    self.yaw = (self.yaw - source.mouseDeltaX * self.lookSensitivity + PI) % TAU - PI
    self.pitch = math.max(
        -self.maxPitch,
        math.min(self.maxPitch, self.pitch - source.mouseDeltaY * self.lookSensitivity)
    )
    writeOrientation(self)

    const forward = (source:keyDown(self._forward) and 1 or 0) - (source:keyDown(self._backward) and 1 or 0)
    const side = (source:keyDown(self._right) and 1 or 0) - (source:keyDown(self._left) and 1 or 0)
    const vertical = (source:keyDown(self._up) and 1 or 0) - (source:keyDown(self._down) and 1 or 0)
    if forward == 0 and side == 0 and vertical == 0 then
        return
    end

    const cosPitch = cos(self.pitch)
    const forwardX, forwardY, forwardZ = -sin(self.yaw) * cosPitch, sin(self.pitch), -cos(self.yaw) * cosPitch
    const rightX, rightZ = cos(self.yaw), -sin(self.yaw)
    const moveX = forwardX * forward + rightX * side
    const moveY = forwardY * forward + vertical
    const moveZ = forwardZ * forward + rightZ * side
    const length = sqrt(moveX * moveX + moveY * moveY + moveZ * moveZ)
    if length == 0.0 then
        return
    end
    const speed = self.moveSpeed * (
        (source:keyDown("ShiftLeft") or source:keyDown("ShiftRight")) and self.sprintMultiplier or 1.0
    )
    const scale = speed * dt / length
    self.camera.x = self.camera.x + moveX * scale
    self.camera.y = self.camera.y + moveY * scale
    self.camera.z = self.camera.z + moveZ * scale
end
