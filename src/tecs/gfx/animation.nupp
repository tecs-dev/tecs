module tecs.gfx.animation

--[[
Fixed-step sprite-sheet playback.

A [`Sheet`](tecs.gfx.sheet.Sheet) divides one image into frames and
names frame spans with tags. An `Animation` selects a sheet and a tag and
carries the speed, the loop flag, and where the cycle has got to. Playback
advances on the fixed clock. The GPU resolves the shared frame table from the
entity's [`Sprite`](tecs.gfx.Sprite) playback encoding, so clean animated crowds
perform no per-entity CPU work or instance uploads as frames change.

```nupp
const hero = tecs.gfx.sheet.grid({
    name = "hero",
    imageWidth = 256,
    imageHeight = 32,
    frameWidth = 32,
    frameHeight = 32,
    tags = {idle = {from = 1, to = 4}, run = {from = 5, to = 8}},
})

hero:bind(tecs.gfx.images.id("sprites/hero"))
tecs.gfx.animation.plugin(world)

world:spawn(
    tecs.ecs.Transform2D(64, 64, 0, 1, 0, 32, 32),
    tecs.gfx.Tint(1, 1, 1, 1),
    hero:sprite(),
    tecs.gfx.animation.of(hero, "run"),
    tecs.gfx.Renderable2D
)
```

An entity needs a [`Sprite`](tecs.gfx.Sprite) as well, because that is
what playback writes and what extraction reads. An `Animation` on its own draws
nothing.

# Events

`Completed` fires once when a one-shot passes its last frame, and `Looped` fires
when a looping tag wraps. Both reach only entities carrying `AnimationEvents`,
so a game watches a handful of animations without walking the rest of an
animated crowd. `Completed` also clears `playing` on watched entities. Unwatched one-shots
clamp to the last frame entirely on the GPU.

# Reloads

Re-exporting a sheet under the same name and folding it in with
`tecs.gfx.sheet.replace` keeps every entity's sheet id, tag, and phase, so
playback carries on and shows the new frames from its next step.
]]

local ecs = require("tecs.ecs")
local events = require("nupp.events")
local archetype = require("tecs.internal.archetype")
local components = require("tecs.internal.components")
local rendercomponents = require("tecs.internal.rendercomponents")
local sheet = require("tecs.gfx.sheet")
local frametable = require("tecs.gfx.frametable")

const SpriteComponent = rendercomponents.SpriteComponent

--- The rate an animation runs at when nothing says otherwise, which is the
--- timing the sheet's frames were authored with.
export const DEFAULT_SPEED: number = 1.0

--- What `Animation.crossed` holds when the last step ended a cycle that
--- repeats.

--- What `Animation.crossed` holds when the last step ended a cycle that does
--- not.

--- Stores playback state for one entity.
---
--- `time` is where the cycle has got to, in seconds, and stays inside the
--- cycle, so it neither grows without bound nor loses precision to its own age.
--- The cycle's duration is the sum of the durations of the frames the tag
--- visits, which `tecs.gfx.sheet.Sheet.cycle` reports.
@derive(nupp.derive.Debug, nupp.derive.Serde)
export struct Animation
    --- Caller-writable. Selects a sheet by its registration index. Zero plays
    --- nothing.
    sheet: integer

    --- Caller-writable. Selects a tag by its `Sheet.tagId` index. Zero plays
    --- the whole sheet in order.
    tag: integer

    --- Caller-writable. Multiplies the timing the sheet carries. One is the
    --- timing as authored and two is twice as fast. Zero or less holds the
    --- current frame and stops time advancing, which is a pause that leaves
    --- `playing` alone.
    ---
    --- How long each frame is held is the sheet's answer rather than an
    --- entity's, because that is where an artist sets it: a hold frame is a
    --- frame with a long duration, which no single rate can express.
    speed: number

    --- Caller-writable. Supplies the phase used when frame is zero. To seek,
    --- write time and reset frame to zero. Read live phase with timeOf.
    time: number

    --- Engine-owned. Holds -1 for encoded GPU playback, or zero to request
    --- re-encoding from time. Ordinary game
    --- code should call `frameOf`, which answers for an entity carrying no
    --- `Animation` too. Writing zero asks playback to rewrite the `Sprite`,
    --- which is what `play`, `restart`, `of`, and a restored snapshot do.
    frame: integer

    --- Caller-writable. Controls whether the tag restarts after its last frame.
    loop: boolean

    --- Caller-writable. Controls whether time advances.
    playing: boolean

    --- Engine-owned. Retains the serialized component layout; GPU playback
    --- leaves this legacy event scratch field at zero.
    --- Ordinary game code should observe `Completed` and `Looped` instead. The
    --- reporting system clears it, and a snapshot drops it.
    crossed: integer
end

--- The process-wide `Animation` component definition.
export const AnimationComponent: ecs.FFIComponent<Animation> = ecs.newFFIComponent({
    -- This persisted component name is a compatibility surface.
    name = "Animation",
    construct = function(
        sheetId: integer?,
        tag: integer?,
        speed: number?,
        time: number?,
        frame: integer?,
        loop: boolean?,
        playing: boolean?
    ): Animation
        return new Animation(
            sheetId ?? 0,
            tag ?? 0,
            speed ?? DEFAULT_SPEED,
            time ?? 0.0,
            frame ?? 0,
            loop ?? true,
            playing ?? true,
            0
        )
    end,
    default = function(): Animation
        return new Animation(0, 0, DEFAULT_SPEED, 0.0, 0, true, true, 0)
    end,
    -- A sheet id and a tag id are this process's answers, decided by the order
    -- sheets were built in. What crosses a save is the pair of names, resolved
    -- again on the way back in; a tag the sheet has since lost resolves to zero
    -- and the sheet reports it. The frame is deliberately dropped: zero makes
    -- the first step rewrite the Sprite, so a restored entity does not depend
    -- on the region its Sprite was saved holding.
    save = function(value: Animation): any
        -- These saved keys are a compatibility surface: a file written by an
        -- earlier build names them, so they do not move when their module does.
        const source = sheet.byId(value.sheet)

        return {
            sheet = source ~= nil and source.name or nil,
            tag = source ~= nil and source:tagName(value.tag) or nil,
            speed = value.speed,
            time = value.time,
            loop = value.loop,
            playing = value.playing,
        }
    end,
    load = function(value: any): Animation
        const stored = value as {[string]: any}
        const name = stored.sheet as string?
        local id: integer = 0
        local tag: integer = 0
        if name ~= nil then
            const source = sheet.byName(name)
            if source ~= nil then
                id = source.id
                tag = source:tagId(stored.tag as string?)
            end
        end

        return new Animation(
            id,
            tag,
            (stored.speed as number?) ?? DEFAULT_SPEED,
            (stored.time as number?) ?? 0.0,
            0,
            (stored.loop as boolean?) ?? true,
            (stored.playing as boolean?) ?? true,
            0
        )
    end,
})

--- Requests `Completed` and `Looped` events for one entity.
---
--- The reporting query visits only entities carrying this tag, so a game asks
--- for events on a handful of entities without walking the rest of its animated
--- crowd. Adding the tag costs one archetype move and nothing per step.
-- This persisted component name is a compatibility surface.
export const AnimationEvents: ecs.Component = ecs.newTagComponent({name = "AnimationEvents"})

--- Fires when a non-looping tag runs past its last frame.
---
--- Playback stops and holds that frame, so this fires once per playthrough and
--- never again until something restarts it.
-- This event name is a compatibility surface.
@derive(events.Event)
@event(name = "Completed")
export record Completed
    --- Read-only. Identifies the entity whose animation ended a cycle.
    entity: integer

    --- Read-only. Reports the sheet that was playing.
    sheet: sheet.Sheet

    --- Read-only. Reports the tag that ended, or the empty string for a whole
    --- sheet.
    tag: string
end

--- Fires when a looping tag passes its last frame and restarts.
---
--- Once per fixed step at most rather than once per cycle: a step long enough
--- to cover several cycles wraps the time once and reports one loop, so
--- counting these is not a way to count playthroughs.
-- This event name is a compatibility surface.
@derive(events.Event)
@event(name = "Looped")
export record Looped
    --- Read-only. Identifies the entity whose animation ended a cycle.
    entity: integer

    --- Read-only. Reports the sheet that was playing.
    sheet: sheet.Sheet

    --- Read-only. Reports the tag that ended, or the empty string for a whole
    --- sheet.
    tag: string
end

--- Configures how an animation plays.
---
--- `speed` defaults to one, and `loop` and `playing` both default to true.
export type PlayOptions = {
    speed: number?,
    loop: boolean?,
    playing: boolean?
}

-------------------------------------------------------------------------------
-- Authoring
-------------------------------------------------------------------------------

local function tagIdFor(source: sheet.Sheet, tag: string?, level: integer): integer
    if tag == nil then
        return 0
    end
    if not source:hasTag(tag) then
        error("gfx.animation: sheet '" .. source.name .. "' has no tag '" .. tag .. "'", level)
    end

    return source:tagId(tag)
end

--- Creates an animation that plays a named sheet tag, ready to spawn.
---
--- Omit the tag to play the whole sheet in order.
--- @param source the sheet to play
--- @param tag a tag the sheet names, or nil for the whole sheet
--- @param options the speed, loop, and playing overrides, or nil for the sheet's
---     own timing, looping, and playing
--- @return a component value ready for `world:spawn` or `world:set`, not an
---     entity
--- @raises when the sheet does not carry the named tag, because an author naming
---     a tag here has one in mind and the sheet is already in hand to check
export function of(
    source: sheet.Sheet,
    tag: string?,
    options: PlayOptions?
): components.FFIInstance<Animation, components.FFIComponent<Animation>>
    const id = tagIdFor(source, tag, 3)

    return AnimationComponent(
        source.id,
        id,
        options ~= nil and options.speed or DEFAULT_SPEED,
        0.0,
        0,
        options == nil or options.loop ~= false,
        options == nil or options.playing ~= false
    )
end

--- Points a live entity at a tag and restarts it there.
---
--- Restarting is the point: the time and the frame both reset, so the next
--- fixed step writes the tag's first frame whatever the entity was showing. An
--- entity carrying no `Animation` is given one.
--- @param world the world the entity lives in
--- @param entity a live entity carrying a [`Sprite`](tecs.gfx.Sprite)
--- @param source the sheet to play
--- @param tag a tag the sheet names, or nil for the whole sheet
--- @param options the speed, loop, and playing overrides, or nil for the
---     defaults
--- @raises when the sheet does not carry the named tag
export function play(
    exclusive world: ecs.World,
    entity: integer,
    source: sheet.Sheet,
    tag: string?,
    options: PlayOptions?
): nil
    const built = of(source, tag, options)
    if not world:has(entity, AnimationComponent) then
        world:set(entity, built)
        return
    end
    const current = assert(world:getMut(entity, AnimationComponent))
    const value = built.value
    current.sheet = value.sheet
    current.tag = value.tag
    current.speed = value.speed
    current.time = 0.0
    current.frame = 0
    current.loop = value.loop
    current.playing = value.playing
    current.crossed = 0
end

--- Plays an entity's animation again from the start of its tag.
---
--- The sheet, tag, speed, and loop flag are left alone; what resets is where in
--- the cycle playback has got to and whether it is running. For replaying a
--- one-shot that has finished, and for rewinding one that has not.
--- @param world the world the entity lives in
--- @param entity a live entity
--- @return whether there was an animation to restart; false leaves the entity
---     untouched, since nothing there says what it would play
export function restart(exclusive world: ecs.World, entity: integer): boolean
    const current = world:getMut(entity, AnimationComponent)
    if current == nil then
        return false
    end
    current.time = 0.0
    -- Zero is no frame written yet, so the next step writes the tag's first one
    -- whatever the entity was showing.
    current.frame = 0
    current.playing = true
    current.crossed = 0

    return true
end

-------------------------------------------------------------------------------
-- Playback
-------------------------------------------------------------------------------

-- Playback keeps no per-frame entity cursor. Only changed archetype columns
-- are encoded; the GPU and queries derive phase from one fixed-step clock.
local record EncodedRun
    structural: integer = -1
    animation: integer = -1
    sprite: integer = -1
    pivot: integer = -1
    sheets: integer = -1
    timestep: number = -1
end
local function ticksOf(borrows sprite: rendercomponents.Sprite, clock: number): number
    if sprite.u1 == 0 then
        return sprite.v0
    end
    return nupp.math.f32.narrow(nupp.math.f32.narrow(clock - sprite.v0) * sprite.u1)
end

local function encode(query: ecs.Query, borrows world: ecs.World, clock: number, runs: {[integer]: EncodedRun}): nil
    const timestep = world:getFixedTiming()
    const changedSheets = sheet.revision()
    unsafe do
        for candidate, count in query:iter() do
            const active = candidate as archetype.Archetype
            local run = runs[active.id]
            if run == nil then
                run = new EncodedRun()
                runs[active.id] = run
            end
            if run.structural ~= active:structuralCount() or run.animation ~= active:writeCount(
                AnimationComponent
            ) or run.sprite ~= active:writeCount(
                SpriteComponent
            ) or run.sheets ~= changedSheets or run.timestep ~= timestep then
                const pivots = active:get(sheet.Pivot)
                const animations = assert(active:get(AnimationComponent))
                const sprites = assert(active:get(SpriteComponent))
                const held = archetype.has(active, ecs.Paused) or archetype.has(active, ecs.Disabled)
                for row = 1, count as integer do
                    const instance = animations[row]
                    const source = sheet.byId(instance.sheet)
                    if source ~= nil then
                        const target = sprites[row]
                        const slice = pivots ~= nil and pivots[row].sheet == source.id and pivots[row].slice or 0
                        const id = frametable.register(source, instance.tag, slice)
                        local ticks = instance.time * frametable.TICK_HZ
                        if instance.frame ~= 0 and frametable.playbackOf(target) ~= 0 then
                            ticks = ticksOf(target, clock)
                        end
                        const rate = not held
                            and instance.playing
                            and instance.speed > 0
                            and timestep
                            * instance.speed
                            * frametable.TICK_HZ
                            or 0
                        assert(rate == rate and rate < math.huge, "animation speed must be finite")
                        target.image = source:boundImage()
                        frametable.encode(target, id, rate > 0 and clock - ticks / rate or ticks, rate, instance.loop)
                        instance.frame = -1
                    end
                end
                active:markComponentDirty(SpriteComponent)
                active:markComponentDirty(AnimationComponent)
                run.structural, run.animation, run.sprite = active:structuralCount(), active:writeCount(
                    AnimationComponent
                ), active:writeCount(SpriteComponent)
                run.sheets, run.timestep, run.pivot = changedSheets, timestep, active:writeCount(sheet.Pivot)
            end
        end
    end
end

local function report(exclusive world: ecs.World, query: ecs.Query, before: number, after: number): nil
    unsafe do
        for candidate, count in query:iter() do
            const active = candidate as archetype.Archetype
            const animations = assert(active:get(AnimationComponent))
            const sprites = assert(active:get(SpriteComponent))
            for row = 1, count as integer do
                const target = sprites[row]
                const id = frametable.playbackOf(target)
                if id ~= 0 and target.u1 > 0 then
                    const cycle = frametable.tickCount(id)
                    const from = math.max(0, ticksOf(target, before))
                    const to = ticksOf(target, after)
                    const instance = animations[row]
                    const source = sheet.byId(instance.sheet)
                    if cycle > 0 and source ~= nil and to > from then
                        if not instance.loop and from < cycle and to >= cycle then
                            instance.playing = false
                            instance.time = cycle / frametable.TICK_HZ
                            active:markComponentDirty(AnimationComponent)
                            world:emit(0, Completed, active.entities[row], source, source:tagName(instance.tag))
                        elseif instance.loop and math.floor(to / cycle) > math.floor(from / cycle) then
                            world:emit(0, Looped, active.entities[row], source, source:tagName(instance.tag))
                        end
                    end
                end
            end
        end
    end
end

local function rebase(query: ecs.Query, clock: number, shift: number): nil
    unsafe do
        for candidate, count in query:iter() do
            const active = candidate as archetype.Archetype
            const sprites = assert(active:get(SpriteComponent))
            local changed = false
            for row = 1, count as integer do
                const target = sprites[row]
                const id = frametable.playbackOf(target)
                if id ~= 0 and target.u1 > 0 then
                    const cycle = frametable.tickCount(id)
                    local ticks = ticksOf(target, clock + shift)
                    ticks = target.v1 ~= 0 and ticks % cycle or math.min(ticks, cycle)
                    target.v0 = clock - ticks / target.u1
                    changed = true
                end
            end
            if changed then
                active:markComponentDirty(SpriteComponent)
            end
        end
    end
end

--- Returns elapsed seconds within an entity's animation cycle. The answer is
--- derived from its start and the fixed clock; no component needs advancing.
--- @param world the entity's world
--- @param entity a live entity
--- @return cycle seconds, or zero without an animation
export function timeOf(borrows world: ecs.World, entity: integer): number
    const instance = world:get(entity, AnimationComponent)
    if instance == nil then
        return 0
    end
    const target = world:get(entity, SpriteComponent)
    if instance.frame == 0 or target == nil or frametable.playbackOf(target) == 0 then
        return instance.time
    end
    const cycle = frametable.tickCount(frametable.playbackOf(target))
    if cycle == 0 then
        return instance.time
    end
    local ticks = ticksOf(target, frametable.clockOf(world))
    ticks = instance.loop and ticks % cycle or math.max(0, math.min(ticks, cycle))

    return ticks / frametable.TICK_HZ
end

--- Returns exactly the sheet frame selected by the shared GPU table.
--- @param world the entity's world
--- @param entity a live entity
--- @return the one-based sheet frame, or zero without a known sheet
export function frameOf(borrows world: ecs.World, entity: integer): integer
    const instance = world:get(entity, AnimationComponent)
    if instance == nil then
        return 0
    end
    const source = sheet.byId(instance.sheet)
    if source == nil then
        return 0
    end
    const id = frametable.register(source, instance.tag)

    return frametable.frameAt(id, timeOf(world, entity) * frametable.TICK_HZ, instance.loop)
end

local installed: {[ecs.World]: boolean} = setmetatable({}, {__mode = "k"}) as {[ecs.World]: boolean}
local record SavedPhase
    entity: integer
    time: number
end

--- Installs dirty-gated GPU playback and events for AnimationEvents entities.
--- One-shots clamp on the GPU without a CPU visit; add AnimationEvents when
--- game code needs Completed or the playing flag cleared. Installing twice is
--- harmless. Snapshots save live phases and restore against a fresh clock.
--- @param world the world receiving the animation systems
export function plugin(exclusive world: ecs.World): nil
    if installed[world] then
        return
    end
    installed[world] = true
    const playing = world:newQuery({include = {AnimationComponent, SpriteComponent}})
    const subscribed = world:newQuery({include = {AnimationComponent, SpriteComponent, AnimationEvents}})
    local runs: {[integer]: EncodedRun} = {}
    world:addSystem({
        name = "tecs.EncodeAnimation",
        phase = ecs.phases.FixedPostUpdate,
        run = function(_dt: number, exclusive running: ecs.World): nil
            encode(playing, running, frametable.clockOf(running) - 1, runs)
        end
    })
    world:addSystem({
        name = "tecs.ReportAnimation",
        phase = ecs.phases.FixedPostUpdate,
        run = function(_dt: number, exclusive running: ecs.World): nil
            const clock = frametable.clockOf(running)
            report(running, subscribed, clock - 1, clock)
        end
    })
    world:addSystem({
        name = "tecs.RebaseAnimation",
        phase = ecs.phases.FixedPostUpdate,
        run = function(_dt: number, exclusive running: ecs.World): nil
            const shift = frametable.rebaseClock(running)
            if shift > 0 then
                rebase(playing, frametable.clockOf(running), shift)
            end
        end
    })
    world:addSnapshotHandler({
        name = "tecs.animation",
        save = function(exclusive running: ecs.World): any
            local phases: {SavedPhase} = {}
            for candidate, count in playing:iter() do
                const active = candidate as archetype.Archetype
                for row = 1, count as integer do
                    const entity = active.entities[row]
                    phases[#phases + 1] = new SavedPhase(entity = entity, time = timeOf(running, entity))
                end
            end

            return phases
        end,
        load = function(exclusive running: ecs.World, stored: any): nil
            for _, entry in ipairs(stored as {SavedPhase}) do
                const value = running:getMut(entry.entity, AnimationComponent)
                if value ~= nil then
                    value.time, value.frame = entry.time, 0
                end
            end
            runs = {}
            encode(playing, running, frametable.clockOf(running), runs)
        end
    })
end
