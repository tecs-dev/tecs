module tecs.log

--[[
Named, leveled logging for engine and game subsystems.

`nupp.log` owns rendering, sinks, formatters, timestamps and the process
threshold, so this module keeps only what Nupp does not have: a threshold per
name. A name is the unit a developer filters on, and turning one subsystem up to
`"debug"` while the process stays at `"warn"` is the reason the engine has named
loggers at all.

```nupp
local log = require("tecs.log")

local combat <const> = log.get("game.combat")
combat:info("wave %d spawned %d enemies", 3, 12)
combat:setLevel("debug")
```

A logger checks its own threshold before it renders, so a filtered call costs a
table read and a compare. Building the arguments is still the caller's cost, so
guard work that exists only to make a message:

```nupp
local combat <const> = log.get("game.combat")
if combat:enabled("debug") then
    combat:debug("snapshot: %s", encode(snapshot))
end
```

## Levels

The levels are the five `nupp.log` names: `"off"`, `"error"`, `"warn"`, `"info"`
and `"debug"`, each admitting itself and everything above it. A logger with no
level of its own follows the process threshold, which `nupp.log.level` reads and
moves. A logger's own threshold wins in both directions: one set to `"debug"`
emits while the process sits at `"warn"`, and one set to `"off"` stays silent
while the process is verbose.

The SDL implementation offered seven priorities. `TRACE` and `VERBOSE` arrive as
`"debug"` and `CRITICAL` arrives as `"error"`, because the sink contract beneath
carries four severities and a fifth would be a level no host could route.
Nothing in the tree called those three methods, so they are removed rather than
aliased.

## Destinations

Lines go wherever `nupp.log.sink` points, which is standard error until a host
says otherwise. This module installs no sink and replaces no formatter, so a
host that routes Nupp's logging routes these lines with it. The SDL build's
`openFile` JSON Lines destination is gone: a sink function or a file handed to
`nupp.log.sink` does the same job without a second file-writing path here.
]]

local nupplog = require("nupp.log")

--- A logging threshold, from silent to most verbose.
export type Level = nupplog.Level

--- A named log category with a threshold of its own.
---
--- `get` returns the same logger for a name on every call.
export record Logger
    --- Read-only. Contains the registered name every line from this logger
    --- carries.
    name: string

    --- Engine-owned. Holds this logger's own threshold, or nil while it follows
    --- the process threshold. Ordinary game code reads `getLevel` instead.
    private threshold: Level?

    --- Engine-owned. Writes one already-rendered line at a `nupp.log` severity.
    ---
    --- Bound to the module view rather than to a named `nupp.log` logger,
    --- because that logger's severity methods are stamped from the process
    --- threshold and a Tecs logger raised above that threshold would reach an
    --- empty function.
    private write: function(severity: integer, line: integer, message: string): nil

    debug: function(borrows self: Logger, message: string, ...: any): nil
    info: function(borrows self: Logger, message: string, ...: any): nil
    warn: function(borrows self: Logger, message: string, ...: any): nil
    error: function(borrows self: Logger, message: string, ...: any): nil
    enabled: function(borrows self: Logger, level: Level): boolean
    getLevel: function(borrows self: Logger): Level
    setLevel: function(exclusive self: Logger, level: Level?): nil
end

-- Compatibility surface. Logger names are what a developer types to filter a
-- running game and what tooling reports, so they keep the spelling the SDL
-- implementation registered even though every module around them has moved.
-- Adding a name here is safe; changing one is a migration, not a rename.
--
-- The Teal tree also registered `tecs.future`, `tecs.pipeline` and
-- `tecs.context` from internals that have no counterpart in the rewrite. They
-- are deliberately absent: naming a logger nothing emits through would be a
-- promise this module cannot keep.

--- Read-only. Names the application lifecycle logger.
export const APP = "tecs.app"

--- Read-only. Names the asset loader logger.
export const ASSETS = "tecs.assets"

--- Read-only. Names the audio service logger.
export const AUDIO = "tecs.audio"

--- Read-only. Names the graphics logger.
export const GFX = "tecs.gfx"

--- Read-only. Names the GPU resource logger.
export const GPU = "tecs.gpu"

--- Read-only. Names the HTTP client logger.
export const HTTP = "tecs.http"

--- Names the gameplay input log, which reports a device that could not be
--- opened and a binding that named nothing.
export const INPUT = "tecs.input"

--- Read-only. Names the debug server logger.
export const MCP = "tecs.mcp"

--- Read-only. Names the profiling logger.
export const PROFILE = "tecs.profile"

--- Read-only. Names the sequencer logger.
export const SEQUENCE = "tecs.sequence"

--- Read-only. Names the file-watching logger.
export const WATCH = "tecs.watch"

--- Read-only. Names the world logger.
export const WORLD = "tecs.world"

local ORDER: {[string]: integer} = {off = 0, error = 1, warn = 2, info = 3, debug = 4}

--- The `nupp.log` severity numbers, which a sink receives directly.
local ERROR: integer = 1

local WARN: integer = 2
local INFO: integer = 3
local DEBUG: integer = 4

local registry: {[string]: Logger} = {}

local function rank(level: Level): integer
    local index = ORDER[level as string]
    if index == nil then
        error("tecs.log: no level named " .. tostring(level), 3)
    end

    return index
end

--- Applies `string.format` only when a line is actually being written.
---
--- `nupp.log`'s own debug directive `%?` is not available here, because it lives
--- in the severity intrinsics rather than in the module view this writes through.
local function render(message: string, ...: any): string
    if select("#", ...) == 0 then
        return message
    end

    return message:format(...)
end

--- Whether `logger` emits at `level`, consulting its own threshold first.
local function admits(borrows logger: Logger, level: Level): boolean
    local own = logger.threshold
    if own == nil then
        return nupplog.enabled(level)
    end

    return rank(own) >= rank(level)
end

--- Returns the logger registered for `name`, creating it the first time.
---
--- Names are compared byte for byte, so two spellings are two loggers with two
--- thresholds. A new logger follows the process threshold until `setLevel`
--- gives it one of its own.
---
--- @param name the filtering name every line from this logger carries
--- @return the shared logger for that name
--- @raises when name is empty
export function get(name: string): Logger
    if name == "" then
        error("tecs.log.get: name must not be empty", 2)
    end
    local existing = registry[name]
    if existing ~= nil then
        return existing
    end
    local view = nupplog.forModule(name) as {[string]: any}
    local logger = new Logger(
        name = name,
        threshold = nil,
        write = view.emit as function(integer, integer, string): nil
    )
    registry[name] = logger

    return logger
end

--- Returns every registered logger name.
---
--- @return a fresh sorted array holding only names something has already asked
---   `get` for, so a subsystem that has not run yet is absent
export function loggers(): {string}
    local names: {string} = {}
    for name in pairs(registry) do
        names[#names + 1] = name
    end
    table.sort(names)

    return names
end

--- Sets one named logger's threshold without creating a logger for an unknown
--- name.
---
--- This is what a debug command that takes a name off the wire calls, because
--- it must not register a category for a typo.
---
--- @param name the registered logger name
--- @param level the threshold, or nil to follow the process threshold again
--- @return whether a logger of that name was registered
--- @raises when level is not one of the five thresholds
export function setLevel(name: string, level: Level?): boolean
    local logger = registry[name]
    if logger == nil then
        return false
    end
    logger:setLevel(level)

    return true
end

--- Clears every per-logger threshold, leaving each logger following the process
--- threshold that `nupp.log.level` controls.
export function resetLevels(): nil
    for _, logger in pairs(registry) do
        logger.threshold = nil
    end
end

--- Logs at debug.
---
--- Rendering runs only when the level admits the line, so a filtered call costs
--- a compare. Building the arguments is the caller's cost; guard that with
--- `enabled`.
---
--- @param self the logger to write through
--- @param message a `string.format` template when arguments follow, and a
---   literal otherwise, so a bare `%` in a plain message is safe
--- @param ... the values formatted into `message`
function Logger.debug(borrows self: Logger, message: string, ...: any): nil
    if not admits(self, "debug") then
        return
    end
    self.write(DEBUG, 0, render(message, ...))
end

--- Logs at info. See `debug` for the formatting rules.
--- @param self the logger to write through
--- @param message the template or literal
--- @param ... the values formatted into `message`
function Logger.info(borrows self: Logger, message: string, ...: any): nil
    if not admits(self, "info") then
        return
    end
    self.write(INFO, 0, render(message, ...))
end

--- Logs at warn. See `debug` for the formatting rules.
--- @param self the logger to write through
--- @param message the template or literal
--- @param ... the values formatted into `message`
function Logger.warn(borrows self: Logger, message: string, ...: any): nil
    if not admits(self, "warn") then
        return
    end
    self.write(WARN, 0, render(message, ...))
end

--- Logs at error. Logging is all this does; it neither raises nor returns
--- anything. See `debug` for the formatting rules.
--- @param self the logger to write through
--- @param message the template or literal
--- @param ... the values formatted into `message`
function Logger.error(borrows self: Logger, message: string, ...: any): nil
    if not admits(self, "error") then
        return
    end
    self.write(ERROR, 0, render(message, ...))
end

--- Reports whether this logger would emit a line at `level`.
---
--- Call it to guard work that exists only to build a message, such as encoding
--- a table. The severity methods already guard themselves.
---
--- @param self the logger to test
--- @param level the level the guarded line would use
--- @return whether a line at that level would reach the sink, which is always
---   false for `"off"`
--- @raises when level is not one of the five thresholds
function Logger.enabled(borrows self: Logger, level: Level): boolean
    if rank(level) == 0 then
        return false
    end

    return admits(self, level)
end

--- Returns the threshold this logger emits at.
---
--- @param self the logger to read
--- @return this logger's own threshold, or the process threshold while it has
---   none of its own
function Logger.getLevel(borrows self: Logger): Level
    return self.threshold or nupplog.level()
end

--- Sets the minimum level this logger emits.
---
--- @param self the logger to filter
--- @param level the threshold, or nil to follow the process threshold again
--- @raises when level is not one of the five thresholds
function Logger.setLevel(exclusive self: Logger, level: Level?): nil
    if level ~= nil then
        rank(level)
    end
    self.threshold = level
end
