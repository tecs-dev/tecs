{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "dev",
            "hidden": true,
            "inherits": "base",
            "description": "System dependencies. Development only: a package manager's paths must not reach a shipped build.",
            "cacheVariables": {
                "TECS_SYSTEM_DEPS": "ON",
                "TECS_UNINIT_PATTERN": "ON"
            }
        },
        {
            "name": "sanitize",
            "hidden": true,
            "inherits": "dev",
            "description": "A development build with AddressSanitizer and UndefinedBehaviorSanitizer under it. Run the demo or a benchmark; see CONTRIBUTING.md for what the spec suite cannot do here.",
            "cacheVariables": { "TECS_SANITIZE": "address,undefined" }
        },
        {
            "name": "packaged",
            "hidden": true,
            "inherits": "base",
            "description": "Pinned dependency sources, so a release is reproducible and carries no system paths.",
            "cacheVariables": { "TECS_SYSTEM_DEPS": "OFF" }
        },

        {
            "name": "macos-arm64-dev",
            "inherits": "dev",
            "displayName": "macOS arm64, development, Metal",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
            }
        },
        {
            "name": "macos-arm64-sanitize",
            "inherits": "sanitize",
            "displayName": "macOS arm64, development, sanitized",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
            }
        },
        {
            "name": "macos-arm64",
            "inherits": "packaged",
            "displayName": "macOS arm64, packaged, Metal",
            "description": "11.0 is where arm64 macOS starts, so it is the oldest release this can run on at all.",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
            }
        },
        {
            "name": "macos-arm64-single",
            "inherits": "packaged",
            "displayName": "macOS arm64, one executable, Metal",
            "description": "The command line tool: every dependency linked in, and the whole content root carried inside.",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
                "TECS_SINGLE_FILE": "ON",
                "TECS_ENTRY": "lua/tecscli.lua"
            }
        },
        {
            "name": "macos-x64",
            "inherits": "packaged",
            "displayName": "macOS x86-64, packaged, Metal",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
            }
        },
        {
            "name": "linux-x64-dev",
            "inherits": "dev",
            "displayName": "Linux x86-64, development, Vulkan"
        },
        {
            "name": "linux-x64-sanitize",
            "inherits": "sanitize",
            "displayName": "Linux x86-64, development, sanitized"
        },
        {
            "name": "linux-x64",
            "inherits": "packaged",
            "displayName": "Linux x86-64, packaged, Vulkan"
        },
        {
            "name": "windows-x64",
            "inherits": "packaged",
            "displayName": "Windows x86-64, packaged, D3D12",
            "generator": "Ninja"
        },
        {
            "name": "ios",
            "inherits": "packaged",
            "displayName": "iOS arm64 device, Metal, interpreter-mode LuaJIT",
            "generator": "Xcode",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "android-arm64",
            "inherits": "packaged",
            "displayName": "Android arm64-v8a, Vulkan, API 29+",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_SYSTEM_VERSION": "29",
                "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-x64",
            "inherits": "packaged",
            "displayName": "Android x86-64 emulator, Vulkan, API 29+",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_SYSTEM_VERSION": "29",
                "CMAKE_ANDROID_ARCH_ABI": "x86_64"
            }
        }
    ],
    "buildPresets": [
        { "name": "macos-arm64-dev", "configurePreset": "macos-arm64-dev" },
        { "name": "macos-arm64-sanitize", "configurePreset": "macos-arm64-sanitize" },
        { "name": "macos-arm64", "configurePreset": "macos-arm64" },
        { "name": "macos-arm64-single", "configurePreset": "macos-arm64-single" },
        { "name": "macos-x64", "configurePreset": "macos-x64" },
        { "name": "linux-x64-dev", "configurePreset": "linux-x64-dev" },
        { "name": "linux-x64-sanitize", "configurePreset": "linux-x64-sanitize" },
        { "name": "linux-x64", "configurePreset": "linux-x64" },
        { "name": "windows-x64", "configurePreset": "windows-x64" },
        { "name": "ios", "configurePreset": "ios" },
        { "name": "android-arm64", "configurePreset": "android-arm64" },
        { "name": "android-x64", "configurePreset": "android-x64" }
    ]
}
