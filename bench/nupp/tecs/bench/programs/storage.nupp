-- Native ECS columns, derived declarations, direct arrays and managed rows.
-- Every loop uses the same two-double layout and arithmetic. Setup is untimed.
const ecs2 = require("tecs.ecs")

local ffi = require("ffi")
local buffer = require("string.buffer")
local ffistorage = require("tecs.internal.ffistorage")
local harness = require("tecs.bench.harness")

const count = harness.count("BENCH_STORAGE_COUNT", 100000)
const warmup = harness.optionalCount("BENCH_STORAGE_WARMUP", 120)
const samples = harness.count("BENCH_STORAGE_SAMPLES", 301)

@derive(tecs.ecs.Component, nupp.derive.Debug, nupp.derive.Serde)
local struct NativePoint
    x: number = 0
    y: number = 1
end
local record ManagedPoint
    x: number
    y: number
end
const native = ecs2.newComponent(NativePoint, {
    name = "bench.NativePoint",
    construct = function(): NativePoint
        return new NativePoint(0, 1)
    end,
    default = function(): NativePoint
        return new NativePoint(0, 1)
    end
})
const managed = ecs2.newComponent(ManagedPoint, {
    name = "bench.ManagedPoint",
    construct = function(): ManagedPoint
        return new ManagedPoint(x = 0, y = 1)
    end,
    default = function(): ManagedPoint
        return new ManagedPoint(x = 0, y = 1)
    end
})
const nativeWorld = ecs2.newWorld({maxEntities = count + 64})
const managedWorld = ecs2.newWorld({maxEntities = count + 64})
const derivedWorld = ecs2.newWorld({maxEntities = count + 64})
derivedWorld:batchSpawn(count, {NativePoint})
derivedWorld:commit()
const derivedQuery = derivedWorld:newQuery({include = {NativePoint}})
nativeWorld:batchSpawn(count, {native})
managedWorld:batchSpawn(count, {managed})
nativeWorld:commit()
managedWorld:commit()
const nativeQuery = nativeWorld:newQuery({include = {native}})
const managedQuery = managedWorld:newQuery({include = {managed}})
const baseline = carray(NativePoint, count)
unsafe do
    for row = 0, count - 1 do
        baseline[row].y = 1
    end
end

local function directLoop(): nil
    unsafe do
        for row = 0, count - 1 do
            baseline[row].x += baseline[row].y
        end
    end
end

local function nativeLoop(): nil
    for candidate, rows in nativeQuery:iter() do
        const column = assert(candidate:getMut(native))
        unsafe do
            for row = 1, assert(rows) do
                column[row].x += column[row].y
            end
        end
    end
end

local function managedLoop(): nil
    for candidate, rows in managedQuery:iter() do
        const column = assert(candidate:getMut(managed))
        for row = 1, assert(rows) do
            column[row].x += column[row].y
        end
    end
end

local function derivedLoop(): nil
    for candidate, rows in derivedQuery:iter() do
        const column = assert(candidate:getMut(NativePoint))
        unsafe do
            for row = 1, assert(rows) do
                column[row].x += column[row].y
            end
        end
    end
end

const direct = harness.newStage("direct FFI")
const ecs = harness.newStage("native ECS")
const tables = harness.newStage("managed ECS")
const derived = harness.newStage("derived ECS")
harness.measure(direct, warmup, samples, directLoop)
harness.measure(ecs, warmup, samples, nativeLoop)
harness.measure(tables, warmup, samples, managedLoop)
harness.measure(derived, warmup, samples, derivedLoop)

-- Compare direct buffer copies with bounded native-column copies.
-- Neither materializes a string or row table.
const bytes = buffer.new(count * 16)
const storage = assert(ffistorage.find(native.componentId))
local column: any
for candidate in nativeQuery:iter() do
    column = candidate:get(native)
end
const raw = harness.newStage("direct raw save")
const nativeRaw = harness.newStage("native raw save")
harness.measure(raw, warmup, samples, function(): nil
    bytes:reset()
    unsafe do
        bytes:putcdata(ffi.cast<voidptr>(baseline), count * 16)
    end
end)
harness.measure(nativeRaw, warmup, samples, function(): nil
    bytes:reset()
    ffistorage.writeRows(storage, column, 1, count, bytes)
end)

local function repeatLoops(run: function(): nil): nil
    for _ = 1, 100 do
        run()
    end
end

for _ = 1, 3 do
    repeatLoops(nativeLoop)
    repeatLoops(derivedLoop)
end
collectgarbage("collect")
collectgarbage("stop")
const before = collectgarbage("count")
repeatLoops(nativeLoop)
const allocated = (collectgarbage("count") - before) * 1024
const derivedBefore = collectgarbage("count")
repeatLoops(derivedLoop)
const derivedAllocated = (collectgarbage("count") - derivedBefore) * 1024
collectgarbage("restart")

const nativeBatch = harness.newStage("native batch")
const derivedBatch = harness.newStage("derived batch")
harness.measure(
    nativeBatch,
    5,
    31,
    function(): nil
        nativeWorld:batchSpawn(count, {native})
        nativeWorld:commit()
    end,
    function(): nil
        nativeWorld:clearEntities()
    end
)
harness.measure(
    derivedBatch,
    5,
    31,
    function(): nil
        derivedWorld:batchSpawn(count, {NativePoint})
        derivedWorld:commit()
    end,
    function(): nil
        derivedWorld:clearEntities()
    end
)
print("Rows per window: " .. tostring(count))
print(harness.format({direct, ecs, derived, tables, raw, nativeRaw, nativeBatch, derivedBatch}))
print("Native ECS allocations over 100 full query loops: " .. tostring(allocated) .. " bytes")
print("Derived ECS allocations over 100 full query loops: " .. tostring(derivedAllocated) .. " bytes")
unsafe do
    assert(baseline[0].x == warmup + samples)
end
