local gates = require("tecs.dev.gates")
local docs = require("tecs.dev.docs")
local files = require("nupp.io.files")
local commands = require("tecs.dev.commands")
local json = require("nupp.codec.json")

local suite = {}

local function report(): table
    return {
        ok = true,
        total = 1,
        passed = 1,
        failed = 0,
        skipped = 0,
        tests = {{suite = "audionativetest", name = "opensOffline", status = "passed"}}
    }
end

function suite.requiresAllDiscoveredSuites(): nil
    gates.tests(report(), {"audionativetest"})
    assert.eq(pcall(gates.tests, report(), {"audionativetest", "gamepadnativetest"}), false)
    assert.eq(pcall(gates.tests, report(), {}), false)
end

function suite.refusesInconsistentCountsAndDuplicateCases(): nil
    local wrong = report()
    wrong.total = 2
    assert.eq(pcall(gates.tests, wrong, {"audionativetest"}), false)
    wrong = report()
    wrong.tests[2] = wrong.tests[1]
    wrong.total, wrong.passed = 2, 2
    assert.eq(pcall(gates.tests, wrong, {"audionativetest"}), false)
end

function suite.refusesSkipsEvenWhenTheRunnerSucceeds(): nil
    local skipped = report()
    skipped.tests[1].status = "skipped"
    skipped.passed, skipped.skipped = 0, 1
    assert.eq(pcall(gates.tests, skipped, {"audionativetest"}), false)
end

function suite.refusesMissingAndInvalidReports(): nil
    assert.eq(pcall(gates.tests, "not a report", {"audionativetest"}), false)
    local empty = report()
    empty.tests = {}
    assert.eq(pcall(gates.tests, empty, {}), false)
end

function suite.performanceGateChecksCompleteTailSamples(): nil
    const good = {stages = {{name = "extract", samples = 900, p95 = 3}}}
    assert.eq(#gates.performance(good, {extract = 3}), 0)
    assert.eq(#gates.performance(good, {extract = 2.9}), 1)
    assert.eq(pcall(gates.performance, good, {update = 3}), false)
    assert.eq(pcall(gates.performance, {stages = {{name = "extract", samples = 899, p95 = 1}}}, {extract = 3}), false)
    assert.eq(pcall(gates.performance, {stages = {good.stages[1], good.stages[1]}}, {extract = 3}), false)
    assert.eq(
        pcall(gates.performance, {stages = {{name = "extract", samples = 900, p95 = math.huge}}}, {
            extract = 3
        }),
        false
    )
end

function suite.previewResolvesCleanRoutesAndRefusesTraversal(): nil
    with scratch = assert(files.createTemporaryDirectory()) do
        const root = scratch:toString()
        assert(files.createDirectory(root .. "/nested"))
        assert(files.write(root .. "/nested/index.html", "example"))
        assert.eq(docs.resolve(root, "/nested?query=yes"), root .. "/nested/index.html")
        assert.eq(docs.resolve(root, "/../nested"), nil)
        assert.eq(docs.resolve(root, "/%2e%2e/nested"), nil)
        assert.eq(docs.resolve(root, "/..\\nested"), nil)
        assert.eq(docs.resolve(root, "/missing"), nil)
    end
end

function suite.benchmarkModulesCannotShadowRuntimeModules(): nil
    for _, found in ipairs(assert(files.glob(commands.root .. "/bench/nupp/**/*.nupp"))) do
        const relative = found:toString():sub(#commands.root + #"/bench/nupp/" + 1)
        assert.eq(files.exists(commands.root .. "/src/" .. relative), false)
        assert.eq(files.exists(commands.root .. "/src/" .. relative:gsub("%.nupp$", "/init.nupp")), false)
    end
end

function suite.taskLauncherPreservesArgumentsAndFailureStatus(): nil
    with scratch = assert(files.createTemporaryDirectory(files.TemporaryOptions(prefix = "tecs task args "))) do
        const root = scratch:toString()
        assert(files.createDirectory(root .. "/tools/tecs/dev"))
        assert(files.copy(commands.root .. "/tools/run.nupp", root .. "/tools/run.nupp"))
        assert(
            files.write(
                root .. "/nupp.lua",
                [[
return {tasks = {probe = {argv = {"nupp", "run", "tools/run.nupp", "first argument"}}}}
]]
            )
        )
        assert(files.write(root .. "/tools/nupp.lua", 'return {include = {"."}}'))
        assert(
            files.write(
                root .. "/tools/tecs/dev/main.nupp",
                [[
local json = require("nupp.codec.json")
print(json.encode({...}))
os.exit(7)
]]
            )
        )
        const literal = "spaces 'quotes' \"double\" $(literal); dollar$"
        const result = commands.capture(
            {commands.compiler(), "task", "probe", literal, "--flag=value with spaces"},
            nil,
            false,
            root
        )
        assert.eq(result.exit.exitCode, 7)
        const args = json.decode(result.output)
        assert.eq(args[1], "first argument")
        assert.eq(args[2], literal)
        assert.eq(args[3], "--flag=value with spaces")
    end
end

function suite.commandsRunTogetherActuallyOverlap(): nil
    with
        scratch = assert(files.createTemporaryDirectory(files.TemporaryOptions(prefix = "tecs parallel commands ")))
    do
        const root = scratch:toString()
        const first = root .. "/first"
        const second = root .. "/second"

        local function rendezvous(mine: string, peer: string): string
            return (
                [[
local files = require("nupp.io.files")

assert(files.write(%q, "ready"))
for _ = 1, 100 do
    if files.isFile(%q) then
        return
    end
    coroutine.sleep(20)
end
error("the peer command never started")
]]
            ):format(mine, peer)
        end

        const firstProgram = root .. "/first.nupp"
        const secondProgram = root .. "/second.nupp"
        assert(files.write(firstProgram, rendezvous(first, second)))
        assert(files.write(secondProgram, rendezvous(second, first)))
        assert.eq(
            commands.runTogether({
                {args = {commands.compiler(), "run", firstProgram}, cwd = root},
                {args = {commands.compiler(), "run", secondProgram}, cwd = root}
            }),
            0
        )
    end
end

return suite
