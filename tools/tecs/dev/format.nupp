module tecs.dev.format

local commands = require("tecs.dev.commands")
local files = require("nupp.io.files")
local path = require("nupp.io.path")

--- Formats the requested files, or all supported source files when none are named.
export function apply(paths: {string}, check: boolean): nil
    if #paths == 0 then
        commands.run(check and {"cargo", "fmt", "--all", "--", "--check"} or {"cargo", "fmt", "--all"})
        commands.run({commands.compiler(), "fmt", check and "--check" or "--write"})
        commands.run({commands.compiler(), "fmt", check and "--check" or "--write"}, nil, commands.root .. "/tools")
    end
    local groups: {[string]: {string}} = {stylua = {}, prettier = {}, nupp = {}, rustfmt = {}}
    const web: {
        [string]: boolean
    } = {
        json = true,
        jsonc = true,
        js = true,
        jsx = true,
        mjs = true,
        cjs = true,
        ts = true,
        tsx = true,
        mts = true,
        cts = true,
        vue = true,
        css = true,
        scss = true,
        html = true,
        md = true,
        yml = true,
        yaml = true
    }
    for _, name in ipairs(commands.sources(paths)) do
        if name:sub(1, 13) == "assets/fonts/" then
            continue
        end
        const extension = path.newPath(name):extension() or ""
        local tool = web[extension] and "prettier" or extension == "lua" and "stylua" or nil
        if #paths > 0 then
            tool = extension == "nupp" and "nupp" or extension == "rs" and "rustfmt" or tool
        end
        if not tool then
            continue
        end
        local generated = false
        local count = 0
        for line in (assert(files.read(commands.root .. "/" .. name)) .. "\n"):gmatch("([^\n]*)\n") do
            count = count + 1
            if count > 5 then
                break
            end
            const lower = line:lower()
            if lower:find(
                "generated by",
                1,
                true
            ) or lower:find("@generated", 1, true) or lower:find("do not edit", 1, true) then
                generated = true
            end
        end
        if not generated then
            table.insert(assert(groups[tool]), name)
        end
    end
    for _, tool in ipairs({"stylua", "prettier", "nupp", "rustfmt"}) do
        const names = assert(groups[tool])
        if #names == 0 then
            continue
        end
        local argv: {string} = {tool}
        if tool == "nupp" then
            argv = {commands.compiler(), "fmt", check and "--check" or "--write"}
        elseif tool == "prettier" then
            argv = {tool, check and "--check" or "--write", "--log-level", "warn"}
        elseif check then
            argv[#argv + 1] = "--check"
        end
        commands.run(commands.append(argv, names))
    end
end
