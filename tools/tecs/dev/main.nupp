local commands = require("tecs.dev.commands")
local gates = require("tecs.dev.gates")
local json = require("serde.json")
local native = require("tecs.dev.native")
local ffi = require("ffi")

local function host(args: {string}, usage: boolean): nil
    if usage and (args[1] == "--help" or args[1] == "-h") then
        print(
            "Usage: nupp task run [target] [--entry MODULE.create] [host arguments...]\nExamples: nupp task ex-lighting; nupp task run mygame --headless --frames 5"
        )
        return
    end
    const target = table.remove(args, 1) or "ex-host"
    const componentName = target:match("^ex%-(.+)$") or target
    local entry = componentName == "host" and "tecs.host.create" or componentName .. ".create"
    if args[1] == "--entry" then
        table.remove(args, 1)
        entry = assert(table.remove(args, 1), "--entry needs an exported constructor")
    end
    if args[1] == "--" then
        table.remove(args, 1)
    end
    if componentName == "sponza3d" or componentName == "bistro3d" then
        const name = componentName:sub(1, -3)
        const model = name == "sponza" and "Sponza" or "Bistro"
        assert(
            os.stat(commands.root .. "/assets/external/" .. name .. "/" .. model .. ".tecs.gltf") == "file",
            "fetch the original scene first: nupp task fetch " .. name
        )
    end
    -- A component build refuses a native library it cannot resolve, so Cargo
    -- builds the services first and the build is handed their paths.
    const libraries = native.libraries()
    commands.run({commands.compiler(), "build", "--target", target}, libraries)
    const component = "out/nupp/" .. componentName .. ".nuppc"
    assert(os.stat(commands.root .. "/" .. component) == "file", "target " .. target .. " did not produce a component")
    local env = commands.sdk()
    for name, value in pairs(libraries) do
        env[name] = value
    end
    commands.run(
        commands.append(
            {"cargo", "run", "--locked", "-p", "tecs-winit-host", "--", "--component", component, "--entry", entry},
            args
        ),
        env
    )
end

local function test(args: {string}): nil
    if args[1] == "--help" or args[1] == "-h" then
        commands.run({commands.compiler(), "test", "--internal-runner", "--help"})
        return
    end
    local expected: {string} = {}
    local structured = false
    for _, name in ipairs(args) do
        if name == "--json" then
            structured = true
        elseif name:sub(1, 1) ~= "-" then
            expected[#expected + 1] = name
        end
    end
    if #expected == 0 then
        -- Discovery finds a suite at any depth under `tests`, and suite names are
        -- unique across the tree, so the expected set is every one of them.
        local seen: {[string]: boolean} = {}
        for _, pattern in ipairs({"/tests/*test.nupp", "/tests/**/*test.nupp"}) do
            for _, found in ipairs((assert(os.glob(commands.root .. pattern)))) do
                const name = assert(found:stem())
                if not seen[name] then
                    seen[name] = true
                    expected[#expected + 1] = name
                end
            end
        end
    end
    const env = native.libraries()
    commands.run({commands.compiler(), "build", "--target", "headless"}, env)
    const result = commands.capture(
        commands.append({commands.compiler(), "test", "--internal-runner", "--json"}, args),
        env
    )
    io.stderr:write(result.erroroutput)
    assert(os.mkdir(commands.root .. "/out/validation"))
    assert(os.writeatomic(commands.root .. "/out/validation/nupp-tests.json", result.output))
    if structured then
        io.stdout:write(result.output)
    end
    if not result:succeeded() then
        if not structured then
            io.stderr:write(result.output)
        end
        os.exit(commands.failure(result.exit) or 1)
    end
    const report = assert(json.decodevalue(result.output))
    gates.tests(report, expected)
    if not structured then
        print(report.total .. " tests passed in " .. #expected .. " suites; zero skipped")
    end
end

local function verify(): nil
    commands.run({commands.compiler(), "check"})
    commands.run({commands.compiler(), "task", "format-check"})
    commands.run({commands.compiler(), "test"})
    commands.run({commands.compiler(), "task", "test-tools"})
    commands.run({commands.compiler(), "task", "docs-check"})
    const env = commands.sdk()
    commands.run({"cargo", "clippy", "--locked", "--workspace", "--all-targets", "--", "-D", "warnings"}, env)
    commands.run({"cargo", "test", "--locked", "--workspace", "--all-targets"}, env)
    for _, target in ipairs({
        "host",
        "flatcolor",
        "sprites",
        "lighting",
        "nativesmoke",
        "tiled",
        "ui",
        "uistandalone",
        "shapes"
    }) do
        commands.run({commands.compiler(), "task", "ex-" .. target, "--headless", "--frames", "5"}, env)
    end
end

local args: {string} = {...}
const task = assert(table.remove(args, 1), "use nupp tasks to list the development commands")
if task == "test" then
    test(args)
elseif task == "host" or task == "run" then
    host(args, task == "run")
elseif task == "physicssmoke" then
    commands.run({commands.compiler(), "run", "examples/nupp/physicssmoke.nupp"}, native.libraries())
elseif task == "fetch" then
    assert(#args == 1 and (args[1] == "sponza" or args[1] == "bistro"), "usage: nupp task fetch sponza|bistro")
    local command = {"cargo", "run", "--locked", "--release", "-p", "tecs-example-assets"}
    if args[1] == "bistro" then
        commands.append(command, {"--features", "bistro-import"})
    end
    commands.run(commands.append(command, {"--", args[1]}))
elseif task == "bench" then
    require("tecs.dev.bench").run(args)
elseif task == "format" or task == "format-check" then
    require("tecs.dev.format").apply(args, task == "format-check")
elseif task == "docs-check" then
    assert(#args == 0, "docs-check takes no arguments")
    require("tecs.dev.docs").check()
elseif task == "docs-dev" then
    assert(#args == 0 or (#args == 2 and args[1] == "--port"), "usage: nupp task docs-dev [--port PORT]")
    const port = #args == 0 and 5173 or assert(tonumber(args[2]), "port must be a number")
    assert(port == math.floor(port) and port > 0 and port <= 65535, "port must be 1 through 65535")
    require("tecs.dev.docs").serve(port as integer)
elseif task == "test-tools" then
    assert(#args == 0, "test-tools takes no arguments")
    commands.run({commands.compiler(), "check"}, nil, commands.root .. "/tools")
    commands.run({commands.compiler(), "test"}, nil, commands.root .. "/tools")
elseif task == "deps" then
    assert(#args == 0, "deps takes no arguments")
    assert(ffi.os == "OSX", "automatic formatter installation is macOS-only; install stylua and prettier on PATH")
    commands.run({"brew", "install", "stylua", "prettier"})
elseif task == "verify" then
    assert(#args == 0, "verify takes no arguments")
    verify()
elseif task == "clean" then
    assert(#args == 0, "clean takes no arguments")
    commands.run({commands.compiler(), "clean"})
    commands.run({"cargo", "clean"})
    if os.exists(commands.root .. "/out") then
        assert(os.remove(commands.root .. "/out", true))
    end
else
    error("unknown development task " .. task)
end
