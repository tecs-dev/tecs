local files = require("nupp.io.files")
local process = require("nupp.io.process")

-- Enter the tooling project before compiling its modules. The game manifest
-- must never acquire the process-launch capabilities its development tools use.
const root = assert(files.currentDirectory())
const compilerRoot = os.getenv("NUPP_COMPILER_ROOT")
local args = {compilerRoot and compilerRoot .. "/bin/nupp" or "nupp", "run", "tecs/dev/main.nupp"}
for _, value in ipairs({...} as {string}) do
    args[#args + 1] = value
end
const options: process.Options = {
    args = args,
    cwd = root .. "/tools",
    env = {TECS_PROJECT_ROOT = root},
    stdin = "inherit",
    stdout = "inherit",
    stderr = "inherit"
}
with child = new process.Process(options) do
    const status = child:wait()
    if not status:succeeded() then
        os.exit(status.exitCode == 0 and 1 or status.exitCode)
    end
end
