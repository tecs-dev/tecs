.claude/

/out/
/build/
/native/rust/target/

# Development dependencies installed into the tree. The vendored C sources
# under vendor/cjson are ours to carry, so they are exempt.
/vendor/*
!/vendor/cjson/

.mcp.json

# The documentation site. Its dependencies and its build output; the content
# and the VitePress configuration are tracked.
/docs/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# macOS system files
.DS_Store

# Python bytecode, which the generator scripts leave behind.
__pycache__/
*.pyc
