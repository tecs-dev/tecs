rockspec_format = "3.0"
package = "tecs.tl"
version = "dev-1"

source = {
    url = "git+https://github.com/tecs-dev/tecs.git",
    branch = "main"
}

description = {
    summary = "High-performance Entity Component System framework for LuaJIT",
    detailed = [[
Tecs is a high-performance Entity Component System (ECS) framework written in Teal,
designed specifically for LuaJIT with FFI. It provides a type-safe, cache-friendly
ECS implementation optimized for game development.

Features:
- Type-safe ECS with Teal
- FFI-optimized component storage
- Immutable spawns for performance
- Transaction system with staging archetypes
- Frame arena memory management
- Zero allocations after warmup
    ]],
    homepage = "https://github.com/your-org/tecs",
    license = "MIT"
}

dependencies = {
    "lua >= 5.1, < 5.5",
}

test_dependencies = {
    "busted",
}

build_dependencies = {
    "cyan >= 0.4.0",
}

test = {
    type = "busted",
    flags = { "--loaders=teal" }
}

build = {
    type = "make",
    build_command = "cyan build -q",
    modules = {
        -- {{LUA_FILES}}
    },
    install = {
        lua = {
            -- {{TEAL_FILES}}
        }
    }
}